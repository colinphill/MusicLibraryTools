using System;
using System.Collections.Generic;
using System.IO;
using System.Text;

using Vorbis;

namespace FLAC
{
    public class FLACFile
    {
        public string Filename;
        public VorbisComments Comments = new VorbisComments();

        public FLACFile(string filename)
        {
            Filename = filename;

            FileStream s = new FileStream(filename, FileMode.Open, FileAccess.Read);
            
            byte [] b = new byte[4];
            s.Read(b, 0, 4);
            if (Encoding.ASCII.GetString(b) != "fLaC")
                throw new InvalidDataException();

            bool last = false;
            while (!last)
            {
                s.Read(b, 0, 4);
                
                long len = b[1];
                len = (len << 8) | b[2];
                len = (len << 8) | b[3];

                if ((b[0] & 127) == 4)
                {
                    byte [] vc = new byte[len];
                    s.Read(vc, 0, (int)len);
                    Comments.FromByteArray(vc);
                }
                else if ((b[0] & 127) == 6)
                {
                    byte[] p = new byte[len];
                    s.Read(p, 0, (int)len);
                    Comments.Artworks.Add(new VorbisArtwork(p));
                }
                else
                    s.Seek(len, SeekOrigin.Current);
                
                last = ((b[0] & 128) == 128);

            }
    
            s.Close();
        }

    }

}