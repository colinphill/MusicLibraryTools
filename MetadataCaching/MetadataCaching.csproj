<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UserSecretsId>5b622ac7-b11d-47cb-8284-42c275d85087</UserSecretsId>
    <!-- SQLite is the active backend; keep its implementation enabled for every configuration. -->
    <DefineConstants>$(DefineConstants);SQLITE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ITLTools\ITLTools.csproj" />
    <ProjectReference Include="..\MusicFileUtilities\MusicFileUtilities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
</Project>
