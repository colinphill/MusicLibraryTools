<Window x:Class="MusicLibraryManager.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        Title="Music Library Manager — Studio" Icon="Assets/AppIcon.ico"
        Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="Manual" WindowStyle="None"
        Background="#0D1417">
    <Window.Resources>
        <SolidColorBrush x:Key="CaptionForegroundBrush" Color="#EAF3F2" />
        <SolidColorBrush x:Key="CaptionHoverBrush" Color="#1B2C31" />
        <SolidColorBrush x:Key="CaptionPressedBrush" Color="#244047" />
        <SolidColorBrush x:Key="CloseHoverBrush" Color="#D85D65" />
        <SolidColorBrush x:Key="CloseHoverTextBrush" Color="#FFFFFF" />
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource CaptionForegroundBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource CloseHoverTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Background="#121D21"
                BorderBrush="#2A3B40" BorderThickness="0,0,0,1">
            <Grid>
                <Grid Margin="12,0,150,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="5" Background="#18262B"
                            BorderBrush="#2CC7BC" BorderThickness="1">
                        <Image Source="Assets/AppIcon.ico" Width="16" Height="16" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="9,0,0,0"
                               VerticalAlignment="Center" Text="Music Library Manager"
                               Foreground="#EAF3F2" FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="13" FontWeight="SemiBold" />
                    <Border x:Name="StudioBadge" Grid.Column="2" Margin="9,0,0,0" Padding="7,2"
                            VerticalAlignment="Center" CornerRadius="8" Background="#18262B"
                            BorderBrush="#2A3B40" BorderThickness="1">
                        <TextBlock x:Name="StudioBadgeText" Text="STUDIO" Foreground="#2CC7BC"
                                   FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="9"
                                   FontWeight="Bold" />
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <Border Width="10" Height="1" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMaximizeRestoreClick" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                        <Grid Width="13" Height="13">
                            <Border x:Name="MaximizeGlyph" Width="10" Height="10" BorderThickness="1"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Grid x:Name="RestoreGlyph" Visibility="Collapsed">
                                <Border Width="9" Height="9" Margin="0,3,3,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        BorderThickness="1" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Border Width="9" Height="9" Margin="3,0,0,3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        BorderThickness="1" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}"
                            Click="OnCloseClick" ToolTip="Close" AutomationProperties.Name="Close">
                        <Path Width="11" Height="11" Stretch="Fill" Data="M 0,0 L 11,11 M 11,0 L 0,11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <blazor:BlazorWebView x:Name="StudioWebView" Grid.Row="1" HostPage="wwwroot\index.html"
                              BlazorWebViewInitialized="OnBlazorWebViewInitialized" />
    </Grid>
</Window>
