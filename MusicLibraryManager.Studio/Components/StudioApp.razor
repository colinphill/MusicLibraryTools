@inherits ReactiveComponentBase
@inject ShellViewModel Shell
@inject LibraryViewModel Library
@inject IndexingViewModel Indexing
@inject INavigationService Navigation
@inject StudioDialogService Dialogs
@inject IThemeService Theme

<div class="studio-app" data-theme="@ThemeName" tabindex="-1" @onkeydown="HandleKeyDown">
    <aside class="studio-rail" aria-label="Primary navigation">
        <div class="brand-block">
            <img src="assets/BrandMark.svg" alt="" />
            <div class="brand-copy"><strong>Music Library</strong><span>STUDIO</span></div>
        </div>
        <nav>
            @NavItem(ShellDestination.Home, "⌂", "Home")
            @NavItem(ShellDestination.Library, "♫", "Library")
            @NavItem(ShellDestination.Health, "◇", "Health")
            @NavItem(ShellDestination.Ingest, "⇥", "Ingest")
            @NavItem(ShellDestination.Organize, "↹", "Organize")
            @NavItem(ShellDestination.Operations, "◫", "Operations")
        </nav>
        <button class="nav-item settings @(Current == ShellDestination.Settings ? "active" : null)"
                @onclick="() => Go(ShellDestination.Settings)"><span class="nav-icon">⚙</span><span class="nav-label">Settings</span></button>
    </aside>

    <section class="studio-stage">
        <header class="studio-toolbar">
            <div class="search-wrap">
                <span aria-hidden="true">⌕</span>
                <input id="global-search" value="@Shell.GlobalSearchText" @oninput="UpdateSearch"
                       @onkeydown="SearchKeyDown" placeholder="Search the library" aria-label="Search the library" />
                <kbd>Ctrl K</kbd>
            </div>
            <button class="toolbar-chip" @onclick="() => Go(ShellDestination.Settings)" title="Library configuration">
                <span class="status-dot"></span><span>@Shell.ConfigurationName</span>
            </button>
            <button class="toolbar-chip" @onclick="ToggleActivities" aria-expanded="@ShowActivities" title="Activity center">
                @if (Shell.HasRunningActivity) { <span class="spinner small"></span> } else { <span>◌</span> }
                <span>@Shell.ActivityText</span>
            </button>
        </header>

        <main class="studio-content">
            @switch (Current)
            {
                case ShellDestination.Home: <HomePage /> break;
                case ShellDestination.Library: <LibraryPage /> break;
                case ShellDestination.Health: <HealthPage /> break;
                case ShellDestination.Ingest: <IngestPage /> break;
                case ShellDestination.Organize: <OrganizePage /> break;
                case ShellDestination.Operations: <OperationsPage /> break;
                case ShellDestination.Settings: <SettingsPage /> break;
            }
        </main>
    </section>

    @if (ShowActivities)
    {
        <button class="drawer-scrim" aria-label="Close activity center" @onclick="ToggleActivities"></button>
        <aside class="activity-drawer" aria-label="Activity center">
            <div class="drawer-heading"><h2>Activity</h2><button class="icon-button" @onclick="ToggleActivities" aria-label="Close">×</button></div>
            @if (Shell.Activities.Count == 0)
            {
                <div class="empty-state"><span>◌</span><p>No activity yet.</p></div>
            }
            else
            {
                @foreach (AppActivity item in Shell.Activities)
                {
                    <article class="activity-item @item.State.ToString().ToLowerInvariant()">
                        <span class="activity-state"></span>
                        <div><strong>@item.Title</strong><p>@item.Message</p></div>
                    </article>
                }
            }
        </aside>
    }
    <StudioDialogHost />
</div>

@code {
    private ShellDestination Current = ShellDestination.Home;
    private bool ShowActivities;
    private string ThemeName => Theme.Current.ToLowerInvariant();

    protected override void OnInitialized()
    {
        Observe(Shell);
        Observe(Shell.Activities);
        Navigation.NavigationRequested += OnNavigationRequested;
        if (Theme is StudioThemeService studioTheme)
            Observe(handler => studioTheme.Changed += handler, handler => studioTheme.Changed -= handler);
    }

    private RenderFragment NavItem(ShellDestination destination, string icon, string label) => builder =>
    {
        int seq = 0;
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "class", $"nav-item {(Current == destination ? "active" : "")}");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => Go(destination)));
        builder.OpenElement(seq++, "span"); builder.AddAttribute(seq++, "class", "nav-icon"); builder.AddContent(seq++, icon); builder.CloseElement();
        builder.OpenElement(seq++, "span"); builder.AddAttribute(seq++, "class", "nav-label"); builder.AddContent(seq++, label); builder.CloseElement();
        builder.CloseElement();
    };

    private void Go(ShellDestination destination) => Navigation.Navigate(destination);

    private void OnNavigationRequested(ShellDestination destination)
    {
        Current = destination;
        Refresh();
    }

    private void UpdateSearch(ChangeEventArgs e) => Shell.GlobalSearchText = e.Value?.ToString();
    private void SearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            Library.SetGlobalFilter(Shell.GlobalSearchText);
    }

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (!e.CtrlKey)
            return;
        if (e.Key.Equals("k", StringComparison.OrdinalIgnoreCase))
            await JS.InvokeVoidAsync("studio.focus", "global-search");
        else if (e.Key.Equals("i", StringComparison.OrdinalIgnoreCase) && Indexing.IndexCommand.CanExecute(null))
            Indexing.IndexCommand.Execute(null);
    }

    [Inject] private IJSRuntime JS { get; set; } = null!;
    private void ToggleActivities() => ShowActivities = !ShowActivities;

    public override void Dispose()
    {
        Navigation.NavigationRequested -= OnNavigationRequested;
        base.Dispose();
    }
}
