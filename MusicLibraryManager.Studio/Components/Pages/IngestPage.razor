@inherits ReactiveComponentBase
@inject IngestViewModel ViewModel
@inject StudioDropService Drops
@inject IJSRuntime JS

<section class="page" style="grid-template-rows:auto auto minmax(0,1fr)">
    <PageHeader Title="Ingest" Subtitle="Preflight, preview, and safely import music into the active library.">
        <Actions>
            <StudioCommandButton Command="ViewModel.PreflightCommand">Preflight</StudioCommandButton>
            <StudioCommandButton Command="ViewModel.PreviewCommand">Preview</StudioCommandButton>
            <StudioCommandButton Command="ViewModel.ApplyCommand" CssClass="button primary">Apply</StudioCommandButton>
            <StudioCommandButton Command="ViewModel.CancelCommand">Cancel</StudioCommandButton>
        </Actions>
    </PageHeader>
    <article id="ingest-drop-zone" class="card stack scrollable-card">
        <div class="row wrap">
            <label class="field grow">Incoming folder<input value="@ViewModel.SourceDirectory" @oninput="e => ViewModel.SourceDirectory=e.Value?.ToString()" placeholder="Drop a folder here or browse" /></label>
            <StudioCommandButton Command="ViewModel.BrowseSourceCommand">Browse</StudioCommandButton>
            <select value="@ViewModel.SelectedRecentSource" @onchange="RecentChanged"><option value="">Recent sources</option>@foreach(string source in ViewModel.RecentSources){<option value="@source">@source</option>}</select>
        </div>
        <div class="row wrap">
            <label class="field grow">Preset name<input value="@ViewModel.PresetName" @oninput="e => ViewModel.PresetName=e.Value?.ToString()" /></label>
            <select value="@ViewModel.SelectedPreset?.Name" @onchange="PresetChanged"><option value="">Presets</option>@foreach(IngestPreset p in ViewModel.Presets){<option value="@p.Name">@p.Name</option>}</select>
            <StudioCommandButton Command="ViewModel.SavePresetCommand">Save preset</StudioCommandButton>
            <StudioCommandButton Command="ViewModel.DeletePresetCommand">Delete</StudioCommandButton>
        </div>
        <div class="status-banner">@ViewModel.ConfigurationReadinessText</div>
        @if(ViewModel.HasPreflightChecks){<div class="row wrap">@foreach(var check in ViewModel.PreflightChecks){<span class="pill @check.Severity.ToString().ToLowerInvariant()">@check.Name: @check.Message</span>}</div>}
        @if(ViewModel.IsApplying){<div class="progress-track"><span style="width:@ApplyPercent%"></span></div>}
        <div class="muted">@ViewModel.StatusText</div>
    </article>
    <article class="card flush stack fill-card" style="padding:12px">
        <div class="tabs">
            <button class="tab @(Tab==0?"active":null)" @onclick="()=>Tab=0">Preview</button>
            <button class="tab @(Tab==1?"active":null)" @onclick="()=>Tab=1">History</button>
        </div>
        @if(Tab==0)
        {
            <div class="row wrap"><span class="pill">@ViewModel.AlbumCount albums</span><span class="pill">@ViewModel.OutputCount outputs</span><span class="pill">@ViewModel.ConflictCount conflicts</span><span class="pill">@ViewModel.CleanupCount cleanup</span><span class="spacer"></span>
                <select value="@ViewModel.SelectedPreviewFilter" @onchange="PreviewFilterChanged">@foreach(var f in ViewModel.PreviewFilters){<option value="@f">@f</option>}</select></div>
            <div class="simple-table scroll-area"><div class="simple-head"><span>Type</span><span>Source</span><span>Plan</span><span>Progress</span></div>
            @foreach(IngestFileItemViewModel item in ViewModel.Files){<div class="simple-row"><span>@item.SourceType</span><span title="@item.Source">@item.Source</span><span>@item.Summary</span><span>@item.ProgressText</span></div>}</div>
        }
        else
        {
            <div class="row"><StudioCommandButton Command="ViewModel.RefreshHistoryCommand">Refresh history</StudioCommandButton><span class="muted">@ViewModel.HistoryStatus</span></div>
            <div class="list scroll-area">@foreach(IngestHistoryItemViewModel item in ViewModel.History){<article class="list-item"><div><strong>@item.AffectedItems</strong><p>@item.Created · @item.State</p><small>@item.RunPath</small></div>@if(item.IsInterrupted){<StudioCommandButton Command="ViewModel.OpenHistoryCommand" Parameter="item">Recover</StudioCommandButton>}</article>}</div>
        }
    </article>
</section>

@code {
    private int Tab;
    private double ApplyPercent => ViewModel.ApplyProgressMaximum <= 0 ? 0 : 100d*ViewModel.ApplyProgress/ViewModel.ApplyProgressMaximum;
    protected override void OnInitialized(){Observe(ViewModel);Observe(ViewModel.Files);Observe(ViewModel.History);Observe(ViewModel.PreflightChecks);Drops.SourceDropped+=Dropped;}
    protected override async Task OnAfterRenderAsync(bool first){if(first)await JS.InvokeVoidAsync("studio.installDropBridge","ingest-drop-zone");}
    private void Dropped(string path)=>ViewModel.SetDroppedSource(path);
    private void RecentChanged(ChangeEventArgs e)=>ViewModel.SelectedRecentSource=e.Value?.ToString();
    private void PresetChanged(ChangeEventArgs e)=>ViewModel.SelectedPreset=ViewModel.Presets.FirstOrDefault(p=>p.Name==e.Value?.ToString());
    private void PreviewFilterChanged(ChangeEventArgs e){if(Enum.TryParse(e.Value?.ToString(),out IngestPreviewFilter f))ViewModel.SelectedPreviewFilter=f;}
    public override void Dispose(){Drops.SourceDropped-=Dropped;base.Dispose();}
}
