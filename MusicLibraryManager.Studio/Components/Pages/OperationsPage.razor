@inherits ReactiveComponentBase
@inject OperationsViewModel ViewModel

<section class="page" style="grid-template-rows:auto minmax(0,1fr)">
    <PageHeader Title="Operations" Subtitle="Run unified jobs, inspect history, and recover journaled changes." />
    <article class="card flush stack fill-card" style="padding:12px">
        <div class="tabs"><button class="tab @(Tab==0?"active":null)" @onclick="()=>Tab=0">Jobs</button><button class="tab @(Tab==1?"active":null)" @onclick="()=>Tab=1">Job history</button><button class="tab @(Tab==2?"active":null)" @onclick="()=>Tab=2">Recovery</button></div>
        @if(Tab==0)
        {
            <div class="operations-jobs">
                <div class="list scroll-area">@foreach(var job in ViewModel.JobCatalog){<button class="list-item buttonless @(ViewModel.SelectedJob==job?"selected":null)" @onclick="()=>ViewModel.SelectedJob=job"><div><strong>@job.Name</strong><p>@job.Description</p></div></button>}</div>
                <div class="stack scroll-area job-form">
                    @if(ViewModel.SelectedJob is not null){<h2>@ViewModel.SelectedJob.Name</h2><p class="muted">@ViewModel.SelectedJob.Description</p>}
                    @if(ViewModel.ShowPlaylistName){<label class="field">Playlist name<input @bind="ViewModel.JobPlaylistName" /></label>}
                    @if(ViewModel.ShowDestinationPath){<label class="field">Destination<div class="row"><input class="grow" @bind="ViewModel.JobDestinationPath"/><StudioCommandButton Command="ViewModel.BrowseJobDestinationCommand">Browse</StudioCommandButton></div></label>}
                    @if(ViewModel.ShowValidationPath){<label class="field">Validation path<div class="row"><input class="grow" @bind="ViewModel.JobValidationPath"/><StudioCommandButton Command="ViewModel.BrowseJobValidationCommand">Browse</StudioCommandButton></div></label>}
                    @if(ViewModel.ShowRemovalLimit){<label class="field">Maximum removals<input type="number" @bind="ViewModel.JobMaxRemovals"/></label>}
                    <div class="row wrap">@if(ViewModel.ShowInitialize){<label class="check"><input type="checkbox" @bind="ViewModel.JobInitialize"/>Initialize</label>}@if(ViewModel.ShowClean){<label class="check"><input type="checkbox" @bind="ViewModel.JobClean"/>Clean</label>}@if(ViewModel.ShowRebalance){<label class="check"><input type="checkbox" @bind="ViewModel.JobRebalance"/>Rebalance</label>}@if(ViewModel.ShowFixErrors){<label class="check"><input type="checkbox" @bind="ViewModel.JobFixErrors"/>Fix errors</label>}</div>
                    <div class="row"><StudioCommandButton Command="ViewModel.PreviewJobCommand">Preview</StudioCommandButton>@if(ViewModel.ShowJobApply){<StudioCommandButton Command="ViewModel.ApplyJobCommand" CssClass="button primary">Apply</StudioCommandButton>}</div>
                    <div class="status-banner">@ViewModel.JobStatus</div><textarea rows="10" readonly value="@ViewModel.JobOutput"></textarea>
                </div>
            </div>
        }
        else if(Tab==1)
        {
            <div class="simple-table fill"><div class="simple-head history"><span>When</span><span>Job</span><span>State</span><span>Elapsed</span><span>Output</span></div>@foreach(var item in ViewModel.JobHistory){<div class="simple-row history"><span>@item.Created</span><span>@item.JobName</span><span>@item.State</span><span>@item.Elapsed</span><span>@item.Output</span></div>}</div>
        }
        else
        {
            <div class="recovery-layout">
                <div class="stack"><div class="row"><input class="grow" @bind="ViewModel.SearchRoot" placeholder="Search root"/><StudioCommandButton Command="ViewModel.BrowseRootCommand">Browse</StudioCommandButton><StudioCommandButton Command="ViewModel.RefreshCommand">Scan</StudioCommandButton></div>
                <div class="list scroll-area">@foreach(OperationRunViewModel run in ViewModel.Runs){<button class="list-item buttonless @(ViewModel.SelectedRun==run?"selected":null)" @onclick="()=>ViewModel.SelectedRun=run"><div><strong>@run.ToolName</strong><p>@run.State · @run.Created</p></div></button>}</div></div>
                <div class="stack"><div class="row wrap"><StudioCommandButton Command="ViewModel.OpenRunCommand">Open run</StudioCommandButton><StudioCommandButton Command="ViewModel.SelectAllRestorableCommand">Select restorable</StudioCommandButton><StudioCommandButton Command="ViewModel.ClearRestoreSelectionCommand">Clear</StudioCommandButton></div>
                    <div class="list scroll-area">@foreach(OperationEntryNodeViewModel node in ViewModel.RootNodes){<label class="list-item"><input type="checkbox" @bind="node.IsSelected" disabled="@(!node.CanRestore)"/><div><strong>@node.Name</strong><p>@node.OriginalPath</p></div><span class="pill">@node.Kind</span></label>}</div>
                    @if(!string.IsNullOrWhiteSpace(ViewModel.RestorePreviewText)){<div class="status-banner preserve-lines">@ViewModel.RestorePreviewText</div>}
                    <div class="row wrap"><StudioCommandButton Command="ViewModel.PreviewRestoreCommand">Preview restore</StudioCommandButton><StudioCommandButton Command="ViewModel.ApplyRestoreCommand" CssClass="button primary">Apply restore</StudioCommandButton><label class="field">Retention days<input type="number" @bind="ViewModel.RetentionDays"/></label><StudioCommandButton Command="ViewModel.PreviewPurgeCommand">Preview purge</StudioCommandButton><StudioCommandButton Command="ViewModel.ApplyPurgeCommand" CssClass="button danger">Purge</StudioCommandButton></div><span class="muted">@ViewModel.StatusText</span>
                </div>
            </div>
        }
    </article>
</section>
@code { private int Tab; protected override void OnInitialized(){Observe(ViewModel);Observe(ViewModel.Runs);Observe(ViewModel.RootNodes);Observe(ViewModel.JobHistory);} }
