@inherits ReactiveComponentBase
@inject LibraryViewModel ViewModel
@inject StudioGridStateService GridState
@inject IPlatformService Platform

<section class="page library-page" style="grid-template-rows:auto auto minmax(0,1fr) auto">
    <PageHeader Title="Library" Subtitle="Browse the cache instantly, even when music roots are offline.">
        <Actions>
            <StudioCommandButton Command="ViewModel.ReloadCommand">Reload</StudioCommandButton>
            <StudioCommandButton Command="ViewModel.Indexing.IndexCommand" CssClass="button primary">Index library</StudioCommandButton>
            <StudioCommandButton Command="ViewModel.Indexing.CancelCommand">Cancel</StudioCommandButton>
            <button class="button inspector-toggle" @onclick="() => ShowInspector = !ShowInspector">Inspector</button>
        </Actions>
    </PageHeader>

    <div class="library-toolbar">
        <input id="library-filter" class="grow" value="@ViewModel.FilterText" @oninput="FilterChanged"
               placeholder="Filter, or use Artist:Name AND NOT Codec:MP3" aria-label="Library filter" />
        <select value="@ViewModel.FilterMode" @onchange="FilterModeChanged" aria-label="Filter mode">
            @foreach (var mode in ViewModel.FilterModes) { <option value="@mode">@mode</option> }
        </select>
        <details class="column-menu"><summary class="button">Columns</summary><div class="popover stack">
            @foreach (StudioGridColumn<LibraryRow> column in Columns)
            {
                <label class="check"><input type="checkbox" checked="@column.Visible" @onchange="e => SetColumnVisible(column, e)" /> @column.Header</label>
            }
        </div></details>
        <select value="@ViewModel.SelectedView?.Name" @onchange="SavedViewChanged" aria-label="Saved view">
            <option value="">Saved views</option>
            @foreach (LibraryViewDefinition view in ViewModel.SavedViews) { <option value="@view.Name">@view.Name</option> }
        </select>
        <input class="view-name" value="@ViewModel.NewViewName" @oninput="e => ViewModel.NewViewName = e.Value?.ToString()" placeholder="View name" />
        <button class="button" @onclick="SaveView">Save view</button>
        <StudioCommandButton Command="ViewModel.DeleteViewCommand">Delete</StudioCommandButton>
    </div>

    <ResizableSplitPane CssClass="@($"library-workspace {(ShowInspector ? "show-inspector" : "")}")" InitialLeftWidth="900" MinLeftWidth="340" MaxLeftWidth="1800" MinRightWidth="190" PersistenceKey="library" Label="Resize library and inspector">
        <Left>
            <div class="card flush grid-card">
                <StudioDataGrid @ref="Grid" TItem="LibraryRow" Items="ViewModel.Rows" Columns="Columns"
                                KeySelector="row => row.Path" FrozenColumnCount="1" AriaLabel="Music library"
                                EmptyText="No tracks match this view" SelectionChanged="SelectionChanged"
                                OnItemRealized="ViewModel.LoadThumbnailAsync" OnItemReleased="ViewModel.ReleaseThumbnail"
                                InitialSortKey="@(InitialSort?.Key)" InitialSortDescending="@(InitialSort?.Descending ?? false)"
                                OnLayoutChanged="PersistLayout" />
            </div>
        </Left>
        <Right><aside class="library-inspector card"><SelectionInspector /></aside></Right>
    </ResizableSplitPane>

    <footer class="row muted">
        <span class="grow">@ViewModel.StatusText</span>
        @if (Selected.Count > 0)
        {
            <span class="pill">@Selected.Count selected</span>
            <button class="button" @onclick="CopyPaths">Copy paths</button>
            <button class="button" @onclick="RevealFirst">Reveal</button>
            <button class="button" @onclick="ReindexSelected">Reindex</button>
        }
        <span>@ViewModel.Indexing.StatusText</span>
    </footer>
</section>

@code {
    private readonly List<StudioGridColumn<LibraryRow>> Columns = [];
    private StudioDataGrid<LibraryRow>? Grid;
    private IReadOnlyList<LibraryRow> Selected = [];
    private LibrarySortState? InitialSort;
    private bool ShowInspector;

    protected override void OnInitialized()
    {
        Observe(ViewModel);
        Observe(ViewModel.SavedViews);
        Observe(ViewModel.Columns);
        Observe(ViewModel.Indexing);
        BuildColumns();
        ApplySnapshot(GridState.Load());
        if (ViewModel.Rows.Count == 0)
            _ = ViewModel.ReloadAsync();
    }

    private void BuildColumns()
    {
        Columns.Add(new() { Key="Artwork", Header="Artwork", Width=58, MinWidth=58, Sortable=false, Value=_ => "",
            Template = row => builder => { if (row.ThumbnailSource is string source) { builder.OpenElement(0,"img"); builder.AddAttribute(1,"class","grid-art"); builder.AddAttribute(2,"src",source); builder.AddAttribute(3,"alt",""); builder.CloseElement(); } } });
        Columns.Add(new() { Key="Title", Header="Title", Width=280, MinWidth=140, Value=row=>row.Title });
        Columns.Add(new() { Key="Artist", Header="Artist", Width=190, MinWidth=100, Value=row=>row.Artist });
        Columns.Add(new() { Key="AlbumArtist", Header="Album artist", Width=190, MinWidth=100, Visible=false, Value=row=>row.AlbumArtist });
        Columns.Add(new() { Key="Album", Header="Album", Width=230, MinWidth=120, Value=row=>row.Album });
        Columns.Add(new() { Key="Track", Header="Track", Width=70, MinWidth=58, Value=row=>row.Track });
        Columns.Add(new() { Key="TrackTotal", Header="Track total", Width=90, MinWidth=72, Visible=false, Value=row=>row.TrackTotal });
        Columns.Add(new() { Key="Disc", Header="Disc", Width=65, MinWidth=58, Visible=false, Value=row=>row.Disc });
        Columns.Add(new() { Key="DiscTotal", Header="Disc total", Width=85, MinWidth=70, Visible=false, Value=row=>row.DiscTotal });
        Columns.Add(new() { Key="Codec", Header="Codec", Width=105, MinWidth=80, Value=row=>row.Codec });
        Columns.Add(new() { Key="Duration", Header="Duration", Width=90, MinWidth=75, Value=row=>row.Duration });
        Columns.Add(new() { Key="Modified", Header="Modified", Width=150, MinWidth=110, Visible=false, Value=row=>row.Modified });
        Columns.Add(new() { Key="Path", Header="Path", Width=420, MinWidth=180, Value=row=>row.Path });
    }

    private void ApplySnapshot(StudioGridSnapshot? state)
    {
        if (state is null) return;
        foreach (LibraryColumnState saved in state.Columns.OrderBy(c => c.DisplayIndex))
        {
            StudioGridColumn<LibraryRow>? column = Columns.FirstOrDefault(c => string.Equals(c.Key, saved.Key, StringComparison.OrdinalIgnoreCase));
            if (column is null) continue;
            column.Visible = saved.Visible;
            if (saved.Width is > 0) column.Width = saved.Width.Value;
            Columns.Remove(column); Columns.Insert(Math.Min(saved.DisplayIndex, Columns.Count), column);
        }
        InitialSort = state.Sort;
    }

    private async Task SelectionChanged(IReadOnlyList<LibraryRow> rows)
    {
        Selected = rows;
        await ViewModel.SelectAsync(rows);
        if (rows.Count > 0 && ShowInspector) Refresh();
    }
    private void FilterChanged(ChangeEventArgs e) => ViewModel.FilterText = e.Value?.ToString();
    private void FilterModeChanged(ChangeEventArgs e) { if (Enum.TryParse(e.Value?.ToString(), out MusicLibrary.Core.Services.FilterMode mode)) ViewModel.FilterMode = mode; }
    private void SetColumnVisible(StudioGridColumn<LibraryRow> column, ChangeEventArgs e) { column.Visible = e.Value is true; PersistLayout(); Refresh(); }

    private void SavedViewChanged(ChangeEventArgs e)
    {
        ViewModel.SelectedView = ViewModel.SavedViews.FirstOrDefault(v => v.Name == e.Value?.ToString());
        if (ViewModel.SelectedView is { } view)
            ApplySnapshot(new StudioGridSnapshot(view.Columns, view.Sort));
        Refresh();
    }

    private void SaveView()
    {
        string name = ViewModel.NewViewName?.Trim() ?? "";
        if (name.Length == 0) return;
        ViewModel.SaveNamedView(name, CaptureColumns(), Grid?.GetSortState());
    }
    private IReadOnlyList<LibraryColumnState> CaptureColumns() => Columns.Select((c,i) => new LibraryColumnState(c.Key,c.Width,i,c.Visible)).ToArray();
    private void PersistLayout() => GridState.Save(new StudioGridSnapshot(CaptureColumns(), Grid?.GetSortState()));
    private async Task CopyPaths() { if (Selected.Count > 0) await Platform.CopyTextAsync(string.Join(Environment.NewLine, Selected.Select(r=>r.Path))); }
    private void RevealFirst() { if (Selected.FirstOrDefault() is { } row) Platform.RevealFile(row.Path); }
    private async Task ReindexSelected() => await ViewModel.ReindexAsync(Selected.Select(r=>r.Path).ToArray());
}
