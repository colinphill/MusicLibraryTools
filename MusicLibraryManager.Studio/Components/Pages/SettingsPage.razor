@inherits ReactiveComponentBase
@inject SettingsViewModel ViewModel

<section class="page" style="grid-template-rows:auto minmax(0,1fr)">
    <PageHeader Title="Settings" Subtitle="Configure libraries, playlists, ingest tools, and the Studio appearance.">
        <Actions><StudioCommandButton Command="ViewModel.SaveConfigurationCommand" CssClass="button primary">Save</StudioCommandButton><StudioCommandButton Command="ViewModel.SaveConfigurationAsCommand">Save as</StudioCommandButton></Actions>
    </PageHeader>
    <article class="card flush settings-surface">
        <div class="tabs scroll-x">
            @foreach ((string label, int index) in Tabs) { <button class="tab @(Tab == index ? "active" : null)" @onclick="() => Tab = index">@label</button> }
        </div>
        <div class="settings-body scroll-area">
            @if (Tab == 0)
            {
                <section class="settings-section stack"><h2>Active configuration</h2><div class="status-banner">@(ViewModel.ActiveConfigurationPath ?? "No configuration loaded")</div>
                    <div class="row wrap"><StudioCommandButton Command="ViewModel.BrowseConfigurationCommand">Open configuration</StudioCommandButton><StudioCommandButton Command="ViewModel.EditCurrentConfigurationCommand" CssClass="button primary">Edit full configuration</StudioCommandButton><StudioCommandButton Command="ViewModel.NewConfigurationCommand">New configuration</StudioCommandButton></div>
                    <label class="field">Recent configurations<select value="@ViewModel.SelectedRecentConfiguration" @onchange="RecentChanged"><option value="">Choose recent configuration</option>@foreach(string path in ViewModel.RecentConfigurations){<option value="@path">@path</option>}</select></label>
                    <div class="row"><StudioCommandButton Command="ViewModel.LoadRecentConfigurationCommand">Load selected</StudioCommandButton><StudioCommandButton Command="ViewModel.ClearRecentConfigurationsCommand">Clear history</StudioCommandButton></div>
                    <label class="field">Configuration path<input value="@ViewModel.EditorPath" readonly /></label><div class="status-banner">@ViewModel.StatusMessage</div>
                </section>
            }
            else if (Tab == 1)
            {
                <section class="settings-section stack"><div class="row"><h2 class="grow">Library roots and set membership</h2><StudioCommandButton Command="ViewModel.AddIndexTargetCommand">Add root</StudioCommandButton></div>
                    @foreach(IndexTargetEditorRow root in ViewModel.IndexTargets)
                    {
                        <article class="nested-card stack"><div class="row"><label class="field grow">Root path<input @bind="root.Path" /></label><StudioCommandButton Command="ViewModel.BrowseIndexTargetCommand" Parameter="root">Browse</StudioCommandButton><StudioCommandButton Command="ViewModel.RemoveIndexTargetCommand" Parameter="root">Remove</StudioCommandButton></div>
                            <div class="form-grid"><label class="field">Filter<input @bind="root.Filter" /></label><label class="field">Default offset<input @bind="root.DefaultOffset" /></label><label class="field">Ingest role<select @bind="root.IngestRole">@foreach(var role in ViewModel.IngestRoles){<option value="@role">@role</option>}</select></label></div>
                            <div class="row wrap"><label class="check"><input type="checkbox" @bind="root.Organize" /> Organize</label><label class="check"><input type="checkbox" @bind="root.UseItunesCanonicalNaming" /> iTunes canonical naming</label><label class="check"><input type="checkbox" @bind="root.IsSyncTarget" /> Sync target</label><StudioCommandButton Command="ViewModel.AddIndexTargetSetCommand" Parameter="root">Add set</StudioCommandButton></div>
                            @foreach(IndexTargetSetEditorRow set in root.Memberships){<div class="row"><input class="grow" @bind="set.Name" placeholder="Set name"/><input @bind="set.Offset" placeholder="Offset"/><StudioCommandButton Command="ViewModel.RemoveIndexTargetSetCommand" Parameter="set">Remove</StudioCommandButton></div>}
                        </article>
                    }
                </section>
            }
            else if (Tab == 2)
            {
                <section class="settings-section stack"><div class="row"><h2 class="grow">Sync playlists</h2><StudioCommandButton Command="ViewModel.AddSyncPlaylistCommand">Add playlist</StudioCommandButton></div>
                    @foreach(SyncPlaylistEditorRow playlist in ViewModel.SyncPlaylists){<div class="row"><input class="grow" @bind="playlist.Name" placeholder="Playlist name"/><StudioCommandButton Command="ViewModel.RemoveSyncPlaylistCommand" Parameter="playlist">Remove</StudioCommandButton></div>}
                    <div class="row"><h2 class="grow">Playlist export targets</h2><StudioCommandButton Command="ViewModel.AddPlaylistTargetCommand">Add target</StudioCommandButton></div>
                    @foreach(PlaylistTargetEditorRow target in ViewModel.PlaylistTargets){<article class="nested-card form-grid"><label class="field">Target<input @bind="target.Target"/></label><label class="field">Type<select @bind="target.Type">@foreach(string type in ViewModel.PlaylistTypes){<option value="@type">@type</option>}</select></label><label class="field">Sets<input @bind="target.Sets"/></label><div class="row"><StudioCommandButton Command="ViewModel.BrowsePlaylistTargetCommand" Parameter="target">Browse</StudioCommandButton><StudioCommandButton Command="ViewModel.RemovePlaylistTargetCommand" Parameter="target">Remove</StudioCommandButton></div></article>}
                </section>
            }
            else if (Tab == 3)
            {
                <section class="settings-section stack"><h2>Cache and tool paths</h2><label class="field">Metadata database<div class="row"><input class="grow" @bind="ViewModel.DatabaseFile"/><StudioCommandButton Command="ViewModel.BrowseDatabaseCommand">Browse</StudioCommandButton></div></label><label class="field">iTunes library<div class="row"><input class="grow" @bind="ViewModel.ItunesLibraryPath"/><StudioCommandButton Command="ViewModel.BrowseItunesLibraryCommand">Browse</StudioCommandButton></div></label><label class="field">FFmpeg<div class="row"><input class="grow" @bind="ViewModel.FfmpegPath"/><StudioCommandButton Command="ViewModel.BrowseFfmpegCommand">Browse</StudioCommandButton></div></label>
                    <div class="form-grid"><label class="field">Path length limit<input type="number" @bind="ViewModel.LengthLimit"/></label><label class="field">Disc number length limit<input type="number" @bind="ViewModel.DiscNumLengthLimit"/></label><label class="field">AAC encoder<input @bind="ViewModel.AacEncoder"/></label><label class="field">AAC bitrate (kbps)<input type="number" @bind="ViewModel.AacBitrateKbps"/></label></div>
                    <label class="check"><input type="checkbox" @bind="ViewModel.DeleteSourcesAfterIngest"/> Delete source music after successful ingest</label><label class="check"><input type="checkbox" @bind="ViewModel.RemoveNonMusicAfterIngest"/> Remove non-music files after successful ingest</label>
                </section>
            }
            else
            {
                <section class="settings-section stack"><h2>Appearance</h2><p class="muted">System follows the Windows preference. Teal is reserved for selection, focus, progress, and safe actions.</p><div class="theme-options">@foreach(string theme in ViewModel.Themes){<label class="theme-option @(ViewModel.SelectedTheme == theme ? "selected" : null)"><input type="radio" name="theme" value="@theme" checked="@(ViewModel.SelectedTheme == theme)" @onchange="() => ViewModel.SelectedTheme = theme"/><span class="theme-swatch @theme.ToLowerInvariant()"></span><strong>@theme</strong></label>}</div></section>
            }
        </div>
    </article>
</section>

@code {
    private static readonly (string, int)[] Tabs = [("Configuration files", 0), ("Library editor", 1), ("Playlist editor", 2), ("Ingest & tools", 3), ("Appearance", 4)];
    private int Tab { get => ViewModel.SelectedTabIndex; set => ViewModel.SelectedTabIndex = value; }
    protected override void OnInitialized() { Observe(ViewModel); Observe(ViewModel.RecentConfigurations); Observe(ViewModel.IndexTargets); Observe(ViewModel.SyncPlaylists); Observe(ViewModel.PlaylistTargets); }
    private void RecentChanged(ChangeEventArgs e) => ViewModel.SelectedRecentConfiguration = e.Value?.ToString();
}
