@inherits ReactiveComponentBase
@inject StudioDialogService Dialogs

@if (Dialogs.Current is { } dialog)
{
    <div class="modal-backdrop" role="presentation" @onclick="Cancel">
        <section class="modal-card @(dialog is StudioFieldsRequest ? "modal-wide" : null)" role="dialog" aria-modal="true"
                 aria-labelledby="dialog-title" @onclick:stopPropagation="true">
            <header><h2 id="dialog-title">@dialog.Title</h2><button class="icon-button" @onclick="Cancel" aria-label="Close">×</button></header>
            @switch (dialog)
            {
                case StudioMessageRequest message:
                    <div class="modal-body preserve-lines">@message.Message</div>
                    <footer><button class="button primary" @onclick="Accept">OK</button></footer>
                    break;
                case StudioConfirmRequest confirm:
                    <div class="modal-body preserve-lines">@confirm.Message</div>
                    <footer><button class="button" @onclick="Cancel">Cancel</button><button class="button primary" @onclick="Accept">@confirm.PrimaryText</button></footer>
                    break;
                case StudioFieldsRequest fields:
                    <FieldsEditor ViewModel="fields.ViewModel" />
                    break;
            }
        </section>
    </div>
}

@code {
    protected override void OnInitialized() =>
        Observe(handler => Dialogs.Changed += handler, handler => Dialogs.Changed -= handler);

    private void Accept() => Dialogs.Complete(true);
    private void Cancel() => Dialogs.Complete(false);
}
