@inherits ReactiveComponentBase
@inject AnalyzerViewModel ViewModel

<div class="tree" role="tree" aria-label="Metadata repair hierarchy">
    <details class="tree-root" open>
        <summary class="tree-node @(ViewModel.SelectedRepairNode is null ? "selected" : null)" @onclick="SelectRoot"><span>All metadata repairs</span><span class="tree-count">@RootCount</span>@if (HasActionableRepairs) { <DispositionSelect Value="RootDisposition" ValueChanged="SetRootDisposition" Options="RootDispositions" /> }</summary>
        <div class="tree-children">
            @foreach (AnalysisRepairCategoryGroupViewModel category in ViewModel.RepairGroups)
            {
                <details open>
                    <summary class="tree-node @(ReferenceEquals(ViewModel.SelectedRepairNode, category) ? "selected" : null)" @onclick="() => Select(category)"><span>@category.Category</span><span class="tree-count">@category.Count</span>@if (HasActionable(category)) { <DispositionSelect Value="category.Disposition" ValueChanged="value => category.Disposition = value" Options="category.Dispositions" /> }</summary>
                    <div class="tree-children">
                        @foreach (AnalysisRepairArtistGroupViewModel artist in category.Artists)
                        {
                            <details open><summary class="tree-node @(ReferenceEquals(ViewModel.SelectedRepairNode, artist) ? "selected" : null)" @onclick="() => Select(artist)"><span>@artist.Artist</span><span class="tree-count">@artist.Count</span>@if (HasActionable(artist)) { <DispositionSelect Value="artist.Disposition" ValueChanged="value => artist.Disposition = value" Options="artist.Dispositions" /> }</summary>
                                <div class="tree-children">@foreach(AnalysisRepairAlbumGroupViewModel album in artist.Albums){<details><summary class="tree-node @(ReferenceEquals(ViewModel.SelectedRepairNode, album) ? "selected" : null)" @onclick="() => Select(album)"><span>@album.Album</span><span class="tree-count">@album.Count</span>@if (HasActionable(album)) { <DispositionSelect Value="album.Disposition" ValueChanged="value => album.Disposition = value" Options="album.Dispositions" /> }</summary><div class="tree-children">@foreach(AnalysisRepairItemViewModel item in album.Items){<button class="tree-button @(ReferenceEquals(ViewModel.SelectedRepairNode,item)?"selected":null)" @onclick="()=>Select(item)">@Path.GetFileName(item.DisplayPath)</button>}</div></details>}</div>
                            </details>
                        }
                    </div>
                </details>
            }
        </div>
    </details>
</div>
@code {
    private static IReadOnlyList<AnalysisRepairDisposition> RootDispositions { get; } = Enum.GetValues<AnalysisRepairDisposition>();
    private int RootCount => ViewModel.RepairGroups.Sum(group => group.Count);
    private bool HasActionableRepairs => ViewModel.RepairItems.Any(item => item.CanChangeDisposition);
    private AnalysisRepairDisposition RootDisposition => Aggregate(ViewModel.RepairGroups.Select(group => group.Disposition));
    protected override void OnInitialized()
    {
        foreach (AnalysisRepairCategoryGroupViewModel category in ViewModel.RepairGroups)
        {
            Observe(category);
            foreach (AnalysisRepairArtistGroupViewModel artist in category.Artists)
            {
                Observe(artist);
                foreach (AnalysisRepairAlbumGroupViewModel album in artist.Albums)
                {
                    Observe(album);
                    foreach (AnalysisRepairItemViewModel item in album.Items) Observe(item);
                }
            }
        }
    }
    private void SelectRoot() => ViewModel.SelectedRepairNode = null;
    private void SetRootDisposition(AnalysisRepairDisposition value) { if (value != AnalysisRepairDisposition.Mixed) foreach (var group in ViewModel.RepairGroups) group.Disposition = value; }
    private void Select(object node) => ViewModel.SelectedRepairNode = node;
    private static bool HasActionable(AnalysisRepairCategoryGroupViewModel category) => category.Artists.Any(HasActionable);
    private static bool HasActionable(AnalysisRepairArtistGroupViewModel artist) => artist.Albums.Any(HasActionable);
    private static bool HasActionable(AnalysisRepairAlbumGroupViewModel album) => album.Items.Any(item => item.CanChangeDisposition);
    private static AnalysisRepairDisposition Aggregate(IEnumerable<AnalysisRepairDisposition> values) { AnalysisRepairDisposition[] distinct = values.Distinct().ToArray(); return distinct.Length == 0 ? AnalysisRepairDisposition.Ignored : distinct.Length == 1 ? distinct[0] : AnalysisRepairDisposition.Mixed; }
}
