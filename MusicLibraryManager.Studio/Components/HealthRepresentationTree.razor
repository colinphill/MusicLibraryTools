@inherits ReactiveComponentBase
@inject AnalyzerViewModel ViewModel

<div class="tree" role="tree" aria-label="File repair hierarchy">
    <details class="tree-root" open>
        <summary class="tree-node @(ViewModel.SelectedRepresentationNode is null ? "selected" : null)" @onclick="SelectRoot"><span>All file repairs</span><span class="tree-count">@RootCount</span><DispositionSelect Value="RootDisposition" ValueChanged="SetRootDisposition" Options="RootDispositions" /></summary>
        <div class="tree-children">
            @foreach (RepresentationRepairCategoryGroupViewModel category in ViewModel.RepresentationActionGroups)
            {
                <details open>
                    <summary class="tree-node @(ReferenceEquals(ViewModel.SelectedRepresentationNode, category) ? "selected" : null)" @onclick="() => Select(category)"><span>@category.Category</span><span class="tree-count">@category.Count</span><DispositionSelect Value="category.Disposition" ValueChanged="value => category.Disposition = value" Options="category.Dispositions" /></summary>
                    <div class="tree-children">
                        @foreach (RepresentationRepairArtistGroupViewModel artist in category.Artists)
                        {
                            <details open><summary class="tree-node @(ReferenceEquals(ViewModel.SelectedRepresentationNode, artist) ? "selected" : null)" @onclick="() => Select(artist)"><span>@artist.Artist</span><span class="tree-count">@artist.Count</span><DispositionSelect Value="artist.Disposition" ValueChanged="value => artist.Disposition = value" Options="artist.Dispositions" /></summary>
                                <div class="tree-children">@foreach(RepresentationRepairAlbumGroupViewModel album in artist.Albums){<details><summary class="tree-node @(ReferenceEquals(ViewModel.SelectedRepresentationNode, album) ? "selected" : null)" @onclick="() => Select(album)"><span>@album.Album</span><span class="tree-count">@album.Count</span><DispositionSelect Value="album.Disposition" ValueChanged="value => album.Disposition = value" Options="album.Dispositions" /></summary><div class="tree-children">@foreach(RepresentationRepairActionItemViewModel item in album.Items){<button class="tree-button @(ReferenceEquals(ViewModel.SelectedRepresentationNode,item)?"selected":null)" @onclick="()=>Select(item)">@Path.GetFileName(item.SourcePath)</button>}</div></details>}</div>
                            </details>
                        }
                    </div>
                </details>
            }
        </div>
    </details>
</div>
@code {
    private static IReadOnlyList<AnalysisRepairDisposition> RootDispositions { get; } = Enum.GetValues<AnalysisRepairDisposition>();
    private int RootCount => ViewModel.RepresentationActionGroups.Sum(group => group.Count);
    private AnalysisRepairDisposition RootDisposition => Aggregate(ViewModel.RepresentationActionGroups.Select(group => group.Disposition));
    protected override void OnInitialized()
    {
        foreach (RepresentationRepairCategoryGroupViewModel category in ViewModel.RepresentationActionGroups)
        {
            Observe(category);
            foreach (RepresentationRepairArtistGroupViewModel artist in category.Artists)
            {
                Observe(artist);
                foreach (RepresentationRepairAlbumGroupViewModel album in artist.Albums)
                {
                    Observe(album);
                    foreach (RepresentationRepairActionItemViewModel item in album.Items) Observe(item);
                }
            }
        }
    }
    private void SelectRoot() => ViewModel.SelectedRepresentationNode = null;
    private void SetRootDisposition(AnalysisRepairDisposition value) { if (value != AnalysisRepairDisposition.Mixed) foreach (var group in ViewModel.RepresentationActionGroups) group.Disposition = value; }
    private void Select(object node) => ViewModel.SelectedRepresentationNode = node;
    private static AnalysisRepairDisposition Aggregate(IEnumerable<AnalysisRepairDisposition> values) { AnalysisRepairDisposition[] distinct = values.Distinct().ToArray(); return distinct.Length == 0 ? AnalysisRepairDisposition.Ignored : distinct.Length == 1 ? distinct[0] : AnalysisRepairDisposition.Mixed; }
}
