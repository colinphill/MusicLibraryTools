@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@GridId" class="studio-grid" role="grid" aria-label="@AriaLabel" tabindex="0" @onkeydown="GridKeyDown"
     @onpointerup="CommitColumnDrag" @onpointercancel="CancelColumnDrag">
    <div class="grid-header" role="row" style="@GridStyle">
        @for (int index = 0; index < VisibleColumns.Count; index++)
        {
            StudioGridColumn<TItem> column = VisibleColumns[index];
            <div class="grid-header-cell @(index < FrozenColumnCount ? "frozen" : null) @(DragKey == column.Key ? "dragging" : null) @(DragTargetKey == column.Key && DragKey != column.Key ? "drop-target" : null)" role="columnheader"
                 style="@(index < FrozenColumnCount ? "left:0" : null)" data-column-key="@column.Key"
                 @onpointerenter="() => TargetColumnDrag(column.Key)"
                 @onpointerup="() => CommitColumnDrag(column.Key)" @onpointerup:stopPropagation="true">
                <button type="button" class="column-drag-handle" data-column-key="@column.Key"
                        title="Drag to reorder @column.Header" aria-label="Drag to reorder @column.Header"
                        @onpointerdown="() => StartColumnDrag(column.Key)" @onpointerdown:preventDefault="true" @onpointerdown:stopPropagation="true">⠿</button>
                <button class="grid-sort" disabled="@(!column.Sortable)" @onclick="() => Sort(column)">
                    <span>@column.Header</span>
                    @if (SortKey == column.Key) { <span class="sort-mark">@(SortDescending ? "▼" : "▲")</span> }
                </button>
                <span class="column-resizer" data-column-key="@column.Key" title="Resize @column.Header"></span>
            </div>
        }
    </div>
    <div class="grid-viewport" @ref="Viewport">
        @if (DisplayItems.Count == 0)
        {
            <div class="grid-empty">@EmptyText</div>
        }
        else
        {
            <Virtualize Items="DisplayItems" Context="item" ItemSize="38" OverscanCount="8">
                <StudioGridRow TItem="TItem" Item="item" Columns="VisibleColumns" GridStyle="@GridStyle"
                               FrozenColumnCount="FrozenColumnCount" IsSelected="IsSelected(item)"
                               KeyValue="@KeySelector(item)" OnClick="e => Select(item, e)"
                               OnDoubleClick="() => Activate(item)" OnRealized="OnItemRealized" OnReleased="OnItemReleased" />
            </Virtualize>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public IList<StudioGridColumn<TItem>> Columns { get; set; } = [];
    [Parameter, EditorRequired] public Func<TItem, string> KeySelector { get; set; } = null!;
    [Parameter] public int FrozenColumnCount { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Data grid";
    [Parameter] public string EmptyText { get; set; } = "No items";
    [Parameter] public EventCallback<IReadOnlyList<TItem>> SelectionChanged { get; set; }
    [Parameter] public EventCallback<TItem> RowActivated { get; set; }
    [Parameter] public EventCallback OnLayoutChanged { get; set; }
    [Parameter] public Func<TItem, Task>? OnItemRealized { get; set; }
    [Parameter] public Action<TItem>? OnItemReleased { get; set; }
    [Parameter] public string? InitialSortKey { get; set; }
    [Parameter] public bool InitialSortDescending { get; set; }

    private readonly HashSet<string> SelectedKeys = new(StringComparer.OrdinalIgnoreCase);
    private readonly string GridId = $"studio-grid-{Guid.NewGuid():N}";
    private IList<TItem> DisplayItems = Array.Empty<TItem>();
    private ElementReference Viewport;
    private DotNetObjectReference<StudioDataGrid<TItem>>? Self;
    private string? SortKey;
    private bool SortDescending;
    private string? DragKey;
    private string? DragTargetKey;
    private int AnchorIndex = -1;
    private int FocusedIndex = -1;
    private IReadOnlyList<StudioGridColumn<TItem>> VisibleColumns => Columns.Where(column => column.Visible).ToArray();
    private string GridStyle => $"grid-template-columns:{string.Join(' ', VisibleColumns.Select(column => $"minmax({column.MinWidth}px,{column.Width}px)"))}";

    protected override void OnInitialized()
    {
        SortKey = InitialSortKey;
        SortDescending = InitialSortDescending;
    }

    protected override void OnParametersSet() => Rebuild();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Self ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("studio.initializeGrid", GridId, Self);
    }

    private void Rebuild()
    {
        IEnumerable<TItem> source = Items;
        StudioGridColumn<TItem>? column = Columns.FirstOrDefault(candidate => candidate.Key == SortKey);
        if (column is not null)
            source = SortDescending
                ? source.OrderByDescending(column.Value, StudioObjectComparer.Instance)
                : source.OrderBy(column.Value, StudioObjectComparer.Instance);
        DisplayItems = source.ToArray();
    }

    private void Sort(StudioGridColumn<TItem> column)
    {
        if (!column.Sortable)
            return;
        SortDescending = SortKey == column.Key && !SortDescending;
        SortKey = column.Key;
        Rebuild();
        _ = OnLayoutChanged.InvokeAsync();
    }

    private async Task Select(TItem item, Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        int index = IndexOf(item);
        string key = KeySelector(item);
        if (e.ShiftKey && AnchorIndex >= 0)
        {
            if (!e.CtrlKey)
                SelectedKeys.Clear();
            for (int i = Math.Min(AnchorIndex, index); i <= Math.Max(AnchorIndex, index); i++)
                SelectedKeys.Add(KeySelector(DisplayItems[i]));
        }
        else if (e.CtrlKey)
        {
            if (!SelectedKeys.Add(key))
                SelectedKeys.Remove(key);
            AnchorIndex = index;
        }
        else
        {
            SelectedKeys.Clear();
            SelectedKeys.Add(key);
            AnchorIndex = index;
        }
        FocusedIndex = index;
        await NotifySelection();
    }

    private async Task GridKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (DisplayItems.Count == 0)
            return;
        int next = e.Key switch
        {
            "ArrowDown" => Math.Min(DisplayItems.Count - 1, Math.Max(0, FocusedIndex + 1)),
            "ArrowUp" => Math.Max(0, FocusedIndex - 1),
            "Home" => 0,
            "End" => DisplayItems.Count - 1,
            "PageDown" => Math.Min(DisplayItems.Count - 1, Math.Max(0, FocusedIndex + 15)),
            "PageUp" => Math.Max(0, FocusedIndex - 15),
            _ => FocusedIndex,
        };
        if (e.Key == "Enter" && FocusedIndex >= 0)
        {
            await Activate(DisplayItems[FocusedIndex]);
            return;
        }
        if (next == FocusedIndex && FocusedIndex >= 0)
            return;
        FocusedIndex = next;
        AnchorIndex = next;
        SelectedKeys.Clear();
        SelectedKeys.Add(KeySelector(DisplayItems[next]));
        await NotifySelection();
        await JS.InvokeVoidAsync("studio.scrollIntoView", $"grid-row-{KeySelector(DisplayItems[next]).GetHashCode()}");
    }

    private async Task NotifySelection() => await SelectionChanged.InvokeAsync(
        DisplayItems.Where(item => SelectedKeys.Contains(KeySelector(item))).ToArray());

    private async Task Activate(TItem item)
    {
        if (RowActivated.HasDelegate)
            await RowActivated.InvokeAsync(item);
    }

    private bool IsSelected(TItem item) => SelectedKeys.Contains(KeySelector(item));
    private int IndexOf(TItem item) => DisplayItems.ToList().FindIndex(value => KeySelector(value) == KeySelector(item));

    [JSInvokable]
    public void ResizeColumn(string key, double width)
    {
        StudioGridColumn<TItem>? column = Columns.FirstOrDefault(candidate => candidate.Key == key);
        if (column is null)
            return;
        column.Width = Math.Max(column.MinWidth, width);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task CommitGridLayout() => await OnLayoutChanged.InvokeAsync();

    [JSInvokable]
    public async Task ReorderColumn(string sourceKey, string targetKey)
    {
        if (sourceKey == targetKey)
            return;
        StudioGridColumn<TItem>? source = Columns.FirstOrDefault(column => column.Key == sourceKey);
        StudioGridColumn<TItem>? target = Columns.FirstOrDefault(column => column.Key == targetKey);
        if (source is null || target is null)
            return;
        int oldIndex = Columns.IndexOf(source);
        int newIndex = Columns.IndexOf(target);
        Columns.RemoveAt(oldIndex);
        Columns.Insert(newIndex, source);
        await OnLayoutChanged.InvokeAsync();
        StateHasChanged();
    }

    private void StartColumnDrag(string key)
    {
        DragKey = key;
        DragTargetKey = key;
    }

    private void TargetColumnDrag(string key)
    {
        if (DragKey is not null)
            DragTargetKey = key;
    }

    private async Task CommitColumnDrag()
    {
        string? source = DragKey;
        string? target = DragTargetKey;
        DragKey = null;
        DragTargetKey = null;
        if (source is not null && target is not null && source != target)
            await ReorderColumn(source, target);
    }

    private async Task CommitColumnDrag(string targetKey)
    {
        if (DragKey is null)
            return;
        DragTargetKey = targetKey;
        await CommitColumnDrag();
    }

    private void CancelColumnDrag()
    {
        DragKey = null;
        DragTargetKey = null;
    }

    public LibrarySortState? GetSortState() => SortKey is null ? null : new LibrarySortState(SortKey, SortDescending);

    public ValueTask DisposeAsync()
    {
        Self?.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed class StudioObjectComparer : IComparer<object?>
    {
        public static StudioObjectComparer Instance { get; } = new();
        public int Compare(object? x, object? y)
        {
            if (ReferenceEquals(x, y)) return 0;
            if (x is null) return -1;
            if (y is null) return 1;
            if (x is IComparable comparable && x.GetType().IsInstanceOfType(y)) return comparable.CompareTo(y);
            return StringComparer.CurrentCultureIgnoreCase.Compare(x.ToString(), y.ToString());
        }
    }
}
