@implements IDisposable

<button type="@Type" class="@CssClass" disabled="@(!CanExecute)" title="@Title" @onclick="ExecuteAsync">
    @ChildContent
</button>

@code {
    [Parameter, EditorRequired] public ICommand Command { get; set; } = null!;
    [Parameter] public object? Parameter { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "button";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Type { get; set; } = "button";

    private bool CanExecute => Command?.CanExecute(Parameter) == true;

    protected override void OnParametersSet()
    {
        if (Command is not null)
        {
            Command.CanExecuteChanged -= OnCanExecuteChanged;
            Command.CanExecuteChanged += OnCanExecuteChanged;
        }
    }

    private async Task ExecuteAsync()
    {
        if (!CanExecute)
            return;
        Command.Execute(Parameter);
        if (Command is CommunityToolkit.Mvvm.Input.IAsyncRelayCommand asyncCommand && asyncCommand.ExecutionTask is { } task)
            await task;
    }

    private void OnCanExecuteChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (Command is not null)
            Command.CanExecuteChanged -= OnCanExecuteChanged;
    }
}
