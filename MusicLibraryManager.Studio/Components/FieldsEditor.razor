@inherits ReactiveComponentBase

<div class="modal-body stack fields-editor">
    <div class="row wrap">
        <select @bind="ViewModel.FieldToAdd">@foreach (var field in ViewModel.AddableFields) { <option value="@field">@field</option> }</select>
        <StudioCommandButton Command="ViewModel.AddFieldCommand">Add field</StudioCommandButton>
        <input class="grow" value="@ViewModel.NewUserStringName" @oninput="e => ViewModel.NewUserStringName=e.Value?.ToString()" placeholder="User-string name" />
        <StudioCommandButton Command="ViewModel.AddUserStringCommand">Add user string</StudioCommandButton>
    </div>
    <div class="fields-list scroll-area">
        @foreach (FieldRow row in ViewModel.Rows)
        {
            <div class="field-row @(row.MarkedForRemoval ? "removed" : null)">
                <div><strong>@row.Name</strong><span class="faint">@row.Kind</span></div>
                <input value="@row.Value" @oninput="e => row.Value=e.Value?.ToString() ?? string.Empty" disabled="@row.MarkedForRemoval" placeholder="@(row.IsMixed ? "Mixed values" : null)" />
                <StudioCommandButton Command="ViewModel.RemoveFieldCommand" Parameter="row" CssClass="button danger">@row.RemoveButtonText</StudioCommandButton>
            </div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage)) { <div class="status-banner warning">@ViewModel.StatusMessage</div> }
</div>
<footer>
    <StudioCommandButton Command="ViewModel.CancelCommand">Cancel</StudioCommandButton>
    <StudioCommandButton Command="ViewModel.SaveCommand" CssClass="button primary">Save fields</StudioCommandButton>
</footer>

@code {
    [Parameter, EditorRequired] public FieldsDialogViewModel ViewModel { get; set; } = null!;
    protected override void OnParametersSet() { Observe(ViewModel); Observe(ViewModel.Rows); }
}
