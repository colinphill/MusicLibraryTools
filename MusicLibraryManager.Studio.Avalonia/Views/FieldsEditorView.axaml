<UserControl x:Class="MusicLibraryManager.Studio.Avalonia.Views.FieldsEditorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10" MinHeight="400">
    <Grid ColumnDefinitions="180,Auto,*,Auto" ColumnSpacing="8">
      <ComboBox Classes="studio" ItemsSource="{Binding AddableFields}" SelectedItem="{Binding FieldToAdd, Mode=TwoWay}" />
      <Button Grid.Column="1" Classes="studio" Content="Add field" Command="{Binding AddFieldCommand}" />
      <TextBox Grid.Column="2" Classes="studio" Text="{Binding NewUserStringName, Mode=TwoWay}" PlaceholderText="User-string name" />
      <Button Grid.Column="3" Classes="studio" Content="Add user string" Command="{Binding AddUserStringCommand}" />
    </Grid>
    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1" CornerRadius="9">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid MinHeight="50" Margin="9,6" ColumnDefinitions="180,*,Auto" ColumnSpacing="10">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Classes="faint" Text="{Binding Kind}" /></StackPanel>
            <TextBox Grid.Column="1" Classes="studio" Text="{Binding Value, Mode=TwoWay}" IsEnabled="{Binding !MarkedForRemoval}" PlaceholderText="Mixed values" />
            <Button Grid.Column="2" Classes="studio danger" Content="{Binding RemoveButtonText}" Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="2" Classes="status-banner" IsVisible="{Binding StatusMessage}"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" /></Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="studio" Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Classes="studio primary" Content="Save fields" Command="{Binding SaveCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
