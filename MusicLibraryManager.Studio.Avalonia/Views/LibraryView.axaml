<UserControl x:Class="MusicLibraryManager.Studio.Avalonia.Views.LibraryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Studio.Avalonia.Controls"
             xmlns:views="using:MusicLibraryManager.Studio.Avalonia.Views"
             KeyDown="OnLibraryKeyDown">
  <Grid Margin="26,22,26,26" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <controls:StudioPageHeader Title="Library"
        Subtitle="Browse the cache instantly, even when music roots are offline.">
      <controls:StudioPageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="studio" Content="Reload" Command="{Binding ReloadCommand}" />
          <Button Classes="studio primary" Content="Index library" Command="{Binding Indexing.IndexCommand}" />
          <Button Classes="studio" Content="Cancel" Command="{Binding Indexing.CancelCommand}" />
          <Button x:Name="InspectorToggle" Classes="studio" Content="Inspector" Click="OnInspectorToggle" IsVisible="False" />
        </StackPanel>
      </controls:StudioPageHeader.Actions>
    </controls:StudioPageHeader>

    <Grid Grid.Row="1" ColumnDefinitions="*,150,Auto,180,120,Auto,Auto" ColumnSpacing="8">
      <TextBox x:Name="FilterBox" Classes="studio" Text="{Binding FilterText, Mode=TwoWay}" PlaceholderText="Filter, or use Artist:Name AND NOT Codec:MP3" />
      <ComboBox Grid.Column="1" Classes="studio" ItemsSource="{Binding FilterModes}" SelectedItem="{Binding FilterMode, Mode=TwoWay}" />
      <Button x:Name="ColumnsButton" Grid.Column="2" Classes="studio" Content="Columns" Click="OnColumnsClick" />
      <ComboBox x:Name="SavedViews" Grid.Column="3" Classes="studio" ItemsSource="{Binding SavedViews}" SelectedItem="{Binding SelectedView, Mode=TwoWay}" PlaceholderText="Saved views" SelectionChanged="OnSavedViewChanged">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox x:Name="ViewNameBox" Grid.Column="4" Classes="studio" Text="{Binding NewViewName, Mode=TwoWay}" PlaceholderText="View name" />
      <Button Grid.Column="5" Classes="studio" Content="Save view" Click="OnSaveView" />
      <Button Grid.Column="6" Classes="studio" Content="Delete" Command="{Binding DeleteViewCommand}" />
    </Grid>

    <Grid Grid.Row="2">
      <controls:StudioSplitView x:Name="WorkspaceSplit" InitialLeftWidth="900" MinLeftWidth="340" MaxLeftWidth="1800" MinRightWidth="190" PersistenceKey="library" Label="Resize library and inspector">
        <controls:StudioSplitView.Left>
          <Border Classes="card" Padding="0" ClipToBounds="True">
            <Grid>
              <controls:StudioDataGrid x:Name="LibraryGrid" ItemsSource="{Binding Rows}" FrozenColumnCount="1"
                                       SelectionChanged="OnGridSelectionChanged" LoadingRow="OnLoadingRow" UnloadingRow="OnUnloadingRow" />
              <TextBlock IsVisible="{Binding !HasRows}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Classes="muted" Text="No tracks match this view" />
            </Grid>
          </Border>
        </controls:StudioSplitView.Left>
        <controls:StudioSplitView.Right>
          <Border Classes="card" Padding="0" ClipToBounds="True"><views:SelectionInspectorView /></Border>
        </controls:StudioSplitView.Right>
      </controls:StudioSplitView>

      <Popup x:Name="ColumnPopover" PlacementTarget="{Binding #ColumnsButton}"
             Placement="BottomEdgeAlignedRight" VerticalOffset="8"
             IsLightDismissEnabled="True" IsOpen="False">
        <Border Width="230" MaxHeight="460"
                Background="{DynamicResource StudioPanelBrush}" BorderBrush="{DynamicResource StudioBorderStrongBrush}"
                BorderThickness="1" CornerRadius="9" Padding="12" BoxShadow="0 14 40 0 #77000000">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock VerticalAlignment="Center" Text="Columns" FontSize="14" FontWeight="SemiBold" />
              <Button x:Name="CloseColumnsButton" Grid.Column="1" Classes="studio" Width="28" Height="28"
                      Padding="0" Content="&#x2715;" ToolTip.Tip="Close column selector" Click="OnColumnsClose" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ColumnOptions" Spacing="8" />
            </ScrollViewer>
          </Grid>
        </Border>
      </Popup>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
      <Border x:Name="SelectedPill" Grid.Column="1" Classes="pill" IsVisible="False"><TextBlock x:Name="SelectedCountText" Classes="muted" /></Border>
      <Button x:Name="CopyButton" Grid.Column="2" Classes="studio" IsVisible="False" Content="Copy paths" Click="OnCopyPaths" />
      <Button x:Name="RevealButton" Grid.Column="3" Classes="studio" IsVisible="False" Content="Reveal" Click="OnReveal" />
      <Button x:Name="ReindexButton" Grid.Column="4" Classes="studio" IsVisible="False" Content="Reindex" Click="OnReindex" />
      <TextBlock Grid.Column="5" Classes="muted" VerticalAlignment="Center" Text="{Binding Indexing.StatusText}" />
    </Grid>
  </Grid>
</UserControl>
