<UserControl x:Class="MusicLibraryManager.Studio.Avalonia.Controls.StudioPageHeader"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
    <StackPanel Spacing="5">
      <TextBlock Classes="page-title" Text="{Binding Title, ElementName=Root}" />
      <TextBlock Classes="muted" Text="{Binding Subtitle, ElementName=Root}" TextWrapping="Wrap" />
    </StackPanel>
    <ContentPresenter Grid.Column="1" Content="{Binding Actions, ElementName=Root}" VerticalAlignment="Top" />
  </Grid>
</UserControl>
