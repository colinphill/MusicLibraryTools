<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="StudioTextFont">Segoe UI Variable Text, Inter</FontFamily>
      <FontFamily x:Key="StudioDisplayFont">Segoe UI Variable Display, Inter</FontFamily>

      <x:Double x:Key="StudioRadiusSmall">6</x:Double>
      <x:Double x:Key="StudioRadius">8</x:Double>
      <x:Double x:Key="StudioRadiusLarge">11</x:Double>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#2CC7BC</Color>
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2CC7BC" />
          <SolidColorBrush x:Key="StudioCanvasBrush" Color="#0D1417" />
          <SolidColorBrush x:Key="StudioPanelBrush" Color="#121D21" />
          <SolidColorBrush x:Key="StudioRaisedBrush" Color="#18262B" />
          <SolidColorBrush x:Key="StudioInsetBrush" Color="#0F181B" />
          <SolidColorBrush x:Key="StudioBorderBrush" Color="#2A3B40" />
          <SolidColorBrush x:Key="StudioBorderStrongBrush" Color="#3D555B" />
          <SolidColorBrush x:Key="StudioTextBrush" Color="#EAF3F2" />
          <SolidColorBrush x:Key="StudioMutedBrush" Color="#91A6A5" />
          <SolidColorBrush x:Key="StudioFaintBrush" Color="#617579" />
          <SolidColorBrush x:Key="StudioAccentBrush" Color="#2CC7BC" />
          <SolidColorBrush x:Key="StudioAccentHoverBrush" Color="#48D8CE" />
          <SolidColorBrush x:Key="StudioAccentInkBrush" Color="#062B2A" />
          <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="#222CC7BC" />
          <SolidColorBrush x:Key="StudioSelectionBrush" Color="#1B3D3F" />
          <SolidColorBrush x:Key="StudioHoverBrush" Color="#1A3033" />
          <SolidColorBrush x:Key="StudioInfoBrush" Color="#3B8FC4" />
          <SolidColorBrush x:Key="StudioSuccessBrush" Color="#3BAA7A" />
          <SolidColorBrush x:Key="StudioWarningBrush" Color="#D99A36" />
          <SolidColorBrush x:Key="StudioDangerBrush" Color="#D85D65" />
          <SolidColorBrush x:Key="StudioScrimBrush" Color="#99000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#087F8C</Color>
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#087F8C" />
          <SolidColorBrush x:Key="StudioCanvasBrush" Color="#EEF4F3" />
          <SolidColorBrush x:Key="StudioPanelBrush" Color="#F8FBFA" />
          <SolidColorBrush x:Key="StudioRaisedBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="StudioInsetBrush" Color="#E7EFED" />
          <SolidColorBrush x:Key="StudioBorderBrush" Color="#CFDDDA" />
          <SolidColorBrush x:Key="StudioBorderStrongBrush" Color="#AEBFBB" />
          <SolidColorBrush x:Key="StudioTextBrush" Color="#142321" />
          <SolidColorBrush x:Key="StudioMutedBrush" Color="#5F7471" />
          <SolidColorBrush x:Key="StudioFaintBrush" Color="#849793" />
          <SolidColorBrush x:Key="StudioAccentBrush" Color="#087F8C" />
          <SolidColorBrush x:Key="StudioAccentHoverBrush" Color="#0A6D77" />
          <SolidColorBrush x:Key="StudioAccentInkBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="#22087F8C" />
          <SolidColorBrush x:Key="StudioSelectionBrush" Color="#DCF1F1" />
          <SolidColorBrush x:Key="StudioHoverBrush" Color="#E7EFED" />
          <SolidColorBrush x:Key="StudioInfoBrush" Color="#2879AA" />
          <SolidColorBrush x:Key="StudioSuccessBrush" Color="#25855D" />
          <SolidColorBrush x:Key="StudioWarningBrush" Color="#B87518" />
          <SolidColorBrush x:Key="StudioDangerBrush" Color="#BD414B" />
          <SolidColorBrush x:Key="StudioScrimBrush" Color="#66000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource StudioTextFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource StudioCanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="UserControl">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}" /></Style>
  <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{DynamicResource StudioFaintBrush}" /></Style>
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontFamily" Value="{DynamicResource StudioDisplayFont}" />
    <Setter Property="FontSize" Value="27" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontFamily" Value="{DynamicResource StudioDisplayFont}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontFamily" Value="{DynamicResource StudioTextFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource StudioSelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="ListBox.studio-list ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioSelectionBrush}" />
  </Style>
  <Style Selector="ListBox.studio-list ListBoxItem:selected Border.card">
    <Setter Property="Background" Value="{DynamicResource StudioSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource StudioRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.inset"><Setter Property="Background" Value="{DynamicResource StudioInsetBrush}" /></Style>
  <Style Selector="Border.status-banner">
    <Setter Property="Background" Value="{DynamicResource StudioInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioInfoBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Button.studio">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource StudioRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.studio:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
  </Style>
  <Style Selector="Button.studio.primary">
    <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
  </Style>
  <Style Selector="Button.studio.danger"><Setter Property="Foreground" Value="{DynamicResource StudioDangerBrush}" /></Style>
  <Style Selector="Button.nav">
    <Setter Property="Height" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Grid.nav-content">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Viewbox.nav-icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.nav-icon-path">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource StudioMutedBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="TextBlock.nav-label">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.nav-marker">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioRaisedBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="Button.nav:pointerover Path.nav-icon-path">
    <Setter Property="Stroke" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource StudioAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="Button.nav.active Path.nav-icon-path">
    <Setter Property="Stroke" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="Button.nav.active Border.nav-marker">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="Button.caption /template/ ContentPresenter">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Viewbox.caption-icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.caption-icon-path">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource StudioTextBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" /></Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioDangerBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.caption.close:pointerover Path.caption-icon-path">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <Style Selector="TextBox.studio, ComboBox.studio, NumericUpDown.studio">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Background" Value="{DynamicResource StudioInsetBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBox.studio:focus, ComboBox.studio:focus, NumericUpDown.studio:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="MinHeight" Value="25" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource StudioInsetBrush}" />
  </Style>

  <Style Selector="Border.result-card">
    <Setter Property="Background" Value="{DynamicResource StudioRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.history-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.history-item">
    <Setter Property="Background" Value="{DynamicResource StudioSelectionBrush}" />
  </Style>
  <Style Selector="TreeView.health-tree">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="TextBlock.tree-count">
    <Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}" />
    <Setter Property="Margin" Value="12,0,3,0" />
  </Style>

  <Style Selector="ProgressBar.studio">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource StudioInsetBrush}" />
  </Style>

  <Style Selector="DataGrid.studio-grid">
    <Setter Property="Background" Value="{DynamicResource StudioRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="RowBackground" Value="{DynamicResource StudioRaisedBrush}" />
  </Style>
  <Style Selector="DataGrid.studio-grid DataGridColumnHeader">
    <Setter Property="Height" Value="39" />
    <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="DataGrid.studio-grid DataGridRow">
    <Setter Property="Height" Value="38" />
    <Setter Property="Background" Value="{DynamicResource StudioRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
  </Style>
  <Style Selector="DataGrid.studio-grid DataGridRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
  </Style>
  <Style Selector="DataGrid.studio-grid DataGridRow:selected">
    <Setter Property="Background" Value="{DynamicResource StudioSelectionBrush}" />
  </Style>
  <Style Selector="DataGrid.studio-grid DataGridCell">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
  </Style>
</Styles>
