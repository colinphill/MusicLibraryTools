<?xml version="1.0" encoding="utf-8"?>
<IngestMusicConfiguration>
  <!-- Legacy format retained for import compatibility. New configurations should flag
       IndexTargets in a LibraryConfiguration; see LibraryConfiguration.example.xml. -->
  <!-- Must be a build that includes libfdk_aac. A command on PATH is also accepted. -->
  <FfmpegPath>ffmpeg</FfmpegPath>
  <AacDestination>Z:\iTunes\AddAAC</AacDestination>
  <!-- Optional. When set, AAC files use this library's media folder and are added to the .itl.
       iTunes must be closed while applying an ingest. Relative paths are resolved beside this file. -->
  <!-- <ItunesLibrary>Z:\iTunes\iTunes Library.itl</ItunesLibrary> -->
  <CdDestination>Z:\iTunes\FLAC</CdDestination>
  <PairedCdDestination>Z:\iTunes\FLAC2</PairedCdDestination>
  <HighResolutionDestination>Z:\iTunes\HiRes\Stereo\PCM</HighResolutionDestination>
  <LengthLimit>255</LengthLimit>
  <DiscNumLengthLimit>255</DiscNumLengthLimit>
  <AacEncoder>libfdk_aac</AacEncoder>
  <AacBitrateKbps>256</AacBitrateKbps>
  <!-- The default false moves successfully ingested sources to the quarantine directory. -->
  <DeleteSourcesAfterIngest>false</DeleteSourcesAfterIngest>
  <!-- Also apply the selected delete/quarantine behavior to unsupported/non-audio files and
       remove emptied folders from the incoming tree. The default false leaves them untouched. -->
  <RemoveNonMusicAfterIngest>false</RemoveNonMusicAfterIngest>
</IngestMusicConfiguration>
