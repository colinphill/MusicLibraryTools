<UserControl x:Class="MusicLibraryManager.Views.OrganizeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid Margin="26,22,26,26" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <controls:PageHeader Title="Organize"
        Subtitle="Move eligible files into the canonical library layout with rollback protection.">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="app" Content="Preview" Command="{Binding PreviewCommand}" />
          <Button Classes="app primary" Content="Apply moves" Command="{Binding ApplyCommand}" />
          <Button Classes="app" Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>
    <Border Grid.Row="1" Classes="card">
      <Grid x:Name="SummaryLayout" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Ellipse Width="8" Height="8" Fill="{DynamicResource AppAccentBrush}" />
        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock Text="Preview before applying" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{Binding StatusText}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="PlannedCount" Grid.Column="2"
                   Classes="summary-label"
                   Text="{Binding Moves.Count, StringFormat={}{0} planned}" />
      </Grid>
    </Border>
    <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
      <controls:AppDataGrid x:Name="MovesGrid" ItemsSource="{Binding Moves}" />
    </Border>
  </Grid>
</UserControl>
