<UserControl x:Class="MusicLibraryManager.Views.OrganizeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <controls:AdaptivePage RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <controls:PageHeader x:Name="OrganizeHeader"
        Title="{DynamicResource Loc.Organize.Title}"
        Subtitle="{DynamicResource Loc.Organize.Subtitle}"
        SecondaryOverflowEnabled="True"
        SecondaryOverflowLabel="{DynamicResource Loc.Workbench.Action.More}"
        SecondaryOverflowAutomationName="{DynamicResource Loc.Workbench.Action.MoreAutomation}">
      <controls:PageHeader.PrimaryAction>
        <Grid x:Name="OrganizeWorkflowActions">
          <Button Classes="app"
                  Classes.primary="{Binding !HasPreview}"
                  IsVisible="{Binding !HasPreview}"
                  Content="{DynamicResource Loc.Organize.Action.Preview}"
                  Command="{Binding PreviewCommand}" />
          <Button Classes="app primary"
                  IsVisible="{Binding HasPreview}"
                  Content="{DynamicResource Loc.Organize.Action.Apply}"
                  Command="{Binding ApplyCommand}" />
        </Grid>
      </controls:PageHeader.PrimaryAction>
      <controls:PageHeader.SecondaryActions>
        <Button x:Name="OrganizeCancelButton"
                Classes="app"
                Content="{DynamicResource Loc.Common.Cancel}"
                controls:PageHeader.OverflowHeader="{DynamicResource Loc.Common.Cancel}"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsBusy}" />
      </controls:PageHeader.SecondaryActions>
    </controls:PageHeader>
    <Border x:Name="OrganizeSetupCard" Grid.Row="1" Classes="card" IsVisible="False">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Classes="section-title" Text="{DynamicResource Loc.Home.Empty.Title}" />
          <TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Empty.Description}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="app primary"
                VerticalAlignment="Center"
                Content="{DynamicResource Loc.Home.Empty.Action}"
                Click="OnOpenSettings" />
      </Grid>
    </Border>
    <Border x:Name="OrganizeSummaryCard" Grid.Row="1" Classes="card">
      <Grid x:Name="SummaryLayout" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Ellipse Width="8" Height="8" Fill="{DynamicResource AppAccentBrush}" />
        <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="{DynamicResource Loc.Organize.PreviewReminder}" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Classes="error"
                     Text="{Binding DiagnosticDetail}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasDiagnosticDetail}" />
        </StackPanel>
        <controls:LocalizedFormatTextBlock
            x:Name="PlannedCount"
            Grid.Column="2"
            Classes="summary-label"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            ResourceKey="Organize.PlannedCount"
            UseCountVariant="True"
            Value="{Binding Moves.Count}" />
      </Grid>
    </Border>
    <Border x:Name="OrganizeResultsCard" Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
      <Grid>
        <controls:AppDataGrid x:Name="MovesGrid" ItemsSource="{Binding Moves}" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    IsVisible="{Binding IsMoveListEmpty}" MaxWidth="420">
          <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource Loc.Organize.Empty.Title}" />
          <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.Organize.Empty.Description}" />
        </StackPanel>
      </Grid>
    </Border>
  </controls:AdaptivePage>
</UserControl>
