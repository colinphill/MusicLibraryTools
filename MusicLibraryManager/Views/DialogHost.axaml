<UserControl x:Class="MusicLibraryManager.Views.DialogHost"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisible="False" Focusable="True" KeyDown="OnKeyDown">
  <Grid>
    <Button Background="{DynamicResource AppScrimBrush}" BorderThickness="0" Click="OnCancel" />
    <Border x:Name="DialogCard" Width="560" MaxWidth="980" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="18" BoxShadow="0 24 80 0 #99000000">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock x:Name="DialogTitle" FontSize="19" FontWeight="SemiBold" />
          <Button Grid.Column="1" Classes="caption" Width="34" Height="34" Content="&#x2715;" Click="OnCancel" />
        </Grid>
        <ContentControl x:Name="DialogContent" Grid.Row="1" />
        <StackPanel x:Name="DialogButtons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
