<UserControl x:Class="MusicLibraryManager.Views.LibraryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls"
             xmlns:views="using:MusicLibraryManager.Views"
             KeyDown="OnLibraryKeyDown">
  <Grid Margin="26,22,26,26" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <controls:PageHeader Title="Library"
        Subtitle="Browse the cache instantly, even when music roots are offline.">
      <controls:PageHeader.Actions>
        <WrapPanel>
          <Button Classes="app" Margin="0,0,8,6" Content="Reload" Command="{Binding ReloadCommand}"
                  AutomationProperties.Name="Reload cached library" />
          <Button Classes="app primary" Margin="0,0,8,6" Content="Index library" Command="{Binding Indexing.IndexCommand}" />
          <Button Classes="app" Margin="0,0,8,6" Content="Open in Workbench"
                  Command="{Binding OpenInWorkbenchCommand}" />
          <Button Classes="app" Margin="0,0,8,6" Content="Cancel" Command="{Binding Indexing.CancelCommand}"
                  IsVisible="{Binding Indexing.IsIndexing}" />
          <Button Classes="app" Margin="0,0,8,6" Content="Cancel load"
                  Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
          <Button x:Name="InspectorToggle" Classes="app" Margin="0,0,0,6" Content="Inspector"
                  Click="OnInspectorToggle" IsVisible="False" ToolTip.Tip="Show or hide the metadata inspector" />
        </WrapPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <StackPanel Grid.Row="1" Spacing="8">
      <Grid ColumnDefinitions="*,150,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBox x:Name="FilterBox" Classes="app" Text="{Binding FilterText, Mode=TwoWay}"
                 PlaceholderText="Filter, or use Artist:Name AND NOT Codec:MP3"
                 AutomationProperties.Name="Filter library" />
        <ComboBox Grid.Column="1" Classes="app" ItemsSource="{Binding FilterModes}"
                  SelectedItem="{Binding FilterMode, Mode=TwoWay}"
                  AutomationProperties.Name="Filter matching mode" />
        <Button Grid.Column="2" Classes="app" Content="Clear" Command="{Binding ClearFilterCommand}"
                IsVisible="{Binding HasTextFilter}" ToolTip.Tip="Clear the text filter" />
        <Button x:Name="FilterHelpButton" Grid.Column="3" Classes="app" Width="36" Content="?"
                Click="OnFilterHelpClick" ToolTip.Tip="Show filter syntax help"
                AutomationProperties.Name="Filter syntax help" />
        <TextBlock Grid.Column="4" Classes="summary-label" VerticalAlignment="Center"
                   Text="{Binding ResultCountText}" AutomationProperties.LiveSetting="Polite" />
      </Grid>

      <TextBlock Classes="error" IsVisible="{Binding HasFilterError}" Text="{Binding FilterError}"
                 TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />

      <WrapPanel>
        <Border Classes="card" Padding="10,5" Margin="0,0,8,6" IsVisible="{Binding HasHealthFilter}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="{Binding HealthFilterSummary}" />
            <Button Classes="app" Padding="5,0" MinWidth="24" MinHeight="24" Content="&#x2715;"
                    Command="{Binding ClearHealthFilterCommand}" ToolTip.Tip="Clear Health filter"
                    AutomationProperties.Name="Clear Health filter" />
          </StackPanel>
        </Border>
        <Button x:Name="ColumnsButton" Classes="app" Margin="0,0,8,6" Content="Columns" Click="OnColumnsClick" />
        <Button x:Name="ViewsButton" Classes="app" Margin="0,0,8,6" Content="Saved views" Click="OnViewsClick" />
        <Button x:Name="VisualFilterButton" Classes="app" Margin="0,0,8,6"
                Content="Visual filter" Click="OnVisualFilterClick" />
        <Button Classes="app" Margin="0,0,8,6" Content="Clear visual filter"
                Command="{Binding ClearVisualFilterCommand}"
                IsVisible="{Binding HasVisualFilter}" />
        <Button x:Name="LibraryOperationsButton" Classes="app primary" Margin="0,0,8,6"
                Content="Operations" Command="{Binding OpenOperationsCommand}" />
      </WrapPanel>
    </StackPanel>

    <Grid Grid.Row="2">
      <controls:PersistedSplitView x:Name="WorkspaceSplit" InitialLeftWidth="900" MinLeftWidth="340"
                                   MaxLeftWidth="1800" MinRightWidth="320" PersistenceKey="library"
                                   Label="Resize library and inspector">
        <controls:PersistedSplitView.Left>
          <Border Classes="card" Padding="0" ClipToBounds="True">
            <Grid>
              <controls:AppDataGrid x:Name="LibraryGrid" ItemsSource="{Binding Rows}" FrozenColumnCount="1"
                                    SelectionChanged="OnGridSelectionChanged" LoadingRow="OnLoadingRow"
                                    UnloadingRow="OnUnloadingRow"
                                    AutomationProperties.Name="Library tracks" />

              <Border x:Name="LibraryEmptyState" IsVisible="{Binding HasEmptyState}"
                      Background="{DynamicResource AppPanelBrush}" Padding="28">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390" Spacing="10">
                  <TextBlock Classes="section-title" FontSize="18" Text="{Binding EmptyStateTitle}"
                             TextAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding EmptyStateMessage}"
                             TextAlignment="Center" TextWrapping="Wrap" />
                  <Button Classes="app primary" HorizontalAlignment="Center" Content="{Binding EmptyStateActionLabel}"
                          Command="{Binding EmptyStateActionCommand}" />
                </StackPanel>
              </Border>

              <Border IsVisible="{Binding IsBusy}" Background="#990D1417" Padding="28">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                  <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
                  <TextBlock Foreground="White" Text="Loading the cached library..."
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
              </Border>

              <Border x:Name="InspectorScrim" IsVisible="False" Background="#66000000"
                      PointerPressed="OnInspectorScrimPressed" />
            </Grid>
          </Border>
        </controls:PersistedSplitView.Left>
        <controls:PersistedSplitView.Right>
          <Border Classes="card" Padding="0" ClipToBounds="True">
            <views:SelectionInspectorView x:Name="InspectorView" />
          </Border>
        </controls:PersistedSplitView.Right>
      </controls:PersistedSplitView>

      <Popup x:Name="ColumnPopover" PlacementTarget="{Binding #ColumnsButton}"
             Placement="BottomEdgeAlignedRight" VerticalOffset="8"
             IsLightDismissEnabled="True" IsOpen="False">
        <Border Width="650" MaxHeight="610"
                Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}"
                BorderThickness="1" CornerRadius="9" Padding="12" BoxShadow="0 14 40 0 #77000000">
          <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*"
                RowSpacing="8" ColumnSpacing="14">
            <Grid Grid.ColumnSpan="2"
                  ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="Columns" FontSize="14" FontWeight="SemiBold" />
              <Button x:Name="CloseColumnsButton" Grid.Column="1" Classes="app" Width="28" Height="28"
                      Padding="0" Content="&#x2715;" ToolTip.Tip="Close column selector" Click="OnColumnsClose" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ColumnOptions" Spacing="8" />
            </ScrollViewer>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="7">
              <TextBlock Classes="section-title"
                         Text="Metadata columns" />
              <ListBox x:Name="LibraryMetadataColumnList"
                       MaxHeight="105"
                       ItemsSource="{Binding ColumnEditor.Columns}"
                       SelectedItem="{Binding ColumnEditor.SelectedColumn, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Classes="muted"
                                 Text="{Binding Field}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                <TextBox Classes="app"
                         Text="{Binding ColumnEditor.Label, Mode=TwoWay}"
                         PlaceholderText="Column label" />
                <ComboBox Grid.Column="1" Classes="app"
                          ItemsSource="{Binding ColumnEditor.FieldKinds}"
                          SelectedItem="{Binding ColumnEditor.FieldKind, Mode=TwoWay}" />
              </Grid>
              <ComboBox Classes="app"
                        ItemsSource="{Binding ColumnEditor.KnownFields}"
                        DisplayMemberBinding="{Binding Label}"
                        SelectedItem="{Binding ColumnEditor.SelectedKnownField, Mode=TwoWay}"
                        PlaceholderText="Known metadata field" />
              <TextBox Classes="app"
                       Text="{Binding ColumnEditor.CustomFieldName, Mode=TwoWay}"
                       PlaceholderText="Native custom field name" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                <ComboBox Classes="app"
                          ItemsSource="{Binding ColumnEditor.SortTypes}"
                          SelectedItem="{Binding ColumnEditor.SortType, Mode=TwoWay}" />
                <NumericUpDown Grid.Column="1" Classes="app"
                               Minimum="50" Maximum="2000"
                               Value="{Binding ColumnEditor.Width, Mode=TwoWay}"
                               FormatString="0" />
              </Grid>
              <WrapPanel>
                <Button Classes="app" Content="New"
                        Command="{Binding ColumnEditor.NewColumnCommand}" />
                <Button x:Name="SaveLibraryMetadataColumnButton"
                        Classes="app primary" Content="Save column"
                        Command="{Binding ColumnEditor.SaveColumnCommand}" />
                <Button Classes="app danger" Content="Remove"
                        Command="{Binding ColumnEditor.DeleteColumnCommand}" />
              </WrapPanel>
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{Binding ColumnEditor.Status}" />
            </StackPanel>
          </Grid>
        </Border>
      </Popup>

      <Popup x:Name="ViewsPopover" PlacementTarget="{Binding #ViewsButton}"
             Placement="BottomEdgeAlignedLeft" VerticalOffset="8"
             IsLightDismissEnabled="True" IsOpen="False">
        <Border Width="330" MaxHeight="480"
                Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}"
                BorderThickness="1" CornerRadius="9" Padding="14" BoxShadow="0 14 40 0 #77000000">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Saved views" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="app" Width="28" Height="28" Padding="0" Content="&#x2715;"
                      Click="OnViewsClose" ToolTip.Tip="Close saved views" />
            </Grid>
            <ComboBox x:Name="SavedViews" Classes="app" ItemsSource="{Binding SavedViews}"
                      SelectedItem="{Binding SelectedView, Mode=TwoWay}" PlaceholderText="Choose a saved view"
                      SelectionChanged="OnSavedViewChanged" AutomationProperties.Name="Saved library views">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Height="1" Background="{DynamicResource AppBorderBrush}" />
            <TextBlock Classes="muted" Text="Save the current filter, columns, and sort" TextWrapping="Wrap" />
            <TextBox x:Name="ViewNameBox" Classes="app" Text="{Binding NewViewName, Mode=TwoWay}"
                     PlaceholderText="View name" AutomationProperties.Name="New saved view name" />
            <WrapPanel>
              <Button Classes="app primary" Margin="0,0,8,0" Content="Save view" Click="OnSaveView" />
              <Button Classes="app" Content="Delete selected" Command="{Binding DeleteViewCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </Popup>

      <Popup x:Name="VisualFilterPopover"
             PlacementTarget="{Binding #VisualFilterButton}"
             Placement="BottomEdgeAlignedLeft" VerticalOffset="8"
             IsLightDismissEnabled="True" IsOpen="False">
        <Border Width="720" MaxHeight="620"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderStrongBrush}"
                BorderThickness="1" CornerRadius="9" Padding="14"
                BoxShadow="0 14 40 0 #77000000">
          <Grid RowDefinitions="Auto,*" ColumnDefinitions="270,*"
                RowSpacing="10" ColumnSpacing="14">
            <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
              <TextBlock Text="Visual filter" FontSize="14"
                         FontWeight="SemiBold" />
              <Button Grid.Column="1" Classes="app" Width="28"
                      Height="28" Padding="0" Content="&#x2715;"
                      Click="OnVisualFilterClose" />
            </Grid>
            <StackPanel Grid.Row="1" Spacing="8">
              <ComboBox Classes="app"
                        ItemsSource="{Binding VisualFilterEditor.RootModes}"
                        SelectedItem="{Binding VisualFilterEditor.RootMode, Mode=TwoWay}" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Conditions with the same group number are combined with AND. Root mode combines the numbered groups." />
              <ListBox x:Name="VisualFilterConditionList" MaxHeight="360"
                       ItemsSource="{Binding VisualFilterEditor.Conditions}"
                       SelectedItem="{Binding VisualFilterEditor.SelectedCondition, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Summary}"
                               TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Classes="app" Content="Add condition"
                        Command="{Binding VisualFilterEditor.AddConditionCommand}" />
                <Button Classes="app danger" Content="Remove"
                        Command="{Binding VisualFilterEditor.RemoveConditionCommand}" />
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8"
                        DataContext="{Binding VisualFilterEditor.SelectedCondition}">
              <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                <NumericUpDown Classes="app" Minimum="1"
                               Value="{Binding Group, Mode=TwoWay}"
                               FormatString="0" />
                <ComboBox Grid.Column="1" Classes="app"
                          ItemsSource="{Binding DataContext.VisualFilterEditor.FieldKinds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding FieldKind, Mode=TwoWay}" />
              </Grid>
              <ComboBox Classes="app"
                        ItemsSource="{Binding DataContext.VisualFilterEditor.TechnicalFields, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        DisplayMemberBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedTechnicalField, Mode=TwoWay}"
                        PlaceholderText="Technical or file field" />
              <ComboBox Classes="app"
                        ItemsSource="{Binding DataContext.VisualFilterEditor.KnownFields, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        DisplayMemberBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedKnownField, Mode=TwoWay}"
                        PlaceholderText="Known metadata field" />
              <TextBox Classes="app"
                       Text="{Binding CustomFieldName, Mode=TwoWay}"
                       PlaceholderText="Native custom field name" />
              <ComboBox Classes="app"
                        ItemsSource="{Binding DataContext.VisualFilterEditor.Comparisons, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        SelectedItem="{Binding Comparison, Mode=TwoWay}" />
              <TextBox Classes="app" Text="{Binding Value, Mode=TwoWay}"
                       PlaceholderText="Comparison value (not needed for present/missing)" />
              <CheckBox Content="Negate this condition"
                        IsChecked="{Binding Negate, Mode=TwoWay}" />
              <WrapPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button x:Name="ApplyVisualFilterButton"
                        Classes="app primary" Content="Apply visual filter"
                        Command="{Binding ApplyVisualFilterCommand}" />
                <Button Classes="app" Content="Clear"
                        Command="{Binding ClearVisualFilterCommand}" />
              </WrapPanel>
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Text="{Binding VisualFilterEditor.Status}" />
            </StackPanel>
          </Grid>
        </Border>
      </Popup>

      <Popup x:Name="FilterHelpPopover" PlacementTarget="{Binding #FilterHelpButton}"
             Placement="BottomEdgeAlignedRight" VerticalOffset="8"
             IsLightDismissEnabled="True" IsOpen="False">
        <Border Width="360" Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1"
                CornerRadius="9" Padding="14" BoxShadow="0 14 40 0 #77000000">
          <StackPanel Spacing="7">
            <TextBlock Text="Filter syntax" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Search all visible metadata with ordinary text. Use Field:Value for a field, quotes for phrases, and AND, OR, or NOT to combine terms." />
            <TextBlock FontFamily="Consolas" Text="Artist:Miles AND NOT Codec:MP3" />
            <TextBlock FontFamily="Consolas" Text="Album:&quot;Kind of Blue&quot;" />
          </StackPanel>
        </Border>
      </Popup>

      <Popup x:Name="LibraryOperationsPopover"
             PlacementTarget="{Binding #LibraryOperationsButton}"
             Placement="BottomEdgeAlignedLeft" VerticalOffset="8"
             IsLightDismissEnabled="True"
             IsOpen="{Binding IsOperationsOpen, Mode=TwoWay}">
        <Border Width="980" MaxHeight="690"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderStrongBrush}"
                BorderThickness="1" CornerRadius="9" Padding="14"
                BoxShadow="0 14 40 0 #77000000">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Library operations and output" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Classes="muted"
                           Text="Apply typed operations, reports, and playlists to an explicit Library scope." />
                <WrapPanel Margin="0,5,0,0">
                  <Button x:Name="UndoLibraryOperationButton"
                          Classes="app" Margin="0,0,6,0"
                          Content="Undo metadata"
                          Command="{Binding UndoLibraryOperationCommand}" />
                  <Button x:Name="RedoLibraryOperationButton"
                          Classes="app" Margin="0,0,6,0"
                          Content="Redo preview"
                          Command="{Binding RedoLibraryOperationCommand}" />
                  <Button x:Name="RepeatLibraryRecipeButton"
                          Classes="app"
                          Content="Repeat recipe"
                          Command="{Binding RepeatLibraryRecipeCommand}" />
                </WrapPanel>
              </StackPanel>
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox Classes="app"
                          ItemsSource="{Binding OperationEditor.SavedRecipes}"
                          SelectedItem="{Binding OperationEditor.SelectedSavedRecipe, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Name}"
                          PlaceholderText="Personal recipe" />
                <Button Grid.Column="1" Classes="app" Content="Load"
                        Command="{Binding OperationEditor.LoadRecipeCommand}" />
              </Grid>
              <Button Grid.Column="2" Classes="app" Width="30" Height="30"
                      Padding="0" Content="&#x2715;"
                      Command="{Binding CloseOperationsCommand}" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="1*,1*,1*,1*,1*" ColumnSpacing="10">
              <StackPanel Spacing="4">
                <TextBlock Classes="muted" Text="Scope" FontSize="12" FontWeight="SemiBold" />
                <ComboBox Classes="app" ItemsSource="{Binding OperationScopes}"
                          SelectedItem="{Binding SelectedOperationScope, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="muted" Text="Operation" FontSize="12" FontWeight="SemiBold" />
                <ComboBox Classes="app"
                          ItemsSource="{Binding OperationEditor.OperationDescriptors}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          SelectedItem="{Binding OperationEditor.SelectedOperation, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Classes="muted" Text="Field" FontSize="12" FontWeight="SemiBold" />
                <ComboBox Classes="app" ItemsSource="{Binding OperationEditor.Fields}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedItem="{Binding OperationEditor.SelectedField, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="3" Spacing="4">
                <TextBlock Classes="muted" Text="Destination field" FontSize="12" FontWeight="SemiBold" />
                <ComboBox Classes="app" ItemsSource="{Binding OperationEditor.Fields}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedItem="{Binding OperationEditor.DestinationField, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="4">
                <TextBlock Classes="muted" Text="Second source field" FontSize="12" FontWeight="SemiBold" />
                <ComboBox Classes="app" ItemsSource="{Binding OperationEditor.Fields}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedItem="{Binding OperationEditor.SecondaryField, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,150,150,150" ColumnSpacing="10">
              <StackPanel Spacing="4">
                <TextBlock Classes="muted" Text="Value" FontSize="12" FontWeight="SemiBold" />
                <TextBox Classes="app"
                         Text="{Binding OperationEditor.OperationValue, Mode=TwoWay}"
                         PlaceholderText="Assignment value" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="muted" Text="Find" FontSize="12" FontWeight="SemiBold" />
                <TextBox Classes="app"
                         Text="{Binding OperationEditor.SearchText, Mode=TwoWay}"
                         PlaceholderText="Text or regular expression" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Classes="muted" Text="Replace with" FontSize="12" FontWeight="SemiBold" />
                <TextBox Classes="app"
                         Text="{Binding OperationEditor.ReplacementText, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="3" Spacing="4">
                <TextBlock Classes="muted" Text="Case" FontSize="12" FontWeight="SemiBold" />
                <ComboBox Classes="app" ItemsSource="{Binding OperationEditor.CaseModes}"
                          SelectedItem="{Binding OperationEditor.SelectedCaseMode, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="4">
                <TextBlock Classes="muted" Text="Separator" FontSize="12" FontWeight="SemiBold" />
                <TextBox Classes="app"
                         Text="{Binding OperationEditor.Separator, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="5" Spacing="4">
                <TextBlock Classes="muted" Text="Value order" FontSize="12" FontWeight="SemiBold" />
                <ComboBox Classes="app" ItemsSource="{Binding OperationEditor.ValueOrders}"
                          SelectedItem="{Binding OperationEditor.SelectedValueOrder, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="190,90,*,140" ColumnSpacing="10">
              <StackPanel Spacing="4">
                <TextBlock Classes="muted" Text="Path component" FontSize="12" FontWeight="SemiBold" />
                <ComboBox Classes="app" ItemsSource="{Binding OperationEditor.PathComponents}"
                          SelectedItem="{Binding OperationEditor.SelectedPathComponent, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="muted" Text="Parent level" FontSize="12" FontWeight="SemiBold" />
                <NumericUpDown Classes="app" Minimum="1"
                               Value="{Binding OperationEditor.ParentLevel, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Classes="muted" Text="Optional extraction pattern" FontSize="12" FontWeight="SemiBold" />
                <TextBox Classes="app"
                         Text="{Binding OperationEditor.ExtractionPattern, Mode=TwoWay}"
                         PlaceholderText="Regular expression with a named capture" />
              </StackPanel>
              <StackPanel Grid.Column="3" Spacing="4">
                <TextBlock Classes="muted" Text="Capture group" FontSize="12" FontWeight="SemiBold" />
                <TextBox Classes="app"
                         Text="{Binding OperationEditor.ExtractionGroup, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,150,130,150,*" ColumnSpacing="10">
              <CheckBox VerticalAlignment="Center" Content="Regular expression"
                        IsChecked="{Binding OperationEditor.UseRegularExpression, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center"
                         Text="Sequence start" />
              <NumericUpDown Grid.Column="2" Classes="app" Width="85" Minimum="0"
                             Value="{Binding OperationEditor.SequenceStart, Mode=TwoWay}" />
              <NumericUpDown Grid.Column="3" Classes="app" Width="85" Minimum="0" Maximum="12"
                             Value="{Binding OperationEditor.SequencePadding, Mode=TwoWay}"
                             ToolTip.Tip="Sequence padding" />
              <CheckBox Grid.Column="4" VerticalAlignment="Center" Content="Condition"
                        IsChecked="{Binding OperationEditor.ConditionEnabled, Mode=TwoWay}" />
              <ComboBox Grid.Column="5" Classes="app"
                        ItemsSource="{Binding OperationEditor.Fields}"
                        DisplayMemberBinding="{Binding Label}"
                        SelectedItem="{Binding OperationEditor.SelectedConditionField, Mode=TwoWay}" />
              <ComboBox Grid.Column="6" Classes="app"
                        ItemsSource="{Binding OperationEditor.ConditionOperators}"
                        SelectedItem="{Binding OperationEditor.SelectedConditionOperator, Mode=TwoWay}" />
              <TextBox Grid.Column="7" Classes="app"
                       Text="{Binding OperationEditor.ConditionValue, Mode=TwoWay}"
                       PlaceholderText="Condition value" />
              <StackPanel Grid.Column="8" HorizontalAlignment="Right"
                          Orientation="Horizontal" Spacing="6">
                <ComboBox x:Name="LibraryImportEmptyCellMode"
                          Classes="app" Width="135"
                          ItemsSource="{Binding ImportEmptyCellModes}"
                          SelectedItem="{Binding ImportEmptyCellMode, Mode=TwoWay}"
                          ToolTip.Tip="How empty import cells are handled" />
                <Button x:Name="ImportLibraryDelimitedMetadataButton"
                        Classes="app" Content="Import CSV/TSV"
                        Command="{Binding ImportLibraryDelimitedMetadataCommand}" />
                <Button x:Name="CopyLibraryMetadataFieldButton"
                        Classes="app" Content="Copy field"
                        ToolTip.Tip="Copy the selected field identity and ordered values from the first file in scope"
                        Command="{Binding CopyLibraryMetadataFieldCommand}" />
                <Button x:Name="PasteLibraryMetadataFieldButton"
                        Classes="app" Content="Paste + preview"
                        ToolTip.Tip="Paste tag-aware or line-delimited text into the selected scope"
                        Command="{Binding PasteLibraryMetadataFieldCommand}" />
                <Button Classes="app primary"
                        Content="Preview"
                        Command="{Binding PreviewLibraryOperationCommand}" />
              </StackPanel>
            </Grid>

            <TabControl Grid.Row="5" MinHeight="190">
              <TabItem Header="Metadata preview">
                <Grid Margin="0,6,0,0"
                      RowDefinitions="Auto,*" RowSpacing="8">
                  <Border x:Name="LibraryRepresentativePreview"
                          Padding="10"
                          Background="{DynamicResource AppInsetBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1" CornerRadius="7">
                    <StackPanel Spacing="6">
                      <TextBlock FontWeight="SemiBold"
                                 Text="Live representative draft" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="{Binding RepresentativePreview.Status}" />
                      <ProgressBar IsVisible="{Binding RepresentativePreview.IsBusy}"
                                   IsIndeterminate="True" Height="3" />
                      <Grid IsVisible="{Binding RepresentativePreview.HasPreview}"
                            ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                          <TextBlock Classes="muted" Text="Before" />
                          <TextBlock Text="{Binding RepresentativePreview.BeforeText}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Classes="muted" Text="After" />
                          <TextBlock Text="{Binding RepresentativePreview.AfterText}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <controls:AppDataGrid x:Name="LibraryOperationPreviewGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding OperationPreviewChanges}" />
                </Grid>
              </TabItem>
              <TabItem Header="Files">
                <views:ReviewedFileOperationEditorView
                    x:Name="LibraryFileOperationEditor"
                    DataContext="{Binding FileOperations}" />
              </TabItem>
              <TabItem Header="Audio matches">
                <controls:AppDataGrid x:Name="LibraryAudioDiscoveryGrid"
                    Margin="0,6,0,0"
                    ItemsSource="{Binding AudioMatches}"
                    SelectedItem="{Binding SelectedAudioMatch, Mode=TwoWay}" />
              </TabItem>
              <TabItem Header="Release editions">
                <Grid Margin="0,6,0,0" RowDefinitions="Auto,*" RowSpacing="6">
                  <Grid ColumnDefinitions="*,*,*,*,*,Auto" ColumnSpacing="6">
                    <TextBox Classes="app"
                             Text="{Binding ReleaseSearch.Artist, Mode=TwoWay}"
                             PlaceholderText="Artist" />
                    <TextBox Grid.Column="1" Classes="app"
                             Text="{Binding ReleaseSearch.Album, Mode=TwoWay}"
                             PlaceholderText="Album" />
                    <TextBox Grid.Column="2" Classes="app"
                             Text="{Binding ReleaseSearch.Barcode, Mode=TwoWay}"
                             PlaceholderText="Barcode" />
                    <TextBox Grid.Column="3" Classes="app"
                             Text="{Binding ReleaseSearch.CatalogNumber, Mode=TwoWay}"
                             PlaceholderText="Catalog no." />
                    <TextBox Grid.Column="4" Classes="app"
                             Text="{Binding ReleaseSearch.ReleaseId, Mode=TwoWay}"
                             PlaceholderText="Release ID" />
                    <Button Grid.Column="5" Classes="app primary"
                            Content="Search"
                            Command="{Binding SearchLibraryMusicBrainzReleasesCommand}" />
                  </Grid>
                  <controls:AppDataGrid x:Name="LibraryReleaseDiscoveryGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding ReleaseMatches}"
                      SelectedItem="{Binding SelectedRelease, Mode=TwoWay}" />
                </Grid>
              </TabItem>
              <TabItem Header="Discogs editions">
                <Grid Margin="0,6,0,0"
                      RowDefinitions="Auto,*,Auto,*,Auto" RowSpacing="6">
                  <Grid ColumnDefinitions="*,*,*,*,*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Classes="app"
                             Text="{Binding DiscogsSearch.Artist, Mode=TwoWay}"
                             PlaceholderText="Artist" />
                    <TextBox Grid.Column="1" Classes="app"
                             Text="{Binding DiscogsSearch.Album, Mode=TwoWay}"
                             PlaceholderText="Album" />
                    <TextBox Grid.Column="2" Classes="app"
                             Text="{Binding DiscogsSearch.Barcode, Mode=TwoWay}"
                             PlaceholderText="Barcode" />
                    <TextBox Grid.Column="3" Classes="app"
                             Text="{Binding DiscogsSearch.CatalogNumber, Mode=TwoWay}"
                             PlaceholderText="Catalog no." />
                    <TextBox Grid.Column="4" Classes="app"
                             Text="{Binding DiscogsSearch.ReleaseId, Mode=TwoWay}"
                             PlaceholderText="Discogs release ID" />
                    <Button Grid.Column="5" Classes="app primary"
                            Content="Search Discogs"
                            Command="{Binding SearchLibraryDiscogsReleasesCommand}" />
                    <Button Grid.Column="6" Classes="app"
                            Content="Load details"
                            Command="{Binding LoadLibraryDiscogsReleaseDetailsCommand}" />
                  </Grid>
                  <controls:AppDataGrid x:Name="LibraryDiscogsDiscoveryGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding DiscogsMatches}"
                      SelectedItem="{Binding SelectedDiscogsRelease, Mode=TwoWay}" />
                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                    <TextBlock Classes="muted" VerticalAlignment="Center"
                               Text="Review every file-to-track suggestion before adding selected fields to the normal preview."
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="app"
                            Content="Build mapping"
                            Command="{Binding BuildLibraryDiscogsReleaseMappingCommand}" />
                    <Button Grid.Column="2" Classes="app primary"
                            Content="Preview mapped metadata"
                            Command="{Binding PreviewLibraryDiscogsReleaseMetadataCommand}" />
                    <Button Grid.Column="3" Classes="app"
                            Content="Preview cover"
                            Command="{Binding PreviewLibraryDiscogsReleaseArtworkCommand}" />
                  </Grid>
                  <controls:AppDataGrid x:Name="LibraryDiscogsTrackMappingGrid"
                      Grid.Row="3"
                      ItemsSource="{Binding DiscogsTrackMappings}" />
                  <WrapPanel Grid.Row="4">
                    <CheckBox Margin="0,0,12,0" Content="Titles"
                              IsChecked="{Binding DiscogsImport.TrackTitles, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,0" Content="Track artists"
                              IsChecked="{Binding DiscogsImport.TrackArtists, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,0" Content="Album/date"
                              IsChecked="{Binding DiscogsImport.ReleaseIdentity, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,0" Content="Numbering"
                              IsChecked="{Binding DiscogsImport.Numbering, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,0" Content="Release details"
                              IsChecked="{Binding DiscogsImport.ReleaseDetails, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,0" Content="Genres/styles"
                              IsChecked="{Binding DiscogsImport.GenresAndStyles, Mode=TwoWay}" />
                    <CheckBox Content="Discogs release ID"
                              IsChecked="{Binding DiscogsImport.DiscogsIdentifier, Mode=TwoWay}" />
                  </WrapPanel>
                </Grid>
              </TabItem>
              <TabItem Header="Track mapping">
                <Grid Margin="0,6,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="6">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                    <TextBlock Classes="muted" VerticalAlignment="Center"
                               Text="Review or replace suggestions before preview."
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="app" Content="Build mapping"
                            Command="{Binding BuildLibraryReleaseMappingCommand}" />
                    <Button Grid.Column="2" Classes="app primary"
                            Content="Preview mapped metadata"
                            Command="{Binding PreviewLibraryReleaseMetadataCommand}" />
                  </Grid>
                  <controls:AppDataGrid x:Name="LibraryReleaseTrackMappingGrid" Grid.Row="1"
                      ItemsSource="{Binding ReleaseTrackMappings}" />
                  <WrapPanel Grid.Row="2">
                    <CheckBox Margin="0,0,12,0" Content="Titles"
                              IsChecked="{Binding ReleaseImport.TrackTitles, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,0" Content="Track artists"
                              IsChecked="{Binding ReleaseImport.TrackArtists, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,0" Content="Album/date"
                              IsChecked="{Binding ReleaseImport.ReleaseIdentity, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,0" Content="Numbering"
                              IsChecked="{Binding ReleaseImport.Numbering, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,0" Content="Release details"
                              IsChecked="{Binding ReleaseImport.ReleaseDetails, Mode=TwoWay}" />
                    <CheckBox Content="MusicBrainz IDs"
                              IsChecked="{Binding ReleaseImport.MusicBrainzIdentifiers, Mode=TwoWay}" />
                  </WrapPanel>
                </Grid>
              </TabItem>
              <TabItem Header="Artwork">
                <Grid Margin="0,6,0,0" RowDefinitions="Auto,*" RowSpacing="6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                    <TextBlock Classes="muted" VerticalAlignment="Center"
                               Text="Preview local artwork for the current Library scope, or use release artwork for confirmed mappings."
                               TextWrapping="Wrap" />
                    <WrapPanel Grid.Column="1">
                      <Button Classes="app" Content="Local front cover"
                              Command="{Binding PreviewLocalLibraryArtworkCommand}" />
                      <Button Classes="app" Content="Remove front"
                              Command="{Binding PreviewRemoveLibraryFrontCoverCommand}" />
                      <Button Classes="app" Content="Remove all"
                              Command="{Binding PreviewRemoveAllLibraryArtworkCommand}" />
                      <Button Classes="app" Content="Find release artwork"
                              Command="{Binding FindLibraryReleaseArtworkCommand}" />
                      <Button Classes="app primary"
                              Content="Preview release cover"
                              Command="{Binding PreviewLibraryReleaseArtworkCommand}" />
                    </WrapPanel>
                  </Grid>
                  <controls:AppDataGrid x:Name="LibraryReleaseArtworkGrid" Grid.Row="1"
                      ItemsSource="{Binding ArtworkMatches}"
                      SelectedItem="{Binding SelectedArtworkMatch, Mode=TwoWay}" />
                </Grid>
              </TabItem>
              <TabItem Header="Reports">
                <Grid Margin="0,6,0,0" ColumnDefinitions="0.9*,12,1.1*">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="*,150,170" ColumnSpacing="7">
                        <TextBox Classes="app"
                                 Text="{Binding ReportEditor.Name, Mode=TwoWay}"
                                 PlaceholderText="Report name" />
                        <ComboBox Grid.Column="1" Classes="app"
                                  ItemsSource="{Binding ReportEditor.Formats}"
                                  SelectedItem="{Binding ReportEditor.Format, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2" Classes="app"
                                  ItemsSource="{Binding ReportEditor.Encodings}"
                                  SelectedItem="{Binding ReportEditor.Encoding, Mode=TwoWay}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                        <TextBox Classes="app"
                                 Text="{Binding ReportEditor.OutputPath, Mode=TwoWay}"
                                 PlaceholderText="Output file or folder" />
                        <Button Grid.Column="1" Classes="app" Content="Browse"
                                Command="{Binding BrowseLibraryReportOutputCommand}" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                        <CheckBox Content="One file per group"
                                  IsChecked="{Binding ReportEditor.OneFilePerGroup, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Classes="app"
                                 Text="{Binding ReportEditor.GroupFileNameTemplate, Mode=TwoWay}"
                                 PlaceholderText="{}{Group}.{Format}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                        <ComboBox Classes="app"
                                  ItemsSource="{Binding ReportEditor.AvailableFields}"
                                  DisplayMemberBinding="{Binding Label}"
                                  SelectedItem="{Binding ReportEditor.SelectedAvailableField, Mode=TwoWay}" />
                        <Button Grid.Column="1" Classes="app" Content="Add column"
                                Command="{Binding ReportEditor.AddSelectedFieldCommand}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                        <TextBox Classes="app"
                                 Text="{Binding ReportEditor.CustomFieldName, Mode=TwoWay}"
                                 PlaceholderText="Native custom field name" />
                        <Button Grid.Column="1" Classes="app" Content="Add custom"
                                Command="{Binding ReportEditor.AddCustomFieldCommand}" />
                      </Grid>
                      <ListBox MinHeight="100"
                               ItemsSource="{Binding ReportEditor.Fields}"
                               SelectedItem="{Binding ReportEditor.SelectedField, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                              <TextBlock Text="{Binding Label}" />
                              <TextBlock Grid.Column="1" Classes="muted"
                                         Text="{Binding Source}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <WrapPanel>
                        <Button Classes="app" Content="Remove"
                                Command="{Binding ReportEditor.RemoveFieldCommand}" />
                        <Button Classes="app" Content="Move up"
                                Command="{Binding ReportEditor.MoveFieldUpCommand}" />
                        <Button Classes="app" Content="Move down"
                                Command="{Binding ReportEditor.MoveFieldDownCommand}" />
                      </WrapPanel>
                      <Grid ColumnDefinitions="*,*,130,Auto" ColumnSpacing="7">
                        <ComboBox Classes="app"
                                  ItemsSource="{Binding ReportEditor.Fields}"
                                  DisplayMemberBinding="{Binding Label}"
                                  SelectedItem="{Binding ReportEditor.SelectedGroupField, Mode=TwoWay}"
                                  PlaceholderText="Group by" />
                        <ComboBox Grid.Column="1" Classes="app"
                                  ItemsSource="{Binding ReportEditor.Fields}"
                                  DisplayMemberBinding="{Binding Label}"
                                  SelectedItem="{Binding ReportEditor.SelectedSortField, Mode=TwoWay}"
                                  PlaceholderText="Sort by" />
                        <ComboBox Grid.Column="2" Classes="app"
                                  ItemsSource="{Binding ReportEditor.SortTypes}"
                                  SelectedItem="{Binding ReportEditor.SortType, Mode=TwoWay}" />
                        <CheckBox Grid.Column="3" VerticalAlignment="Center"
                                  Content="Descending"
                                  IsChecked="{Binding ReportEditor.SortDescending, Mode=TwoWay}" />
                      </Grid>
                    </StackPanel>
                  </ScrollViewer>
                  <Grid Grid.Column="2" RowDefinitions="*,Auto" RowSpacing="7">
                    <controls:AppDataGrid x:Name="LibraryReportOutputGrid"
                        ItemsSource="{Binding ReportOutputs}" />
                    <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                      <Button Classes="app" Content="Preview report"
                              Command="{Binding PreviewLibraryReportCommand}" />
                      <Button Classes="app primary"
                              Content="Write reviewed report"
                              Command="{Binding ApplyLibraryReportCommand}" />
                    </WrapPanel>
                  </Grid>
                </Grid>
              </TabItem>
              <TabItem Header="Playlists">
                <Grid Margin="0,6,0,0"
                      ColumnDefinitions="0.9*,12,1.1*">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="*,120" ColumnSpacing="7">
                        <TextBox Classes="app"
                                 Text="{Binding PlaylistEditor.Name, Mode=TwoWay}"
                                 PlaceholderText="Playlist name" />
                        <ComboBox Grid.Column="1" Classes="app"
                                  ItemsSource="{Binding PlaylistEditor.Formats}"
                                  SelectedItem="{Binding PlaylistEditor.Format, Mode=TwoWay}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                        <TextBox Classes="app"
                                 Text="{Binding PlaylistEditor.OutputPath, Mode=TwoWay}"
                                 PlaceholderText="Output file or folder" />
                        <Button Grid.Column="1" Classes="app" Content="Browse"
                                Command="{Binding BrowseLibraryPlaylistOutputCommand}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
                        <ComboBox Classes="app"
                                  ItemsSource="{Binding PlaylistEditor.PathStyles}"
                                  SelectedItem="{Binding PlaylistEditor.PathStyle, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1" Classes="app"
                                  ItemsSource="{Binding PlaylistEditor.Encodings}"
                                  SelectedItem="{Binding PlaylistEditor.Encoding, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2" Classes="app"
                                  ItemsSource="{Binding PlaylistEditor.LineEndings}"
                                  SelectedItem="{Binding PlaylistEditor.LineEnding, Mode=TwoWay}" />
                      </Grid>
                      <CheckBox Content="Include extended track information"
                                IsChecked="{Binding PlaylistEditor.IncludeExtendedInfo, Mode=TwoWay}" />
                      <CheckBox Content="One playlist per metadata group"
                                IsChecked="{Binding PlaylistEditor.OnePlaylistPerGroup, Mode=TwoWay}" />
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                        <ComboBox Classes="app"
                                  ItemsSource="{Binding PlaylistEditor.GroupFields}"
                                  DisplayMemberBinding="{Binding Label}"
                                  SelectedItem="{Binding PlaylistEditor.SelectedGroupField, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Classes="app"
                                 Text="{Binding PlaylistEditor.GroupFileNameTemplate, Mode=TwoWay}"
                                 PlaceholderText="{}{Name} - {Group}" />
                      </Grid>
                      <Border Classes="status-banner info">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Playlist order follows the selected Library scope. Preview reads current metadata from disk and records recoverable output." />
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                  <Grid Grid.Column="2" RowDefinitions="*,Auto"
                        RowSpacing="7">
                    <controls:AppDataGrid
                        x:Name="LibraryPlaylistOutputGrid"
                        ItemsSource="{Binding PlaylistOutputs}" />
                    <WrapPanel Grid.Row="1"
                               HorizontalAlignment="Right">
                      <Button x:Name="PreviewLibraryPlaylistButton"
                              Classes="app"
                              Content="Preview playlist"
                              Command="{Binding PreviewLibraryPlaylistCommand}" />
                      <Button Classes="app primary"
                              Content="Write reviewed playlist"
                              Command="{Binding ApplyLibraryPlaylistCommand}" />
                    </WrapPanel>
                  </Grid>
                </Grid>
              </TabItem>
              <TabItem Header="Tools">
                <Grid Margin="0,6,0,0"
                      ColumnDefinitions="0.95*,12,1.05*">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                            ColumnSpacing="6">
                        <ComboBox Classes="app"
                                  ItemsSource="{Binding ExternalToolEditor.SavedTools}"
                                  DisplayMemberBinding="{Binding Name}"
                                  SelectedItem="{Binding ExternalToolEditor.SelectedSavedTool, Mode=TwoWay}"
                                  PlaceholderText="Saved personal tool" />
                        <Button Grid.Column="1" Classes="app" Content="Load"
                                Command="{Binding ExternalToolEditor.LoadToolCommand}" />
                        <Button Grid.Column="2" Classes="app" Content="New"
                                Command="{Binding ExternalToolEditor.NewToolCommand}" />
                        <Button Grid.Column="3" Classes="app" Content="Save"
                                Command="{Binding ExternalToolEditor.SaveToolCommand}" />
                        <Button Grid.Column="4" Classes="app" Content="Delete"
                                Command="{Binding ExternalToolEditor.DeleteToolCommand}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,170" ColumnSpacing="7">
                        <TextBox Classes="app"
                                 Text="{Binding ExternalToolEditor.Name, Mode=TwoWay}"
                                 PlaceholderText="Tool name" />
                        <ComboBox Grid.Column="1" Classes="app"
                                  ItemsSource="{Binding ExternalToolEditor.InvocationModes}"
                                  SelectedItem="{Binding ExternalToolEditor.InvocationMode, Mode=TwoWay}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                        <TextBox Classes="app"
                                 Text="{Binding ExternalToolEditor.Executable, Mode=TwoWay}"
                                 PlaceholderText="Executable path or command name" />
                        <Button Grid.Column="1" Classes="app"
                                Content="Browse executable"
                                Command="{Binding BrowseLibraryExternalToolExecutableCommand}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                        <TextBox Classes="app"
                                 Text="{Binding ExternalToolEditor.WorkingDirectory, Mode=TwoWay}"
                                 PlaceholderText="Optional working directory or {Directory}" />
                        <Button Grid.Column="1" Classes="app"
                                Content="Browse folder"
                                Command="{Binding BrowseLibraryExternalToolWorkingDirectoryCommand}" />
                      </Grid>
                      <TextBox Classes="app" MinHeight="90"
                               AcceptsReturn="True" TextWrapping="NoWrap"
                               Text="{Binding ExternalToolEditor.ArgumentsText, Mode=TwoWay}"
                               PlaceholderText="{}{Files}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="One argument per line. Supported placeholders: {Files}, {File}, {Directory}, {FileName}, {FileNameWithoutExtension}, {Extension}, {Index}, and {Count}." />
                      <Border Classes="status-banner warning">
                        <TextBlock TextWrapping="Wrap"
                                   Text="External tools run without a shell but remain outside application recovery. Running always requires confirmation." />
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                  <Grid Grid.Column="2" RowDefinitions="*,Auto"
                        RowSpacing="7">
                    <controls:AppDataGrid
                        x:Name="LibraryExternalToolInvocationGrid"
                        ItemsSource="{Binding ExternalToolInvocations}" />
                    <WrapPanel Grid.Row="1"
                               HorizontalAlignment="Right">
                      <Button x:Name="PreviewLibraryExternalToolButton"
                              Classes="app" Content="Preview tool"
                              Command="{Binding PreviewLibraryExternalToolCommand}" />
                      <Button Classes="app primary"
                              Content="Run reviewed tool"
                              Command="{Binding RunLibraryExternalToolCommand}" />
                    </WrapPanel>
                  </Grid>
                </Grid>
              </TabItem>
            </TabControl>

            <Grid Grid.Row="6" ColumnDefinitions="*,190,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="7">
              <TextBlock Classes="muted" VerticalAlignment="Center"
                         Text="{Binding OperationStatus}" TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite" />
              <StackPanel Grid.Column="1" Spacing="3"
                          IsVisible="{Binding IsOperationBusy}">
                <TextBlock Classes="muted" FontSize="11"
                           Text="{Binding OperationProgressText}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar Height="4"
                             IsIndeterminate="{Binding IsOperationProgressIndeterminate}"
                             Maximum="{Binding OperationProgressMaximum}"
                             Value="{Binding OperationProgressValue}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="app" Content="Cancel"
                      IsVisible="{Binding IsOperationBusy}"
                      Command="{Binding CancelLibraryOperationCommand}" />
              <Button Grid.Column="3" Classes="app" Content="Find by audio"
                      Command="{Binding DiscoverLibraryAudioCommand}" />
              <Button Grid.Column="4" Classes="app" Content="Preview selected IDs"
                      Command="{Binding PreviewLibraryAudioIdentifiersCommand}" />
              <Button Grid.Column="5" Classes="app" Content="Find releases"
                      Command="{Binding ResolveLibraryRecordingCommand}" />
              <Button Grid.Column="6" Classes="app primary" Content="Apply preview"
                      Command="{Binding ApplyLibraryOperationCommand}" />
            </Grid>
          </Grid>
        </Border>
      </Popup>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding StatusText}"
                 TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="SelectedCountLabel" Grid.Column="1" Classes="summary-label" IsVisible="False" />
      <Button x:Name="CopyButton" Grid.Column="2" Classes="app" IsVisible="False" Content="Copy paths" Click="OnCopyPaths" />
      <Button x:Name="RevealButton" Grid.Column="3" Classes="app" IsVisible="False" Content="Reveal" Click="OnReveal" />
      <Button x:Name="ReindexButton" Grid.Column="4" Classes="app" IsVisible="False" Content="Reindex" Click="OnReindex" />
      <TextBlock Grid.Column="5" Classes="muted" VerticalAlignment="Center" Text="{Binding Indexing.StatusText}" />
    </Grid>
  </Grid>
</UserControl>
