<UserControl x:Class="MusicLibraryManager.Views.HealthView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls"
             xmlns:vm="using:MusicLibraryManager.Presentation">
  <UserControl.Styles>
    <Style Selector="ListBox.health-result-navigation ListBoxItem.health-navigation-group">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="12,8,12,4" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TabControl.health-result-content /template/ TabStrip">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>
  <controls:AdaptivePage RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <controls:PageHeader Title="{DynamicResource Loc.Health.Title}"
        Subtitle="{DynamicResource Loc.Health.Subtitle}">
      <controls:PageHeader.SecondaryActions>
        <StackPanel x:Name="HealthWorkflowActions"
                    Orientation="Horizontal"
                    Spacing="8">
          <Button Classes="app"
                  Content="{DynamicResource Loc.Common.Cancel}"
                  Command="{Binding CancelCommand}"
                  IsVisible="{Binding IsBusy}" />
        </StackPanel>
      </controls:PageHeader.SecondaryActions>
    </controls:PageHeader>

    <Border x:Name="HealthSetupCard"
            Grid.Row="1"
            Classes="card"
            IsVisible="False">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Classes="section-title"
                     Text="{DynamicResource Loc.Home.Empty.Title}" />
          <TextBlock Classes="muted"
                     Text="{DynamicResource Loc.Home.Empty.Description}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button x:Name="HealthSetupAction"
                Grid.Column="1"
                Classes="app primary"
                VerticalAlignment="Center"
                Content="{DynamicResource Loc.Home.Empty.Action}"
                AutomationProperties.Name="{DynamicResource Loc.Home.Empty.Action}"
                Click="OnOpenSettings" />
      </Grid>
    </Border>

    <Border x:Name="HealthActionCard"
            Grid.Row="1"
            Classes="card"
            Padding="16">
      <StackPanel x:Name="HealthActionContent"
                  Spacing="12">
        <Grid x:Name="HealthActionLayout"
              ColumnDefinitions="1.25*,1*"
              ColumnSpacing="24">
          <StackPanel Spacing="8">
            <TextBlock x:Name="HealthAuditTitle"
                       Text="{DynamicResource Loc.Health.Audit.Title}"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="HealthAuditDescription"
                       Classes="muted"
                       Text="{DynamicResource Loc.Health.Audit.Description}"
                       TextWrapping="Wrap" />
            <Button x:Name="RunHealthAuditButton"
                    Classes="app primary overflow"
                    HorizontalAlignment="Left"
                    Content="{DynamicResource Loc.Health.Audit.Run}"
                    AutomationProperties.Name="{DynamicResource Loc.Health.Audit.RunAutomation}">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="{DynamicResource Loc.Health.Audit.Menu.Metadata}"
                            Command="{Binding RunInconsistenciesCommand}" />
                  <MenuItem Header="{DynamicResource Loc.Health.Audit.Menu.LossyFiles}"
                            Command="{Binding RunLossyCommand}" />
                  <MenuItem Header="{DynamicResource Loc.Health.Audit.Menu.Duplicates}"
                            Command="{Binding RunDuplicatesCommand}" />
                  <MenuItem Header="{DynamicResource Loc.Health.Audit.Menu.CrossSet}"
                            Command="{Binding RunCheckSetsCommand}" />
                  <MenuItem Header="{DynamicResource Loc.Health.Audit.Menu.FileRepresentations}"
                            Command="{Binding RunRepresentationsCommand}" />
                  <MenuItem Header="{DynamicResource Loc.Health.Audit.Menu.VerifyAudio}"
                            Command="{Binding VerifyDecodedAudioCommand}" />
                  <MenuItem Header="{DynamicResource Loc.Health.Audit.Menu.AlbumMatrix}"
                            Command="{Binding RunAlbumMatrixCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock x:Name="HealthRepairTitle"
                       Text="{DynamicResource Loc.Health.Repair.Title}"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="HealthRepairDescription"
                       Classes="muted"
                       Text="{DynamicResource Loc.Health.Repair.Description}"
                       TextWrapping="Wrap" />
            <WrapPanel>
              <Button x:Name="PrepareHealthRepairsButton"
                      Classes="app overflow" Margin="0,0,12,8"
                      Content="{DynamicResource Loc.Health.Repair.Prepare}"
                      AutomationProperties.Name="{DynamicResource Loc.Health.Repair.PrepareAutomation}">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="{DynamicResource Loc.Health.Repair.Menu.MetadataPolicy}"
                              Command="{Binding PreviewMetadataRepairsCommand}" />
                    <MenuItem Header="{DynamicResource Loc.Health.Repair.Menu.FileRepresentations}"
                              Command="{Binding PreviewRepresentationRepairsCommand}" />
                    <MenuItem Header="{DynamicResource Loc.Health.Repair.Menu.SimilarArtists}"
                              Command="{Binding RunSimilarArtistsCommand}" />
                    <MenuItem Header="{DynamicResource Loc.Health.Repair.Menu.Artwork}"
                              Command="{Binding RunArtworkHealthCommand}" />
                    <MenuItem Header="{DynamicResource Loc.Health.Repair.Menu.AlbumArtistConflicts}"
                              Command="{Binding FindAlbumArtistConflictsCommand}" />
                    <MenuItem Header="{DynamicResource Loc.Health.Repair.Menu.Conflicts}"
                              Command="{Binding PreviewConflictRepairsCommand}" />
                    <MenuItem Header="{DynamicResource Loc.Health.Repair.Menu.Itunes}"
                              Command="{Binding PreviewItlMetadataRepairsCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Grid>
        <Grid IsVisible="{Binding IsBusy}">
          <ProgressBar Classes="app" Minimum="0" Maximum="1"
                       Value="{Binding AnalysisProgressFraction}"
                       IsVisible="{Binding HasDeterminateAnalysisProgress}" />
          <ProgressBar Classes="app" IsIndeterminate="True"
                       IsVisible="{Binding HasIndeterminateAnalysisProgress}" />
        </Grid>
        <Border x:Name="HealthStatusBanner"
                Classes="status-banner"
                Classes.info="{Binding IsStatusInfo}"
                Classes.success="{Binding IsStatusSuccess}"
                Classes.warning="{Binding IsStatusWarning}"
                Classes.error="{Binding IsStatusError}"
                AutomationProperties.LiveSetting="Polite">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Classes="status-icon" Text="{Binding StatusIcon}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
              <controls:LocalizedFormatTextBlock
                  Classes="muted"
                  ResourceKey="Common.DiagnosticDetailFormat"
                  Value="{Binding StatusDiagnosticDetail}"
                  IsVisible="{Binding HasStatusDiagnosticDetail}"
                  TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <controls:PersistedSplitView x:Name="HealthResultsHost"
                              Grid.Row="2" InitialLeftWidth="260" MinLeftWidth="190" MaxLeftWidth="430"
                              MinRightWidth="560" PersistenceKey="health-history" Label="{DynamicResource Loc.Health.Split.History}">
      <controls:PersistedSplitView.Left>
        <Border Classes="card" Padding="12">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <TextBlock Classes="section-title" Text="{DynamicResource Loc.Health.History.Title}" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate><DataTemplate><Border Classes="history-item" Padding="12,8" Margin="0,0,0,8"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{Binding DisplayLabel}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" IsVisible="{Binding !HasRuns}" Classes="muted"
                       Text="{DynamicResource Loc.Health.History.Empty}"
                       TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Classes="app" Content="{DynamicResource Loc.Common.Remove}" Command="{Binding RemoveRunCommand}" /><Button Classes="app" Content="{DynamicResource Loc.Common.Clear}" Command="{Binding ClearRunsCommand}" /></StackPanel>
          </Grid>
        </Border>
      </controls:PersistedSplitView.Left>

      <controls:PersistedSplitView.Right>
        <Border Classes="card" Padding="0" ClipToBounds="True">
          <Grid>
          <Grid x:Name="HealthResultNavigationLayout"
                ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,*"
                IsVisible="{Binding HasRuns}">
            <Border x:Name="HealthResultPickerHost"
                    Grid.ColumnSpan="2"
                    Padding="12,8"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource AppPanelBrush}"
                    IsVisible="False">
              <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource Loc.Health.Title}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="HealthResultPicker"
                          Grid.Column="1"
                          Classes="app"
                          MinWidth="220"
                          MaxWidth="360"
                          HorizontalAlignment="Left"
                          SelectionChanged="OnHealthResultPickerChanged"
                          AutomationProperties.Name="{DynamicResource Loc.Health.Title}">
                  <ComboBoxItem Tag="0"
                                Content="{DynamicResource Loc.Health.Tab.Findings}" />
                  <ComboBoxItem Tag="1"
                                Content="{DynamicResource Loc.Health.Tab.Duplicates}" />
                  <ComboBoxItem Tag="2"
                                Content="{DynamicResource Loc.Health.Tab.SimilarArtists}" />
                  <ComboBoxItem Tag="5"
                                Content="{DynamicResource Loc.Health.Tab.Conflicts}" />
                  <ComboBoxItem Tag="6"
                                Content="{DynamicResource Loc.Health.Tab.AlbumMatrix}" />
                  <ComboBoxItem Tag="3"
                                Content="{DynamicResource Loc.Health.Tab.MetadataRepairs}" />
                  <ComboBoxItem Tag="4"
                                Content="{DynamicResource Loc.Health.Tab.FileRepairs}" />
                  <ComboBoxItem Tag="7"
                                Content="{DynamicResource Loc.Health.Tab.ItunesRepairs}" />
                  <ComboBoxItem Tag="8"
                                Content="{DynamicResource Loc.Health.Tab.ArtworkRepairs}" />
                </ComboBox>
              </Grid>
            </Border>

            <Border x:Name="HealthResultNavigationRail"
                    Grid.Row="1"
                    Width="190"
                    Padding="8"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource AppPanelBrush}">
              <ListBox x:Name="HealthResultNavigation"
                         Classes="secondary-nav health-result-navigation"
                         SelectionChanged="OnHealthResultNavigationChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{DynamicResource Loc.Health.Title}">
                  <ListBoxItem Classes="health-navigation-group"
                               IsEnabled="False"
                               Focusable="False"
                               IsHitTestVisible="False">
                    <TextBlock Classes="field-label muted"
                               Text="{DynamicResource Loc.Health.Audit.Title}" />
                  </ListBoxItem>
                  <ListBoxItem Tag="0"
                               AutomationProperties.Name="{DynamicResource Loc.Health.Tab.Findings}">
                    <TextBlock Text="{DynamicResource Loc.Health.Tab.Findings}" />
                  </ListBoxItem>
                  <ListBoxItem Tag="1"
                               AutomationProperties.Name="{DynamicResource Loc.Health.Tab.Duplicates}">
                    <TextBlock Text="{DynamicResource Loc.Health.Tab.Duplicates}" />
                  </ListBoxItem>
                  <ListBoxItem Tag="2"
                               AutomationProperties.Name="{DynamicResource Loc.Health.Tab.SimilarArtists}">
                    <TextBlock Text="{DynamicResource Loc.Health.Tab.SimilarArtists}" />
                  </ListBoxItem>
                  <ListBoxItem Tag="5"
                               AutomationProperties.Name="{DynamicResource Loc.Health.Tab.Conflicts}">
                    <TextBlock Text="{DynamicResource Loc.Health.Tab.Conflicts}" />
                  </ListBoxItem>
                  <ListBoxItem Tag="6"
                               AutomationProperties.Name="{DynamicResource Loc.Health.Tab.AlbumMatrix}">
                    <TextBlock Text="{DynamicResource Loc.Health.Tab.AlbumMatrix}" />
                  </ListBoxItem>
                  <ListBoxItem Classes="health-navigation-group"
                               IsEnabled="False"
                               Focusable="False"
                               IsHitTestVisible="False">
                    <TextBlock Classes="field-label muted"
                               Text="{DynamicResource Loc.Health.Repair.Title}" />
                  </ListBoxItem>
                  <ListBoxItem Tag="3"
                               AutomationProperties.Name="{DynamicResource Loc.Health.Tab.MetadataRepairs}">
                    <TextBlock Text="{DynamicResource Loc.Health.Tab.MetadataRepairs}" />
                  </ListBoxItem>
                  <ListBoxItem Tag="4"
                               AutomationProperties.Name="{DynamicResource Loc.Health.Tab.FileRepairs}">
                    <TextBlock Text="{DynamicResource Loc.Health.Tab.FileRepairs}" />
                  </ListBoxItem>
                  <ListBoxItem Tag="7"
                               AutomationProperties.Name="{DynamicResource Loc.Health.Tab.ItunesRepairs}">
                    <TextBlock Text="{DynamicResource Loc.Health.Tab.ItunesRepairs}" />
                  </ListBoxItem>
                  <ListBoxItem Tag="8"
                               AutomationProperties.Name="{DynamicResource Loc.Health.Tab.ArtworkRepairs}">
                    <TextBlock Text="{DynamicResource Loc.Health.Tab.ArtworkRepairs}" />
                  </ListBoxItem>
              </ListBox>
            </Border>

          <TabControl x:Name="HealthResultsTabs"
                      Grid.Row="1"
                      Grid.Column="1"
                      Classes="health-result-content"
                      SelectedIndex="{Binding ActiveResultIndex, Mode=OneWay}"
                      ContextRequested="OnHealthResultContextRequested">
            <TabItem Header="{DynamicResource Loc.Health.Tab.Findings}">
              <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0" Classes="status-banner warning" Margin="12,8,12,4"
                      IsVisible="{Binding HasDeferredArtwork}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel>
                    <controls:LocalizedFormatTextBlock
                        FontWeight="SemiBold"
                        ResourceKey="Health.Deferred.Count"
                        UseCountVariant="True"
                        Value="{Binding DeferredArtworkCount}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="{DynamicResource Loc.Health.Deferred.Description}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="app" Content="{DynamicResource Loc.Health.Action.ForceScanDeferred}"
                          Command="{Binding ForceScanDeferredArtworkCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <controls:PersistedSplitView Grid.Row="1" InitialLeftWidth="330" MinLeftWidth="230" MaxLeftWidth="620" MinRightWidth="280" PersistenceKey="health-findings" Label="{DynamicResource Loc.Health.Split.Findings}">
                <controls:PersistedSplitView.Left>
                  <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                      <Button x:Name="FindingRootButton"
                              Padding="12,8"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" Click="OnSelectFindingRoot"
                              AutomationProperties.Name="{DynamicResource Loc.Health.Findings.SelectAllAutomation}">
                        <Grid HorizontalAlignment="Stretch">
                          <Border IsVisible="{Binding IsFindingRootSelected}" Background="{DynamicResource AppSelectionBrush}" CornerRadius="6" />
                          <Grid Margin="8,4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource Loc.Health.Findings.All}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="tree-count" Text="{Binding FindingCount}" />
                          </Grid>
                        </Grid>
                      </Button>
                      <StackPanel Grid.Column="1"
                                  Classes="field"
                                  VerticalAlignment="Center">
                        <TextBlock Classes="field-label"
                                   Text="{DynamicResource Loc.Column.Disposition}" />
                        <ComboBox x:Name="FindingRootDisposition"
                                  Classes="app"
                                  MinWidth="104"
                                  HorizontalAlignment="Right"
                                  AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.AllFindings}" />
                      </StackPanel>
                    </Grid>
                    <TreeView Grid.Row="1" Classes="health-tree" ItemsSource="{Binding FindingGroups}" SelectedItem="{Binding SelectedFindingNode, Mode=TwoWay}">
                      <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="{x:Type vm:AnalysisProblemGroupViewModel}" ItemsSource="{Binding Artists}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Problem}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                    <TreeDataTemplate DataType="{x:Type vm:AnalysisArtistGroupViewModel}" ItemsSource="{Binding Albums}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Artist}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                    <TreeDataTemplate DataType="{x:Type vm:AnalysisAlbumGroupViewModel}" ItemsSource="{Binding Findings}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Album}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                        <DataTemplate DataType="{x:Type vm:AnalysisFindingViewModel}"><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                      </TreeView.DataTemplates>
                    </TreeView>
                  </Grid>
                </controls:PersistedSplitView.Left>
                <controls:PersistedSplitView.Right>
                  <Grid RowDefinitions="Auto,*">
                    <Border Classes="quiet-toolbar"
                            IsVisible="{Binding !!SelectedFindingNode}">
                      <StackPanel Classes="field"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  Spacing="8">
                        <TextBlock Classes="field-label"
                                   Text="{DynamicResource Loc.Column.Disposition}"
                                   VerticalAlignment="Center" />
                        <ComboBox Classes="app"
                                  MinWidth="112"
                                  DataContext="{Binding SelectedFindingNode}"
                                  ItemsSource="{Binding DispositionChoices}"
                                  SelectedValue="{Binding Disposition, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Value}"
                                  AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.AllFindings}" />
                      </StackPanel>
                    </Border>
                    <controls:AppDataGrid x:Name="FindingGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding DisplayedFindings}"
                                          SelectedItem="{Binding SelectedFindingNode, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" IsVisible="{Binding !DisplayedFindings.Count}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Classes="muted" Text="{Binding FindingsEmptyText}" TextWrapping="Wrap" TextAlignment="Center" Margin="16" />
                  </Grid>
                </controls:PersistedSplitView.Right>
              </controls:PersistedSplitView>
              </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc.Health.Tab.Duplicates}">
              <Grid>
                <Grid x:Name="DuplicateMasterDetailLayout"
                      Margin="12"
                      ColumnDefinitions="280,*"
                      ColumnSpacing="12"
                      IsVisible="{Binding HasDuplicateResults}">
                  <Border Classes="section-frame"
                          Padding="0"
                          ClipToBounds="True">
                    <ListBox x:Name="DuplicateResultsList"
                             ItemsSource="{Binding Duplicates}"
                             SelectedItem="{Binding SelectedDuplicate, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{DynamicResource Loc.Health.Tab.Duplicates}">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="8"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">
                            <TextBlock Text="{Binding Key}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Classes="tree-count"
                                       Text="{Binding Tracks.Count}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                  <Border Grid.Column="1"
                          Classes="section-frame"
                          Padding="0"
                          ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                      <TextBlock Margin="12,12,12,8"
                                 Classes="section-title"
                                 Text="{Binding SelectedDuplicate.Key}"
                                 TextTrimming="CharacterEllipsis" />
                      <ListBox x:Name="DuplicateTrackList"
                               Grid.Row="1"
                               ItemsSource="{Binding SelectedDuplicate.Tracks}"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               AutomationProperties.Name="{DynamicResource Loc.Column.Files}">
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                          </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="8,8"
                                        Spacing="4">
                              <TextBlock Text="{Binding Title}"
                                         FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="muted caption"
                                         Text="{Binding Path}"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding Path}" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Border>
                </Grid>
                <TextBlock Classes="muted" IsVisible="{Binding !HasDuplicateResults}" Text="{DynamicResource Loc.Health.Duplicates.Empty}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc.Health.Tab.SimilarArtists}">
              <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="status-banner warning" Margin="12,8,12,4"
                        IsVisible="{Binding HasArtistResults}">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc.Health.Artist.ReviewTitle}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="{DynamicResource Loc.Health.Artist.Description}" />
                      <controls:LocalizedFormatTextBlock
                          Classes="muted"
                          ResourceKey="Health.Artist.ActiveTrackCount"
                          UseCountVariant="True"
                          Value="{Binding ActiveArtistTrackCount}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Classes="field"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                      <TextBlock Classes="field-label"
                                 Text="{DynamicResource Loc.Health.Artist.Threshold}"
                                 VerticalAlignment="Center" />
                      <TextBox x:Name="ArtistThresholdInput"
                               Classes="app"
                               Width="70"
                               Text="{Binding ArtistThresholdText, Mode=TwoWay}"
                               ToolTip.Tip="{DynamicResource Loc.Health.Artist.ThresholdTooltip}"
                               AutomationProperties.Name="{DynamicResource Loc.Health.Artist.ThresholdAutomation}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Classes="field"
                                VerticalAlignment="Center">
                      <TextBlock Classes="field-label"
                                 Text="{DynamicResource Loc.Column.Disposition}" />
                      <ComboBox x:Name="ArtistRootDisposition"
                                Classes="app"
                                MinWidth="112"
                                AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.AllArtists}" />
                    </StackPanel>
                    <Button Grid.Column="3" Classes="app primary" Content="{DynamicResource Loc.Health.Action.ApplyActiveMerges}"
                            Command="{Binding ApplySimilarArtistsCommand}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Grid x:Name="SimilarArtistMasterDetailLayout"
                      Grid.Row="1"
                      Margin="12"
                      ColumnDefinitions="280,*"
                      ColumnSpacing="12"
                      IsVisible="{Binding HasArtistResults}">
                  <Border Classes="section-frame"
                          Padding="0"
                          ClipToBounds="True">
                    <ListBox x:Name="SimilarArtistResultsList"
                             ItemsSource="{Binding ArtistGroups}"
                             SelectedItem="{Binding SelectedArtistGroup, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{DynamicResource Loc.Health.Tab.SimilarArtists}">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="8"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">
                            <TextBlock Text="{Binding CanonicalName}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <controls:LocalizedFormatTextBlock
                                Grid.Column="1"
                                Classes="tree-count"
                                ResourceKey="Health.Artist.ClusterTrackCount"
                                UseCountVariant="True"
                                Value="{Binding TrackCount}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                  <Border Grid.Column="1"
                          Classes="section-frame"
                          Padding="0"
                          ClipToBounds="True">
                    <ScrollViewer x:Name="SimilarArtistDetailsScroll"
                                  DataContext="{Binding SelectedArtistGroup}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Margin="12"
                                  Spacing="8">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                          <Grid Classes="field"
                                controls:FieldAccessibility.Associate="True"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">
                            <TextBlock Classes="field-label"
                                       Text="{DynamicResource Loc.Health.Artist.CanonicalName}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Classes="app"
                                     MinWidth="180"
                                     Text="{Binding CanonicalName, Mode=TwoWay}"
                                     IsEnabled="{Binding CanEditCanonical}"
                                     AutomationProperties.Name="{DynamicResource Loc.Health.Artist.CanonicalNameAutomation}" />
                          </Grid>
                          <Grid Grid.Column="1"
                                Classes="field"
                                controls:FieldAccessibility.Associate="True"
                                ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="12">
                            <TextBlock Classes="field-label"
                                       Text="{DynamicResource Loc.Column.Disposition}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      Classes="app"
                                      MinWidth="112"
                                      ItemsSource="{Binding DispositionChoices}"
                                      SelectedValue="{Binding Disposition, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Value}"
                                      AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.ArtistCluster}" />
                          </Grid>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Variants}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="6"
                                      Margin="0,0,0,8"
                                      Padding="12">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                  <Expander Grid.Column="0">
                                    <Expander.Header>
                                      <Grid ColumnDefinitions="*,Auto,Auto"
                                            ColumnSpacing="12">
                                        <StackPanel MinWidth="180"
                                                    VerticalAlignment="Center">
                                          <TextBlock Text="{Binding Name}"
                                                     FontWeight="SemiBold" />
                                          <controls:LocalizedFormatTextBlock
                                              Classes="muted caption"
                                              ResourceKey="Health.Artist.FileCount"
                                              UseCountVariant="True"
                                              Value="{Binding TrackCount}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource Loc.Health.Artist.CanonicalTarget}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppSuccessBrush}"
                                                   IsVisible="{Binding IsCanonical}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">
                                          <TextBlock Classes="muted"
                                                     Text="{Binding ResultText}" />
                                          <controls:LocalizedFormatTextBlock
                                              Classes="muted"
                                              ResourceKey="Common.DiagnosticDetailFormat"
                                              Value="{Binding ResultDiagnosticDetail}"
                                              IsVisible="{Binding HasResultDiagnosticDetail}"
                                              TextWrapping="Wrap" />
                                        </StackPanel>
                                      </Grid>
                                    </Expander.Header>
                                    <Grid Margin="0,12,0,0"
                                          ColumnDefinitions="1*,1.5*"
                                          ColumnSpacing="16">
                                      <StackPanel Spacing="4">
                                        <controls:LocalizedFormatTextBlock
                                            Classes="muted"
                                            FontWeight="SemiBold"
                                            ResourceKey="Health.Artist.FolderCount"
                                            UseCountVariant="True"
                                            Value="{Binding FolderCount}" />
                                        <ItemsControl ItemsSource="{Binding Folders}">
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                              <TextBlock Text="{Binding Path}"
                                                         TextTrimming="CharacterEllipsis"
                                                         ToolTip.Tip="{Binding Path}" />
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                      </StackPanel>
                                      <StackPanel Grid.Column="1"
                                                  Spacing="4">
                                        <controls:LocalizedFormatTextBlock
                                            Classes="muted"
                                            FontWeight="SemiBold"
                                            ResourceKey="Health.Artist.FilesCount"
                                            UseCountVariant="True"
                                            Value="{Binding TrackCount}" />
                                        <ItemsControl ItemsSource="{Binding Files}">
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                              <TextBlock Text="{Binding Path}"
                                                         TextTrimming="CharacterEllipsis"
                                                         ToolTip.Tip="{Binding Path}" />
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                      </StackPanel>
                                    </Grid>
                                  </Expander>
                                  <StackPanel Grid.Column="1"
                                              Classes="field"
                                              VerticalAlignment="Top">
                                    <TextBlock Classes="field-label"
                                               Text="{DynamicResource Loc.Column.Disposition}" />
                                    <ComboBox Classes="app"
                                              MinWidth="112"
                                              ItemsSource="{Binding DispositionChoices}"
                                              SelectedValue="{Binding Disposition, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Value}"
                                              IsEnabled="{Binding CanChangeDisposition}"
                                              AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.ArtistVariant}" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                </Grid>
                <TextBlock Grid.Row="1" Classes="muted" IsVisible="{Binding !HasArtistResults}"
                           Text="{DynamicResource Loc.Health.Artist.Empty}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc.Health.Tab.MetadataRepairs}">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="status-banner info" Margin="12,8,12,4">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <controls:LocalizedFormatTextBlock
                        Classes="summary-label"
                        VerticalAlignment="Center"
                        ResourceKey="Health.Repairs.MetadataCount"
                        UseCountVariant="True"
                        Value="{Binding SelectedRun.ActiveRepairCount}" />
                    <Button Grid.Column="1" Classes="app primary" Content="{DynamicResource Loc.Health.Action.ApplyMetadataRepairs}"
                            Command="{Binding ApplyRepairsCommand}" />
                  </Grid>
                </Border>
              <controls:PersistedSplitView Grid.Row="1" InitialLeftWidth="350" MinLeftWidth="240" MaxLeftWidth="650" MinRightWidth="280" PersistenceKey="health-metadata-repairs" Label="{DynamicResource Loc.Health.Split.MetadataRepairs}">
                <controls:PersistedSplitView.Left>
                  <Grid RowDefinitions="Auto,*">
                <Grid Margin="12,8,12,4" ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource Loc.Health.Repairs.AllMetadata}" /><StackPanel Grid.Column="1" Classes="field"><TextBlock Classes="field-label" Text="{DynamicResource Loc.Column.Disposition}" /><ComboBox x:Name="RepairRootDisposition" Classes="app" MinWidth="112" AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.AllMetadataRepairs}" /></StackPanel></Grid>
                  <TreeView Grid.Row="1" Classes="health-tree" ItemsSource="{Binding RepairGroups}" SelectedItem="{Binding SelectedRepairNode, Mode=TwoWay}">
                    <TreeView.DataTemplates>
                  <TreeDataTemplate DataType="{x:Type vm:AnalysisRepairCategoryGroupViewModel}" ItemsSource="{Binding Artists}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Category}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                  <TreeDataTemplate DataType="{x:Type vm:AnalysisRepairArtistGroupViewModel}" ItemsSource="{Binding Albums}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Artist}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                  <TreeDataTemplate DataType="{x:Type vm:AnalysisRepairAlbumGroupViewModel}" ItemsSource="{Binding Items}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Album}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                      <DataTemplate DataType="{x:Type vm:AnalysisRepairItemViewModel}"><TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                    </TreeView.DataTemplates>
                  </TreeView>
                  </Grid>
                </controls:PersistedSplitView.Left>
                <controls:PersistedSplitView.Right>
                  <Grid RowDefinitions="Auto,*">
                    <Border Classes="quiet-toolbar"
                            IsVisible="{Binding !!SelectedRepairNode}">
                      <StackPanel Classes="field"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  Spacing="8">
                        <TextBlock Classes="field-label" Text="{DynamicResource Loc.Column.Disposition}" VerticalAlignment="Center" />
                        <ComboBox Classes="app" MinWidth="112"
                                  DataContext="{Binding SelectedRepairNode}"
                                  ItemsSource="{Binding DispositionChoices}"
                                  SelectedValue="{Binding Disposition, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Value}"
                                  AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.AllMetadataRepairs}" />
                      </StackPanel>
                    </Border>
                    <controls:AppDataGrid x:Name="RepairGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding DisplayedRepairItems}"
                                          SelectedItem="{Binding SelectedRepairNode, Mode=TwoWay}" />
                  </Grid>
                </controls:PersistedSplitView.Right>
              </controls:PersistedSplitView>
              </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc.Health.Tab.FileRepairs}">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="status-banner warning" Margin="12,8,12,4">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <controls:LocalizedFormatTextBlock
                        Classes="summary-label"
                        VerticalAlignment="Center"
                        ResourceKey="Health.Repairs.FileCount"
                        UseCountVariant="True"
                        Value="{Binding SelectedRun.ActiveRepresentationRepairCount}" />
                    <Button Grid.Column="1" Classes="app primary" Content="{DynamicResource Loc.Health.Action.ApplyFileRepairs}"
                            Command="{Binding ApplyRepresentationRepairsCommand}" />
                  </Grid>
                </Border>
              <controls:PersistedSplitView Grid.Row="1" InitialLeftWidth="350" MinLeftWidth="240" MaxLeftWidth="650" MinRightWidth="280" PersistenceKey="health-file-repairs" Label="{DynamicResource Loc.Health.Split.FileRepairs}">
                <controls:PersistedSplitView.Left>
                  <Grid RowDefinitions="Auto,*">
                <Grid Margin="12,8,12,4" ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource Loc.Health.Repairs.AllFile}" /><StackPanel Grid.Column="1" Classes="field"><TextBlock Classes="field-label" Text="{DynamicResource Loc.Column.Disposition}" /><ComboBox x:Name="RepresentationRootDisposition" Classes="app" MinWidth="112" AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.AllFileRepairs}" /></StackPanel></Grid>
                  <TreeView Grid.Row="1" Classes="health-tree" ItemsSource="{Binding RepresentationActionGroups}" SelectedItem="{Binding SelectedRepresentationNode, Mode=TwoWay}">
                    <TreeView.DataTemplates>
                  <TreeDataTemplate DataType="{x:Type vm:RepresentationRepairCategoryGroupViewModel}" ItemsSource="{Binding Artists}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Category}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                  <TreeDataTemplate DataType="{x:Type vm:RepresentationRepairArtistGroupViewModel}" ItemsSource="{Binding Albums}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Artist}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                  <TreeDataTemplate DataType="{x:Type vm:RepresentationRepairAlbumGroupViewModel}" ItemsSource="{Binding Items}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Album}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                      <DataTemplate DataType="{x:Type vm:RepresentationRepairActionItemViewModel}"><TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                    </TreeView.DataTemplates>
                  </TreeView>
                  </Grid>
                </controls:PersistedSplitView.Left>
                <controls:PersistedSplitView.Right>
                  <Grid RowDefinitions="Auto,*">
                    <Border Classes="quiet-toolbar"
                            IsVisible="{Binding !!SelectedRepresentationNode}">
                      <StackPanel Classes="field"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  Spacing="8">
                        <TextBlock Classes="field-label" Text="{DynamicResource Loc.Column.Disposition}" VerticalAlignment="Center" />
                        <ComboBox Classes="app" MinWidth="112"
                                  DataContext="{Binding SelectedRepresentationNode}"
                                  ItemsSource="{Binding DispositionChoices}"
                                  SelectedValue="{Binding Disposition, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Value}"
                                  AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.AllFileRepairs}" />
                      </StackPanel>
                    </Border>
                    <controls:AppDataGrid x:Name="RepresentationGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding DisplayedRepresentationItems}"
                                          SelectedItem="{Binding SelectedRepresentationNode, Mode=TwoWay}" />
                  </Grid>
                </controls:PersistedSplitView.Right>
              </controls:PersistedSplitView>
              </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc.Health.Tab.Conflicts}"><Grid><controls:AppDataGrid x:Name="ConflictGrid" Margin="12" ItemsSource="{Binding ConflictGroups}" IsVisible="{Binding HasConflictResults}" /><TextBlock Classes="muted" IsVisible="{Binding !HasConflictResults}" Text="{DynamicResource Loc.Health.Conflicts.Empty}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></TabItem>
            <TabItem Header="{DynamicResource Loc.Health.Tab.AlbumMatrix}">
              <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="status-banner info" Margin="12,12,12,0">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <controls:AppVectorIcon Kind="Information" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock x:Name="AlbumMatrixExplanation" FontWeight="SemiBold"
                                 Text="{DynamicResource Loc.Health.AlbumMatrix.ReadOnly}" />
                      <TextBlock TextWrapping="Wrap"
                                 Text="{DynamicResource Loc.Health.AlbumMatrix.Description}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid x:Name="AlbumMatrixMasterDetailLayout"
                      Grid.Row="1"
                      Margin="12"
                      ColumnDefinitions="280,*"
                      ColumnSpacing="12"
                      IsVisible="{Binding HasMatrixResults}">
                  <Border Classes="section-frame"
                          Padding="0"
                          ClipToBounds="True">
                    <ListBox x:Name="AlbumMatrixResultsList"
                             ItemsSource="{Binding Matrices}"
                             SelectedItem="{Binding SelectedMatrix, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{DynamicResource Loc.Health.Tab.AlbumMatrix}">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="8"
                                      Spacing="4">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted caption"
                                       Text="{Binding Summary}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                  <Border Grid.Column="1"
                          Classes="section-frame"
                          Padding="0"
                          ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                      <StackPanel Margin="12,12,12,8"
                                  Spacing="4">
                        <TextBlock Classes="section-title"
                                   Text="{Binding SelectedMatrix.DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted caption"
                                   Text="{Binding SelectedMatrix.Root}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding SelectedMatrix.Root}" />
                      </StackPanel>
                      <controls:AppDataGrid x:Name="AlbumMatrixRowsGrid"
                                            Grid.Row="1"
                                            ItemsSource="{Binding SelectedMatrix.Rows}"
                                            AutomationProperties.Name="{DynamicResource Loc.Health.Tab.AlbumMatrix}" />
                    </Grid>
                  </Border>
                </Grid>
                <TextBlock Grid.Row="1" Classes="muted" IsVisible="{Binding !HasMatrixResults}"
                           Text="{DynamicResource Loc.Health.AlbumMatrix.Empty}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Loc.Health.Tab.ItunesRepairs}">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="status-banner warning" Margin="12,8,12,4">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <controls:LocalizedFormatTextBlock
                        Classes="summary-label"
                        VerticalAlignment="Center"
                        ResourceKey="Health.Repairs.ItunesCount"
                        UseCountVariant="True"
                        Value="{Binding SelectedRun.ActiveItlRepairCount}" />
                    <Button Grid.Column="1" Classes="app primary" Content="{DynamicResource Loc.Health.Action.ApplyItunesRepairs}"
                            Command="{Binding ApplyItlMetadataRepairsCommand}" />
                  </Grid>
                </Border>
              <controls:PersistedSplitView Grid.Row="1" InitialLeftWidth="350" MinLeftWidth="240" MaxLeftWidth="650" MinRightWidth="280" PersistenceKey="health-itl-metadata-repairs" Label="{DynamicResource Loc.Health.Split.ItunesRepairs}">
                <controls:PersistedSplitView.Left>
                  <Grid RowDefinitions="Auto,*">
                <Grid Margin="12,8,12,4" ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource Loc.Health.Repairs.AllItunes}" /><StackPanel Grid.Column="1" Classes="field"><TextBlock Classes="field-label" Text="{DynamicResource Loc.Column.Disposition}" /><ComboBox x:Name="ItlRepairRootDisposition" Classes="app" MinWidth="112" AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.AllItunesRepairs}" /></StackPanel></Grid>
                    <TreeView Grid.Row="1" Classes="health-tree" ItemsSource="{Binding ItlRepairGroups}" SelectedItem="{Binding SelectedItlRepairNode, Mode=TwoWay}">
                      <TreeView.DataTemplates>
                  <TreeDataTemplate DataType="{x:Type vm:ItlMetadataRepairCategoryGroupViewModel}" ItemsSource="{Binding Artists}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Category}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                  <TreeDataTemplate DataType="{x:Type vm:ItlMetadataRepairArtistGroupViewModel}" ItemsSource="{Binding Albums}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Artist}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                  <TreeDataTemplate DataType="{x:Type vm:ItlMetadataRepairAlbumGroupViewModel}" ItemsSource="{Binding Items}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Album}" /><TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" /></Grid></TreeDataTemplate>
                        <DataTemplate DataType="{x:Type vm:ItlMetadataRepairItemViewModel}"><TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                      </TreeView.DataTemplates>
                    </TreeView>
                  </Grid>
                </controls:PersistedSplitView.Left>
                <controls:PersistedSplitView.Right>
                  <Grid RowDefinitions="Auto,*">
                    <Border Classes="quiet-toolbar"
                            IsVisible="{Binding !!SelectedItlRepairNode}">
                      <StackPanel Classes="field"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  Spacing="8">
                        <TextBlock Classes="field-label" Text="{DynamicResource Loc.Column.Disposition}" VerticalAlignment="Center" />
                        <ComboBox Classes="app" MinWidth="112"
                                  DataContext="{Binding SelectedItlRepairNode}"
                                  ItemsSource="{Binding DispositionChoices}"
                                  SelectedValue="{Binding Disposition, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Value}"
                                  AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.AllItunesRepairs}" />
                      </StackPanel>
                    </Border>
                    <controls:AppDataGrid x:Name="ItlRepairGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding DisplayedItlRepairItems}"
                                          SelectedItem="{Binding SelectedItlRepairNode, Mode=TwoWay}" />
                  </Grid>
                </controls:PersistedSplitView.Right>
              </controls:PersistedSplitView>
              </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Loc.Health.Tab.ArtworkRepairs}">
              <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="status-banner warning" Margin="12,8,12,4">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc.Health.Artwork.ReviewTitle}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="{DynamicResource Loc.Health.Artwork.Description}" />
                      <controls:LocalizedFormatTextBlock
                          Classes="muted"
                          ResourceKey="Health.Artwork.SelectedCount"
                          UseCountVariant="True"
                          Value="{Binding SelectedRun.ActiveArtworkRepairCount}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Classes="field"
                                VerticalAlignment="Center">
                      <TextBlock Classes="field-label"
                                 Text="{DynamicResource Loc.Column.Disposition}" />
                      <ComboBox x:Name="ArtworkRepairRootDisposition"
                                Classes="app"
                                MinWidth="112"
                                AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.AllArtworkRepairs}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="app" Content="{DynamicResource Loc.Health.Action.ForceScanDeferred}"
                              IsVisible="{Binding HasDeferredArtwork}"
                              Command="{Binding ForceScanDeferredArtworkCommand}" />
                      <Button Classes="app primary" Content="{DynamicResource Loc.Health.Action.ApplyArtworkRepairs}"
                              Command="{Binding ApplyArtworkRepairsCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <controls:PersistedSplitView Grid.Row="1" InitialLeftWidth="330" MinLeftWidth="230"
                                             MaxLeftWidth="560" MinRightWidth="360"
                                             PersistenceKey="health-artwork-repairs"
                                             Label="{DynamicResource Loc.Health.Split.ArtworkRepairs}">
                  <controls:PersistedSplitView.Left>
                    <Grid RowDefinitions="Auto,*">
                      <Grid Margin="12,8,12,4"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{DynamicResource Loc.Health.Artwork.Plan}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Classes="field"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    IsVisible="{Binding !!SelectedArtworkRepairNode}">
                          <TextBlock Classes="field-label"
                                     Text="{DynamicResource Loc.Column.Disposition}"
                                     VerticalAlignment="Center" />
                          <ComboBox Classes="app"
                                    MinWidth="112"
                                    DataContext="{Binding SelectedArtworkRepairNode}"
                                    ItemsSource="{Binding DispositionChoices}"
                                    SelectedValue="{Binding Disposition, Mode=TwoWay}"
                                    SelectedValueBinding="{Binding Value}"
                                    AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.ArtworkRepair}" />
                        </StackPanel>
                      </Grid>
                       <TreeView Grid.Row="1" Classes="health-tree" ItemsSource="{Binding ArtworkRepairGroups}"
                                SelectedItem="{Binding SelectedArtworkRepairNode, Mode=TwoWay}"
                                ContextRequested="OnArtworkRepairTreeContextRequested">
                         <TreeView.DataTemplates>
                          <TreeDataTemplate DataType="{x:Type vm:ArtworkRepairCategoryGroupViewModel}" ItemsSource="{Binding Artists}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Text="{Binding Category}" />
                              <TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" />
                            </Grid>
                          </TreeDataTemplate>
                          <TreeDataTemplate DataType="{x:Type vm:ArtworkRepairArtistGroupViewModel}" ItemsSource="{Binding Albums}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Text="{Binding Artist}" />
                              <TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" />
                            </Grid>
                          </TreeDataTemplate>
                          <TreeDataTemplate DataType="{x:Type vm:ArtworkRepairAlbumGroupViewModel}" ItemsSource="{Binding Items}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Text="{Binding Album}" />
                              <TextBlock Grid.Column="1" Classes="tree-count" Text="{Binding Count}" />
                            </Grid>
                          </TreeDataTemplate>
                          <DataTemplate DataType="{x:Type vm:ArtworkRepairItemViewModel}">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          </DataTemplate>
                        </TreeView.DataTemplates>
                      </TreeView>
                    </Grid>
                  </controls:PersistedSplitView.Left>
                  <controls:PersistedSplitView.Right>
                    <Grid>
                      <Grid x:Name="ArtworkRepairMasterDetailLayout"
                            Margin="12"
                            ColumnDefinitions="260,*"
                            ColumnSpacing="12"
                            IsVisible="{Binding HasArtworkRepairResults}">
                        <Border Classes="section-frame"
                                Padding="0"
                                ClipToBounds="True">
                          <ListBox x:Name="ArtworkRepairResultsList"
                                   ItemsSource="{Binding DisplayedArtworkRepairItems}"
                                   SelectedItem="{Binding SelectedArtworkRepairItem, Mode=TwoWay}"
                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                                   AutomationProperties.Name="{DynamicResource Loc.Health.Tab.ArtworkRepairs}">
                            <ListBox.ItemsPanel>
                              <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                              </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Margin="8"
                                            Spacing="4">
                                  <TextBlock Text="{Binding Title}"
                                             FontWeight="SemiBold"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Classes="muted caption"
                                             Text="{Binding TargetSummary}"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Border>
                        <Border Grid.Column="1"
                                Classes="section-frame"
                                Padding="0"
                                ClipToBounds="True">
                          <ScrollViewer x:Name="ArtworkRepairDetailsScroll"
                                        DataContext="{Binding SelectedArtworkRepairItem}"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12"
                                        Spacing="8">
                              <Grid ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">
                                <StackPanel>
                                  <TextBlock Text="{Binding Title}"
                                             FontWeight="SemiBold" />
                                  <TextBlock Classes="muted"
                                             Text="{Binding TargetSummary}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Classes="field"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                  <TextBlock Classes="field-label"
                                             Text="{DynamicResource Loc.Column.Disposition}"
                                             VerticalAlignment="Center" />
                                  <ComboBox Classes="app"
                                            MinWidth="112"
                                            ItemsSource="{Binding DispositionChoices}"
                                            SelectedValue="{Binding Disposition, Mode=TwoWay}"
                                            SelectedValueBinding="{Binding Value}"
                                            IsEnabled="{Binding CanChangeDisposition}"
                                            AutomationProperties.Name="{DynamicResource Loc.Health.Disposition.ArtworkRepair}" />
                                </StackPanel>
                              </Grid>
                              <TextBlock Text="{Binding Description}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="warning-text"
                                         Text="{Binding BlockingReason}"
                                         TextWrapping="Wrap"
                                         IsVisible="{Binding !!BlockingReason}" />
                              <ListBox ItemsSource="{Binding Candidates}"
                                       SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                       IsVisible="{Binding ShowGallery}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       AutomationProperties.Name="{DynamicResource Loc.Health.Artwork.ChooseCanonicalAutomation}">
                                <ListBox.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel />
                                  </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                  <DataTemplate>
                                    <StackPanel Width="180"
                                                Margin="4"
                                                Spacing="4">
                                      <Border Background="{DynamicResource AppPanelBrush}"
                                              CornerRadius="6"
                                              Padding="8">
                                        <Image Source="{Binding ImageSource}"
                                               Width="168"
                                               Height="168"
                                               Stretch="Uniform"
                                               Tag="{Binding}"
                                               AttachedToVisualTree="OnArtworkCandidateAttached" />
                                      </Border>
                                      <TextBlock Text="{Binding Label}"
                                                 FontWeight="SemiBold"
                                                 TextTrimming="CharacterEllipsis" />
                                      <TextBlock Classes="muted caption"
                                                 Text="{Binding Details}"
                                                 TextWrapping="Wrap"
                                                 MaxLines="2" />
                                      <TextBlock Classes="warning-text caption"
                                                 Text="{Binding ThumbnailError}"
                                                 TextWrapping="Wrap"
                                                 MaxLines="2"
                                                 IsVisible="{Binding !!ThumbnailError}"
                                                 AutomationProperties.LiveSetting="Polite" />
                                      <controls:LocalizedFormatTextBlock
                                          Classes="muted caption"
                                          ResourceKey="Common.DiagnosticDetailFormat"
                                          Value="{Binding ThumbnailDiagnosticDetail}"
                                          IsVisible="{Binding HasThumbnailDiagnosticDetail}"
                                          TextWrapping="Wrap"
                                          MaxLines="2" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ListBox.ItemTemplate>
                              </ListBox>
                              <Expander>
                                <Expander.Header>
                                  <controls:LocalizedFormatTextBlock
                                      Classes="muted"
                                      FontWeight="SemiBold"
                                      ResourceKey="Health.Artwork.AffectedFiles"
                                      UseCountVariant="True"
                                      Value="{Binding FileCount}" />
                                </Expander.Header>
                                <ItemsControl Margin="8,8,0,0"
                                              ItemsSource="{Binding AffectedPaths}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <TextBlock Text="{Binding Path}"
                                                 TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding Path}" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Expander>
                              <TextBlock Classes="muted"
                                         Text="{Binding ResultText}"
                                         TextWrapping="Wrap" />
                              <controls:LocalizedFormatTextBlock
                                  Classes="muted"
                                  ResourceKey="Common.DiagnosticDetailFormat"
                                  Value="{Binding ResultDiagnosticDetail}"
                                  IsVisible="{Binding HasResultDiagnosticDetail}"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                          </ScrollViewer>
                        </Border>
                      </Grid>
                      <TextBlock Classes="muted" IsVisible="{Binding !HasArtworkRepairResults}"
                                 Text="{DynamicResource Loc.Health.Artwork.Empty}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                  </controls:PersistedSplitView.Right>
                </controls:PersistedSplitView>
              </Grid>
            </TabItem>
          </TabControl>
          </Grid>
          <StackPanel IsVisible="{Binding !HasRuns}" Spacing="12"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <TextBlock Classes="section-title" Text="{DynamicResource Loc.Health.NoSelection.Title}" TextAlignment="Center" />
            <TextBlock Classes="muted" Text="{DynamicResource Loc.Health.NoSelection.Description}"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
          </StackPanel>
          </Grid>
        </Border>
      </controls:PersistedSplitView.Right>
    </controls:PersistedSplitView>
  </controls:AdaptivePage>
</UserControl>
