<UserControl x:Class="MusicLibraryManager.Views.DevicesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid Margin="26,22,26,26" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <controls:PageHeader Title="{DynamicResource Loc.Devices.Title}"
        Subtitle="{DynamicResource Loc.Devices.Subtitle}">
      <controls:PageHeader.Actions>
        <WrapPanel>
          <Button Classes="app" Content="{DynamicResource Loc.Devices.Action.Initialize}" Command="{Binding InitializeCommand}" />
          <Button Classes="app" Margin="8,0,0,0" Content="{DynamicResource Loc.Common.Preview}" Command="{Binding PreviewCommand}" />
          <Button Classes="app primary" Margin="8,0,0,0" Content="{DynamicResource Loc.Common.Apply}" Command="{Binding ApplyCommand}" />
          <Button x:Name="RestoreButton" Classes="app" Margin="8,0,0,0" Content="{DynamicResource Loc.Devices.Action.Restore}" Command="{Binding RestoreCommand}" />
          <Button Classes="app"
                  Margin="8,0,0,0"
                  Content="{DynamicResource Loc.Common.Cancel}"
                  Command="{Binding CancelCommand}"
                  IsVisible="{Binding IsBusy}" />
        </WrapPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Border Grid.Row="1" Classes="status-banner info" AutomationProperties.LiveSetting="Polite">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Classes="status-icon" Text="i" AutomationProperties.Name="{DynamicResource Loc.Devices.InformationAutomation}" />
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
          <TextBlock Classes="faint"
                     Text="{Binding DiagnosticDetail}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasDiagnosticDetail}" />
        </StackPanel>
        <controls:LocalizedFormatTextBlock
            Grid.Column="2"
            Classes="summary-label"
            ResourceKey="Devices.PlannedCount"
            UseCountVariant="True"
            Value="{Binding Actions.Count}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="360,14,*">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ConfigurationPanel" Spacing="10"
                    IsEnabled="{Binding IsConfigurationEnabled}">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="section-title" Text="{DynamicResource Loc.Devices.MirrorProfile}" />
              <TextBlock Classes="muted" Text="{DynamicResource Loc.Devices.AndroidDevice}" FontSize="12" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox x:Name="DeviceSelector" Classes="app"
                          ItemsSource="{Binding AvailableDevices}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          AutomationProperties.Name="{DynamicResource Loc.Devices.AndroidDevice}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="{Binding Details}" FontSize="12" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="RefreshDevicesButton" Grid.Column="1" Classes="app"
                        Content="{DynamicResource Loc.Common.Refresh}" Command="{Binding RefreshDevicesCommand}"
                        AutomationProperties.Name="{DynamicResource Loc.Devices.RefreshAutomation}" />
              </Grid>
              <ProgressBar Classes="app" IsIndeterminate="True" IsVisible="{Binding IsLoadingDevices}"
                           AutomationProperties.Name="{DynamicResource Loc.Devices.DiscoveringAutomation}" />
              <Border Classes="status-banner error" IsVisible="{Binding HasDeviceEnumerationError}"
                      AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="status-icon" Text="!" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{DynamicResource Loc.Devices.DeviceDiscoveryFailed}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeviceEnumerationError}" TextWrapping="Wrap" />
                    <TextBlock Classes="faint"
                               Text="{Binding DeviceEnumerationDiagnosticDetail}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasDeviceEnumerationDiagnosticDetail}" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="status-banner info" IsVisible="{Binding HasNoEnumeratedDevices}"
                      AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="status-icon" Text="i" />
                  <TextBlock Grid.Column="1" Text="{DynamicResource Loc.Devices.NoDevices}"
                             TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Border Classes="status-banner warning" IsVisible="{Binding NeedsDeviceSelection}"
                      AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="status-icon" Text="!" />
                  <TextBlock Grid.Column="1"
                             Text="{DynamicResource Loc.Devices.MultipleReady}"
                             TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Border Classes="status-banner warning" IsVisible="{Binding IsSelectedDeviceUnavailable}"
                      AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="status-icon" Text="!" />
                  <TextBlock Grid.Column="1" Text="{DynamicResource Loc.Devices.Unavailable}"
                             TextWrapping="Wrap" />
                </Grid>
              </Border>
              <StackPanel Spacing="4" IsVisible="{Binding IsManualDeviceSelected}">
                <TextBlock Classes="muted" Text="{DynamicResource Loc.Devices.DeviceSerialOptional}" FontSize="12" FontWeight="SemiBold" />
                <TextBox x:Name="ManualDeviceSerial" Classes="app" Text="{Binding DeviceSerial, Mode=TwoWay}"
                         PlaceholderText="{DynamicResource Loc.Devices.DeviceSerialPlaceholder}"
                         AutomationProperties.Name="{DynamicResource Loc.Devices.DeviceSerial}" />
              </StackPanel>
              <TextBlock Classes="muted" Text="{DynamicResource Loc.Devices.LocalSource}" FontSize="12" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Classes="app" Text="{Binding SourcePath, Mode=TwoWay}" PlaceholderText="{DynamicResource Loc.Devices.LocalSourcePlaceholder}" AutomationProperties.Name="{DynamicResource Loc.Devices.LocalSourceAutomation}" />
                <Button Grid.Column="1" Classes="app" Content="{DynamicResource Loc.Common.Browse}" Command="{Binding BrowseSourceCommand}" />
              </Grid>
              <TextBlock Classes="muted" Text="{DynamicResource Loc.Devices.AndroidDestination}" FontSize="12" FontWeight="SemiBold" />
              <TextBox Classes="app" Text="{Binding DestinationPath, Mode=TwoWay}"
                       PlaceholderText="music or /storage/…/Music" AutomationProperties.Name="{DynamicResource Loc.Devices.AndroidDestination}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="{DynamicResource Loc.Devices.DestinationAliasDescription}" />
              <TextBlock Classes="muted" Text="{DynamicResource Loc.Devices.AdbOverride}" FontSize="12" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Classes="app" Text="{Binding AdbPath, Mode=TwoWay}" PlaceholderText="{DynamicResource Loc.Devices.AdbOverridePlaceholder}" AutomationProperties.Name="{DynamicResource Loc.Devices.AdbOverrideAutomation}" />
                <Button Grid.Column="1" Classes="app" Content="{DynamicResource Loc.Common.Browse}" Command="{Binding BrowseAdbCommand}" />
              </Grid>
              <Border Classes="status-banner warning">
                <StackPanel Spacing="5">
                  <TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc.Devices.ExistingDestination}" />
                  <CheckBox Content="{DynamicResource Loc.Devices.AdoptExisting}" IsChecked="{Binding Adopt, Mode=TwoWay}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="{DynamicResource Loc.Devices.AdoptDescription}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="section-title" Text="{DynamicResource Loc.Devices.Policy}" />
              <Border Classes="status-banner warning">
                <StackPanel Spacing="6">
                  <TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc.Devices.DeletionRecovery}" />
                  <CheckBox Content="{DynamicResource Loc.Devices.DeleteExtras}" IsChecked="{Binding DeleteExtras, Mode=TwoWay}" />
                  <CheckBox Content="{DynamicResource Loc.Devices.DirectTransfer}" IsChecked="{Binding Direct, Mode=TwoWay}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="{DynamicResource Loc.Devices.DirectTransferDescription}" />
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Classes="muted" Text="{DynamicResource Loc.Devices.MaximumRemovals}" FontSize="12" FontWeight="SemiBold" />
                  <NumericUpDown Classes="app" Minimum="0" Value="{Binding MaxRemovals, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc.Devices.MaximumRemovals}" />
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="{DynamicResource Loc.Devices.MaximumRemovalsDescription}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="muted" Text="{DynamicResource Loc.Devices.MtimeTolerance}" FontSize="12" FontWeight="SemiBold" />
                  <NumericUpDown Classes="app" Minimum="0" Value="{Binding MtimeToleranceSeconds, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc.Devices.MtimeToleranceAutomation}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="muted" Text="{DynamicResource Loc.Devices.ExclusionGlobs}" FontSize="12" FontWeight="SemiBold" />
              <TextBox Classes="app" Text="{Binding Exclusions, Mode=TwoWay}" AcceptsReturn="True"
                       MinHeight="88" PlaceholderText="**/*.tmp" AutomationProperties.Name="{DynamicResource Loc.Devices.ExclusionGlobsAutomation}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="10">
        <ItemsControl ItemsSource="{Binding Issues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="status-banner info" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="status-icon" Text="i" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    <TextBlock Classes="faint" Text="{Binding DiagnosticDetail}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
          <Grid>
            <controls:AppDataGrid x:Name="ActionsGrid" ItemsSource="{Binding Actions}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                        IsVisible="{Binding IsActionListEmpty}" MaxWidth="420">
              <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource Loc.Devices.NoActions.Title}" />
              <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                         Text="{DynamicResource Loc.Devices.NoActions.Description}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
