<UserControl x:Class="MusicLibraryManager.Views.DevicesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid Margin="26,22,26,26" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <controls:PageHeader Title="Devices"
        Subtitle="Mirror a local music folder into a verified, managed Android destination over ADB.">
      <controls:PageHeader.Actions>
        <WrapPanel>
          <Button Classes="app" Content="Initialize" Command="{Binding InitializeCommand}" />
          <Button Classes="app" Margin="8,0,0,0" Content="Preview" Command="{Binding PreviewCommand}" />
          <Button Classes="app primary" Margin="8,0,0,0" Content="Apply" Command="{Binding ApplyCommand}" />
          <Button x:Name="RestoreButton" Classes="app" Margin="8,0,0,0" Content="Restore" Command="{Binding RestoreCommand}" />
          <Button Classes="app" Margin="8,0,0,0" Content="Cancel" Command="{Binding CancelCommand}" />
        </WrapPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Border Grid.Row="1" Classes="status-banner info" AutomationProperties.LiveSetting="Polite">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Classes="status-icon" Text="i" AutomationProperties.Name="Information" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="2" Classes="summary-label"
                   Text="{Binding Actions.Count, StringFormat={}{0} planned}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="360,14,*">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ConfigurationPanel" Spacing="10"
                    IsEnabled="{Binding IsConfigurationEnabled}">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="section-title" Text="Mirror profile" />
              <TextBlock Classes="muted" Text="Android device" FontSize="12" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox x:Name="DeviceSelector" Classes="app"
                          ItemsSource="{Binding AvailableDevices}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          AutomationProperties.Name="Android device">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="{Binding Details}" FontSize="12" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="RefreshDevicesButton" Grid.Column="1" Classes="app"
                        Content="Refresh" Command="{Binding RefreshDevicesCommand}"
                        AutomationProperties.Name="Refresh Android devices" />
              </Grid>
              <ProgressBar Classes="app" IsIndeterminate="True" IsVisible="{Binding IsLoadingDevices}"
                           AutomationProperties.Name="Discovering Android devices" />
              <Border Classes="status-banner error" IsVisible="{Binding HasDeviceEnumerationError}"
                      AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="status-icon" Text="!" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Device discovery failed" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeviceEnumerationError}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="status-banner info" IsVisible="{Binding HasNoEnumeratedDevices}"
                      AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="status-icon" Text="i" />
                  <TextBlock Grid.Column="1" Text="No Android devices were reported by ADB. Connect a device or enter its serial manually."
                             TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Border Classes="status-banner warning" IsVisible="{Binding NeedsDeviceSelection}"
                      AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="status-icon" Text="!" />
                  <TextBlock Grid.Column="1"
                             Text="More than one ready device is connected. Choose one above or enter a device serial before synchronizing."
                             TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Border Classes="status-banner warning" IsVisible="{Binding IsSelectedDeviceUnavailable}"
                      AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="status-icon" Text="!" />
                  <TextBlock Grid.Column="1" Text="This device is unavailable. Authorize or reconnect it, then refresh before synchronizing."
                             TextWrapping="Wrap" />
                </Grid>
              </Border>
              <StackPanel Spacing="4" IsVisible="{Binding IsManualDeviceSelected}">
                <TextBlock Classes="muted" Text="Device serial (optional)" FontSize="12" FontWeight="SemiBold" />
                <TextBox x:Name="ManualDeviceSerial" Classes="app" Text="{Binding DeviceSerial, Mode=TwoWay}"
                         PlaceholderText="Auto-select the only ready device"
                         AutomationProperties.Name="Device serial" />
              </StackPanel>
              <TextBlock Classes="muted" Text="Local source" FontSize="12" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Classes="app" Text="{Binding SourcePath, Mode=TwoWay}" PlaceholderText="Local music folder" AutomationProperties.Name="Local music source folder" />
                <Button Grid.Column="1" Classes="app" Content="Browse" Command="{Binding BrowseSourceCommand}" />
              </Grid>
              <TextBlock Classes="muted" Text="Android destination" FontSize="12" FontWeight="SemiBold" />
              <TextBox Classes="app" Text="{Binding DestinationPath, Mode=TwoWay}"
                       PlaceholderText="music or /storage/…/Music" AutomationProperties.Name="Android destination" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="The ‘music’ alias selects removable SD storage only. Use /sdcard/Music for internal shared storage." />
              <TextBlock Classes="muted" Text="ADB executable override (optional)" FontSize="12" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Classes="app" Text="{Binding AdbPath, Mode=TwoWay}" PlaceholderText="Auto-detect adb" AutomationProperties.Name="ADB executable override" />
                <Button Grid.Column="1" Classes="app" Content="Browse" Command="{Binding BrowseAdbCommand}" />
              </Grid>
              <Border Classes="status-banner warning">
                <StackPanel Spacing="5">
                  <TextBlock FontWeight="SemiBold" Text="Existing destination" />
                  <CheckBox Content="Adopt an existing non-empty destination" IsChecked="{Binding Adopt, Mode=TwoWay}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Adoption trusts the current destination contents and includes them in the first synchronization preview." />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="section-title" Text="Policy" />
              <Border Classes="status-banner warning">
                <StackPanel Spacing="6">
                  <TextBlock FontWeight="SemiBold" Text="Deletion and recovery" />
                  <CheckBox Content="Delete destination-only entries" IsChecked="{Binding DeleteExtras, Mode=TwoWay}" />
                  <CheckBox Content="Direct transfer (advanced; no staging or recovery)" IsChecked="{Binding Direct, Mode=TwoWay}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Direct transfer is faster but cannot be restored. Preview and review the final confirmation carefully." />
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Classes="muted" Text="Maximum removals" FontSize="12" FontWeight="SemiBold" />
                  <NumericUpDown Classes="app" Minimum="0" Value="{Binding MaxRemovals, Mode=TwoWay}" AutomationProperties.Name="Maximum removals" />
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="Blank allows any number; 0 allows none." />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="muted" Text="Mtime tolerance (sec)" FontSize="12" FontWeight="SemiBold" />
                  <NumericUpDown Classes="app" Minimum="0" Value="{Binding MtimeToleranceSeconds, Mode=TwoWay}" AutomationProperties.Name="Modification time tolerance in seconds" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="muted" Text="Exclusion globs (one per line)" FontSize="12" FontWeight="SemiBold" />
              <TextBox Classes="app" Text="{Binding Exclusions, Mode=TwoWay}" AcceptsReturn="True"
                       MinHeight="88" PlaceholderText="**/*.tmp" AutomationProperties.Name="Exclusion globs" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="10">
        <ItemsControl ItemsSource="{Binding Issues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="status-banner info" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="status-icon" Text="i" />
                  <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
          <Grid>
            <controls:AppDataGrid x:Name="ActionsGrid" ItemsSource="{Binding Actions}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                        IsVisible="{Binding IsActionListEmpty}" MaxWidth="420">
              <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No synchronization actions" />
              <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                         Text="Configure the destination and run Preview to compare it with the local source." />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
