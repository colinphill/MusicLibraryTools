<UserControl x:Class="MusicLibraryManager.Views.SelectionInspectorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Styles>
    <Style Selector="Border.artwork-preview-target:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    </Style>
    <Style Selector="Border.artwork-preview-target:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Grid Margin="12,10,10,0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel>
        <TextBlock Classes="faint" Text="SELECTION" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Classes="muted" Text="{Binding UnsavedChangesSummary}"
                   IsVisible="{Binding HasUnsavedChanges}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="app" Width="30" Height="30" Padding="0" Content="&#x2715;"
              Click="OnClose" ToolTip.Tip="Close inspector" AutomationProperties.Name="Close inspector" />
    </Grid>

    <Border x:Name="EmptyState" Grid.Row="1" IsVisible="{Binding !HasSelection}" Padding="24">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="240">
        <TextBlock Text="No selection" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="Select one or more tracks to inspect metadata and artwork."
                   TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer x:Name="InspectorContent" Grid.Row="1" IsVisible="{Binding HasSelection}"
                  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12" Spacing="10">
        <TextBlock Classes="section-title" Text="{Binding SelectionSummary}" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="muted" Text="{Binding Overview}" TextWrapping="Wrap" />
        <ProgressBar Classes="app" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
        <Border Height="1" Background="{DynamicResource AppBorderBrush}" />

        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,10" Spacing="5">
                <TextBlock Classes="muted" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                <TextBox Classes="app" Text="{Binding Value, Mode=TwoWay}"
                         PlaceholderText="{Binding PlaceholderText}"
                         AutomationProperties.Name="{Binding Label}"
                         AutomationProperties.HelpText="{Binding VerificationMessage}" />
                <TextBlock Classes="warning" FontSize="12" IsVisible="{Binding IsUnverified}"
                           Text="Current value not verified across all selected tracks."
                           TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="status-banner" Classes.info="{Binding IsStatusInfo}"
                Classes.success="{Binding IsStatusSuccess}"
                Classes.warning="{Binding IsStatusWarning}"
                Classes.error="{Binding IsStatusError}"
                IsVisible="{Binding HasStatusMessage}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Classes="status-icon" Text="{Binding StatusIcon}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </Grid>
        </Border>
        <WrapPanel>
          <Button Classes="app primary" Margin="0,0,8,6" Content="Save tags" Command="{Binding SaveTagsCommand}" />
          <Button Classes="app" Margin="0,0,8,6" Content="All fields..." Command="{Binding EditAllFieldsCommand}" />
          <Button Classes="app" Margin="0,0,8,6" Content="Revert" Command="{Binding RevertCommand}" />
        </WrapPanel>

        <Border Height="1" Background="{DynamicResource AppBorderBrush}" />
        <TextBlock Classes="section-title" Text="Artwork" />
        <TextBlock Classes="muted" Text="{Binding ArtworkSummary}" TextWrapping="Wrap" />
        <Border Height="220" CornerRadius="10" Background="{DynamicResource AppInsetBrush}"
                IsVisible="{Binding IsArtworkMixed}">
          <TextBlock Classes="muted" Text="Mixed artwork" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ItemsControl ItemsSource="{Binding ArtworkItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Padding="8" Margin="0,0,0,10">
                <StackPanel Spacing="7">
                  <Border Classes="artwork-preview-target" Height="220" CornerRadius="10"
                          Background="{DynamicResource AppInsetBrush}" BorderBrush="Transparent"
                          BorderThickness="2" ClipToBounds="True" Focusable="True" Cursor="Hand"
                          Tag="{Binding}" DoubleTapped="OnArtworkDoubleTapped" KeyDown="OnArtworkKeyDown"
                          ToolTip.Tip="Double-click or press Enter to open the full-size artwork"
                          AutomationProperties.Name="Artwork preview"
                          AutomationProperties.HelpText="Double-click or press Enter to open full size.">
                    <Image Source="{Binding Source}" Stretch="Uniform" IsHitTestVisible="False" />
                  </Border>
                  <TextBlock Classes="muted" Text="Artwork type" FontSize="12" FontWeight="SemiBold" />
                  <ComboBox Classes="app"
                            ItemsSource="{Binding DataContext.ArtworkTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            SelectedItem="{Binding Type, Mode=TwoWay}"
                            AutomationProperties.Name="Artwork type" />
                  <TextBlock Classes="muted" Text="Description" FontSize="12" FontWeight="SemiBold" />
                  <TextBox Classes="app" Text="{Binding Description, Mode=TwoWay}"
                           PlaceholderText="Optional description" AutomationProperties.Name="Artwork description" />
                  <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Classes="app" Margin="0,0,8,6" Content="Save to file..." Tag="{Binding}"
                            Click="OnSaveArtwork" AutomationProperties.Name="Save artwork to file" />
                    <Button Classes="app" Margin="0,0,8,6" Content="Replace this artwork..." Tag="{Binding}" Click="OnReplaceArtwork" />
                  </WrapPanel>
                  <Button Classes="app danger" Content="Remove this artwork" Tag="{Binding}" Click="OnRemoveArtwork" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted" Text="Maximum dimension" FontSize="12" FontWeight="SemiBold" />
        <NumericUpDown Classes="app" Minimum="64" Value="{Binding ArtworkMaxDimension, Mode=TwoWay}"
                       AutomationProperties.Name="Maximum artwork dimension" />
        <WrapPanel>
          <Button Classes="app" Margin="0,0,8,6" Content="Add artwork..." Command="{Binding AddArtworkCommand}" />
          <Button Classes="app" Margin="0,0,8,6" Content="Optimize" Command="{Binding ScrubArtworkCommand}" />
          <Button Classes="app danger" Margin="0,0,8,6" Content="Remove all" Command="{Binding RemoveArtworkCommand}" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
