<UserControl x:Class="MusicLibraryManager.Views.OperationsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid Margin="26,22,26,26" RowDefinitions="Auto,*" RowSpacing="14">
    <controls:PageHeader Title="{DynamicResource Loc.Operations.Title}"
        Subtitle="{DynamicResource Loc.Operations.Subtitle}">
      <controls:PageHeader.Actions>
        <Button Classes="app" Content="{DynamicResource Loc.Common.Cancel}" Command="{Binding CancelCommand}"
                IsVisible="{Binding IsBusy}" />
      </controls:PageHeader.Actions>
    </controls:PageHeader>
    <Border Grid.Row="1" Classes="card" Padding="12" ClipToBounds="True">
      <TabControl>
        <TabItem Header="{DynamicResource Loc.Operations.Tab.Jobs}">
          <Grid Margin="0,12,0,0" ColumnDefinitions="330,14,*">
            <ListBox Grid.Column="0" Classes="primary-list" ItemsSource="{Binding JobChoices}" SelectedItem="{Binding SelectedJobChoice, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Background="Transparent" Padding="11" Margin="0,0,0,6">
                    <StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" /></StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="6" Spacing="10">
                <TextBlock Classes="section-title" Text="{Binding SelectedJobChoice.Name}" />
                <TextBlock Classes="muted" Text="{Binding SelectedJobChoice.Description}" TextWrapping="Wrap" />
                <StackPanel Spacing="5" IsVisible="{Binding ShowPlaylistName}"><TextBlock Classes="muted" Text="{DynamicResource Loc.Operations.PlaylistName}" FontSize="12" FontWeight="SemiBold" /><TextBox Classes="app" Text="{Binding JobPlaylistName, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc.Operations.PlaylistName}" /></StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowDestinationPath}"><TextBox Classes="app" Text="{Binding JobDestinationPath, Mode=TwoWay}" PlaceholderText="{DynamicResource Loc.Operations.Destination}" AutomationProperties.Name="{DynamicResource Loc.Operations.JobDestinationAutomation}" /><Button Grid.Column="1" Classes="app" Content="{DynamicResource Loc.Common.Browse}" Command="{Binding BrowseJobDestinationCommand}" /></Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowValidationPath}"><TextBox Classes="app" Text="{Binding JobValidationPath, Mode=TwoWay}" PlaceholderText="{DynamicResource Loc.Operations.ValidationPath}" AutomationProperties.Name="{DynamicResource Loc.Operations.ValidationPath}" /><Button Grid.Column="1" Classes="app" Content="{DynamicResource Loc.Common.Browse}" Command="{Binding BrowseJobValidationCommand}" /></Grid>
                <StackPanel Spacing="5" IsVisible="{Binding ShowRemovalLimit}"><TextBlock Classes="muted" Text="{DynamicResource Loc.Operations.MaximumRemovals}" FontSize="12" FontWeight="SemiBold" /><NumericUpDown Classes="app" Minimum="0" Value="{Binding JobMaxRemovals, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc.Operations.MaximumRemovals}" /></StackPanel>
                <WrapPanel>
                  <CheckBox Margin="0,0,14,6" Content="{DynamicResource Loc.Operations.Initialize}" IsChecked="{Binding JobInitialize, Mode=TwoWay}" IsVisible="{Binding ShowInitialize}" />
                  <CheckBox Margin="0,0,14,6" Content="{DynamicResource Loc.Operations.Rebalance}" IsChecked="{Binding JobRebalance, Mode=TwoWay}" IsVisible="{Binding ShowRebalance}" />
                  <CheckBox Margin="0,0,14,6" Content="{DynamicResource Loc.Operations.FixErrors}" IsChecked="{Binding JobFixErrors, Mode=TwoWay}" IsVisible="{Binding ShowFixErrors}" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="app" Content="{DynamicResource Loc.Common.Preview}" Command="{Binding PreviewJobCommand}" /><Button Classes="app primary" Content="{DynamicResource Loc.Operations.Action.ApplyJob}" Command="{Binding ApplyJobCommand}" IsVisible="{Binding ShowJobApply}" /></StackPanel>
                <Border Classes="status-banner info" AutomationProperties.LiveSetting="Polite">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Classes="status-icon" Text="i" />
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="{Binding JobStatus}" TextWrapping="Wrap" />
                      <controls:LocalizedFormatTextBlock
                          Classes="muted"
                          ResourceKey="Common.DiagnosticDetailFormat"
                          Value="{Binding JobStatusDiagnosticDetail}"
                          IsVisible="{Binding HasJobStatusDiagnosticDetail}"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBox Classes="app" Text="{Binding JobOutput}" AcceptsReturn="True" IsReadOnly="True" MinHeight="220" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Loc.Operations.JobOutputAutomation}" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <TabItem Header="{DynamicResource Loc.Operations.Tab.History}">
          <controls:AppDataGrid x:Name="HistoryGrid" Margin="0,12,0,0" ItemsSource="{Binding JobHistory}" />
        </TabItem>

        <TabItem Header="{DynamicResource Loc.Operations.Tab.Recovery}">
          <Grid Margin="0,12,0,0" ColumnDefinitions="0.7*,14,1.3*">
            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox Classes="app" Text="{Binding SearchRoot, Mode=TwoWay}" PlaceholderText="{DynamicResource Loc.Operations.Recovery.SearchRoot}" AutomationProperties.Name="{DynamicResource Loc.Operations.Recovery.SearchRootAutomation}" /><Button Grid.Column="1" Classes="app" Content="{DynamicResource Loc.Common.Browse}" Command="{Binding BrowseRootCommand}" /><Button Grid.Column="2" Classes="app" Content="{DynamicResource Loc.Common.Scan}" Command="{Binding RefreshCommand}" /></Grid>
              <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate><DataTemplate><Border Classes="card" Padding="11" Margin="0,0,0,6"><StackPanel Spacing="3"><TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{Binding State}" /><TextBlock Classes="faint" Text="{Binding Created}" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding IsRunListEmpty}" MaxWidth="300">
                  <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource Loc.Operations.Recovery.EmptyTitle}" />
                  <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                             Text="{DynamicResource Loc.Operations.Recovery.EmptyDescription}" />
                </StackPanel>
              </Grid>
            </Grid>
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
              <WrapPanel>
                <Button Classes="app" Margin="0,0,8,6" Content="{DynamicResource Loc.Operations.Action.OpenRun}"
                        Command="{Binding OpenRunCommand}" CommandParameter="{Binding SelectedRun}" />
                <Button Classes="app quiet" Margin="0,0,8,6" Content="{DynamicResource Loc.Operations.Action.SelectRestorable}"
                        Command="{Binding SelectAllRestorableCommand}" />
                <Button Classes="app quiet" Margin="0,0,8,6" Content="{DynamicResource Loc.Operations.Action.ClearSelection}"
                        Command="{Binding ClearRestoreSelectionCommand}" />
              </WrapPanel>
              <ListBox Grid.Row="1" ItemsSource="{Binding RootNodes}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate><DataTemplate><Border Classes="card" Padding="11" Margin="0,0,0,6"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanRestore}" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Classes="summary-label" HorizontalAlignment="Right" Text="{Binding StateText}" /></Grid></Border></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Border Grid.Row="2" Classes="status-banner warning" IsVisible="{Binding ShowRestorePreview}" AutomationProperties.LiveSetting="Polite"><TextBlock Text="{Binding RestorePreviewText}" TextWrapping="Wrap" /></Border>
              <StackPanel Grid.Row="3" Spacing="8">
                <WrapPanel>
                  <Button Classes="app" Margin="0,0,8,6"
                          Content="{DynamicResource Loc.Operations.Action.PreviewRestore}" Command="{Binding PreviewRestoreCommand}" />
                  <Button Classes="app primary" Margin="0,0,8,6"
                          Content="{DynamicResource Loc.Operations.Action.ApplyRestore}" Command="{Binding ApplyRestoreCommand}" />
                </WrapPanel>
                <WrapPanel>
                  <StackPanel Margin="0,0,8,6" Spacing="4">
                    <TextBlock Classes="muted" Text="{DynamicResource Loc.Operations.Recovery.Retention}"
                               FontSize="12" FontWeight="SemiBold" />
                    <NumericUpDown Classes="app" Width="150" Minimum="1"
                                   Value="{Binding RetentionDays, Mode=TwoWay}"
                                   AutomationProperties.Name="{DynamicResource Loc.Operations.Recovery.RetentionAutomation}" />
                  </StackPanel>
                  <Button x:Name="RecoveryMaintenanceButton"
                          Classes="app quiet overflow" Margin="0,0,8,6"
                          VerticalAlignment="Bottom"
                          Content="{DynamicResource Loc.Operations.Action.Maintenance}"
                          AutomationProperties.Name="{DynamicResource Loc.Operations.Action.MaintenanceAutomation}">
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="{DynamicResource Loc.Operations.PreviewRetentionPurge}"
                                  Command="{Binding PreviewPurgeCommand}" />
                        <MenuItem Classes="danger"
                                  Header="{DynamicResource Loc.Operations.PurgeReviewed}"
                                  Command="{Binding ApplyPurgeCommand}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </WrapPanel>
                <StackPanel Spacing="3" AutomationProperties.LiveSetting="Polite">
                  <TextBlock Classes="muted" Text="{Binding StatusText}" TextWrapping="Wrap" />
                  <controls:LocalizedFormatTextBlock
                      Classes="faint"
                      ResourceKey="Common.DiagnosticDetailFormat"
                      Value="{Binding StatusDiagnosticDetail}"
                      IsVisible="{Binding HasStatusDiagnosticDetail}"
                      TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</UserControl>
