<UserControl x:Class="MusicLibraryManager.Views.OperationsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <controls:AdaptivePage RowDefinitions="Auto,*" RowSpacing="16">
    <controls:PageHeader Title="{DynamicResource Loc.Operations.Title}"
        Subtitle="{DynamicResource Loc.Operations.Subtitle}">
      <controls:PageHeader.SecondaryActions>
        <Button Classes="app" Content="{DynamicResource Loc.Common.Cancel}" Command="{Binding CancelCommand}"
                IsVisible="{Binding IsBusy}" />
      </controls:PageHeader.SecondaryActions>
    </controls:PageHeader>
    <Border Grid.Row="1" Classes="card" Padding="12" ClipToBounds="True">
      <TabControl>
        <TabItem Header="{DynamicResource Loc.Operations.Tab.Jobs}">
          <Grid x:Name="JobsLayout"
                Margin="0,12,0,0"
                ColumnDefinitions="300,14,*"
                RowDefinitions="Auto,*"
                RowSpacing="12">
            <ListBox x:Name="JobListPane"
                     Grid.Column="0"
                     Grid.RowSpan="2"
                     Classes="primary-list" ItemsSource="{Binding JobChoices}" SelectedItem="{Binding SelectedJobChoice, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Background="Transparent" Padding="12" Margin="0,0,0,8">
                    <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" /></StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ComboBox x:Name="JobPicker"
                      Grid.Column="2"
                      Classes="app"
                      ItemsSource="{Binding JobChoices}"
                      SelectedItem="{Binding SelectedJobChoice, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Name}"
                      AutomationProperties.Name="{DynamicResource Loc.Operations.Job.PickerAutomation}"
                      IsVisible="False" />
            <ScrollViewer x:Name="JobDetailsScroll"
                          Grid.Row="1"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="8" Spacing="12">
                <TextBlock Classes="section-title" Text="{Binding SelectedJobChoice.Name}" />
                <TextBlock Classes="muted" Text="{Binding SelectedJobChoice.Description}" TextWrapping="Wrap" />
                <StackPanel Classes="field" Spacing="4" IsVisible="{Binding ShowPlaylistName}"><TextBlock Classes="field-label" Text="{DynamicResource Loc.Operations.PlaylistName}" /><TextBox Classes="app" Text="{Binding JobPlaylistName, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc.Operations.PlaylistName}" /></StackPanel>
                <StackPanel Classes="field"
                            IsVisible="{Binding ShowDestinationPath}">
                  <TextBlock Classes="field-label"
                             Text="{DynamicResource Loc.Operations.Destination}" />
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                    <TextBox Classes="app"
                             Text="{Binding JobDestinationPath, Mode=TwoWay}"
                             AutomationProperties.Name="{DynamicResource Loc.Operations.JobDestinationAutomation}" />
                    <Button Grid.Column="1"
                            Classes="app"
                            Content="{DynamicResource Loc.Common.Browse}"
                            Command="{Binding BrowseJobDestinationCommand}" />
                  </Grid>
                </StackPanel>
                <StackPanel Classes="field"
                            IsVisible="{Binding ShowValidationPath}">
                  <TextBlock Classes="field-label"
                             Text="{DynamicResource Loc.Operations.ValidationPath}" />
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                    <TextBox Classes="app"
                             Text="{Binding JobValidationPath, Mode=TwoWay}"
                             AutomationProperties.Name="{DynamicResource Loc.Operations.ValidationPath}" />
                    <Button Grid.Column="1"
                            Classes="app"
                            Content="{DynamicResource Loc.Common.Browse}"
                            Command="{Binding BrowseJobValidationCommand}" />
                  </Grid>
                </StackPanel>
                <StackPanel Classes="field" Spacing="4" IsVisible="{Binding ShowRemovalLimit}"><TextBlock Classes="field-label" Text="{DynamicResource Loc.Operations.MaximumRemovals}" /><NumericUpDown Classes="app" Minimum="0" Value="{Binding JobMaxRemovals, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc.Operations.MaximumRemovals}" /></StackPanel>
                <WrapPanel>
                  <CheckBox Margin="0,0,16,8" Content="{DynamicResource Loc.Operations.Initialize}" IsChecked="{Binding JobInitialize, Mode=TwoWay}" IsVisible="{Binding ShowInitialize}" />
                  <CheckBox Margin="0,0,16,8" Content="{DynamicResource Loc.Operations.Rebalance}" IsChecked="{Binding JobRebalance, Mode=TwoWay}" IsVisible="{Binding ShowRebalance}" />
                  <CheckBox Margin="0,0,16,8" Content="{DynamicResource Loc.Operations.FixErrors}" IsChecked="{Binding JobFixErrors, Mode=TwoWay}" IsVisible="{Binding ShowFixErrors}" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="app" Content="{DynamicResource Loc.Common.Preview}" Command="{Binding PreviewJobCommand}" /><Button Classes="app primary" Content="{DynamicResource Loc.Operations.Action.ApplyJob}" Command="{Binding ApplyJobCommand}" IsVisible="{Binding ShowJobApply}" /></StackPanel>
                <Border Classes="status-banner info" AutomationProperties.LiveSetting="Polite">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <controls:AppVectorIcon Kind="Information" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding JobStatus}" TextWrapping="Wrap" />
                      <controls:LocalizedFormatTextBlock
                          Classes="muted"
                          ResourceKey="Common.DiagnosticDetailFormat"
                          Value="{Binding JobStatusDiagnosticDetail}"
                          IsVisible="{Binding HasJobStatusDiagnosticDetail}"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
                <StackPanel Classes="field"
                            Spacing="4"
                            IsVisible="{Binding HasJobOutput}">
                  <TextBlock Classes="field-label"
                             Text="{DynamicResource Loc.Operations.Job.OutputLabel}" />
                  <TextBox Classes="app"
                           Text="{Binding JobOutput}"
                           AcceptsReturn="True"
                           IsReadOnly="True"
                           MaxHeight="240"
                           TextWrapping="Wrap"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           AutomationProperties.Name="{DynamicResource Loc.Operations.JobOutputAutomation}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <TabItem Header="{DynamicResource Loc.Operations.Tab.History}">
          <controls:AppDataGrid x:Name="HistoryGrid" Margin="0,12,0,0" ItemsSource="{Binding JobHistory}" />
        </TabItem>

        <TabItem Header="{DynamicResource Loc.Operations.Tab.Recovery}">
          <Grid x:Name="RecoveryLayout"
                Margin="0,12,0,0"
                ColumnDefinitions="0.7*,14,1.3*">
            <Grid x:Name="RecoveryRunPane"
                  Grid.Column="0"
                  RowDefinitions="Auto,*"
                  RowSpacing="12">
              <StackPanel Classes="field">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource Loc.Operations.Recovery.SearchRoot}" />
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="8">
                  <TextBox Classes="app"
                           Text="{Binding SearchRoot, Mode=TwoWay}"
                           AutomationProperties.Name="{DynamicResource Loc.Operations.Recovery.SearchRootAutomation}" />
                  <Button Grid.Column="1"
                          Classes="app"
                          Content="{DynamicResource Loc.Common.Browse}"
                          Command="{Binding BrowseRootCommand}" />
                  <Button Grid.Column="2"
                          Classes="app"
                          Content="{DynamicResource Loc.Common.Scan}"
                          Command="{Binding RefreshCommand}" />
                </Grid>
              </StackPanel>
              <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card" Padding="12" Margin="0,0,0,8">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" />
                          <TextBlock Classes="muted" Text="{Binding State}" />
                          <TextBlock Classes="muted"
                                     Text="{Binding ReviewedTransactionDetail}"
                                     IsVisible="{Binding HasReviewedTransaction}" />
                          <TextBlock Classes="faint" Text="{Binding AffectedItems}" />
                          <TextBlock Classes="faint" Text="{Binding Created}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            IsVisible="{Binding IsRunListEmpty}" MaxWidth="300">
                  <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource Loc.Operations.Recovery.EmptyTitle}" />
                  <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                             Text="{DynamicResource Loc.Operations.Recovery.EmptyDescription}" />
                </StackPanel>
              </Grid>
            </Grid>
            <Grid x:Name="RecoveryDetailPane"
                  Grid.Column="2"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="12">
              <Border x:Name="RecoveryMaintenanceBar"
                      Classes="quiet-toolbar">
                <WrapPanel>
                  <StackPanel Margin="0,0,8,8"
                              Classes="field"
                              Spacing="4">
                    <TextBlock Classes="field-label"
                               Text="{DynamicResource Loc.Operations.Recovery.Retention}" />
                    <NumericUpDown Classes="app"
                                   Width="150"
                                   Minimum="1"
                                   Value="{Binding RetentionDays, Mode=TwoWay}"
                                   AutomationProperties.Name="{DynamicResource Loc.Operations.Recovery.RetentionAutomation}" />
                  </StackPanel>
                  <Button x:Name="RecoveryMaintenanceButton"
                          Classes="app quiet overflow"
                          Margin="0,0,8,8"
                          VerticalAlignment="Bottom"
                          Content="{DynamicResource Loc.Operations.Action.Maintenance}"
                          AutomationProperties.Name="{DynamicResource Loc.Operations.Action.MaintenanceAutomation}">
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem x:Name="PreviewRetentionPurgeMenuItem"
                                  Header="{DynamicResource Loc.Operations.PreviewRetentionPurge}"
                                  Command="{Binding PreviewPurgeCommand}" />
                        <MenuItem x:Name="PurgeReviewedMenuItem"
                                  Classes="danger"
                                  Header="{DynamicResource Loc.Operations.PurgeReviewed}"
                                  Command="{Binding ApplyPurgeCommand}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </WrapPanel>
              </Border>
              <ScrollViewer x:Name="RecoveryDetailScroll"
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                  <Grid x:Name="RecoveryCompactSearch"
                        Classes="field"
                        controls:FieldAccessibility.Associate="True"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="4"
                        IsVisible="False">
                    <TextBlock Classes="field-label"
                               Text="{DynamicResource Loc.Operations.Recovery.SearchRoot}" />
                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                      <TextBox Classes="app"
                               Text="{Binding SearchRoot, Mode=TwoWay}"
                               AutomationProperties.Name="{DynamicResource Loc.Operations.Recovery.SearchRootAutomation}" />
                      <Button Grid.Column="1"
                              Classes="app"
                              Content="{DynamicResource Loc.Common.Browse}"
                              Command="{Binding BrowseRootCommand}" />
                      <Button Grid.Column="2"
                              Classes="app"
                              Content="{DynamicResource Loc.Common.Scan}"
                              Command="{Binding RefreshCommand}" />
                    </Grid>
                  </Grid>
                  <ComboBox x:Name="RecoveryRunPicker"
                            Classes="app"
                            ItemsSource="{Binding Runs}"
                            SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                            DisplayMemberBinding="{Binding ToolName}"
                            AutomationProperties.Name="{DynamicResource Loc.Operations.Tab.Recovery}"
                            IsVisible="False" />
                  <Border Classes="quiet-toolbar">
                    <WrapPanel>
                      <Button Classes="app"
                              Margin="0,0,8,8"
                              Content="{DynamicResource Loc.Operations.Action.OpenRun}"
                              Command="{Binding OpenRunCommand}"
                              CommandParameter="{Binding SelectedRun}" />
                      <Button Classes="app quiet"
                              Margin="0,0,8,8"
                              Content="{DynamicResource Loc.Operations.Action.SelectRestorable}"
                              Command="{Binding SelectAllRestorableCommand}" />
                      <Button Classes="app quiet"
                              Margin="0,0,8,8"
                              Content="{DynamicResource Loc.Operations.Action.ClearSelection}"
                              Command="{Binding ClearRestoreSelectionCommand}" />
                    </WrapPanel>
                  </Border>
                  <ItemsControl x:Name="RecoveryEntryList"
                                ItemsSource="{Binding RootNodes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="card"
                                Padding="12"
                                Margin="0,0,0,8">
                          <Grid ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanRestore}"
                                      AutomationProperties.Name="{Binding Name}" />
                            <StackPanel Grid.Column="1"
                                        Spacing="4">
                              <TextBlock Text="{Binding Name}"
                                         FontWeight="SemiBold" />
                              <TextBlock Classes="muted"
                                         Text="{Binding OriginalPath}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="muted"
                                         Text="{Binding RecoveryStorageText}"
                                         IsVisible="{Binding HasRecoveryStorage}"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Classes="summary-label"
                                       HorizontalAlignment="Right"
                                       Text="{Binding StateText}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <Border x:Name="RestoreStickyFooter"
                      Grid.Row="2"
                      Classes="sticky-footer">
                <StackPanel Spacing="8">
                  <Border x:Name="RestorePreviewBanner"
                          Classes="status-banner warning"
                          IsVisible="{Binding ShowRestorePreview}"
                          AutomationProperties.LiveSetting="Polite">
                    <TextBlock Text="{Binding RestorePreviewText}"
                               TextWrapping="Wrap"
                               MaxLines="3" />
                  </Border>
                  <WrapPanel>
                    <Button x:Name="PreviewRestoreButton"
                            Classes="app"
                            Margin="0,0,8,8"
                            Content="{DynamicResource Loc.Operations.Action.PreviewRestore}"
                            Command="{Binding PreviewRestoreCommand}" />
                    <Button x:Name="ApplyRestoreButton"
                            Classes="app primary"
                            Margin="0,0,8,8"
                            Content="{DynamicResource Loc.Operations.Action.ApplyRestore}"
                            Command="{Binding ApplyRestoreCommand}" />
                  </WrapPanel>
                  <StackPanel Spacing="4"
                              IsVisible="{Binding !ShowRestorePreview}"
                              AutomationProperties.LiveSetting="Polite">
                    <TextBlock Classes="muted"
                               Text="{Binding StatusText}"
                               TextWrapping="Wrap"
                               MaxLines="3" />
                    <controls:LocalizedFormatTextBlock
                        Classes="faint"
                        ResourceKey="Common.DiagnosticDetailFormat"
                        Value="{Binding StatusDiagnosticDetail}"
                        IsVisible="{Binding HasStatusDiagnosticDetail}"
                        TextWrapping="Wrap"
                        MaxLines="3" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>
    </Border>
  </controls:AdaptivePage>
</UserControl>
