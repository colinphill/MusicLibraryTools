<UserControl x:Class="MusicLibraryManager.Views.FieldsEditorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12" MinHeight="400">
    <UniformGrid x:Name="FieldAdditionChoices" Columns="2">
      <Border Classes="card" Margin="0,0,8,0" Padding="12">
        <StackPanel Classes="field" Spacing="8">
          <TextBlock FontWeight="SemiBold"
                     Text="{DynamicResource Loc.FieldsEditor.AddField}" />
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.FieldsEditor.FieldToAddAutomation}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox Classes="app"
                      ItemsSource="{Binding AddableFieldChoices}"
                      SelectedValue="{Binding FieldToAdd, Mode=TwoWay}"
                      SelectedValueBinding="{Binding Value}"
                      DisplayMemberBinding="{Binding Label}"
                      AutomationProperties.Name="{DynamicResource Loc.FieldsEditor.FieldToAddAutomation}" />
            <Button Grid.Column="1"
                    Classes="app"
                    Content="{DynamicResource Loc.FieldsEditor.AddField}"
                    Command="{Binding AddFieldCommand}" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="8,0,0,0" Padding="12">
        <StackPanel Classes="field" Spacing="8">
          <TextBlock FontWeight="SemiBold"
                     Text="{DynamicResource Loc.FieldsEditor.AddUserString}" />
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.FieldsEditor.UserStringName}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Classes="app"
                     Text="{Binding NewUserStringName, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Loc.FieldsEditor.UserStringName}"
                     AutomationProperties.Name="{DynamicResource Loc.FieldsEditor.UserStringName}" />
            <Button Grid.Column="1"
                    Classes="app"
                    Content="{DynamicResource Loc.FieldsEditor.AddUserString}"
                    Command="{Binding AddUserStringCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </UniformGrid>
    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Classes="field"
                controls:FieldAccessibility.Associate="True"
                MinHeight="50"
                Margin="12,8"
                ColumnDefinitions="180,*,Auto"
                ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center"><TextBlock Classes="field-label" Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Classes="faint" Text="{Binding Kind}" /></StackPanel>
            <TextBox Grid.Column="1" Classes="app"
                     Text="{Binding Value, Mode=TwoWay}"
                     IsEnabled="{Binding !MarkedForRemoval}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="38"
                 PlaceholderText="{DynamicResource Loc.FieldsEditor.MixedValuesPlaceholder}"
                     AutomationProperties.Name="{Binding Name}" />
            <Button Grid.Column="2" Classes="app danger" Content="{Binding RemoveButtonText}" Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="2" Classes="status-banner"
            Classes.info="{Binding IsStatusInfo}"
            Classes.success="{Binding IsStatusSuccess}"
            Classes.warning="{Binding IsStatusWarning}"
            Classes.error="{Binding IsStatusError}"
            IsVisible="{Binding HasStatusMessage}" AutomationProperties.LiveSetting="Polite">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Classes="status-icon" Text="{Binding StatusIcon}" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          <TextBlock Classes="faint"
                     Text="{Binding DiagnosticDetail}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasDiagnosticDetail}" />
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="app" Classes.primary="{Binding IsConfirmingCancel}"
              Classes.danger="{Binding IsConfirmingCancel}"
              Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" />
      <Button Classes="app primary" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
              IsVisible="{Binding !IsConfirmingCancel}" />
    </StackPanel>
  </Grid>
</UserControl>
