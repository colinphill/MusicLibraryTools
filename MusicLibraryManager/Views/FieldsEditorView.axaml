<UserControl x:Class="MusicLibraryManager.Views.FieldsEditorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10" MinHeight="400">
    <Grid ColumnDefinitions="180,Auto,*,Auto" ColumnSpacing="8">
      <ComboBox Classes="app" ItemsSource="{Binding AddableFields}" SelectedItem="{Binding FieldToAdd, Mode=TwoWay}" AutomationProperties.Name="Metadata field to add" />
      <Button Grid.Column="1" Classes="app" Content="Add field" Command="{Binding AddFieldCommand}" />
      <TextBox Grid.Column="2" Classes="app" Text="{Binding NewUserStringName, Mode=TwoWay}" PlaceholderText="User-string name" AutomationProperties.Name="User-string name" />
      <Button Grid.Column="3" Classes="app" Content="Add user string" Command="{Binding AddUserStringCommand}" />
    </Grid>
    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="9">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid MinHeight="50" Margin="9,6" ColumnDefinitions="180,*,Auto" ColumnSpacing="10">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Classes="faint" Text="{Binding Kind}" /></StackPanel>
            <TextBox Grid.Column="1" Classes="app"
                     Text="{Binding Value, Mode=TwoWay}"
                     IsEnabled="{Binding !MarkedForRemoval}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="38"
                     PlaceholderText="Mixed values; one value per line"
                     AutomationProperties.Name="{Binding Name}" />
            <Button Grid.Column="2" Classes="app danger" Content="{Binding RemoveButtonText}" Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="2" Classes="status-banner"
            Classes.info="{Binding IsStatusInfo}"
            Classes.success="{Binding IsStatusSuccess}"
            Classes.warning="{Binding IsStatusWarning}"
            Classes.error="{Binding IsStatusError}"
            IsVisible="{Binding HasStatusMessage}" AutomationProperties.LiveSetting="Polite">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Classes="status-icon" Text="{Binding StatusIcon}" />
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      </Grid>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="app" Classes.primary="{Binding IsConfirmingCancel}"
              Classes.danger="{Binding IsConfirmingCancel}"
              Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" />
      <Button Classes="app primary" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
              IsVisible="{Binding !IsConfirmingCancel}" />
    </StackPanel>
  </Grid>
</UserControl>
