<UserControl x:Class="MusicLibraryManager.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <UserControl.Styles>
    <Style Selector="ScrollViewer.settings-scroll">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="StackPanel.settings-content">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MaxWidth" Value="1040" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.theme-option">
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>
  <Grid Margin="26,22,26,26" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <controls:PageHeader Title="Settings"
        Subtitle="Configure libraries, playlists, ingest tools, and application appearance.">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="muted" Text="Unsaved changes" IsVisible="{Binding HasUnsavedChanges}" VerticalAlignment="Center" />
          <Button Classes="app primary" Content="Save" Command="{Binding SaveConfigurationCommand}" />
          <Button Classes="app" Content="Save as" Command="{Binding SaveConfigurationAsCommand}" />
          <Button Classes="app danger" Content="Discard" Command="{Binding DiscardChangesCommand}"
                  IsVisible="{Binding HasUnsavedChanges}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <StackPanel Grid.Row="1" Spacing="8">
      <Border Classes="status-banner error" IsVisible="{Binding HasValidationError}"
              AutomationProperties.LiveSetting="Assertive">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Classes="status-icon" Text="!" AutomationProperties.Name="Error" />
          <TextBlock Grid.Column="1" Text="{Binding ValidationSummary}" TextWrapping="Wrap" />
          <Button Grid.Column="2" Classes="app" Content="Review" Command="{Binding OpenValidationCommand}"
                  VerticalAlignment="Center" AutomationProperties.Name="Go to the first invalid setting" />
        </Grid>
      </Border>
      <Border Classes="status-banner info" AutomationProperties.LiveSetting="Polite">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Classes="status-icon" Text="i" AutomationProperties.Name="Information" />
          <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </StackPanel>

    <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
      <TabControl x:Name="SettingsTabs" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem Header="Configuration">
          <ScrollViewer x:Name="ConfigurationSettingsScroll" Classes="settings-scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ConfigurationSettingsContent" Classes="settings-content" Margin="18" Spacing="10">
              <TextBlock Classes="section-title" Text="Active configuration" />
              <Border Classes="status-banner info"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><TextBlock Classes="status-icon" Text="i" /><TextBlock Grid.Column="1" Text="{Binding ActiveConfigurationPath, TargetNullValue=No configuration loaded}" TextWrapping="Wrap" /></Grid></Border>
              <WrapPanel><Button Classes="app" Margin="0,0,8,6" Content="Open configuration" Command="{Binding BrowseConfigurationCommand}" /><Button Classes="app primary" Margin="0,0,8,6" Content="Edit full configuration" Command="{Binding EditCurrentConfigurationCommand}" /><Button Classes="app" Margin="0,0,8,6" Content="New configuration" Command="{Binding NewConfigurationCommand}" /></WrapPanel>
              <TextBlock Classes="muted" Text="Recent configurations" FontSize="12" FontWeight="SemiBold" />
              <ComboBox Classes="app" ItemsSource="{Binding RecentConfigurations}" SelectedItem="{Binding SelectedRecentConfiguration, Mode=TwoWay}" PlaceholderText="Choose recent configuration" AutomationProperties.Name="Recent configurations" />
              <StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="app" Content="Load selected" Command="{Binding LoadRecentConfigurationCommand}" /><Button Classes="app" Content="Clear history" Command="{Binding ClearRecentConfigurationsCommand}" /></StackPanel>
              <TextBlock Classes="muted" Text="Configuration path" FontSize="12" FontWeight="SemiBold" />
              <TextBox Classes="app" Text="{Binding EditorPath}" IsReadOnly="True" AutomationProperties.Name="Configuration path" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Library roots">
          <ScrollViewer Classes="settings-scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LibrarySettingsContent" Classes="settings-content" Margin="18" Spacing="10">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="section-title" Text="Library roots and set membership" /><Button Grid.Column="1" Classes="app" Content="Add root" Command="{Binding AddIndexTargetCommand}" /></Grid>
              <ItemsControl ItemsSource="{Binding IndexTargets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Margin="0,0,0,10" Padding="11">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <StackPanel Spacing="5"><TextBlock Classes="muted" Text="Root path" FontSize="12" FontWeight="SemiBold" /><TextBox Classes="app" Text="{Binding Path, Mode=TwoWay}" AutomationProperties.Name="Library root path" /></StackPanel>
                          <Button Grid.Column="1" Classes="app" VerticalAlignment="Bottom" Content="Browse" Command="{Binding DataContext.BrowseIndexTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                          <Button Grid.Column="2" Classes="app danger" VerticalAlignment="Bottom" Content="Remove" Command="{Binding DataContext.RemoveIndexTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                          <StackPanel Spacing="5"><TextBlock Classes="muted" Text="Filter" FontSize="12" FontWeight="SemiBold" /><TextBox Classes="app" Text="{Binding Filter, Mode=TwoWay}" AutomationProperties.Name="Library root filter" /></StackPanel>
                          <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="muted" Text="Ingest role" FontSize="12" FontWeight="SemiBold" /><ComboBox Classes="app" ItemsSource="{Binding DataContext.IngestRoles, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding IngestRole, Mode=TwoWay}" AutomationProperties.Name="Library root ingest role" /></StackPanel>
                        </Grid>
                        <WrapPanel><CheckBox Margin="0,0,14,6" Content="Organize" IsChecked="{Binding Organize, Mode=TwoWay}" /><CheckBox Margin="0,0,14,6" Content="iTunes canonical naming" IsChecked="{Binding UseItunesCanonicalNaming, Mode=TwoWay}" /><CheckBox Margin="0,0,14,6" Content="Sync target" IsChecked="{Binding IsSyncTarget, Mode=TwoWay}" /><Button Classes="app" Content="Add set" Command="{Binding DataContext.AddIndexTargetSetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></WrapPanel>
                        <ItemsControl ItemsSource="{Binding Memberships}">
                          <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6" ColumnDefinitions="*,*,Auto" ColumnSpacing="8"><TextBox Classes="app" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Set names (comma separated)" AutomationProperties.Name="Scan set names" /><TextBox Grid.Column="1" Classes="app" Text="{Binding Offset, Mode=TwoWay}" PlaceholderText="Shared offset" AutomationProperties.Name="Scan set shared offset" /><Button Grid.Column="2" Classes="app danger" Content="Remove" Command="{Binding DataContext.RemoveIndexTargetSetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Playlists">
          <ScrollViewer Classes="settings-scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PlaylistSettingsContent" Classes="settings-content" Margin="18" Spacing="10">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="section-title" Text="Sync playlists" /><Button Grid.Column="1" Classes="app" Content="Add playlist" Command="{Binding AddSyncPlaylistCommand}" /></Grid>
              <ItemsControl ItemsSource="{Binding SyncPlaylists}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Classes="app" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Playlist name" AutomationProperties.Name="Sync playlist name" /><Button Grid.Column="1" Classes="app danger" Content="Remove" Command="{Binding DataContext.RemoveSyncPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Border Classes="status-banner warning">
                <StackPanel Spacing="8">
                  <TextBlock Text="Cross-sync cleanup" FontWeight="SemiBold" />
                  <CheckBox Content="Permanently delete stale cross-sync music files instead of quarantining them" IsChecked="{Binding DeleteStaleCrossSyncFiles, Mode=TwoWay}" />
                  <CheckBox Content="Clean playlist export targets before cross-syncing playlists" IsChecked="{Binding CleanCrossSyncPlaylists, Mode=TwoWay}" />
                </StackPanel>
              </Border>
              <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto"><TextBlock Classes="section-title" Text="Playlist export targets" /><Button Grid.Column="1" Classes="app" Content="Add target" Command="{Binding AddPlaylistTargetCommand}" /></Grid>
              <ItemsControl ItemsSource="{Binding PlaylistTargets}">
                <ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,0,8" Padding="11"><Grid ColumnDefinitions="*,160,*,Auto" ColumnSpacing="8"><TextBox Classes="app" Text="{Binding Target, Mode=TwoWay}" PlaceholderText="Target" AutomationProperties.Name="Playlist export target" /><ComboBox Grid.Column="1" Classes="app" ItemsSource="{Binding DataContext.PlaylistTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Type, Mode=TwoWay}" AutomationProperties.Name="Playlist export format" /><TextBox Grid.Column="2" Classes="app" Text="{Binding Sets, Mode=TwoWay}" PlaceholderText="Sets" AutomationProperties.Name="Playlist export sets" /><StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"><Button Classes="app" Content="Browse" Command="{Binding DataContext.BrowsePlaylistTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /><Button Classes="app danger" Content="Remove" Command="{Binding DataContext.RemovePlaylistTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Tools &amp; ingest">
          <ScrollViewer Classes="settings-scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ToolsSettingsContent" Classes="settings-content" Margin="18" Spacing="10">
              <TextBlock Classes="section-title" Text="Cache and tool paths" />
              <TextBlock Classes="muted" Text="Metadata database" FontSize="12" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Classes="app" Text="{Binding DatabaseFile, Mode=TwoWay}" AutomationProperties.Name="Metadata database" /><Button Grid.Column="1" Classes="app" Content="Browse" Command="{Binding BrowseDatabaseCommand}" /></Grid>
              <TextBlock Classes="muted" Text="iTunes library" FontSize="12" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Classes="app" Text="{Binding ItunesLibraryPath, Mode=TwoWay}" AutomationProperties.Name="iTunes library" /><Button Grid.Column="1" Classes="app" Content="Browse" Command="{Binding BrowseItunesLibraryCommand}" /></Grid>
              <TextBlock Classes="muted" Text="FFmpeg" FontSize="12" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Classes="app" Text="{Binding FfmpegPath, Mode=TwoWay}" AutomationProperties.Name="FFmpeg executable" /><Button Grid.Column="1" Classes="app" Content="Browse" Command="{Binding BrowseFfmpegCommand}" /></Grid>
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <StackPanel Spacing="5"><TextBlock Classes="muted" Text="Path length limit" FontSize="12" FontWeight="SemiBold" /><NumericUpDown Classes="app" Minimum="1" Value="{Binding LengthLimit, Mode=TwoWay}" AutomationProperties.Name="Path length limit" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="muted" Text="Disc number length limit" FontSize="12" FontWeight="SemiBold" /><NumericUpDown Classes="app" Minimum="1" Value="{Binding DiscNumLengthLimit, Mode=TwoWay}" AutomationProperties.Name="Disc number length limit" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="5"><TextBlock Classes="muted" Text="AAC encoder" FontSize="12" FontWeight="SemiBold" /><TextBox Classes="app" Text="{Binding AacEncoder, Mode=TwoWay}" AutomationProperties.Name="AAC encoder" /></StackPanel>
                <StackPanel Grid.Column="3" Spacing="5"><TextBlock Classes="muted" Text="AAC bitrate (kbps)" FontSize="12" FontWeight="SemiBold" /><NumericUpDown Classes="app" Minimum="1" Value="{Binding AacBitrateKbps, Mode=TwoWay}" AutomationProperties.Name="AAC bitrate in kilobits per second" /></StackPanel>
              </Grid>
              <Border Classes="status-banner warning">
                <StackPanel Spacing="8">
                  <TextBlock Text="Cleanup after ingest" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="These options remove source material only after an ingest succeeds." TextWrapping="Wrap" />
                  <CheckBox Content="Delete source music after successful ingest" IsChecked="{Binding DeleteSourcesAfterIngest, Mode=TwoWay}" />
                  <CheckBox Content="Remove non-music files after successful ingest" IsChecked="{Binding RemoveNonMusicAfterIngest, Mode=TwoWay}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Health">
          <ScrollViewer Classes="settings-scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="HealthSettingsContent" Classes="settings-content" Margin="18" Spacing="10">
              <TextBlock Classes="section-title" Text="Artwork health" />
              <TextBlock Classes="muted" Text="The Artwork audit flags an embedded image when its encoded size OR its width or height exceeds the corresponding per-library threshold." TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Spacing="5">
                  <TextBlock Classes="muted" Text="Oversized encoded size (MiB)" FontSize="12" FontWeight="SemiBold" />
                  <NumericUpDown x:Name="ArtworkSizeThresholdInput" Classes="app"
                                 Minimum="0.25" Maximum="1024" Increment="0.25" FormatString="0.##"
                                 Value="{Binding OversizedArtworkSizeThresholdMib, Mode=TwoWay}"
                                 AutomationProperties.Name="Oversized artwork encoded size threshold in mebibytes" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Classes="muted" Text="Oversized width or height (pixels)" FontSize="12" FontWeight="SemiBold" />
                  <NumericUpDown x:Name="ArtworkDimensionThresholdInput" Classes="app"
                                 Minimum="64" Maximum="100000" Increment="100"
                                 Value="{Binding OversizedArtworkDimensionThreshold, Mode=TwoWay}"
                                 AutomationProperties.Name="Oversized artwork width or height threshold in pixels" />
                </StackPanel>
              </Grid>
              <Border Classes="status-banner info">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="status-icon" Text="i" AutomationProperties.Name="Information" />
                  <TextBlock Grid.Column="1" Text="Defaults: 2 MiB encoded size and 2,000 pixels for either dimension. Artwork exactly equal to a threshold is not flagged." TextWrapping="Wrap" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Appearance">
          <StackPanel x:Name="AppearanceSettingsContent" Classes="settings-content" Margin="18" Spacing="10">
            <TextBlock Classes="section-title" Text="Appearance" />
            <TextBlock Classes="muted" Text="Theme changes apply immediately. System follows the operating-system preference; teal remains reserved for selection, focus, progress, and safe actions." TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedThemeChoice, Mode=TwoWay}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Application theme">
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate><Border Classes="card theme-option" Margin="0,0,12,12" HorizontalAlignment="Stretch"><StackPanel Spacing="8"><Border Height="72" CornerRadius="6" Background="{Binding Canvas}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ClipToBounds="True"><Grid ColumnDefinitions="*,*" RowDefinitions="*,6"><Border Background="{Binding Canvas}" /><Border Grid.Column="1" Background="{Binding Raised}" /><Border Grid.Row="1" Grid.ColumnSpan="2" Background="{Binding Accent}" /></Grid></Border><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</UserControl>
