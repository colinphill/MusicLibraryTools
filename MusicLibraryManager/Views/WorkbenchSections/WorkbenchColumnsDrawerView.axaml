<UserControl x:Class="MusicLibraryManager.Views.WorkbenchSections.WorkbenchColumnsDrawerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid RowDefinitions="Auto,*,Auto"
        RowSpacing="12">
    <Grid Margin="12,12,12,0"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="8">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource Loc.Workbench.Columns.Title}"
                   FontSize="16"
                   FontWeight="SemiBold" />
        <TextBlock Classes="supporting"
                   Text="{DynamicResource Loc.Workbench.Columns.Description}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Button x:Name="WorkbenchColumnsCloseButton"
              Grid.Column="1"
              Classes="app icon"
              Width="36"
              Height="36"
              Padding="0"
              ToolTip.Tip="{DynamicResource Loc.Workbench.Columns.Close}"
              AutomationProperties.Name="{DynamicResource Loc.Workbench.Columns.Close}"
              Click="OnClose">
        <controls:AppVectorIcon Kind="Close" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12"
                  Classes="content-stack">
        <TextBlock Classes="section-title"
                   Text="{DynamicResource Loc.Workbench.Columns.Visible}" />
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Shell.Search}" />
          <TextBox x:Name="ColumnSearchBox"
                   Classes="app"
                   PlaceholderText="{DynamicResource Loc.Shell.Search}"
                   AutomationProperties.Name="{DynamicResource Loc.Shell.Search}"
                   TextChanged="OnColumnSearchChanged" />
        </StackPanel>
        <StackPanel x:Name="WorkbenchColumnOptions"
                    Spacing="8" />
        <Border x:Name="BuiltInColumnDetails"
                Classes="card dense-card"
                IsVisible="False">
          <StackPanel Spacing="8">
            <TextBlock x:Name="BuiltInColumnTitle"
                       Classes="section-title" />
            <Grid ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="8">
              <TextBlock Classes="field-label"
                         Text="{DynamicResource Loc.Library.Columns.Width}" />
              <TextBlock x:Name="BuiltInColumnWidth"
                         Grid.Column="1"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Row="1"
                         Classes="field-label"
                         Text="{DynamicResource Loc.Workbench.Columns.AllowInlineEditing}" />
              <TextBlock x:Name="BuiltInColumnEditable"
                         Grid.Row="1"
                         Grid.Column="1"
                         VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="BuiltInColumnEditingHelp"
                       Classes="field-help"
                       Text="{DynamicResource Loc.Workbench.Columns.InlineEditingDescription}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Height="1"
                Background="{DynamicResource AppBorderBrush}" />
        <TextBlock Classes="section-title"
                   Text="{DynamicResource Loc.Workbench.Columns.Metadata}" />
        <ListBox x:Name="WorkbenchMetadataColumnList"
                 MaxHeight="160"
                 ItemsSource="{Binding ColumnEditor.Columns}"
                 SelectedItem="{Binding ColumnEditor.SelectedColumn, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Grid.Column="1"
                           Classes="muted"
                           Text="{Binding Field}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Columns.LabelPlaceholder}" />
            <TextBox Classes="app"
                     Text="{Binding ColumnEditor.Label, Mode=TwoWay}"
                     AutomationProperties.Name="{DynamicResource Loc.Workbench.Columns.LabelPlaceholder}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Grid.Header.Kind}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding ColumnEditor.FieldKindChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedValueBinding="{Binding Value}"
                      SelectedValue="{Binding ColumnEditor.FieldKind, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Grid.Header.Kind}" />
          </StackPanel>
        </Grid>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Columns.KnownFieldPlaceholder}" />
          <ComboBox Classes="app"
                    ItemsSource="{Binding ColumnEditor.KnownFields}"
                    DisplayMemberBinding="{Binding Label}"
                    SelectedItem="{Binding ColumnEditor.SelectedKnownField, Mode=TwoWay}"
                    PlaceholderText="{DynamicResource Loc.Workbench.Columns.KnownFieldPlaceholder}"
                    AutomationProperties.Name="{DynamicResource Loc.Workbench.Columns.KnownFieldPlaceholder}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Common.CustomFieldPlaceholder}" />
          <TextBox Classes="app"
                   Text="{Binding ColumnEditor.CustomFieldName, Mode=TwoWay}"
                   PlaceholderText="{DynamicResource Loc.Workbench.Common.CustomFieldPlaceholder}"
                   AutomationProperties.Name="{DynamicResource Loc.Workbench.Common.CustomFieldPlaceholder}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Reports.SortBy}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding ColumnEditor.SortTypeChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedValueBinding="{Binding Value}"
                      SelectedValue="{Binding ColumnEditor.SortType, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Reports.SortBy}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Library.Columns.Width}" />
            <NumericUpDown Classes="app"
                           Minimum="50"
                           Maximum="2000"
                           Value="{Binding ColumnEditor.Width, Mode=TwoWay}"
                           FormatString="0"
                           AutomationProperties.Name="{DynamicResource Loc.Library.Columns.Width}" />
          </StackPanel>
        </Grid>
        <CheckBox Content="{DynamicResource Loc.Workbench.Columns.AllowInlineEditing}"
                  IsEnabled="{Binding ColumnEditor.CanInlineEdit}"
                  IsChecked="{Binding ColumnEditor.InlineEditable, Mode=TwoWay}" />
        <TextBlock Classes="muted"
                   FontSize="{DynamicResource AppFontSizeCaption}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding !ColumnEditor.CanInlineEdit}"
                   Text="{DynamicResource Loc.Workbench.Columns.InlineEditingDescription}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2"
            Margin="12,0,12,12"
            Classes="sticky-footer">
      <StackPanel Spacing="8">
        <TextBlock Classes="compact-status"
                   TextWrapping="Wrap"
                   Text="{Binding ColumnEditor.Status}" />
        <WrapPanel>
          <Button Classes="app"
                  Content="{DynamicResource Loc.Workbench.Action.New}"
                  Command="{Binding ColumnEditor.NewColumnCommand}" />
          <Button x:Name="SaveWorkbenchMetadataColumnButton"
                  Classes="app primary"
                  Content="{DynamicResource Loc.Workbench.Columns.Action.Save}"
                  Command="{Binding ColumnEditor.SaveColumnCommand}" />
          <Button Classes="app danger"
                  Content="{DynamicResource Loc.Common.Remove}"
                  Command="{Binding ColumnEditor.DeleteColumnCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
