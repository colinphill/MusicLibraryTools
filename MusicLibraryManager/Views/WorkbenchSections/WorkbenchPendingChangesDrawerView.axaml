<UserControl x:Class="MusicLibraryManager.Views.WorkbenchSections.WorkbenchPendingChangesDrawerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid x:Name="WorkbenchPendingChangesLayout"
        Margin="12,12,12,12"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource Loc.Workbench.PendingChanges.Title}"
                   FontSize="16"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="SupportingText"
                   Classes="supporting"
                   Text="{DynamicResource Loc.Workbench.PendingChanges.Description}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Button x:Name="WorkbenchPendingChangesCloseButton"
              Grid.Column="1"
              Classes="app icon"
              Width="36"
              Height="36"
              Padding="0"
              ToolTip.Tip="{DynamicResource Loc.Workbench.PendingChanges.Close}"
              AutomationProperties.Name="{DynamicResource Loc.Workbench.PendingChanges.Close}"
              Click="OnClose">
        <controls:AppVectorIcon Kind="Close" />
      </Button>
    </Grid>

    <controls:LocalizedFormatTextBlock
        Grid.Row="1"
        Classes="summary-label"
        ResourceKey="Workbench.PendingChanges.Count"
        UseCountVariant="True"
        Value="{Binding PendingChanges.Count}" />

    <Grid Grid.Row="2">
      <ListBox
          x:Name="WorkbenchPendingChangesGrid"
          Classes="virtualized-results"
          MinHeight="180"
          ItemsSource="{Binding PendingChanges}"
          AutomationProperties.Name="{DynamicResource Loc.Workbench.PendingChanges.GridAutomation}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="card dense-card"
                    Margin="0,0,8,8">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                  <TextBlock FontWeight="SemiBold"
                             Text="{Binding File}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding File}" />
                  <TextBlock Grid.Column="1"
                             Classes="muted"
                             Text="{Binding Field}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto,*"
                      ColumnSpacing="8">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="faint"
                               FontSize="{DynamicResource AppFontSizeCaption}"
                               Text="{DynamicResource Loc.Workbench.Common.Before}" />
                    <TextBlock Text="{Binding Before}"
                               TextWrapping="Wrap"
                               MaxLines="3" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             Classes="muted"
                             FontSize="18"
                             Text="&#x2192;" />
                  <StackPanel Grid.Column="2"
                              Spacing="4">
                    <TextBlock Classes="faint"
                               FontSize="{DynamicResource AppFontSizeCaption}"
                               Text="{DynamicResource Loc.Workbench.Common.After}" />
                    <TextBlock Text="{Binding After}"
                               TextWrapping="Wrap"
                               MaxLines="3" />
                  </StackPanel>
                </Grid>
                <Expander Header="{DynamicResource Loc.Column.TechnicalDetails}"
                          IsVisible="{Binding DiagnosticDetail}"
                          AutomationProperties.Name="{DynamicResource Loc.Column.TechnicalDetails}">
                  <TextBlock Classes="supporting"
                             Margin="0,8,0,0"
                             Text="{Binding DiagnosticDetail}"
                             TextWrapping="Wrap" />
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Classes="empty-state"
              IsVisible="{Binding !PendingChanges.Count}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
          <TextBlock FontWeight="SemiBold"
                     Text="{DynamicResource Loc.Workbench.PendingChanges.EmptyTitle}" />
          <TextBlock Classes="muted"
                     Text="{DynamicResource Loc.Workbench.PendingChanges.EmptyDescription}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="3"
            Classes="sticky-footer">
      <Grid RowDefinitions="Auto,Auto,Auto"
            RowSpacing="8">
        <TextBlock x:Name="StatusText"
                   Classes="compact-status"
                   VerticalAlignment="Center"
                   Text="{Binding StatusText}"
                   ToolTip.Tip="{Binding StatusDiagnosticDetail}"
                   TextTrimming="CharacterEllipsis" />
        <controls:LocalizedFormatTextBlock
            x:Name="PendingChangesStatusDiagnostic"
            Grid.Row="1"
            Classes="muted"
            FontSize="{DynamicResource AppFontSizeCaption}"
            TextWrapping="Wrap"
            TextTrimming="CharacterEllipsis"
            MaxLines="3"
            ResourceKey="Common.DiagnosticDetailFormat"
            Value="{Binding StatusDiagnosticDetail}"
            IsVisible="{Binding HasStatusDiagnosticDetail}"
            ToolTip.Tip="{Binding StatusDiagnosticDetail}"
            AutomationProperties.HelpText="{Binding StatusDiagnosticDetail}" />
        <WrapPanel Grid.Row="2"
                   HorizontalAlignment="Right">
          <Button x:Name="WorkbenchRevertPendingChangesButton"
                  Classes="app danger"
                  Margin="0,0,8,8"
                  MaxWidth="240"
                  IsEnabled="{Binding HasPendingChanges}"
                  Command="{Binding RevertPendingChangesCommand}">
            <TextBlock MaxWidth="208"
                       Text="{DynamicResource Loc.Workbench.Action.Revert}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
          </Button>
          <Button x:Name="WorkbenchApplyPendingChangesButton"
                  Classes="app primary"
                  Margin="0,0,0,8"
                  Content="{DynamicResource Loc.Common.Apply}"
                  IsEnabled="{Binding HasPendingChanges}"
                  Command="{Binding ApplyCommand}" />
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
