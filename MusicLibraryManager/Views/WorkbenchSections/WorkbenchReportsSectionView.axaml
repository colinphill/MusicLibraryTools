<UserControl x:Class="MusicLibraryManager.Views.WorkbenchSections.WorkbenchReportsSectionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid x:Name="SectionLayout"
        Margin="0,12,0,0"
        ColumnDefinitions="0.9*,12,1.1*">
    <ScrollViewer x:Name="EditorScroll"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="content-stack">
        <TextBlock Classes="section-title"
                   Text="{DynamicResource Loc.Workbench.Reports.Title}" />
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Reports.NamePlaceholder}" />
          <TextBox Classes="app"
                   Text="{Binding ReportEditor.Name, Mode=TwoWay}"
                   PlaceholderText="{DynamicResource Loc.Workbench.Reports.NamePlaceholder}"
                   AutomationProperties.Name="{DynamicResource Loc.Workbench.Reports.NamePlaceholder}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Common.Format}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding ReportEditor.FormatChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedValueBinding="{Binding Value}"
                      SelectedValue="{Binding ReportEditor.Format, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Common.Format}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Playlists.Encoding}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding ReportEditor.EncodingChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedValueBinding="{Binding Value}"
                      SelectedValue="{Binding ReportEditor.Encoding, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Playlists.Encoding}" />
          </StackPanel>
        </Grid>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Common.OutputPathPlaceholder}" />
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
            <TextBox Classes="app"
                     Text="{Binding ReportEditor.OutputPath, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Loc.Workbench.Common.OutputPathPlaceholder}"
                     AutomationProperties.Name="{DynamicResource Loc.Workbench.Common.OutputPathPlaceholder}" />
            <Button Grid.Column="1"
                    Classes="app"
                    Content="{DynamicResource Loc.Common.Browse}"
                    Command="{Binding BrowseReportOutputCommand}" />
          </Grid>
        </StackPanel>
        <CheckBox Content="{DynamicResource Loc.Workbench.Reports.OnePerGroup}"
                  IsChecked="{Binding ReportEditor.OneFilePerGroup, Mode=TwoWay}" />
        <StackPanel x:Name="GroupFileNameField"
                    IsVisible="{Binding ReportEditor.OneFilePerGroup}"
                    Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Reports.GroupFileNamePattern}" />
          <TextBox Classes="app"
                   Text="{Binding ReportEditor.GroupFileNameTemplate, Mode=TwoWay}"
                   PlaceholderText="{}{Group}.{Format}"
                   AutomationProperties.Name="{DynamicResource Loc.Workbench.Reports.GroupFileNamePattern}"
                   AutomationProperties.HelpText="{DynamicResource Loc.Workbench.Reports.GroupFileNameHelp}" />
          <TextBlock Classes="field-help"
                     Text="{DynamicResource Loc.Workbench.Reports.GroupFileNameHelp}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Classes="section-title"
                   Margin="0,8,0,0"
                   Text="{DynamicResource Loc.Workbench.Reports.Columns}" />
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Reports.Columns}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox Classes="app"
                      ItemsSource="{Binding ReportEditor.AvailableFields}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedItem="{Binding ReportEditor.SelectedAvailableField, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Reports.Columns}" />
            <Button Grid.Column="1"
                    Classes="app"
                    Content="{DynamicResource Loc.Workbench.Action.Add}"
                    Command="{Binding ReportEditor.AddSelectedFieldCommand}" />
          </Grid>
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Common.CustomFieldPlaceholder}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Classes="app"
                     Text="{Binding ReportEditor.CustomFieldName, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Loc.Workbench.Common.CustomFieldPlaceholder}"
                     AutomationProperties.Name="{DynamicResource Loc.Workbench.Common.CustomFieldPlaceholder}" />
            <Button Grid.Column="1"
                    Classes="app"
                    Content="{DynamicResource Loc.Workbench.Reports.Action.AddCustom}"
                    Command="{Binding ReportEditor.AddCustomFieldCommand}" />
          </Grid>
        </StackPanel>
        <ListBox MinHeight="120"
                 MaxHeight="210"
                 ItemsSource="{Binding ReportEditor.Fields}"
                 SelectedItem="{Binding ReportEditor.SelectedField, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Grid.Column="1"
                           Classes="muted"
                           Text="{Binding Source}" />
                <Button Grid.Column="2"
                        Classes="app icon"
                        AutomationProperties.Name="{DynamicResource Loc.Workbench.Reports.ColumnActions}">
                  <controls:AppVectorIcon Kind="More" />
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="{DynamicResource Loc.Workbench.Action.MoveUp}"
                                Tag="{Binding}"
                                Click="OnMoveFieldUp" />
                      <MenuItem Header="{DynamicResource Loc.Workbench.Action.MoveDown}"
                                Tag="{Binding}"
                                Click="OnMoveFieldDown" />
                      <Separator />
                      <MenuItem Header="{DynamicResource Loc.Common.Remove}"
                                Tag="{Binding}"
                                Click="OnRemoveField" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="GroupFieldPickerField"
                    Classes="field"
                    IsVisible="{Binding ReportEditor.OneFilePerGroup}">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Reports.GroupBy}" />
          <ComboBox Classes="app"
                    ItemsSource="{Binding ReportEditor.Fields}"
                    DisplayMemberBinding="{Binding Label}"
                    SelectedItem="{Binding ReportEditor.SelectedGroupField, Mode=TwoWay}"
                    PlaceholderText="{DynamicResource Loc.Workbench.Reports.NoGrouping}"
                    AutomationProperties.Name="{DynamicResource Loc.Workbench.Reports.GroupBy}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Reports.SortBy}" />
          <ComboBox Classes="app"
                    ItemsSource="{Binding ReportEditor.Fields}"
                    DisplayMemberBinding="{Binding Label}"
                    SelectedItem="{Binding ReportEditor.SelectedSortField, Mode=TwoWay}"
                    PlaceholderText="{DynamicResource Loc.Workbench.Reports.SourceOrder}"
                    AutomationProperties.Name="{DynamicResource Loc.Workbench.Reports.SortBy}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Reports.SortType}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox Classes="app"
                      ItemsSource="{Binding ReportEditor.SortTypeChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedValueBinding="{Binding Value}"
                      SelectedValue="{Binding ReportEditor.SortType, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Reports.SortType}" />
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      Content="{DynamicResource Loc.Workbench.Reports.Descending}"
                      IsChecked="{Binding ReportEditor.SortDescending, Mode=TwoWay}" />
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid x:Name="ReviewedPanel"
          Grid.Column="2"
          RowDefinitions="Auto,*,Auto,Auto"
          RowSpacing="8">
      <TextBlock x:Name="ReviewedTitle"
                 Classes="section-title"
                 Text="{DynamicResource Loc.Workbench.Reports.Reviewed}" />
      <controls:AppDataGrid x:Name="ReportOutputGrid"
                            Grid.Row="1"
                            MinHeight="150"
                            IsVisible="{Binding ReportOutputs.Count}"
                            ItemsSource="{Binding ReportOutputs}" />
      <Border x:Name="ReportPreviewEmptyState"
              Grid.Row="1"
              Classes="empty-state"
              MaxHeight="132"
              IsVisible="{Binding !ReportOutputs.Count}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="360"
                    Spacing="8">
          <TextBlock FontWeight="SemiBold"
                     TextAlignment="Center"
                     Text="{DynamicResource Loc.Workbench.Reports.EmptyPreviewTitle}" />
          <TextBlock Classes="muted"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{DynamicResource Loc.Workbench.Reports.EmptyPreviewDescription}" />
        </StackPanel>
      </Border>
      <Border x:Name="ReportsStatusBanner"
              Grid.Row="2"
              Classes="status-banner info">
        <StackPanel Spacing="4">
          <TextBlock x:Name="ReportsStatusText"
                     Text="{Binding StatusText}"
                     TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis"
                     MaxLines="2" />
          <controls:LocalizedFormatTextBlock
              x:Name="ReportsStatusDiagnostic"
              Classes="muted"
              FontSize="{DynamicResource AppFontSizeCaption}"
              TextWrapping="Wrap"
              TextTrimming="CharacterEllipsis"
              MaxLines="3"
              ResourceKey="Common.DiagnosticDetailFormat"
              Value="{Binding StatusDiagnosticDetail}"
              IsVisible="{Binding HasStatusDiagnosticDetail}"
              ToolTip.Tip="{Binding StatusDiagnosticDetail}"
              AutomationProperties.HelpText="{Binding StatusDiagnosticDetail}" />
        </StackPanel>
      </Border>
      <Border x:Name="ReportsStickyFooter"
              Grid.Row="3"
              Classes="sticky-footer">
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="PreviewReportButton"
                  Classes="app"
                  Classes.primary="{Binding !ReportOutputs.Count}"
                  Content="{DynamicResource Loc.Workbench.Reports.Action.Preview}"
                  Command="{Binding PreviewReportCommand}" />
          <Button Classes="app primary"
                  IsVisible="{Binding ReportOutputs.Count}"
                  Content="{DynamicResource Loc.Workbench.Reports.Action.Write}"
                  Command="{Binding ApplyReportCommand}" />
        </WrapPanel>
      </Border>
    </Grid>
    <Border x:Name="ReportsSourceEmptyState"
            Grid.ColumnSpan="3"
            Grid.RowSpan="3"
            Classes="empty-state"
            IsVisible="{Binding !HasFiles}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="360"
                  Spacing="8">
        <TextBlock Classes="faint caption"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Text="{DynamicResource Loc.Workbench.Section.ReportsAutomation}" />
        <TextBlock Classes="section-title"
                   HorizontalAlignment="Center"
                   Text="{DynamicResource Loc.Workbench.Session.EmptyTitle}" />
        <TextBlock Classes="muted"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{DynamicResource Loc.Workbench.Session.EmptyDescription}" />
        <Button x:Name="ReportsAddFilesButton"
                Classes="app"
                HorizontalAlignment="Center"
                Content="{DynamicResource Loc.Workbench.Action.AddFiles}"
                Command="{Binding BrowseFilesCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
