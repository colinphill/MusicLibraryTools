<UserControl x:Class="MusicLibraryManager.Views.WorkbenchSections.WorkbenchSessionSectionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid Margin="0,4,0,0"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="8">
    <WrapPanel>
      <Button x:Name="WorkbenchColumnsButton"
              Classes="app"
              Margin="0,0,8,8"
              Content="{DynamicResource Loc.Workbench.Session.Columns}"
              Click="OnColumnsClick" />
      <SplitButton x:Name="ImportDelimitedMetadataButton"
                   Classes="app"
                   Margin="0,0,8,8"
                   Content="{DynamicResource Loc.Workbench.Session.ImportDelimited}"
                   Command="{Binding ImportDelimitedMetadataCommand}">
        <SplitButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <Border Width="320"
                    Classes="card dense-card">
              <StackPanel Classes="content-stack">
                <StackPanel Classes="field">
                  <TextBlock Classes="field-label"
                             FontWeight="SemiBold"
                             Text="{DynamicResource Loc.Workbench.Session.EmptyCellAutomation}" />
                  <TextBlock Classes="muted field-help"
                             TextWrapping="Wrap"
                             Text="{DynamicResource Loc.Workbench.Session.EmptyCellTooltip}" />
                  <ComboBox x:Name="ImportEmptyCellMode"
                            Classes="app"
                            ItemsSource="{Binding ImportEmptyCellModeChoices}"
                            DisplayMemberBinding="{Binding Label}"
                            SelectedValueBinding="{Binding Value}"
                            SelectedValue="{Binding ImportEmptyCellMode, Mode=TwoWay}"
                            AutomationProperties.Name="{DynamicResource Loc.Workbench.Session.EmptyCellAutomation}" />
                </StackPanel>
                <Button Classes="app primary"
                        HorizontalContentAlignment="Left"
                        Content="{DynamicResource Loc.Workbench.Session.ImportDelimited}"
                        Command="{Binding ImportDelimitedMetadataCommand}" />
              </StackPanel>
            </Border>
          </Flyout>
        </SplitButton.Flyout>
      </SplitButton>
      <Button x:Name="WorkbenchSessionActionsButton"
              Classes="app"
              Margin="0,0,8,8"
              Content="{DynamicResource Loc.Workbench.Session.SelectionActions}"
              AutomationProperties.Name="{DynamicResource Loc.Workbench.Session.SelectionActions}">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="{DynamicResource Loc.Workbench.Session.Action.RemoveSelected}"
                      Command="{Binding RemoveCurrentCommand}" />
            <MenuItem Header="{DynamicResource Loc.Workbench.Action.MoveUp}"
                      Command="{Binding MoveUpCommand}" />
            <MenuItem Header="{DynamicResource Loc.Workbench.Action.MoveDown}"
                      Command="{Binding MoveDownCommand}" />
            <Separator />
            <MenuItem Header="{DynamicResource Loc.Transcode.Action.Open}"
                      Click="OnTranscodeClick" />
            <MenuItem Header="{DynamicResource Loc.Workbench.Session.Action.SendToIngest}"
                      Command="{Binding SendSelectedToIngestCommand}" />
            <Separator />
            <MenuItem Header="{DynamicResource Loc.Workbench.Session.Action.Clear}"
                      Command="{Binding ClearCommand}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </WrapPanel>

    <Grid Grid.Row="1">
      <controls:AppDataGrid x:Name="WorkbenchGrid"
                            MinHeight="220"
                            ItemsSource="{Binding Files}"
                            SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                            SelectionChanged="OnWorkbenchSelectionChanged"
                            PointerPressed="OnWorkbenchPointerPressed"
                            AutomationProperties.Name="{DynamicResource Loc.Workbench.Session.GridAutomation}">
        <controls:AppDataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{DynamicResource Loc.Workbench.Session.Action.RemoveSelected}"
                      Command="{Binding RemoveCurrentCommand}" />
            <MenuItem Header="{DynamicResource Loc.Workbench.Action.MoveUp}"
                      Command="{Binding MoveUpCommand}" />
            <MenuItem Header="{DynamicResource Loc.Workbench.Action.MoveDown}"
                      Command="{Binding MoveDownCommand}" />
            <Separator />
            <MenuItem Header="{DynamicResource Loc.Transcode.Action.Open}"
                      Click="OnTranscodeClick" />
            <MenuItem Header="{DynamicResource Loc.Workbench.Session.Action.SendToIngest}"
                      Command="{Binding SendSelectedToIngestCommand}" />
            <Separator />
            <MenuItem Header="{DynamicResource Loc.Workbench.Session.Action.Clear}"
                      Command="{Binding ClearCommand}" />
          </ContextMenu>
        </controls:AppDataGrid.ContextMenu>
      </controls:AppDataGrid>
      <Border x:Name="SessionEmptyState"
              Classes="empty-state"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding !HasFiles}"
              MaxWidth="430">
        <StackPanel Spacing="8">
          <TextBlock HorizontalAlignment="Center"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Text="{DynamicResource Loc.Workbench.Session.EmptyTitle}" />
          <TextBlock x:Name="EmptyStateSupportingText"
                     Classes="supporting"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{DynamicResource Loc.Workbench.Session.EmptyDescription}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border x:Name="SessionStatusFooter"
            Grid.Row="2"
            Classes="inset-card sticky-footer"
            AutomationProperties.LiveSetting="Polite">
      <Grid ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="8"
            RowSpacing="4">
        <controls:AppVectorIcon Kind="Information" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{Binding StatusText}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding StatusText}" />
          <controls:LocalizedFormatTextBlock
              x:Name="StatusDiagnosticText"
              Classes="muted"
              FontSize="{DynamicResource AppFontSizeCaption}"
              TextTrimming="CharacterEllipsis"
              ResourceKey="Common.DiagnosticDetailFormat"
              Value="{Binding StatusDiagnosticDetail}"
              IsVisible="{Binding HasStatusDiagnosticDetail}" />
        </StackPanel>
        <Grid x:Name="SessionSummary"
              Grid.Row="1"
              Grid.ColumnSpan="2"
              Margin="0,4,0,0"
              ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="12"
              IsVisible="{Binding SelectedFile}">
          <TextBlock Classes="muted"
                     Text="{Binding FieldSelectionSummary}"
                     TextTrimming="CharacterEllipsis" />
          <controls:LocalizedFormatTextBlock
              Grid.Column="1"
              Classes="summary-label"
              ResourceKey="Workbench.Session.TagsFormat"
              Value="{Binding SelectedFile.LayerSummary}" />
          <controls:LocalizedFormatTextBlock
              Grid.Column="2"
              Classes="summary-label"
              ResourceKey="Workbench.Session.ArtworkCount"
              UseCountVariant="True"
              Value="{Binding SelectedFile.ArtworkCount}" />
          <controls:LocalizedFormatTextBlock
              Grid.Column="3"
              Classes="summary-label"
              ResourceKey="Workbench.Session.FieldsCount"
              UseCountVariant="True"
              Value="{Binding SelectedFile.FieldCount}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
