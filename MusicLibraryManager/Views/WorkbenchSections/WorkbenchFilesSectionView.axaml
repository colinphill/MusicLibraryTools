<UserControl x:Class="MusicLibraryManager.Views.WorkbenchSections.WorkbenchFilesSectionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:MusicLibraryManager.Views">
  <Grid>
    <Border IsVisible="{Binding HasFiles}">
      <views:ReviewedFileOperationEditorView
          x:Name="WorkbenchFileOperationEditor"
          DataContext="{Binding FileOperations}" />
    </Border>
    <Border x:Name="FileOperationsEmptyState"
            Classes="empty-state"
            IsVisible="{Binding !HasFiles}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8"
                  MaxWidth="360">
        <TextBlock x:Name="FileOperationsEmptyContext"
                   Classes="faint caption"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Text="{DynamicResource Loc.Workbench.Section.FilesAutomation}" />
        <TextBlock x:Name="FileOperationsEmptyTitle"
                   Classes="section-title"
                   HorizontalAlignment="Center"
                   Text="{DynamicResource Loc.Workbench.Session.EmptyTitle}" />
        <TextBlock x:Name="FileOperationsEmptyDescription"
                   Classes="muted"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{DynamicResource Loc.Workbench.Session.EmptyDescription}" />
        <Button x:Name="FileOperationsAddFilesButton"
                Classes="app"
                HorizontalAlignment="Center"
                Content="{DynamicResource Loc.Workbench.Action.AddFiles}"
                Command="{Binding BrowseFilesCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
