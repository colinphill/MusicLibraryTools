<UserControl x:Class="MusicLibraryManager.Views.WorkbenchSections.WorkbenchInspectorDrawerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:MusicLibraryManager.Views"
             xmlns:local="using:MusicLibraryManager.Views.WorkbenchSections"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <UserControl.Resources>
    <local:TagLayerPresenceConverter x:Key="TagLayerPresent" />
    <local:TagLayerMissingConverter x:Key="TagLayerMissing" />
  </UserControl.Resources>
  <views:SelectionInspectorView
      x:Name="WorkbenchInspectorView"
      DataContext="{Binding Inspector}">
    <views:SelectionInspectorView.SupplementaryContent>
      <Expander x:Name="WorkbenchTagToolsExpander"
                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=local:WorkbenchInspectorDrawerView}}"
                Header="{DynamicResource Loc.Workbench.Inspector.TagLayers}"
                IsVisible="{Binding SelectedFile.HasEditableTagLayers}">
        <StackPanel Margin="4,8,4,4"
                    Classes="content-stack">
          <controls:LocalizedFormatTextBlock
              Classes="muted"
              ResourceKey="Workbench.Inspector.CurrentLayersFormat"
              Value="{Binding SelectedFile.LayerSummary}"
              TextWrapping="Wrap" />
          <CheckBox Content="{DynamicResource Loc.Workbench.Inspector.CopyPrimaryMetadata}"
                    IsChecked="{Binding CopyPrimaryMetadataToNewLayer, Mode=TwoWay}" />
          <Border Classes="card dense-card">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
              <TextBlock FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Text="ID3v2" />
              <TextBlock Grid.Column="1"
                         Classes="muted"
                         VerticalAlignment="Center"
                         IsVisible="{Binding SelectedFile.Document.EditableTagLayers, Converter={StaticResource TagLayerPresent}, ConverterParameter=Id3v2}"
                         Text="{DynamicResource Loc.Workbench.Inspector.LayerPresent}" />
              <TextBlock Grid.Column="1"
                         Classes="muted"
                         VerticalAlignment="Center"
                         IsVisible="{Binding SelectedFile.Document.EditableTagLayers, Converter={StaticResource TagLayerMissing}, ConverterParameter=Id3v2}"
                         Text="{DynamicResource Loc.Workbench.Inspector.LayerMissing}" />
              <Button Grid.Column="2"
                      Classes="app icon"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.Id3v2Actions}">
                <controls:AppVectorIcon Kind="More" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="{DynamicResource Loc.Workbench.Action.Add}"
                              AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.AddId3v2Automation}"
                              Command="{Binding PreviewAddId3LayerCommand}" />
                    <MenuItem Header="{DynamicResource Loc.Common.Remove}"
                              AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.RemoveId3v2Automation}"
                              Command="{Binding PreviewRemoveId3LayerCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>
          <Border Classes="card dense-card">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
              <TextBlock FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Text="APEv2" />
              <TextBlock Grid.Column="1"
                         Classes="muted"
                         VerticalAlignment="Center"
                         IsVisible="{Binding SelectedFile.Document.EditableTagLayers, Converter={StaticResource TagLayerPresent}, ConverterParameter=ApeV2}"
                         Text="{DynamicResource Loc.Workbench.Inspector.LayerPresent}" />
              <TextBlock Grid.Column="1"
                         Classes="muted"
                         VerticalAlignment="Center"
                         IsVisible="{Binding SelectedFile.Document.EditableTagLayers, Converter={StaticResource TagLayerMissing}, ConverterParameter=ApeV2}"
                         Text="{DynamicResource Loc.Workbench.Inspector.LayerMissing}" />
              <Button Grid.Column="2"
                      Classes="app icon"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.ApeV2Actions}">
                <controls:AppVectorIcon Kind="More" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="{DynamicResource Loc.Workbench.Action.Add}"
                              AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.AddApeV2Automation}"
                              Command="{Binding PreviewAddApeLayerCommand}" />
                    <MenuItem Header="{DynamicResource Loc.Common.Remove}"
                              AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.RemoveApeV2Automation}"
                              Command="{Binding PreviewRemoveApeLayerCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>
          <Border Classes="card dense-card">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
              <TextBlock FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Text="ID3v1" />
              <TextBlock Grid.Column="1"
                         Classes="muted"
                         VerticalAlignment="Center"
                         IsVisible="{Binding SelectedFile.Document.EditableTagLayers, Converter={StaticResource TagLayerPresent}, ConverterParameter=Id3v1}"
                         Text="{DynamicResource Loc.Workbench.Inspector.LayerPresent}" />
              <TextBlock Grid.Column="1"
                         Classes="muted"
                         VerticalAlignment="Center"
                         IsVisible="{Binding SelectedFile.Document.EditableTagLayers, Converter={StaticResource TagLayerMissing}, ConverterParameter=Id3v1}"
                         Text="{DynamicResource Loc.Workbench.Inspector.LayerMissing}" />
              <Button Grid.Column="2"
                      Classes="app icon"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.Id3v1Actions}">
                <controls:AppVectorIcon Kind="More" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="{DynamicResource Loc.Workbench.Action.Add}"
                              AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.AddId3v1Automation}"
                              Command="{Binding PreviewAddId3v1LayerCommand}" />
                    <MenuItem Header="{DynamicResource Loc.Common.Remove}"
                              AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.RemoveId3v1Automation}"
                              Command="{Binding PreviewRemoveId3v1LayerCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>
          <Expander Header="{DynamicResource Loc.Workbench.Common.Advanced}"
                    IsVisible="{Binding SelectedFile.HasId3Tag}">
            <StackPanel Margin="0,8,0,0"
                        Classes="content-stack">
              <TextBlock FontWeight="SemiBold"
                         Text="{DynamicResource Loc.Workbench.Inspector.Id3Conversion}" />
              <controls:LocalizedFormatTextBlock
                  Classes="muted"
                  ResourceKey="Workbench.Inspector.CurrentValueFormat"
                  Value="{Binding SelectedFile.Document.Id3Version}" />
              <StackPanel Classes="field">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource Loc.Workbench.Inspector.TargetId3VersionAutomation}" />
                <ComboBox Classes="app"
                          ItemsSource="{Binding Id3VersionChoices}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding TargetId3Version, Mode=TwoWay}"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.TargetId3VersionAutomation}" />
              </StackPanel>
              <CheckBox Content="{DynamicResource Loc.Workbench.Inspector.DropUnsupportedFrames}"
                        IsChecked="{Binding DropUnsupportedId3Frames, Mode=TwoWay}" />
              <CheckBox Content="{DynamicResource Loc.Workbench.Inspector.JoinMultiValueText}"
                        IsChecked="{Binding CoalesceId3TextValues, Mode=TwoWay}" />
              <Button Classes="app primary"
                      Content="{DynamicResource Loc.Workbench.Inspector.PreviewConversion}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.PreviewConversionAutomation}"
                      Command="{Binding PreviewId3VersionCommand}" />
              <WrapPanel>
                <Button Classes="app"
                        Margin="0,0,8,8"
                        Content="{DynamicResource Loc.Workbench.Inspector.CopyV2ToV1}"
                        AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.CopyV2ToV1Automation}"
                        Command="{Binding PreviewId3v2ToId3v1Command}" />
                <Button Classes="app"
                        Margin="0,0,8,8"
                        Content="{DynamicResource Loc.Workbench.Inspector.CopyV1ToV2}"
                        AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.CopyV1ToV2Automation}"
                        Command="{Binding PreviewId3v1ToId3v2Command}" />
              </WrapPanel>
              <StackPanel Classes="field">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource Loc.Workbench.Inspector.Id3EncodingAutomation}" />
                <ComboBox Classes="app"
                          ItemsSource="{Binding Id3EncodingPolicyChoices}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding SelectedId3EncodingPolicy, Mode=TwoWay}"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.Id3EncodingAutomation}" />
              </StackPanel>
              <Button Classes="app"
                      Content="{DynamicResource Loc.Workbench.Inspector.PreviewEncoding}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Inspector.PreviewEncodingAutomation}"
                      Command="{Binding PreviewId3EncodingCommand}" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Expander>
    </views:SelectionInspectorView.SupplementaryContent>
  </views:SelectionInspectorView>
</UserControl>
