<UserControl x:Class="MusicLibraryManager.Views.WorkbenchSections.WorkbenchTranscodeDrawerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid Margin="12,12,12,12"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource Loc.Transcode.Title}"
                   FontSize="16"
                   FontWeight="SemiBold" />
        <TextBlock Classes="supporting"
                   Text="{Binding TranscodeEditor.CapturedSelectionSummary}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Button x:Name="WorkbenchTranscodeCloseButton"
              Grid.Column="1"
              Classes="app icon"
              Width="36"
              Height="36"
              Padding="0"
              ToolTip.Tip="{DynamicResource Loc.Transcode.Action.Close}"
              AutomationProperties.Name="{DynamicResource Loc.Transcode.Action.Close}"
              Click="OnClose">
        <controls:AppVectorIcon Kind="Close" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="content-stack">
        <Border Classes="card dense-card">
          <StackPanel Classes="content-stack">
            <TextBlock Classes="section-title"
                       Text="{DynamicResource Loc.Transcode.Preset.Title}" />
            <StackPanel Classes="field">
              <TextBlock Classes="field-label"
                         Text="{DynamicResource Loc.Transcode.Preset.Title}" />
              <ComboBox Classes="app"
                        ItemsSource="{Binding TranscodeEditor.PresetChoices}"
                        SelectedItem="{Binding TranscodeEditor.SelectedPreset}"
                        DisplayMemberBinding="{Binding Name}"
                        PlaceholderText="{DynamicResource Loc.Transcode.Preset.Custom}"
                        AutomationProperties.Name="{DynamicResource Loc.Transcode.Preset.Title}" />
            </StackPanel>
            <StackPanel Classes="field">
              <TextBlock Classes="field-label"
                         Text="{DynamicResource Loc.Transcode.Preset.Name}" />
              <TextBox Classes="app"
                       Text="{Binding TranscodeEditor.PresetName}"
                       PlaceholderText="{DynamicResource Loc.Transcode.Preset.Name}"
                       AutomationProperties.Name="{DynamicResource Loc.Transcode.Preset.Name}" />
            </StackPanel>
            <WrapPanel>
              <Button Classes="app"
                      Margin="0,0,8,8"
                      Content="{DynamicResource Loc.Transcode.Preset.SaveAs}"
                      Command="{Binding TranscodeEditor.SavePresetCommand}" />
              <Button Classes="app"
                      Margin="0,0,8,8"
                      Content="{DynamicResource Loc.Workbench.Action.More}"
                      AutomationProperties.Name="{DynamicResource Loc.Transcode.Preset.Title}">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="{DynamicResource Loc.Transcode.Preset.Update}"
                              Command="{Binding TranscodeEditor.UpdatePresetCommand}" />
                    <MenuItem Header="{DynamicResource Loc.Common.Delete}"
                              Command="{Binding TranscodeEditor.DeletePresetCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Border>

        <StackPanel Classes="content-stack">
          <TextBlock Classes="section-title"
                     Text="{DynamicResource Loc.Transcode.Encoding.Title}" />
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Transcode.Format.Label}" />
            <ComboBox x:Name="WorkbenchTranscodeFormat"
                      Classes="app"
                      ItemsSource="{Binding TranscodeEditor.FormatChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedItem="{Binding TranscodeEditor.SelectedFormatChoice, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Transcode.Format.Label}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding TranscodeEditor.Issues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="status-banner warning"
                        Margin="0,0,0,4">
                  <TextBlock Text="{Binding}"
                             TextWrapping="Wrap" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Transcode.Encoder.Label}" />
            <ComboBox x:Name="WorkbenchTranscodeEncoder"
                      Classes="app"
                      ItemsSource="{Binding TranscodeEditor.EncoderChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedItem="{Binding TranscodeEditor.SelectedEncoderChoice, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Transcode.Encoder.Label}" />
          </StackPanel>
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Transcode.RateMode.Label}" />
            <ComboBox x:Name="WorkbenchTranscodeRateMode"
                      Classes="app"
                      ItemsSource="{Binding TranscodeEditor.RateModeChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedItem="{Binding TranscodeEditor.SelectedRateModeChoice, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Transcode.RateMode.Label}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <StackPanel IsVisible="{Binding TranscodeEditor.HasBitrateControl}"
                        Classes="field">
              <TextBlock Classes="field-label"
                         Text="{DynamicResource Loc.Transcode.Bitrate.Label}" />
              <NumericUpDown Classes="app"
                             Minimum="8"
                             Maximum="2000"
                             Increment="8"
                             Value="{Binding TranscodeEditor.BitrateKbps}"
                             AutomationProperties.Name="{DynamicResource Loc.Transcode.Bitrate.Label}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        IsVisible="{Binding TranscodeEditor.HasQualityControl}"
                        Classes="field">
              <TextBlock Classes="field-label"
                         Text="{DynamicResource Loc.Transcode.Quality.Label}" />
              <NumericUpDown Classes="app"
                             Minimum="0"
                             Maximum="10"
                             Increment="0.5"
                             Value="{Binding TranscodeEditor.Quality}"
                             AutomationProperties.Name="{DynamicResource Loc.Transcode.Quality.Label}" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <StackPanel Classes="field">
              <TextBlock Classes="field-label"
                         Text="{DynamicResource Loc.Transcode.SampleRate.Label}" />
              <ComboBox Classes="app"
                        ItemsSource="{Binding TranscodeEditor.SampleRateChoices}"
                        DisplayMemberBinding="{Binding Label}"
                        SelectedValueBinding="{Binding Value}"
                        SelectedValue="{Binding TranscodeEditor.SelectedSampleRate, Mode=TwoWay}"
                        AutomationProperties.Name="{DynamicResource Loc.Transcode.SampleRate.Label}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Classes="field">
              <TextBlock Classes="field-label"
                         Text="{DynamicResource Loc.Transcode.BitDepth.Label}" />
              <ComboBox Classes="app"
                        ItemsSource="{Binding TranscodeEditor.BitDepthChoices}"
                        DisplayMemberBinding="{Binding Label}"
                        SelectedValueBinding="{Binding Value}"
                        SelectedValue="{Binding TranscodeEditor.SelectedBitDepth, Mode=TwoWay}"
                        AutomationProperties.Name="{DynamicResource Loc.Transcode.BitDepth.Label}" />
            </StackPanel>
          </Grid>
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Transcode.CompressionEffort.Label}" />
            <NumericUpDown Classes="app"
                           Minimum="0"
                           Maximum="10"
                           Increment="1"
                           Value="{Binding TranscodeEditor.CompressionEffort}"
                           AutomationProperties.Name="{DynamicResource Loc.Transcode.CompressionEffort.Label}" />
          </StackPanel>
          <CheckBox Content="{DynamicResource Loc.Transcode.Metadata.Preserve}"
                    IsChecked="{Binding TranscodeEditor.PreserveMetadata}" />
          <CheckBox Content="{DynamicResource Loc.Transcode.Artwork.Preserve}"
                    IsChecked="{Binding TranscodeEditor.PreserveArtwork}" />
          <StackPanel
              IsVisible="{Binding TranscodeEditor.IsCorrectionFileOptionVisible}"
              Spacing="{DynamicResource AppSpaceXSmall}">
            <CheckBox x:Name="CreateCorrectionFileCheckBox"
                      Content="{DynamicResource Loc.Transcode.Correction.Create}"
                      IsChecked="{Binding TranscodeEditor.CreateCorrectionFile}"
                      IsEnabled="{Binding TranscodeEditor.CanEditCorrectionFile}"
                      AutomationProperties.Name="{DynamicResource Loc.Transcode.Correction.Create}"
                      AutomationProperties.HelpText="{Binding TranscodeEditor.CorrectionFileHelpText}" />
            <TextBlock
                Classes="field-help warning"
                IsVisible="{Binding !TranscodeEditor.IsCorrectionFileSupported}"
                Text="{DynamicResource Loc.Transcode.Issue.CorrectionUnavailable}"
                TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>

        <StackPanel Classes="content-stack">
          <TextBlock Classes="section-title"
                     Text="{DynamicResource Loc.Transcode.Destination.Title}" />
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Transcode.Destination.Title}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding TranscodeEditor.DestinationModeChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedValueBinding="{Binding Value}"
                      SelectedValue="{Binding TranscodeEditor.SelectedDestinationMode, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Transcode.Destination.Title}" />
          </StackPanel>
          <StackPanel Classes="field"
                      IsVisible="{Binding TranscodeEditor.NeedsDestinationFolder}">
            <TextBlock Classes="field-label"
                       IsVisible="{Binding TranscodeEditor.NeedsDestinationFolder}"
                       Text="{DynamicResource Loc.Transcode.Destination.Folder}" />
            <Grid IsVisible="{Binding TranscodeEditor.NeedsDestinationFolder}"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
              <TextBox Classes="app"
                       Text="{Binding TranscodeEditor.DestinationDirectory}"
                       PlaceholderText="{DynamicResource Loc.Transcode.Destination.Folder}"
                       AutomationProperties.Name="{DynamicResource Loc.Transcode.Destination.Folder}" />
              <Button Grid.Column="1"
                      Classes="app"
                      Content="{DynamicResource Loc.Common.Browse}"
                      Command="{Binding TranscodeEditor.BrowseDestinationCommand}" />
            </Grid>
          </StackPanel>
          <StackPanel x:Name="FolderLayoutOptions"
                      IsVisible="{Binding TranscodeEditor.NeedsDestinationFolder}"
                      Spacing="{DynamicResource AppSpaceSmall}">
            <RadioButton x:Name="PreserveSourceLayoutCheckBox"
                         GroupName="TranscodeFolderLayout"
                         Content="{DynamicResource Loc.Transcode.Destination.PreserveLayout}"
                         IsChecked="{Binding TranscodeEditor.PreserveSourceLayout}" />
            <RadioButton x:Name="FlattenOutputCheckBox"
                         GroupName="TranscodeFolderLayout"
                         Content="{DynamicResource Loc.Transcode.Destination.Flatten}"
                         IsChecked="{Binding TranscodeEditor.Flatten}" />
          </StackPanel>
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Transcode.Naming.Label}" />
            <TextBox Classes="app"
                     Text="{Binding TranscodeEditor.FileNameTemplate}"
                     AutomationProperties.Name="{DynamicResource Loc.Transcode.Naming.Label}" />
            <TextBlock Classes="muted field-help"
                       Text="{DynamicResource Loc.Transcode.Naming.Tokens}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Transcode.Collision.Label}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding TranscodeEditor.CollisionPolicyChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedValueBinding="{Binding Value}"
                      SelectedValue="{Binding TranscodeEditor.SelectedCollisionPolicy, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Transcode.Collision.Label}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Classes="content-stack">
          <TextBlock Classes="section-title"
                     Text="{DynamicResource Loc.Transcode.Concurrency.Title}" />
          <CheckBox Content="{DynamicResource Loc.Transcode.Concurrency.Automatic}"
                    IsChecked="{Binding TranscodeEditor.AutomaticConcurrency}" />
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Transcode.Concurrency.ParallelJobs}" />
            <NumericUpDown Classes="app"
                           Minimum="1"
                           Maximum="{Binding TranscodeEditor.MaximumProcessorCount}"
                           Value="{Binding TranscodeEditor.MaximumConcurrentProcesses}"
                           IsEnabled="{Binding !TranscodeEditor.AutomaticConcurrency}"
                           AutomationProperties.Name="{DynamicResource Loc.Transcode.Concurrency.ParallelJobs}" />
          </StackPanel>
          <TextBlock Classes="muted"
                     Text="{Binding TranscodeEditor.ToolReadiness}"
                     TextWrapping="Wrap" />
          <Button Classes="app"
                  HorizontalAlignment="Left"
                  Content="{DynamicResource Loc.Transcode.Tools.Refresh}"
                  Command="{Binding TranscodeEditor.RefreshCapabilitiesCommand}" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Classes="sticky-footer">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
        <TextBlock Classes="compact-status"
                   VerticalAlignment="Center"
                   Text="{Binding TranscodeEditor.Status}"
                   ToolTip.Tip="{Binding TranscodeEditor.StatusDiagnosticDetail}"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1"
                Classes="app primary"
                Content="{DynamicResource Loc.Common.Preview}"
                Command="{Binding TranscodeEditor.PreviewCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
