<UserControl x:Class="MusicLibraryManager.Views.WorkbenchSections.WorkbenchPlaylistsSectionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid x:Name="SectionLayout"
        Margin="0,12,0,0"
        ColumnDefinitions="0.85*,14,1.15*">
    <ScrollViewer x:Name="EditorScroll"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="content-stack">
        <TextBlock Classes="section-title"
                   Text="{DynamicResource Loc.Workbench.Playlists.Title}" />
        <TextBlock x:Name="SupportingText"
                   Classes="muted"
                   TextWrapping="Wrap"
                   Text="{DynamicResource Loc.Workbench.Playlists.Description}" />
        <Grid ColumnDefinitions="*,130"
              ColumnSpacing="8">
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Playlists.NamePlaceholder}" />
            <TextBox Classes="app"
                     Text="{Binding PlaylistEditor.Name, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Loc.Workbench.Playlists.NamePlaceholder}"
                     AutomationProperties.Name="{DynamicResource Loc.Workbench.Playlists.NamePlaceholder}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Common.Format}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding PlaylistEditor.Formats}"
                      SelectedItem="{Binding PlaylistEditor.Format, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Common.Format}" />
          </StackPanel>
        </Grid>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Common.OutputPathPlaceholder}" />
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
            <TextBox Classes="app"
                     Text="{Binding PlaylistEditor.OutputPath, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Loc.Workbench.Common.OutputPathPlaceholder}"
                     AutomationProperties.Name="{DynamicResource Loc.Workbench.Common.OutputPathPlaceholder}" />
            <Button Grid.Column="1"
                    Classes="app"
                    Content="{DynamicResource Loc.Common.Browse}"
                    Command="{Binding BrowsePlaylistOutputCommand}" />
          </Grid>
        </StackPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <StackPanel Classes="field"
                      Spacing="4">
            <TextBlock Classes="field-label" Text="{DynamicResource Loc.Workbench.Playlists.PathStyle}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding PlaylistEditor.PathStyleChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedValueBinding="{Binding Value}"
                      SelectedValue="{Binding PlaylistEditor.PathStyle, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Playlists.PathStyle}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Classes="field"
                      Spacing="4">
            <TextBlock Classes="field-label" Text="{DynamicResource Loc.Workbench.Playlists.Encoding}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding PlaylistEditor.EncodingChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedValueBinding="{Binding Value}"
                      SelectedValue="{Binding PlaylistEditor.Encoding, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Playlists.Encoding}" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Classes="field"
                      Spacing="4">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Playlists.LineEnding}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding PlaylistEditor.LineEndingChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedValueBinding="{Binding Value}"
                      SelectedValue="{Binding PlaylistEditor.LineEnding, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Playlists.LineEnding}" />
          </StackPanel>
          <CheckBox Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8"
                    Content="{DynamicResource Loc.Workbench.Playlists.ExtendedInfo}"
                    IsChecked="{Binding PlaylistEditor.IncludeExtendedInfo, Mode=TwoWay}" />
        </Grid>
        <CheckBox Content="{DynamicResource Loc.Workbench.Playlists.OnePerGroup}"
                  IsChecked="{Binding PlaylistEditor.OnePlaylistPerGroup, Mode=TwoWay}" />
        <StackPanel IsVisible="{Binding PlaylistEditor.OnePlaylistPerGroup}"
                    Spacing="8">
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Playlists.Grouping}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding PlaylistEditor.GroupFields}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedItem="{Binding PlaylistEditor.SelectedGroupField, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Playlists.Grouping}" />
          </StackPanel>
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Reports.GroupFileNamePattern}" />
            <TextBox Classes="app"
                     Text="{Binding PlaylistEditor.GroupFileNameTemplate, Mode=TwoWay}"
                     PlaceholderText="{}{Name} - {Group}"
                     AutomationProperties.Name="{DynamicResource Loc.Workbench.Reports.GroupFileNamePattern}" />
          </StackPanel>
        </StackPanel>
        <Border x:Name="SafetyNote"
                Classes="status-banner info">
          <TextBlock TextWrapping="Wrap"
                     Text="{DynamicResource Loc.Workbench.Playlists.Safety}" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid x:Name="ReviewedPanel"
          Grid.Column="2"
          RowDefinitions="Auto,*,Auto,Auto"
          RowSpacing="8">
      <TextBlock Classes="section-title"
                 Text="{DynamicResource Loc.Workbench.Playlists.Reviewed}" />
      <controls:AppDataGrid x:Name="PlaylistOutputGrid"
                            Grid.Row="1"
                            MinHeight="150"
                            ItemsSource="{Binding PlaylistOutputs}" />
      <Border Grid.Row="2" Classes="status-banner info">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding StatusText}"
                     TextWrapping="Wrap" />
          <controls:LocalizedFormatTextBlock
              Classes="muted"
              FontSize="{DynamicResource AppFontSizeCaption}"
              TextWrapping="Wrap"
              ResourceKey="Common.DiagnosticDetailFormat"
              Value="{Binding StatusDiagnosticDetail}"
              IsVisible="{Binding HasStatusDiagnosticDetail}" />
        </StackPanel>
      </Border>
      <Border Grid.Row="3"
              Classes="sticky-footer">
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="PreviewPlaylistButton"
                  Classes="app"
                  Classes.primary="{Binding !PlaylistOutputs.Count}"
                  Content="{DynamicResource Loc.Workbench.Playlists.Action.Preview}"
                  Command="{Binding PreviewPlaylistCommand}" />
          <Button Classes="app primary"
                  IsVisible="{Binding PlaylistOutputs.Count}"
                  Content="{DynamicResource Loc.Workbench.Playlists.Action.Write}"
                  Command="{Binding ApplyPlaylistCommand}" />
        </WrapPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
