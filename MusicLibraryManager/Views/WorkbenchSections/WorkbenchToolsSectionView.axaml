<UserControl x:Class="MusicLibraryManager.Views.WorkbenchSections.WorkbenchToolsSectionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <Grid x:Name="SectionLayout"
        Margin="0,12,0,0"
        ColumnDefinitions="0.9*,14,1.1*">
    <ScrollViewer x:Name="EditorScroll"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="content-stack">
        <TextBlock Classes="section-title"
                   Text="{DynamicResource Loc.Workbench.Tools.Title}" />
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Tools.SavedPlaceholder}" />
          <Grid ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8">
            <ComboBox Classes="app"
                      ItemsSource="{Binding ExternalToolEditor.SavedTools}"
                      DisplayMemberBinding="{Binding Name}"
                      SelectedItem="{Binding ExternalToolEditor.SelectedSavedTool, Mode=TwoWay}"
                      PlaceholderText="{DynamicResource Loc.Workbench.Tools.SavedPlaceholder}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Tools.SavedPlaceholder}" />
            <Button Grid.Column="1"
                    Classes="app"
                    Content="{DynamicResource Loc.Workbench.Tools.Load}"
                    Command="{Binding ExternalToolEditor.LoadToolCommand}" />
            <Button x:Name="SavedToolMoreButton"
                    Grid.Column="2"
                    Classes="app"
                    Content="{DynamicResource Loc.Workbench.Action.More}"
                    AutomationProperties.Name="{DynamicResource Loc.Workbench.Tools.MoreAutomation}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="{DynamicResource Loc.Workbench.Tools.New}"
                            Command="{Binding ExternalToolEditor.NewToolCommand}" />
                  <MenuItem Header="{DynamicResource Loc.Workbench.Tools.Save}"
                            Command="{Binding ExternalToolEditor.SaveToolCommand}" />
                  <Separator />
                  <MenuItem Header="{DynamicResource Loc.Workbench.Tools.Delete}"
                            Command="{Binding ExternalToolEditor.DeleteToolCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </StackPanel>
        <Grid ColumnDefinitions="*,190"
              ColumnSpacing="8">
          <StackPanel Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Tools.NamePlaceholder}" />
            <TextBox x:Name="ExternalToolNameInput"
                     Classes="app"
                     Text="{Binding ExternalToolEditor.Name, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Loc.Workbench.Tools.NamePlaceholder}"
                     AutomationProperties.Name="{DynamicResource Loc.Workbench.Tools.NamePlaceholder}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Classes="field">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource Loc.Workbench.Tools.InvocationMode}" />
            <ComboBox Classes="app"
                      ItemsSource="{Binding ExternalToolEditor.InvocationModeChoices}"
                      DisplayMemberBinding="{Binding Label}"
                      SelectedValueBinding="{Binding Value}"
                      SelectedValue="{Binding ExternalToolEditor.InvocationMode, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Loc.Workbench.Tools.InvocationMode}" />
          </StackPanel>
        </Grid>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Tools.ExecutablePlaceholder}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="ExternalToolExecutableInput"
                     Classes="app"
                     Text="{Binding ExternalToolEditor.Executable, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Loc.Workbench.Tools.ExecutablePlaceholder}"
                     AutomationProperties.Name="{DynamicResource Loc.Workbench.Tools.ExecutablePlaceholder}" />
            <Button Grid.Column="1"
                    Classes="app"
                    Content="{DynamicResource Loc.Workbench.Tools.BrowseExecutable}"
                    Command="{Binding BrowseExternalToolExecutableCommand}" />
          </Grid>
        </StackPanel>
        <StackPanel Classes="field"
                    Spacing="4">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Tools.WorkingDirectoryPlaceholder}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="ExternalToolWorkingDirectoryInput"
                     Classes="app"
                     Text="{Binding ExternalToolEditor.WorkingDirectory, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Loc.Workbench.Tools.WorkingDirectoryPlaceholder}"
                     AutomationProperties.Name="{DynamicResource Loc.Workbench.Tools.WorkingDirectoryPlaceholder}" />
            <Button Grid.Column="1"
                    Classes="app"
                    Content="{DynamicResource Loc.Workbench.Tools.BrowseFolder}"
                    Command="{Binding BrowseExternalToolWorkingDirectoryCommand}" />
          </Grid>
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label"
                     Text="{DynamicResource Loc.Workbench.Tools.ArgumentsLabel}" />
          <TextBox x:Name="ExternalToolArgumentsInput"
                   Classes="app"
                   MinHeight="105"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   Text="{Binding ExternalToolEditor.ArgumentsText, Mode=TwoWay}"
                   PlaceholderText="{}{Files}"
                   AutomationProperties.Name="{DynamicResource Loc.Workbench.Tools.ArgumentsLabel}" />
          <TextBlock x:Name="PlaceholderHelp"
                     Classes="muted field-help"
                     TextWrapping="Wrap"
                     Text="{DynamicResource Loc.Workbench.Tools.PlaceholderHelp}" />
        </StackPanel>
        <Border x:Name="SafetyNote"
                Classes="status-banner warning">
          <TextBlock TextWrapping="Wrap"
                     Text="{DynamicResource Loc.Workbench.Tools.Safety}" />
        </Border>
        <TextBlock Classes="muted"
                   Text="{Binding ExternalToolEditor.StoreStatus}" />
      </StackPanel>
    </ScrollViewer>

    <Grid x:Name="ReviewedPanel"
          Grid.Column="2"
          RowDefinitions="Auto,*,Auto,Auto"
          RowSpacing="8">
      <TextBlock Classes="section-title"
                 Text="{DynamicResource Loc.Workbench.Tools.ReviewedTitle}" />
      <controls:AppDataGrid x:Name="ExternalToolInvocationGrid"
                            Grid.Row="1"
                            MinHeight="150"
                            IsVisible="{Binding ExternalToolInvocations.Count}"
                            ItemsSource="{Binding ExternalToolInvocations}" />
      <Border x:Name="ExternalToolPreviewEmptyState"
              Grid.Row="1"
              Classes="empty-state"
              ClipToBounds="True"
              Padding="{DynamicResource AppPaddingSmall}"
              IsVisible="{Binding !ExternalToolInvocations.Count}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="360"
                    Spacing="8">
          <TextBlock x:Name="ExternalToolPreviewEmptyTitle"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     Text="{DynamicResource Loc.Workbench.Tools.EmptyPreviewTitle}" />
          <TextBlock x:Name="ExternalToolPreviewEmptyDescription"
                     Classes="muted"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{DynamicResource Loc.Workbench.Tools.EmptyPreviewDescription}" />
        </StackPanel>
      </Border>
      <Border x:Name="ToolsStatusBanner"
              Grid.Row="2"
              Classes="status-banner info">
        <StackPanel Spacing="4">
          <TextBlock x:Name="ToolsStatusText"
                     Text="{Binding StatusText}"
                     TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding StatusText}"
                     AutomationProperties.HelpText="{Binding StatusText}" />
          <controls:LocalizedFormatTextBlock
              Classes="muted"
              FontSize="{DynamicResource AppFontSizeCaption}"
              TextWrapping="Wrap"
              ResourceKey="Common.DiagnosticDetailFormat"
              Value="{Binding StatusDiagnosticDetail}"
              IsVisible="{Binding HasStatusDiagnosticDetail}" />
        </StackPanel>
      </Border>
      <Border x:Name="ToolsStickyFooter"
              Grid.Row="3"
              Classes="sticky-footer">
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="PreviewExternalToolButton"
                  Classes="app"
                  Classes.primary="{Binding !ExternalToolInvocations.Count}"
                  Content="{DynamicResource Loc.Workbench.Tools.Preview}"
                  Command="{Binding PreviewExternalToolCommand}" />
          <Button x:Name="RunExternalToolButton"
                  Classes="app primary"
                  IsVisible="{Binding ExternalToolInvocations.Count}"
                  Content="{DynamicResource Loc.Workbench.Tools.Run}"
                  Command="{Binding RunExternalToolCommand}" />
        </WrapPanel>
      </Border>
    </Grid>
    <Border x:Name="ToolsSourceEmptyState"
            Grid.ColumnSpan="3"
            Grid.RowSpan="3"
            Classes="empty-state"
            IsVisible="{Binding !HasFiles}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="360"
                  Spacing="8">
        <TextBlock Classes="faint caption"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Text="{DynamicResource Loc.Workbench.Section.ToolsAutomation}" />
        <TextBlock FontSize="17"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Text="{DynamicResource Loc.Workbench.Session.EmptyTitle}" />
        <TextBlock Classes="muted"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{DynamicResource Loc.Workbench.Session.EmptyDescription}" />
        <Button x:Name="ToolsAddFilesButton"
                Classes="app"
                HorizontalAlignment="Center"
                Content="{DynamicResource Loc.Workbench.Action.AddFiles}"
                Command="{Binding BrowseFilesCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
