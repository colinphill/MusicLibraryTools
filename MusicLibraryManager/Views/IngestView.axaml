<UserControl x:Class="MusicLibraryManager.Views.IngestView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls"
             DragDrop.AllowDrop="True" DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop">
  <Grid Margin="26,22,26,26" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <controls:PageHeader Title="Ingest"
        Subtitle="Preflight, preview, and safely import music into the active library.">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="app" Content="Preflight" Command="{Binding PreflightCommand}" />
          <Button Classes="app" Content="Preview" Command="{Binding PreviewCommand}" />
          <Button Classes="app primary" Content="Apply" Command="{Binding ApplyCommand}" />
          <Button Classes="app" Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Border Grid.Row="1" Classes="card">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto,220" ColumnSpacing="8">
          <StackPanel Spacing="5"><TextBlock Classes="muted" Text="Incoming folder" FontSize="12" FontWeight="SemiBold" /><TextBox Classes="app" Text="{Binding SourceDirectory, Mode=TwoWay}" PlaceholderText="Drop a folder here or browse" /></StackPanel>
          <Button Grid.Column="1" Classes="app" VerticalAlignment="Bottom" Content="Browse" Command="{Binding BrowseSourceCommand}" />
          <ComboBox Grid.Column="2" Classes="app" VerticalAlignment="Bottom" ItemsSource="{Binding RecentSources}" SelectedItem="{Binding SelectedRecentSource, Mode=TwoWay}" PlaceholderText="Recent sources" />
        </Grid>
        <Grid ColumnDefinitions="*,220,Auto,Auto" ColumnSpacing="8">
          <StackPanel Spacing="5"><TextBlock Classes="muted" Text="Preset name" FontSize="12" FontWeight="SemiBold" /><TextBox Classes="app" Text="{Binding PresetName, Mode=TwoWay}" /></StackPanel>
          <ComboBox Grid.Column="1" Classes="app" VerticalAlignment="Bottom" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" PlaceholderText="Presets" />
          <Button Grid.Column="2" Classes="app" VerticalAlignment="Bottom" Content="Save preset" Command="{Binding SavePresetCommand}" />
          <Button Grid.Column="3" Classes="app" VerticalAlignment="Bottom" Content="Delete" Command="{Binding DeletePresetCommand}" />
        </Grid>
        <Border Classes="status-banner"><TextBlock Text="{Binding ConfigurationReadinessText}" TextWrapping="Wrap" /></Border>
        <ItemsControl ItemsSource="{Binding PreflightChecks}" IsVisible="{Binding HasPreflightChecks}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Classes="summary-label" Margin="0,0,12,6" Text="{Binding Message}" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ProgressBar Classes="app" Minimum="0" Maximum="{Binding ApplyProgressMaximum}" Value="{Binding ApplyProgress}" IsVisible="{Binding IsApplying}" />
        <TextBlock Classes="muted" Text="{Binding StatusText}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Classes="card" Padding="12" ClipToBounds="True">
      <TabControl>
        <TabItem Header="Preview">
          <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,12,0,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,220" ColumnSpacing="8">
              <TextBlock Classes="summary-label" Text="{Binding AlbumCount, StringFormat={}{0} albums}" />
              <TextBlock Grid.Column="1" Classes="summary-label" Text="{Binding OutputCount, StringFormat={}{0} outputs}" />
              <TextBlock Grid.Column="2" Classes="summary-label" Text="{Binding ConflictCount, StringFormat={}{0} conflicts}" />
              <TextBlock Grid.Column="3" Classes="summary-label" Text="{Binding CleanupCount, StringFormat={}{0} cleanup}" />
              <ComboBox Grid.Column="5" Classes="app" ItemsSource="{Binding PreviewFilters}" SelectedItem="{Binding SelectedPreviewFilter, Mode=TwoWay}" />
            </Grid>
            <controls:AppDataGrid x:Name="PreviewGrid" Grid.Row="1" ItemsSource="{Binding Files}" />
          </Grid>
        </TabItem>
        <TabItem Header="History">
          <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="app" Content="Refresh history" Command="{Binding RefreshHistoryCommand}" /><TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding HistoryStatus}" /></StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate><DataTemplate><Border Classes="card" Padding="11" Margin="0,0,0,6"><StackPanel Spacing="3"><TextBlock Text="{Binding AffectedItems}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{Binding State}" /><TextBlock Classes="faint" Text="{Binding RunPath}" TextTrimming="CharacterEllipsis" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</UserControl>
