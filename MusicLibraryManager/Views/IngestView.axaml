<UserControl x:Class="MusicLibraryManager.Views.IngestView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls"
             DragDrop.AllowDrop="True" DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop">
  <Grid Margin="26,22,26,26" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <controls:PageHeader Title="Ingest"
        Subtitle="Preflight, preview, and safely import music into the active library.">
      <controls:PageHeader.Actions>
        <WrapPanel>
          <Button Classes="app" Content="Preflight" Command="{Binding PreflightCommand}" />
          <Button Classes="app" Margin="8,0,0,0" Content="Preview" Command="{Binding PreviewCommand}" />
          <Button Classes="app primary" Margin="8,0,0,0" Content="Apply" Command="{Binding ApplyCommand}" />
          <Button Classes="app" Margin="8,0,0,0" Content="Cancel" Command="{Binding CancelCommand}" />
        </WrapPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Border x:Name="SetupCard" Grid.Row="1" Classes="card">
      <StackPanel x:Name="SetupPanel" Spacing="10">
        <Grid ColumnDefinitions="*,Auto,220" ColumnSpacing="8">
          <StackPanel Spacing="5"><TextBlock Classes="muted" Text="Incoming folder" FontSize="12" FontWeight="SemiBold" /><TextBox Classes="app" Text="{Binding SourceDirectory, Mode=TwoWay}" PlaceholderText="Drop a folder here or browse" AutomationProperties.Name="Incoming folder" /></StackPanel>
          <Button Grid.Column="1" Classes="app" VerticalAlignment="Bottom" Content="Browse" Command="{Binding BrowseSourceCommand}" />
          <ComboBox x:Name="RecentFoldersCombo" Grid.Column="2" Classes="app" VerticalAlignment="Bottom" ItemsSource="{Binding RecentSources}" SelectedItem="{Binding SelectedRecentSource, Mode=TwoWay}" PlaceholderText="Recent folders" AutomationProperties.Name="Recent ingest folders" />
        </Grid>
        <Border Classes="status-banner info"
                IsVisible="{Binding HasExplicitSourceFiles}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <TextBlock Classes="status-icon" Text="i" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ExplicitSourceSummary}"
                       TextWrapping="Wrap" />
            <Button Grid.Column="2" Classes="app"
                    Content="Clear selected files"
                    Command="{Binding ClearExplicitSourcesCommand}" />
          </Grid>
        </Border>
        <Border Classes="status-banner" Classes.info="{Binding IsConfigurationReady}"
                Classes.warning="{Binding !IsConfigurationReady}"
                AutomationProperties.LiveSetting="Polite">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Classes="status-icon" Text="{Binding ConfigurationReadinessIcon}" />
            <TextBlock Grid.Column="1" Text="{Binding ConfigurationReadinessText}" TextWrapping="Wrap" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding PreflightChecks}" IsVisible="{Binding HasPreflightChecks}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Classes="summary-label" Margin="0,0,12,6" Text="{Binding Message}" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ProgressBar Classes="app" Minimum="0" Maximum="{Binding PreviewProgressMaximum}" Value="{Binding PreviewProgress}" IsVisible="{Binding IsPreviewing}" />
        <ProgressBar Classes="app" Minimum="0" Maximum="{Binding ApplyProgressMaximum}" Value="{Binding ApplyProgress}" IsVisible="{Binding IsApplying}" />
        <TextBlock Classes="muted" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Classes="card" Padding="12" ClipToBounds="True">
      <TabControl>
        <TabItem Header="Preview">
          <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,12,0,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,220" ColumnSpacing="8">
              <TextBlock Classes="summary-label" Text="{Binding AlbumCount, StringFormat={}{0} albums}" />
              <TextBlock Grid.Column="1" Classes="summary-label" Text="{Binding OutputCount, StringFormat={}{0} outputs}" />
              <TextBlock Grid.Column="2" Classes="summary-label" Text="{Binding ConflictCount, StringFormat={}{0} conflicts}" />
              <TextBlock Grid.Column="3" Classes="summary-label" Text="{Binding CleanupCount, StringFormat={}{0} cleanup}" />
              <ComboBox Grid.Column="5" Classes="app" ItemsSource="{Binding PreviewFilters}" SelectedItem="{Binding SelectedPreviewFilter, Mode=TwoWay}" AutomationProperties.Name="Preview filter" />
            </Grid>
            <Grid Grid.Row="1">
              <controls:AppDataGrid x:Name="PreviewGrid" ItemsSource="{Binding Files}" />
              <Border Margin="0,39,0,0" Padding="10" Background="{DynamicResource AppRaisedBrush}"
                      IsVisible="{Binding IsPreviewEmpty}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="420">
                  <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Nothing to review yet" />
                  <TextBlock x:Name="PreviewEmptyDescription" Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                             Text="Choose an incoming folder and run Preview to see albums, outputs, conflicts, and cleanup." />
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="History">
          <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,12,0,0">
            <WrapPanel><Button Classes="app" Margin="0,0,8,6" Content="Refresh history" Command="{Binding RefreshHistoryCommand}" /><Button Classes="app" Margin="0,0,8,6" Content="Open in Recovery" Command="{Binding OpenHistoryCommand}" /><TextBlock Classes="muted" Margin="0,0,0,6" VerticalAlignment="Center" Text="{Binding HistoryStatus}" /></WrapPanel>
            <Grid Grid.Row="1">
              <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate><DataTemplate><Border Classes="card" Padding="11" Margin="0,0,0,6"><StackPanel Spacing="3"><TextBlock Text="{Binding AffectedItems}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{Binding State}" /><TextBlock Classes="faint" Text="{Binding RunPath}" TextTrimming="CharacterEllipsis" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                          IsVisible="{Binding IsHistoryEmpty}" MaxWidth="420">
                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No ingest runs found" />
                <TextBlock x:Name="HistoryEmptyDescription" Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Choose a source folder, then refresh to discover journaled and interrupted ingest runs." />
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</UserControl>
