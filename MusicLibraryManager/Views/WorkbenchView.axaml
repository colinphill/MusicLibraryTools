<UserControl x:Class="MusicLibraryManager.Views.WorkbenchView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls"
             xmlns:sections="using:MusicLibraryManager.Views.WorkbenchSections"
             DragDrop.AllowDrop="True"
             DragDrop.DragOver="OnDragOver"
             DragDrop.Drop="OnDrop"
             KeyDown="OnWorkbenchKeyDown">
  <Grid x:Name="WorkbenchRoot"
        Margin="26,22,26,26"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="14">
    <controls:PageHeader x:Name="WorkbenchHeader"
                         Title="{DynamicResource Loc.Workbench.Title}"
                         Subtitle="{DynamicResource Loc.Workbench.Subtitle}">
      <controls:PageHeader.Actions>
        <WrapPanel>
          <Button x:Name="WorkbenchPendingChangesButton"
                  Classes="app primary"
                  Margin="0,0,8,6"
                  AutomationProperties.Name="{DynamicResource Loc.Workbench.PendingChanges.ReviewAutomation}"
                  Click="OnWorkbenchPendingChangesClick">
            <controls:LocalizedFormatTextBlock
                ResourceKey="Workbench.PendingChanges.Review"
                UseCountVariant="True"
                Value="{Binding PendingChanges.Count}" />
          </Button>
          <Button x:Name="WorkbenchInspectorToggle"
                  Classes="app"
                  Margin="0,0,8,6"
                  Content="{DynamicResource Loc.Workbench.Action.Inspector}"
                  AutomationProperties.Name="{DynamicResource Loc.Workbench.Action.InspectorAutomation}"
                  Click="OnInspectorToggle" />
          <Button x:Name="WorkbenchMoreButton"
                  Classes="app"
                  Margin="0,0,0,6"
                  Content="{DynamicResource Loc.Workbench.Action.More}"
                  AutomationProperties.Name="{DynamicResource Loc.Workbench.Action.MoreAutomation}">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{DynamicResource Loc.Workbench.Action.UndoLastApply}"
                          Command="{Binding UndoCommand}" />
                <MenuItem Header="{DynamicResource Loc.Workbench.Action.Redo}"
                          Command="{Binding RedoCommand}" />
                <MenuItem Header="{DynamicResource Loc.Workbench.Action.RepeatRecipe}"
                          Command="{Binding RepeatCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </WrapPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <WrapPanel x:Name="WorkbenchSourceBar"
               Grid.Row="1"
               VerticalAlignment="Center">
      <SplitButton x:Name="AddWorkbenchSourceButton"
                   Classes="app primary"
                   Margin="0,0,8,6"
                   Content="{DynamicResource Loc.Workbench.Action.AddFiles}"
                   Command="{Binding BrowseFilesCommand}"
                   AutomationProperties.Name="{DynamicResource Loc.Workbench.Source.AddAutomation}">
        <SplitButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <Border Width="320"
                    Padding="12"
                    Background="{DynamicResource AppPanelBrush}">
              <StackPanel Spacing="9">
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Loc.Workbench.Source.Title}" />
                <TextBlock Classes="muted"
                           Text="{DynamicResource Loc.Workbench.Source.Description}"
                           TextWrapping="Wrap" />
                <Button x:Name="ChooseWorkbenchFilesButton"
                        Classes="app primary"
                        HorizontalContentAlignment="Left"
                        Content="{DynamicResource Loc.Workbench.Source.ChooseFiles}"
                        AutomationProperties.Name="{DynamicResource Loc.Workbench.Source.ChooseFilesAutomation}"
                        Command="{Binding BrowseFilesCommand}" />
                <Button x:Name="ChooseWorkbenchFolderButton"
                        Classes="app"
                        HorizontalContentAlignment="Left"
                        Content="{DynamicResource Loc.Workbench.Source.ChooseFolder}"
                        AutomationProperties.Name="{DynamicResource Loc.Workbench.Source.ChooseFolderAutomation}"
                        Command="{Binding BrowseFolderCommand}" />
                <CheckBox x:Name="WorkbenchIncludeSubfoldersCheckBox"
                          Content="{DynamicResource Loc.Workbench.Source.IncludeSubfolders}"
                          IsChecked="{Binding Recursive, Mode=TwoWay}" />
                <Border Height="1"
                        Background="{DynamicResource AppBorderBrush}" />
                <TextBlock FontWeight="SemiBold"
                           Text="{DynamicResource Loc.Workbench.Source.RecentLocation}" />
                <ComboBox x:Name="RecentLocationsBox"
                          Classes="app"
                          ItemsSource="{Binding RecentLocations}"
                          PlaceholderText="{DynamicResource Loc.Workbench.Source.RecentPlaceholder}"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Source.RecentAutomation}" />
                <Button x:Name="AddRecentWorkbenchSourceButton"
                        Classes="app"
                        HorizontalContentAlignment="Left"
                        Content="{DynamicResource Loc.Workbench.Source.AddRecent}"
                        Command="{Binding AddRecentCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=RecentLocationsBox}" />
              </StackPanel>
            </Border>
          </Flyout>
        </SplitButton.Flyout>
      </SplitButton>
      <StackPanel x:Name="WorkbenchProgressPanel"
                  Width="250"
                  Margin="0,0,8,6"
                  Spacing="3"
                  IsVisible="{Binding IsBusy}">
        <TextBlock Classes="muted"
                   FontSize="11"
                   Text="{Binding ProgressText}"
                   TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite" />
        <ProgressBar Height="4"
                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                     Maximum="{Binding ProgressMaximum}"
                     Value="{Binding ProgressValue}" />
      </StackPanel>
      <Button Classes="app"
              Margin="0,0,0,6"
              Content="{DynamicResource Loc.Common.Cancel}"
              Command="{Binding CancelCommand}"
              IsVisible="{Binding IsBusy}" />
    </WrapPanel>

    <controls:PersistedSplitView x:Name="WorkbenchSplit"
                                 Grid.Row="2"
                                 InitialLeftWidth="980"
                                 MinLeftWidth="420"
                                 MaxLeftWidth="1800"
                                 MinRightWidth="320"
                                 PersistenceKey="workbench"
                                 Label="{DynamicResource Loc.Workbench.Split.Resize}">
      <controls:PersistedSplitView.Left>
        <Grid RowDefinitions="Auto,*"
              RowSpacing="8">
          <ComboBox x:Name="WorkbenchSectionPicker"
                    Classes="app"
                    ItemsSource="{Binding SectionOptions}"
                    DisplayMemberBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedSectionOption, Mode=TwoWay}"
                    AutomationProperties.Name="{DynamicResource Loc.Workbench.Navigation.SectionAutomation}" />
          <Grid x:Name="WorkbenchBody"
                Grid.Row="1"
                ColumnDefinitions="212,10,*">
            <Border x:Name="WorkbenchSectionRail"
                    Classes="card"
                    Padding="8"
                    ClipToBounds="True"
                    AutomationProperties.Name="{DynamicResource Loc.Workbench.Navigation.Automation}">
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="3">
                  <TextBlock Classes="faint"
                             Margin="8,5,8,2"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Text="{DynamicResource Loc.Workbench.Navigation.Group.Workspace}" />
                  <Button x:Name="WorkbenchSectionSession"
                          Classes="app quiet"
                          HorizontalContentAlignment="Left"
                          Content="{DynamicResource Loc.Workbench.Section.Session}"
                          Tag="Session"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Section.SessionAutomation}"
                          Click="OnWorkbenchSectionClick" />
                  <TextBlock Classes="faint"
                             Margin="8,10,8,2"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Text="{DynamicResource Loc.Workbench.Navigation.Group.Edit}" />
                  <Button x:Name="WorkbenchSectionBulkOperation"
                          Classes="app quiet"
                          HorizontalContentAlignment="Left"
                          Content="{DynamicResource Loc.Workbench.Section.BulkOperation}"
                          Tag="BulkOperation"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Section.BulkOperationAutomation}"
                          Click="OnWorkbenchSectionClick" />
                  <Button x:Name="WorkbenchSectionAllFields"
                          Classes="app quiet"
                          HorizontalContentAlignment="Left"
                          Content="{DynamicResource Loc.Workbench.Section.AllFields}"
                          Tag="AllFields"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Section.AllFieldsAutomation}"
                          Click="OnWorkbenchSectionClick" />
                  <Button x:Name="WorkbenchSectionFiles"
                          Classes="app quiet"
                          HorizontalContentAlignment="Left"
                          Content="{DynamicResource Loc.Workbench.Section.Files}"
                          Tag="Files"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Section.FilesAutomation}"
                          Click="OnWorkbenchSectionClick" />
                  <TextBlock Classes="faint"
                             Margin="8,10,8,2"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Text="{DynamicResource Loc.Workbench.Navigation.Group.Enrich}" />
                  <Button x:Name="WorkbenchSectionOnlineMetadata"
                          Classes="app quiet"
                          HorizontalContentAlignment="Left"
                          Content="{DynamicResource Loc.Workbench.Section.OnlineMetadata}"
                          Tag="OnlineMetadata"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Section.OnlineMetadataAutomation}"
                          Click="OnWorkbenchSectionClick" />
                  <TextBlock Classes="faint"
                             Margin="8,10,8,2"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Text="{DynamicResource Loc.Workbench.Navigation.Group.Output}" />
                  <Button x:Name="WorkbenchSectionReports"
                          Classes="app quiet"
                          HorizontalContentAlignment="Left"
                          Content="{DynamicResource Loc.Workbench.Section.Reports}"
                          Tag="Reports"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Section.ReportsAutomation}"
                          Click="OnWorkbenchSectionClick" />
                  <Button x:Name="WorkbenchSectionPlaylists"
                          Classes="app quiet"
                          HorizontalContentAlignment="Left"
                          Content="{DynamicResource Loc.Workbench.Section.Playlists}"
                          Tag="Playlists"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Section.PlaylistsAutomation}"
                          Click="OnWorkbenchSectionClick" />
                  <TextBlock Classes="faint"
                             Margin="8,10,8,2"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Text="{DynamicResource Loc.Workbench.Navigation.Group.Automate}" />
                  <Button x:Name="WorkbenchSectionTools"
                          Classes="app quiet"
                          HorizontalContentAlignment="Left"
                          Content="{DynamicResource Loc.Workbench.Section.Tools}"
                          Tag="Tools"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Section.ToolsAutomation}"
                          Click="OnWorkbenchSectionClick" />
                  <Button x:Name="WorkbenchSectionShortcuts"
                          Classes="app quiet"
                          HorizontalContentAlignment="Left"
                          Content="{DynamicResource Loc.Workbench.Section.Shortcuts}"
                          Tag="Shortcuts"
                          AutomationProperties.Name="{DynamicResource Loc.Workbench.Section.ShortcutsAutomation}"
                          Click="OnWorkbenchSectionClick" />
                </StackPanel>
              </ScrollViewer>
            </Border>
            <Border x:Name="WorkbenchSectionDivider"
                    Grid.Column="1"
                    Width="2"
                    Margin="4,8"
                    CornerRadius="2"
                    Background="{DynamicResource AppBorderBrush}" />
            <Border x:Name="WorkbenchSectionContentCard"
                    Grid.Column="2"
                    Classes="card"
                    Padding="12"
                    ClipToBounds="True">
              <Carousel x:Name="WorkbenchTabs">
                <sections:WorkbenchSessionSectionView
                    x:Name="WorkbenchSessionSection" />
                <sections:WorkbenchBulkOperationSectionView
                    x:Name="WorkbenchBulkOperationSection" />
                <sections:WorkbenchAllFieldsSectionView
                    x:Name="WorkbenchAllFieldsSection" />
                <sections:WorkbenchFilesSectionView
                    x:Name="WorkbenchFilesSection" />
                <sections:WorkbenchOnlineMetadataSectionView
                    x:Name="WorkbenchOnlineMetadataSection" />
                <sections:WorkbenchReportsSectionView
                    x:Name="WorkbenchReportsSection" />
                <sections:WorkbenchPlaylistsSectionView
                    x:Name="WorkbenchPlaylistsSection" />
                <sections:WorkbenchToolsSectionView
                    x:Name="WorkbenchToolsSection" />
                <sections:WorkbenchShortcutsSectionView
                    x:Name="WorkbenchShortcutsSection" />
              </Carousel>
            </Border>
            <Border x:Name="WorkbenchInspectorScrim"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource AppScrimBrush}"
                    IsVisible="False"
                    AutomationProperties.Name="{DynamicResource Loc.Workbench.Drawer.CloseAutomation}"
                    PointerPressed="OnDrawerScrimPressed" />
          </Grid>
        </Grid>
      </controls:PersistedSplitView.Left>
      <controls:PersistedSplitView.Right>
        <Border x:Name="WorkbenchDrawerPane"
                Classes="card"
                Padding="0"
                ClipToBounds="True"
                AutomationProperties.Name="{DynamicResource Loc.Workbench.Drawer.Automation}">
          <Grid>
            <sections:WorkbenchInspectorDrawerView
                x:Name="WorkbenchInspectorDrawer"
                IsVisible="False" />
            <sections:WorkbenchPendingChangesDrawerView
                x:Name="WorkbenchPendingChangesDrawer"
                IsVisible="False" />
            <sections:WorkbenchColumnsDrawerView
                x:Name="WorkbenchColumnsDrawer"
                IsVisible="False" />
            <sections:WorkbenchTranscodeDrawerView
                x:Name="WorkbenchTranscodeDrawer"
                IsVisible="False" />
          </Grid>
        </Border>
      </controls:PersistedSplitView.Right>
    </controls:PersistedSplitView>

    <Border x:Name="WorkbenchHeaderScrim"
            Grid.RowSpan="2"
            Background="{DynamicResource AppScrimBrush}"
            IsVisible="False"
            AutomationProperties.Name="{DynamicResource Loc.Workbench.Drawer.CloseAutomation}"
            PointerPressed="OnDrawerScrimPressed" />
  </Grid>
</UserControl>
