<UserControl x:Class="MusicLibraryManager.Views.HomeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MusicLibraryManager.Controls">
  <controls:AdaptivePage x:Name="PageScaffold"
                         RowDefinitions="Auto,Auto,*"
                         RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Classes="page-title"
                   Text="{DynamicResource Loc.Home.Title}"
                   Focusable="False"
                   AutomationProperties.HeadingLevel="1" />
        <TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Subtitle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasConfiguration}">
          <Button Classes="app" Content="{DynamicResource Loc.Home.Action.Refresh}" Command="{Binding RefreshCommand}" />
          <Button Classes="app primary" Content="{DynamicResource Loc.Home.Action.OpenLibrary}" Command="{Binding OpenLibraryCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Classes="status-banner error" IsVisible="{Binding HasError}"
            AutomationProperties.LiveSetting="Assertive">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />
        <TextBlock Classes="muted"
                   Text="{Binding ErrorDetail}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasErrorDetail}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="content-stack">
        <Border Classes="section-frame" IsVisible="{Binding NeedsSetup}">
          <Grid x:Name="SetupLayout" ColumnDefinitions="1.2*,0.8*" ColumnSpacing="24">
            <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="{DynamicResource Loc.Home.Empty.Title}" />
          <TextBlock Classes="supporting" Text="{DynamicResource Loc.Home.Empty.Description}" TextWrapping="Wrap" />
          <Button Classes="app primary" HorizontalAlignment="Left" Content="{DynamicResource Loc.Home.Empty.Action}"
                      Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="12">
              <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                <Border Width="26" Height="26" CornerRadius="99" Background="{DynamicResource AppAccentBrush}"><TextBlock Text="1" Foreground="{DynamicResource AppAccentInkBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Loc.Home.Step.ChooseConfiguration.Title}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Step.ChooseConfiguration.Description}" TextWrapping="Wrap" /></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                <Border Width="26" Height="26" CornerRadius="99" Background="{DynamicResource AppInsetBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"><TextBlock Text="2" Classes="muted" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Loc.Home.Step.AddRoots.Title}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Step.AddRoots.Description}" TextWrapping="Wrap" /></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                <Border Width="26" Height="26" CornerRadius="99" Background="{DynamicResource AppInsetBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"><TextBlock Text="3" Classes="muted" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Loc.Home.Step.Index.Title}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Step.Index.Description}" TextWrapping="Wrap" /></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                <Border Width="26" Height="26" CornerRadius="99" Background="{DynamicResource AppInsetBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"><TextBlock Text="4" Classes="muted" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Loc.Home.Step.Browse.Title}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Step.Browse.Description}" TextWrapping="Wrap" /></StackPanel>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="card" IsVisible="{Binding Indexing.IsIndexing}">
          <Grid x:Name="IndexingBannerLayout" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <ProgressBar Width="22" Height="22" IsIndeterminate="True" />
            <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{DynamicResource Loc.Home.Indexing.Scanning}" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="{Binding Indexing.StatusText}" />
              <TextBlock Classes="faint"
                         Text="{Binding Indexing.DiagnosticDetail}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Indexing.HasDiagnosticDetail}" />
            </StackPanel>
          </Grid>
        </Border>

        <UniformGrid x:Name="MetricGrid" Columns="4" IsVisible="{Binding HasConfiguration}">
          <Border Classes="card" Margin="4">
            <StackPanel Spacing="8"><TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Metric.Tracks}" FontWeight="SemiBold" /><TextBlock Text="{Binding TrackCount}" FontFamily="{DynamicResource AppDisplayFont}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
          </Border>
          <Border Classes="card" Margin="4">
            <StackPanel Spacing="8"><TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Metric.Albums}" FontWeight="SemiBold" /><TextBlock Text="{Binding AlbumCount}" FontFamily="{DynamicResource AppDisplayFont}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
          </Border>
          <Border Classes="card" Margin="4">
            <StackPanel Spacing="8"><TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Metric.AlbumArtists}" FontWeight="SemiBold" /><TextBlock Text="{Binding ArtistCount}" FontFamily="{DynamicResource AppDisplayFont}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
          </Border>
          <Border Classes="card" Margin="4">
            <StackPanel Spacing="8"><TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Metric.ArtworkCached}" FontWeight="SemiBold" /><TextBlock Text="{Binding ArtworkCount}" FontFamily="{DynamicResource AppDisplayFont}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
          </Border>
        </UniformGrid>

        <Grid x:Name="HealthMetricLayout" ColumnDefinitions="*,14,*" IsVisible="{Binding HasConfiguration}">
          <Border Grid.Column="0" Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Metric.LastSuccessfulIndex}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LastIndexTime}" FontFamily="{DynamicResource AppDisplayFont}" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="8">
                <TextBlock Classes="muted" Text="{DynamicResource Loc.Home.Metric.RootsNeedingAttention}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding AttentionCount}" FontFamily="{DynamicResource AppDisplayFont}" FontSize="20" FontWeight="SemiBold" />
              </StackPanel>
              <Button Grid.Column="1" Classes="app" Content="{DynamicResource Loc.Home.Action.OpenHealth}" Command="{Binding OpenHealthCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="LibraryActionLayout" ColumnDefinitions="1.45*,14,1*" IsVisible="{Binding HasConfiguration}">
          <Border Grid.Column="0" Classes="card">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="8" Height="8" Fill="{DynamicResource AppAccentBrush}" /><TextBlock Classes="section-title" Text="{DynamicResource Loc.Home.Roots.Title}" /></StackPanel>
              <TextBlock Classes="muted" Text="{Binding RootHealth}" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{DynamicResource Loc.Home.Roots.Description}" TextWrapping="Wrap" />
              <Button Classes="app" HorizontalAlignment="Left" Content="{DynamicResource Loc.Home.Action.ReviewConfiguration}" Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card">
            <StackPanel Spacing="12">
            <TextBlock Classes="section-title" Text="{DynamicResource Loc.Home.Indexing.Title}" />
              <TextBlock Classes="muted" Text="{Binding Indexing.StatusText}" TextWrapping="Wrap" />
              <TextBlock Classes="faint"
                         Text="{Binding Indexing.DiagnosticDetail}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Indexing.HasDiagnosticDetail}" />
              <ProgressBar Classes="app" Minimum="0" Maximum="1" Value="{Binding Indexing.Progress}" IsVisible="{Binding Indexing.IsIndexing}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="app" Content="{DynamicResource Loc.Home.Indexing.IndexLibrary}" Command="{Binding Indexing.IndexCommand}" />
                <Button Classes="app" Content="{DynamicResource Loc.Home.Indexing.Cancel}" Command="{Binding Indexing.CancelCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="card" IsVisible="{Binding HasRecentActivity}">
          <StackPanel Spacing="12">
            <TextBlock Classes="section-title" Text="{DynamicResource Loc.Home.RecentActivity.Title}" />
            <ItemsControl ItemsSource="{Binding RecentActivityItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,180,*,Auto" ColumnSpacing="12">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Classes="muted" Text="{Binding State}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </controls:AdaptivePage>
</UserControl>
