<UserControl
    x:Class="MusicLibraryManager.Pages.LibraryPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    Background="Transparent">
    <Grid Margin="24,20,24,24" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Library" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Browse the cache instantly, even when music roots are offline." Opacity="0.66" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Reload" Command="{Binding ReloadCommand}"/>
                <Button Content="Index library" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Indexing.IndexCommand}"/>
                <Button Content="Cancel" Command="{Binding Indexing.CancelCommand}"/>
                <Button x:Name="InspectorButton" Content="Inspector" Visibility="Collapsed" Click="InspectorButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" MinWidth="220" PlaceholderText="Filter, or use Artist:Name AND NOT Codec:MP3"
                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox Grid.Column="1" Width="110" ItemsSource="{Binding FilterModes}" SelectedItem="{Binding FilterMode, Mode=TwoWay}"/>
            <Button Grid.Column="2" Content="Columns">
                <Button.Flyout>
                    <Flyout>
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible, Mode=TwoWay}" Click="ColumnVisibility_Changed" Padding="6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <ComboBox Grid.Column="3" Width="150" ItemsSource="{Binding SavedViews}" SelectedItem="{Binding SelectedView, Mode=TwoWay}" DisplayMemberPath="Name"/>
            <TextBox Grid.Column="4" Width="120" PlaceholderText="View name" Text="{Binding NewViewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                <Button Content="Save view" Command="{Binding SaveViewCommand}"/>
                <Button Content="Delete" Command="{Binding DeleteViewCommand}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TableColumn" Width="*" MinWidth="360"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="390" MinWidth="280" MaxWidth="620"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" Clip="{x:Null}">
                <tv:TableView x:Name="LibraryTable" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="Row" RowHeight="42" HeaderRowHeight="42"
                              CanResizeColumns="True" CanReorderColumns="True" CanSortColumns="True"
                              SelectionChanged="LibraryTable_SelectionChanged"
                              ContainerContentChanging="LibraryTable_ContainerContentChanging">
                    <tv:TableView.RowContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Copy path(s)" Click="CopyPaths_Click"/>
                            <MenuFlyoutItem Text="Reveal first file" Click="RevealFile_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Reindex selection" Click="ReindexSelection_Click"/>
                        </MenuFlyout>
                    </tv:TableView.RowContextFlyout>
                    <tv:TableView.Columns>
                        <tv:TableViewTemplateColumn Header="Artwork" Width="58" MinWidth="58" MaxWidth="58" CanSort="False" CanResize="False">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="34" Height="34" CornerRadius="4" Background="{StaticResource CardStrokeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding ThumbnailSource}" Width="34" Height="34" Stretch="UniformToFill"/>
                                    </Border>
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                        <tv:TableViewTextColumn Header="Title" Binding="{Binding Title}" SortMemberPath="Title" Width="280" MinWidth="140"/>
                        <tv:TableViewTextColumn Header="Artist" Binding="{Binding Artist}" SortMemberPath="Artist" Width="190" MinWidth="100"/>
                        <tv:TableViewTextColumn Header="Album artist" Binding="{Binding AlbumArtist}" SortMemberPath="AlbumArtist" Width="190" MinWidth="100" Visibility="Collapsed"/>
                        <tv:TableViewTextColumn Header="Album" Binding="{Binding Album}" SortMemberPath="Album" Width="230" MinWidth="120"/>
                        <tv:TableViewTextColumn Header="Track" Binding="{Binding Track}" SortMemberPath="Track" Width="70"/>
                        <tv:TableViewTextColumn Header="Disc" Binding="{Binding Disc}" SortMemberPath="Disc" Width="65" Visibility="Collapsed"/>
                        <tv:TableViewTextColumn Header="Codec" Binding="{Binding Codec}" SortMemberPath="Codec" Width="105"/>
                        <tv:TableViewTextColumn Header="Duration" Binding="{Binding Duration}" SortMemberPath="Duration" Width="90"/>
                        <tv:TableViewTextColumn Header="Modified" Binding="{Binding Modified}" SortMemberPath="Modified" Width="150" Visibility="Collapsed"/>
                        <tv:TableViewTextColumn Header="Path" Binding="{Binding Path}" SortMemberPath="Path" Width="420"/>
                    </tv:TableView.Columns>
                </tv:TableView>
            </Border>

            <Border x:Name="InspectorPanel" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18" DataContext="{Binding Inspector}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Selection" Opacity="0.62"/>
                        <TextBlock Text="{Binding SelectionSummary}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TabView Grid.Row="1" IsAddTabButtonVisible="False">
                        <TabViewItem Header="Overview" IsClosable="False">
                            <ScrollViewer><StackPanel Margin="4,14,4,4" Spacing="12">
                                <TextBlock Text="{Binding Overview}" TextWrapping="Wrap"/>
                                <ProgressRing IsActive="{Binding IsBusy}"/>
                            </StackPanel></ScrollViewer>
                        </TabViewItem>
                        <TabViewItem Header="Tags" IsClosable="False">
                            <Grid Margin="4,14,4,4" RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Margin="0,3" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Opacity="0.68"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel Grid.Row="1" Spacing="8">
                                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.72"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save tags" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveTagsCommand}"/>
                                        <Button Content="All fields…" Command="{Binding EditAllFieldsCommand}"/>
                                        <Button Content="Revert" Command="{Binding RevertCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </TabViewItem>
                        <TabViewItem Header="Artwork" IsClosable="False">
                            <ScrollViewer><StackPanel Margin="4,14,4,4" Spacing="10">
                                <Border Background="#16000000" CornerRadius="10" Padding="8"><Image Source="{Binding ArtworkSource}" Height="260" Stretch="Uniform"/></Border>
                                <TextBlock Text="{Binding ArtworkSummary}" TextWrapping="Wrap" Opacity="0.68"/>
                                <TextBlock Text="Maximum dimension" Opacity="0.68"/>
                                <TextBox Text="{Binding ArtworkMaxDimension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Replace" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ReplaceArtworkCommand}"/>
                                    <Button Content="Optimize" Command="{Binding ScrubArtworkCommand}"/>
                                    <Button Content="Remove" Command="{Binding RemoveArtworkCommand}"/>
                                </StackPanel>
                            </StackPanel></ScrollViewer>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Opacity="0.68" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="{Binding Indexing.StatusText}" Opacity="0.58" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</UserControl>
