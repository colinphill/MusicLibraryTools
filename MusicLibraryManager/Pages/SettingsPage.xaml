<UserControl x:Class="MusicLibraryManager.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Margin="36,30,36,56" MaxWidth="1100" HorizontalAlignment="Stretch">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Library configuration and Music Library Manager preferences." Opacity="0.66" Margin="0,5,0,0" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Active library" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding ActiveConfigurationPath}" TextWrapping="Wrap" Opacity="0.72" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button Content="Open configuration" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding BrowseConfigurationCommand}" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" MinWidth="220" MaxWidth="520" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding RecentConfigurations}"
                                  SelectedItem="{Binding SelectedRecentConfiguration}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Load recent" Command="{Binding LoadRecentConfigurationCommand}" Margin="0,0,8,0" />
                            <Button Content="Clear recent" Command="{Binding ClearRecentConfigurationsCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Configuration editor" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding EditorPath}" Opacity="0.62" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Edit active" Command="{Binding EditCurrentConfigurationCommand}" Margin="0,0,8,0" />
                            <Button Content="New" Command="{Binding NewConfigurationCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Metadata cache" VerticalAlignment="Center" Opacity="0.68" />
                        <TextBox Grid.Column="1" Text="{Binding DatabaseFile, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8" />
                        <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseDatabaseCommand}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Text="iTunes library" VerticalAlignment="Center" Opacity="0.68" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ItunesLibraryPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Browse" Command="{Binding BrowseItunesLibraryCommand}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Text="ffmpeg" VerticalAlignment="Center" Opacity="0.68" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Grid.Row="2" Grid.Column="2" Content="Browse" Command="{Binding BrowseFfmpegCommand}" />
                    </Grid>

                    <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Maximum path length" Opacity="0.68"/>
                                <TextBox Text="{Binding LengthLimit}" Margin="0,4,0,0" ToolTip="Maximum generated path length"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Maximum disc title length" Opacity="0.68"/>
                                <TextBox Text="{Binding DiscNumLengthLimit}" Margin="0,4,0,0" ToolTip="Maximum title component length for multi-disc naming"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,9,0,0" Opacity="0.58" TextWrapping="Wrap"
                                       Text="These limits are used by canonical naming and organization previews."/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Music roots" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Clear sync target" Command="{Binding ClearSyncTargetCommand}" Margin="0,0,8,0"/>
                            <Button Content="Add root" Command="{Binding AddIndexTargetCommand}" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding IndexTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Indexed music folder" />
                                            <Button Grid.Column="1" Content="Browse"
                                                    Command="{Binding DataContext.BrowseIndexTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,6,0" />
                                            <Button Grid.Column="2" Content="Remove"
                                                    Command="{Binding DataContext.RemoveIndexTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="File filter" Opacity="0.64"/>
                                                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                                                         ToolTip="Optional extension filter, for example *.flac"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="Default playlist offset" Opacity="0.64"/>
                                                <TextBox Text="{Binding DefaultOffset, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                                                         ToolTip="Default exported path prefix for all set memberships"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Ingest destination role" Opacity="0.64"/>
                                                <ComboBox ItemsSource="{Binding DataContext.IngestRoles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding IngestRole}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <WrapPanel Margin="0,10,0,4">
                                            <CheckBox Content="Include in organization" IsChecked="{Binding Organize}" Margin="0,0,18,6"/>
                                            <CheckBox Content="Use iTunes canonical naming" IsChecked="{Binding UseItunesCanonicalNaming}" Margin="0,0,18,6"
                                                      ToolTip="Use iTunes Media component and filename rules for this root"/>
                                            <RadioButton Content="Cross-library sync destination" IsChecked="{Binding IsSyncTarget}"
                                                         GroupName="CrossLibrarySyncTarget" Margin="0,0,18,6"/>
                                        </WrapPanel>

                                        <Grid Margin="0,6,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Set memberships" FontWeight="SemiBold"/>
                                                <TextBlock Text="The default offset is used unless a membership supplies an override." Opacity="0.58" FontSize="11"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Add set"
                                                    Command="{Binding DataContext.AddIndexTargetSetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Memberships}" Margin="18,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="Set name" FontSize="11" Opacity="0.58"/>
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"
                                                                     ToolTip="Alphanumeric set name"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                            <TextBlock Text="Offset override" FontSize="11" Opacity="0.58"/>
                                                            <TextBox Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"
                                                                     ToolTip="Optional offset override for this set"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="Remove" VerticalAlignment="Bottom"
                                                                Command="{Binding DataContext.RemoveIndexTargetSetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,0,14">
                        <StackPanel>
                            <TextBlock Text="Ingest behavior" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Assign destination roles on the music roots above. Each role can be assigned once." Opacity="0.6" Margin="0,3,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="AAC encoder" Opacity="0.64"/>
                                    <TextBox Text="{Binding AacEncoder, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="AAC bitrate (kbit/s)" Opacity="0.64"/>
                                    <TextBox Text="{Binding AacBitrateKbps}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <CheckBox Content="Delete successfully ingested sources" IsChecked="{Binding DeleteSourcesAfterIngest}" Margin="0,0,18,4"/>
                                <CheckBox Content="Also remove non-music files and empty folders" IsChecked="{Binding RemoveNonMusicAfterIngest}" Margin="0,0,0,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Cross-library sync playlists" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="These playlists sync to the music root selected as the cross-library destination." Opacity="0.6" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Add playlist" Command="{Binding AddSyncPlaylistCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SyncPlaylists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="iTunes playlist name"/>
                                            <Button Grid.Column="1" Content="Remove"
                                                    Command="{Binding DataContext.RemoveSyncPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Playlist export targets" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="Export M3U or WPL playlists using paths resolved from selected root sets and offsets." Opacity="0.6" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Add target" Command="{Binding AddPlaylistTargetCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PlaylistTargets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="Export folder" FontSize="11" Opacity="0.58"/>
                                                    <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" ToolTip="Playlist export folder"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="Type" FontSize="11" Opacity="0.58"/>
                                                    <ComboBox ItemsSource="{Binding DataContext.PlaylistTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding Type}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                    <TextBlock Text="Scan sets" FontSize="11" Opacity="0.58"/>
                                                    <TextBox Text="{Binding Sets, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"
                                                             ToolTip="Required comma-separated set names"/>
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="Browse" VerticalAlignment="Bottom"
                                                        Command="{Binding DataContext.BrowsePlaylistTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                                <Button Grid.Column="4" Content="Remove" VerticalAlignment="Bottom"
                                                        Command="{Binding DataContext.RemovePlaylistTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.72" Margin="0,4,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveConfigurationCommand}" Margin="0,0,8,0" />
                        <Button Content="Save as" Command="{Binding SaveConfigurationAsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Follow Windows, or choose a consistent light or dark workspace." Opacity="0.66" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
