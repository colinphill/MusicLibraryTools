<UserControl
    x:Class="MusicLibraryManager.Pages.SettingsPage" x:Name="SettingsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Margin="28,24,28,28" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Choose the active library, edit roots and tools, and control appearance." Opacity="0.66" Margin="0,4,0,0"/></StackPanel>
        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Message="{Binding StatusMessage}"/>
        <TabView Grid.Row="2" IsAddTabButtonVisible="False" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabViewItem Header="Configuration" IsClosable="False">
                <ScrollViewer><StackPanel Spacing="14" Padding="4,8">
                    <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10">
                        <TextBlock Text="Active configuration" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding ActiveConfigurationPath}" TextWrapping="Wrap" Opacity="0.72"/>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open and edit configuration" Command="{Binding BrowseConfigurationCommand}"/><Button Content="Edit current" Command="{Binding EditCurrentConfigurationCommand}"/><Button Content="New" Command="{Binding NewConfigurationCommand}"/></StackPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10">
                        <TextBlock Text="Recent configurations" Style="{StaticResource SectionTitleStyle}"/>
                        <ComboBox ItemsSource="{Binding RecentConfigurations}" SelectedItem="{Binding SelectedRecentConfiguration, Mode=TwoWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Load" Command="{Binding LoadRecentConfigurationCommand}"/><Button Content="Clear history" Command="{Binding ClearRecentConfigurationsCommand}"/></StackPanel>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Editor" IsClosable="False">
                <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding EditorPath}" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                    <ScrollViewer Grid.Row="1"><StackPanel Spacing="14" Padding="4,8">
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10">
                            <TextBlock Text="Core paths" Style="{StaticResource SectionTitleStyle}"/>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Header="Metadata database" Text="{Binding DatabaseFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse" Command="{Binding BrowseDatabaseCommand}" VerticalAlignment="Bottom"/></Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Header="iTunes library" Text="{Binding ItunesLibraryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse" Command="{Binding BrowseItunesLibraryCommand}" VerticalAlignment="Bottom"/></Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Header="ffmpeg" Text="{Binding FfmpegPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse" Command="{Binding BrowseFfmpegCommand}" VerticalAlignment="Bottom"/></Grid>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Header="Path length" Text="{Binding LengthLimit, Mode=TwoWay}"/><TextBox Grid.Column="1" Header="Disc path length" Text="{Binding DiscNumLengthLimit, Mode=TwoWay}"/><TextBox Grid.Column="2" Header="AAC encoder" Text="{Binding AacEncoder, Mode=TwoWay}"/><TextBox Grid.Column="3" Header="AAC kbps" Text="{Binding AacBitrateKbps, Mode=TwoWay}"/></Grid>
                            <StackPanel Orientation="Horizontal" Spacing="14"><CheckBox Content="Delete sources after ingest" IsChecked="{Binding DeleteSourcesAfterIngest, Mode=TwoWay}"/><CheckBox Content="Remove non-music after ingest" IsChecked="{Binding RemoveNonMusicAfterIngest, Mode=TwoWay}"/></StackPanel>
                        </StackPanel></Border>

                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Library roots" Style="{StaticResource SectionTitleStyle}"/><Button Grid.Column="1" Content="Clear sync target" Command="{Binding ClearSyncTargetCommand}" Margin="0,0,8,0"/><Button Grid.Column="2" Content="Add root" Command="{Binding AddIndexTargetCommand}"/></Grid>
                            <ItemsControl ItemsSource="{Binding IndexTargets}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"><StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Music root"/><Button Grid.Column="1" Content="Browse" Click="BrowseRoot_Click" Tag="{Binding}"/><Button Grid.Column="2" Content="Remove" Click="RemoveRoot_Click" Tag="{Binding}"/></Grid>
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional extension filter"/><ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.IngestRoles, ElementName=SettingsRoot}" SelectedItem="{Binding IngestRole, Mode=TwoWay}"/><CheckBox Grid.Column="2" Content="Organize" IsChecked="{Binding Organize, Mode=TwoWay}"/><CheckBox Grid.Column="3" Content="Sync target" IsChecked="{Binding IsSyncTarget, Mode=TwoWay}"/></Grid>
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding DefaultOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Default set offset"/><CheckBox Grid.Column="1" Content="iTunes canonical naming" IsChecked="{Binding UseItunesCanonicalNaming, Mode=TwoWay}"/><Button Grid.Column="2" Content="Add set" Command="{Binding DataContext.AddIndexTargetSetCommand, ElementName=SettingsRoot}" CommandParameter="{Binding}"/><TextBlock Grid.Column="3" Text="Set offsets override the default for this root." Opacity="0.58" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
                                    <ItemsControl ItemsSource="{Binding Memberships}" Margin="18,0,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid ColumnSpacing="8" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Scan-set name"/><TextBox Grid.Column="1" Text="{Binding Offset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional offset override"/><Button Grid.Column="2" Content="Remove set" Command="{Binding DataContext.RemoveIndexTargetSetCommand, ElementName=SettingsRoot}" CommandParameter="{Binding}"/></Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel></Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel></Border>

                        <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Sync playlists" Style="{StaticResource SectionTitleStyle}"/><Button Grid.Column="1" Content="Add" Command="{Binding AddSyncPlaylistCommand}"/></Grid><ItemsControl ItemsSource="{Binding SyncPlaylists}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Remove" Command="{Binding DataContext.RemoveSyncPlaylistCommand, ElementName=SettingsRoot}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Playlist targets" Style="{StaticResource SectionTitleStyle}"/><Button Grid.Column="1" Content="Add" Command="{Binding AddPlaylistTargetCommand}"/></Grid><TextBlock Text="Each export target requires one or more comma-separated scan sets." Opacity="0.58" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding PlaylistTargets}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Export folder"/><Button Grid.Column="1" Content="Browse" Command="{Binding DataContext.BrowsePlaylistTargetCommand, ElementName=SettingsRoot}" CommandParameter="{Binding}"/><ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.PlaylistTypes, ElementName=SettingsRoot}" SelectedItem="{Binding Type, Mode=TwoWay}"/><TextBox Grid.Column="3" Text="{Binding Sets, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="set1,set2"/><Button Grid.Column="4" Content="Remove" Command="{Binding DataContext.RemovePlaylistTargetCommand, ElementName=SettingsRoot}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        </Grid>
                    </StackPanel></ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Save as" Command="{Binding SaveConfigurationAsCommand}"/><Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveConfigurationCommand}"/></StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Appearance" IsClosable="False">
                <Border Style="{StaticResource CardStyle}" Margin="4,8" VerticalAlignment="Top"><StackPanel Spacing="10"><TextBlock Text="Theme" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="WinUI controls and TableView consume the same native theme resources." Opacity="0.66" TextWrapping="Wrap"/><ComboBox Width="180" HorizontalAlignment="Left" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"/></StackPanel></Border>
            </TabViewItem>
        </TabView>
    </Grid>
</UserControl>
