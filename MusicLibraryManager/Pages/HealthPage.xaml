<UserControl
    x:Class="MusicLibraryManager.Pages.HealthPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicLibraryManager.Controls"
    xmlns:tv="using:WinUI.TableView"
    Background="Transparent">
    <Grid Margin="28,24,28,28" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Health" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Audit the collection, review every proposed change, then apply safe repairs." Opacity="0.66" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Apply metadata repairs" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyRepairsCommand}"/>
                <Button Content="Apply file repairs" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyRepresentationRepairsCommand}"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <StackPanel Spacing="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Inconsistencies" Command="{Binding RunInconsistenciesCommand}"/>
                        <Button Content="Lossy files" Command="{Binding RunLossyCommand}"/>
                        <Button Content="Duplicates" Command="{Binding RunDuplicatesCommand}"/>
                        <Button Content="Similar artists" Command="{Binding RunSimilarArtistsCommand}"/>
                        <Button Content="Cross-set check" Command="{Binding RunCheckSetsCommand}"/>
                        <Button Content="Representations" Command="{Binding RunRepresentationsCommand}"/>
                        <Button Content="Verify audio" Command="{Binding VerifyDecodedAudioCommand}"/>
                        <Button Content="Album matrix" Command="{Binding RunAlbumMatrixCommand}"/>
                        <Button Content="Artwork audit" Command="{Binding RunArtworkHealthCommand}"/>
                        <Button Content="Preview metadata repairs" Command="{Binding PreviewMetadataRepairsCommand}"/>
                        <Button Content="Preview file repairs" Command="{Binding PreviewRepresentationRepairsCommand}"/>
                        <Button Content="Album artist conflicts" Command="{Binding FindAlbumArtistConflictsCommand}"/>
                        <Button Content="Preview conflict repairs" Command="{Binding PreviewConflictRepairsCommand}"/>
                    </StackPanel>
                </ScrollViewer>
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.72"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250" MinWidth="200" MaxWidth="420"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Analysis history" Style="{StaticResource SectionTitleStyle}" Margin="4,2"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}">
                        <ListView.ItemTemplate><DataTemplate><StackPanel Margin="5,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DisplayLabel}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                        </StackPanel></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Remove" Command="{Binding RemoveRunCommand}"/>
                        <Button Content="Clear" Command="{Binding ClearRunsCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <controls:ColumnSplitter Grid.Column="1" AutomationProperties.Name="Resize analysis history" Style="{StaticResource ColumnSplitterStyle}"/>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                <TabView x:Name="ResultsTabs" IsAddTabButtonVisible="False" SelectedIndex="{Binding ActiveResultIndex, Mode=TwoWay}">
                    <TabViewItem Header="Findings" IsClosable="False">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="360" MinWidth="260" MaxWidth="560"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TreeView x:Name="FindingTree" SelectionMode="Single" SelectionChanged="FindingTree_SelectionChanged">
                                <TreeView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="310" MinHeight="38" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Content.Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Content.Count}" Opacity="0.58" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <controls:ColumnSplitter Grid.Column="1" AutomationProperties.Name="Resize findings hierarchy" Style="{StaticResource ColumnSplitterStyle}"/>
                            <Grid Grid.Column="2" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Files in selected branch" FontSize="15" FontWeight="SemiBold"/>
                                <tv:TableView Grid.Row="1" ItemsSource="{Binding DisplayedFindings}" AutoGenerateColumns="False"
                                              CanResizeColumns="True" CanReorderColumns="True" CanSortColumns="True" FrozenColumnCount="1"
                                              controls:TableViewColumnReorderBehavior.IsEnabled="True">
                                    <tv:TableView.Columns>
                                        <tv:TableViewTextColumn Header="Track" Binding="{Binding Path}" Width="360" MinWidth="240" IsReadOnly="True"/>
                                        <tv:TableViewTextColumn Header="Reason" Binding="{Binding Description}" Width="360" MinWidth="240" IsReadOnly="True"/>
                                    </tv:TableView.Columns>
                                </tv:TableView>
                            </Grid>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem Header="Duplicates" IsClosable="False">
                        <ScrollViewer><ItemsControl ItemsSource="{Binding Duplicates}" Margin="4,8">
                            <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <StackPanel Spacing="6"><TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Tracks}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                            </Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl></ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Header="Similar artists" IsClosable="False">
                        <ScrollViewer><ItemsControl ItemsSource="{Binding ArtistGroups}" Margin="4,8">
                            <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ItemsControl ItemsSource="{Binding Variants}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <TextBox Grid.Column="1" Text="{Binding CanonicalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="2" Content="Merge" Command="{Binding MergeCommand}"/>
                                </Grid>
                            </Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl></ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Header="Metadata repairs" IsClosable="False">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="360" MinWidth="260" MaxWidth="560"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TreeView x:Name="RepairTree" SelectionMode="Single" SelectionChanged="RepairTree_SelectionChanged">
                                <TreeView.ItemTemplate><DataTemplate>
                                    <Grid Width="310" MinHeight="38" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Content.Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Content.Count}" Opacity="0.58" VerticalAlignment="Center"/><ComboBox Grid.Column="2" ItemsSource="{Binding Content.Dispositions}" SelectedItem="{Binding Content.Disposition, Mode=TwoWay}" Visibility="{Binding Content.HasAutomatedRepair, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate></TreeView.ItemTemplate>
                            </TreeView>
                            <controls:ColumnSplitter Grid.Column="1" AutomationProperties.Name="Resize metadata repair hierarchy" Style="{StaticResource ColumnSplitterStyle}"/>
                            <tv:TableView Grid.Column="2" ItemsSource="{Binding DisplayedRepairItems}" AutoGenerateColumns="False" CanResizeColumns="True" CanReorderColumns="True" FrozenColumnCount="1"
                                          controls:TableViewColumnReorderBehavior.IsEnabled="True">
                                <tv:TableView.Columns>
                                    <tv:TableViewTemplateColumn Header="Disposition" Width="150"><tv:TableViewTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Visibility="{Binding CanChangeDisposition, Converter={StaticResource BooleanToVisibilityConverter}}"/></DataTemplate></tv:TableViewTemplateColumn.CellTemplate></tv:TableViewTemplateColumn>
                                    <tv:TableViewTextColumn Header="Track" Binding="{Binding DisplayPath}" Width="320" IsReadOnly="True"/><tv:TableViewTextColumn Header="Before" Binding="{Binding Before}" Width="180" IsReadOnly="True"/><tv:TableViewTextColumn Header="After" Binding="{Binding After}" Width="180" IsReadOnly="True"/><tv:TableViewTextColumn Header="Reason" Binding="{Binding Reason}" Width="300" IsReadOnly="True"/>
                                </tv:TableView.Columns>
                            </tv:TableView>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem Header="File repairs" IsClosable="False">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="360" MinWidth="260" MaxWidth="560"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TreeView x:Name="RepresentationTree" SelectionMode="Single" SelectionChanged="RepresentationTree_SelectionChanged">
                                <TreeView.ItemTemplate><DataTemplate>
                                    <Grid Width="310" MinHeight="38" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Content.Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Content.Count}" Opacity="0.58" VerticalAlignment="Center"/><ComboBox Grid.Column="2" ItemsSource="{Binding Content.Dispositions}" SelectedItem="{Binding Content.Disposition, Mode=TwoWay}" Visibility="{Binding Content.HasAutomatedRepair, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate></TreeView.ItemTemplate>
                            </TreeView>
                            <controls:ColumnSplitter Grid.Column="1" AutomationProperties.Name="Resize file repair hierarchy" Style="{StaticResource ColumnSplitterStyle}"/>
                            <tv:TableView Grid.Column="2" ItemsSource="{Binding DisplayedRepresentationItems}" AutoGenerateColumns="False" CanResizeColumns="True" CanReorderColumns="True" FrozenColumnCount="1"
                                          controls:TableViewColumnReorderBehavior.IsEnabled="True">
                                <tv:TableView.Columns>
                                    <tv:TableViewTemplateColumn Header="Disposition" Width="150"><tv:TableViewTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Visibility="{Binding CanChangeDisposition, Converter={StaticResource BooleanToVisibilityConverter}}"/></DataTemplate></tv:TableViewTemplateColumn.CellTemplate></tv:TableViewTemplateColumn>
                                    <tv:TableViewTextColumn Header="Track" Binding="{Binding SourcePath}" Width="320" IsReadOnly="True"/><tv:TableViewTextColumn Header="Action" Binding="{Binding Description}" Width="260" IsReadOnly="True"/><tv:TableViewTextColumn Header="Destination" Binding="{Binding DestinationPath}" Width="320" IsReadOnly="True"/><tv:TableViewTextColumn Header="Result" Binding="{Binding ResultText}" Width="180" IsReadOnly="True"/>
                                </tv:TableView.Columns>
                            </tv:TableView>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem Header="Conflicts" IsClosable="False">
                        <tv:TableView ItemsSource="{Binding ConflictGroups}" AutoGenerateColumns="False" CanResizeColumns="True" CanReorderColumns="True"
                                      controls:TableViewColumnReorderBehavior.IsEnabled="True">
                            <tv:TableView.Columns>
                                <tv:TableViewTextColumn Header="Album" Binding="{Binding Album}" Width="180" IsReadOnly="True"/><tv:TableViewTextColumn Header="Field" Binding="{Binding Field}" Width="120" IsReadOnly="True"/><tv:TableViewTextColumn Header="Files" Binding="{Binding FileCount}" Width="65" IsReadOnly="True"/>
                                <tv:TableViewTemplateColumn Header="Canonical value" Width="220"><tv:TableViewTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}" DisplayMemberPath="Value"/></DataTemplate></tv:TableViewTemplateColumn.CellTemplate></tv:TableViewTemplateColumn>
                                <tv:TableViewTextColumn Header="Directory" Binding="{Binding Directory}" Width="320" IsReadOnly="True"/>
                            </tv:TableView.Columns>
                        </tv:TableView>
                    </TabViewItem>

                    <TabViewItem Header="Album matrix" IsClosable="False">
                        <ScrollViewer><ItemsControl ItemsSource="{Binding Matrices}" Margin="4,8"><ItemsControl.ItemTemplate><DataTemplate>
                            <Expander Header="{Binding DisplayName}" IsExpanded="True" Margin="0,0,0,8">
                                <tv:TableView ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="360" CanResizeColumns="True">
                                    <tv:TableView.Columns>
                                        <tv:TableViewTextColumn Header="Disc" Binding="{Binding DiscNumber.Display}" Width="60"/><tv:TableViewTextColumn Header="Track" Binding="{Binding TrackNumber.Display}" Width="65"/><tv:TableViewTextColumn Header="Title" Binding="{Binding Title.Display}" Width="180"/><tv:TableViewTextColumn Header="Artist" Binding="{Binding Artist.Display}" Width="150"/><tv:TableViewTextColumn Header="Album artist" Binding="{Binding AlbumArtist.Display}" Width="150"/><tv:TableViewTextColumn Header="Album" Binding="{Binding Album.Display}" Width="170"/><tv:TableViewTextColumn Header="Date" Binding="{Binding ReleaseDate.Display}" Width="90"/><tv:TableViewTextColumn Header="Path" Binding="{Binding Path}" Width="300"/>
                                    </tv:TableView.Columns>
                                </tv:TableView>
                            </Expander>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </TabViewItem>
                </TabView>
            </Border>
        </Grid>
    </Grid>
</UserControl>
