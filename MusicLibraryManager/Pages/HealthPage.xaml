<UserControl x:Class="MusicLibraryManager.Pages.HealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:MusicLibrary.App.ViewModels;assembly=MusicLibraryManager.Presentation"
      Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="AnalysisTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeView}, Mode=OneWay}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="AnalysisGridStyle" TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="MinColumnWidth" Value="70"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Health" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Audit the collection, review every proposed change, then apply safe repairs." Opacity="0.66" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Apply metadata repairs" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ApplyRepairsCommand}" Margin="0,0,8,0"
                        ToolTipService.ShowOnDisabled="True" ToolTip="Preview metadata repairs and leave at least one item Active first."/>
                <Button Content="Apply file repairs" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ApplyRepresentationRepairsCommand}" Margin="0,0,8,0"
                        ToolTipService.ShowOnDisabled="True" ToolTip="Preview file repairs and leave at least one item Active first."/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,14" Padding="16">
            <StackPanel>
                <WrapPanel>
                    <Button Content="Inconsistencies" Command="{Binding RunInconsistenciesCommand}" Margin="0,0,8,8"/>
                    <Button Content="Lossy files" Command="{Binding RunLossyCommand}" Margin="0,0,8,8"/>
                    <Button Content="Duplicates" Command="{Binding RunDuplicatesCommand}" Margin="0,0,8,8"/>
                    <Button Content="Similar artists" Command="{Binding RunSimilarArtistsCommand}" Margin="0,0,8,8"/>
                    <Button Content="Cross-set check" Command="{Binding RunCheckSetsCommand}" Margin="0,0,8,8"/>
                    <Button Content="Representations" Command="{Binding RunRepresentationsCommand}" Margin="0,0,8,8"/>
                    <Button Content="Verify decoded audio" Command="{Binding VerifyDecodedAudioCommand}" Margin="0,0,8,8"
                            ToolTipService.ShowOnDisabled="True" ToolTip="Run Representations first; verification is enabled when compatible lossless pairs are found."/>
                    <Button Content="Album matrix" Command="{Binding RunAlbumMatrixCommand}" Margin="0,0,8,8"/>
                    <Button Content="Artwork audit" Command="{Binding RunArtworkHealthCommand}" Margin="0,0,8,8"/>
                    <Button Content="Preview metadata repairs" Command="{Binding PreviewMetadataRepairsCommand}" Margin="0,0,8,8"/>
                    <Button Content="Preview file repairs" Command="{Binding PreviewRepresentationRepairsCommand}" Margin="0,0,8,8"
                            ToolTipService.ShowOnDisabled="True" ToolTip="Requires an active library configuration with representation roots."/>
                    <Button Content="Album artist conflicts" Command="{Binding FindAlbumArtistConflictsCommand}" Margin="0,0,0,8"/>
                    <Button Content="Preview chosen conflict repairs" Command="{Binding PreviewConflictRepairsCommand}" Margin="8,0,0,8"
                            ToolTipService.ShowOnDisabled="True" ToolTip="Find album artist conflicts, then choose a canonical value for one or more rows."/>
                </WrapPanel>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,2,0,8"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.72"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4,10,4,2">
                        <Button Content="Remove" Command="{Binding RemoveRunCommand}" Margin="0,0,8,0"/>
                        <Button Content="Clear" Command="{Binding ClearRunsCommand}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Analysis history" Style="{StaticResource SectionTitleStyle}" Margin="4,2,4,10"/>
                    <ListBox ItemsSource="{Binding Runs, Mode=OneWay}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AnalysisRunViewModel}">
                                <StackPanel Margin="5,6">
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplayLabel, Mode=OneWay}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14">
                <TabControl x:Name="ResultsTabs" Background="Transparent" BorderThickness="0"
                            SelectedIndex="{Binding ActiveResultIndex, Mode=TwoWay}">
                    <TabItem Header="Findings">
                        <Grid Margin="4,12,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="370" MinWidth="280"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*" MinWidth="360"/>
                            </Grid.ColumnDefinitions>
                            <TreeView ItemsSource="{Binding FindingGroups}" BorderThickness="0" Background="Transparent"
                                      FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabControl}, Mode=OneWay}"
                                      ItemContainerStyle="{StaticResource AnalysisTreeItemStyle}"
                                      SelectedItemChanged="FindingTree_SelectedItemChanged"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:AnalysisProblemGroupViewModel}" ItemsSource="{Binding Artists}">
                                        <Grid MinWidth="270" Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Problem, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Count, Mode=OneWay, StringFormat={}  ({0})}"/></TextBlock>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:AnalysisArtistGroupViewModel}" ItemsSource="{Binding Albums}">
                                        <Grid MinWidth="270" Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Artist, Mode=OneWay}"/><Run Text="{Binding Count, Mode=OneWay, StringFormat={}  ({0})}"/></TextBlock>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                    <DataTemplate DataType="{x:Type vm:AnalysisAlbumGroupViewModel}">
                                        <Grid MinWidth="270" Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Album, Mode=OneWay}"/><Run Text="{Binding Count, Mode=OneWay, StringFormat={}  ({0})}"/></TextBlock>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource CardStrokeBrush}"/>
                            <Grid Grid.Column="2" Margin="12,0,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Files in selected branch" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" Style="{StaticResource AnalysisGridStyle}" ItemsSource="{Binding DisplayedFindings}" AutoGenerateColumns="False"
                                          FrozenColumnCount="1" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="File disposition" Width="150" MinWidth="135">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Margin="4,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Track" Binding="{Binding Path, Mode=OneWay}" Width="2*" MinWidth="240" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Description, Mode=OneWay}" Width="2*" MinWidth="240" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Duplicates">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="4,12,4,4">
                            <ItemsControl ItemsSource="{Binding Duplicates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <ItemsControl ItemsSource="{Binding Tracks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding CodecName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding SampleRate, Mode=OneWay, StringFormat={}{0:N0} Hz}" Opacity="0.66"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Path, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path, Mode=OneWay}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Similar artists">
                        <ItemsControl ItemsSource="{Binding ArtistGroups}" Margin="4,12,4,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ArtistGroupViewModel}">
                                    <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TrackCount, Mode=OneWay, StringFormat={}Similar spellings across {0:N0} tracks}" FontWeight="SemiBold"/>
                                                <ItemsControl ItemsSource="{Binding Variants}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate><TextBlock><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding TrackCount, Mode=OneWay, StringFormat={}  ({0:N0} files)}"/></TextBlock></DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding Status, Mode=OneWay}" Opacity="0.66" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding CanonicalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,8,0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="Merge" Command="{Binding MergeCommand}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem Header="Metadata repairs">
                        <Grid Margin="4,12,4,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="370" MinWidth="280"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
                            <TreeView ItemsSource="{Binding RepairGroups}" BorderThickness="0" Background="Transparent"
                                      FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabControl}, Mode=OneWay}"
                                      ItemContainerStyle="{StaticResource AnalysisTreeItemStyle}" SelectedItemChanged="RepairTree_SelectedItemChanged"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:AnalysisRepairCategoryGroupViewModel}" ItemsSource="{Binding Artists}">
                                        <Grid MinWidth="270" Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Category, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Count, Mode=OneWay, StringFormat={}  ({0})}"/></TextBlock>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:AnalysisRepairArtistGroupViewModel}" ItemsSource="{Binding Albums}">
                                        <Grid MinWidth="270" Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Artist, Mode=OneWay}"/><Run Text="{Binding Count, Mode=OneWay, StringFormat={}  ({0})}"/></TextBlock>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                    <DataTemplate DataType="{x:Type vm:AnalysisRepairAlbumGroupViewModel}">
                                        <Grid MinWidth="270" Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Album, Mode=OneWay}"/><Run Text="{Binding Count, Mode=OneWay, StringFormat={}  ({0})}"/></TextBlock>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource CardStrokeBrush}"/>
                            <Grid Grid.Column="2" Margin="12,0,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Files in selected branch" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" Style="{StaticResource AnalysisGridStyle}" ItemsSource="{Binding DisplayedRepairItems}" AutoGenerateColumns="False"
                                          FrozenColumnCount="1" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="File disposition" Width="150" MinWidth="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" IsEnabled="{Binding CanChangeDisposition}" Margin="4,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Track" Binding="{Binding DisplayPath, Mode=OneWay}" Width="2*" MinWidth="240" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Before" Binding="{Binding Before, Mode=OneWay}" Width="*" MinWidth="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="After" Binding="{Binding After, Mode=OneWay}" Width="*" MinWidth="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason, Mode=OneWay}" Width="2*" MinWidth="220" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="File repairs">
                        <Grid Margin="4,12,4,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="370" MinWidth="280"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
                            <TreeView ItemsSource="{Binding RepresentationActionGroups}" BorderThickness="0" Background="Transparent"
                                      FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabControl}, Mode=OneWay}"
                                      ItemContainerStyle="{StaticResource AnalysisTreeItemStyle}" SelectedItemChanged="RepresentationTree_SelectedItemChanged"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:RepresentationRepairCategoryGroupViewModel}" ItemsSource="{Binding Artists}">
                                        <Grid MinWidth="270" Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Category, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Count, Mode=OneWay, StringFormat={}  ({0})}"/></TextBlock>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:RepresentationRepairArtistGroupViewModel}" ItemsSource="{Binding Albums}">
                                        <Grid MinWidth="270" Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Artist, Mode=OneWay}"/><Run Text="{Binding Count, Mode=OneWay, StringFormat={}  ({0})}"/></TextBlock>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                    <DataTemplate DataType="{x:Type vm:RepresentationRepairAlbumGroupViewModel}">
                                        <Grid MinWidth="270" Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Album, Mode=OneWay}"/><Run Text="{Binding Count, Mode=OneWay, StringFormat={}  ({0})}"/></TextBlock>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource CardStrokeBrush}"/>
                            <Grid Grid.Column="2" Margin="12,0,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Files in selected branch" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" Style="{StaticResource AnalysisGridStyle}" ItemsSource="{Binding DisplayedRepresentationItems}" AutoGenerateColumns="False"
                                          FrozenColumnCount="1" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="File disposition" Width="150" MinWidth="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Dispositions}" SelectedItem="{Binding Disposition, Mode=TwoWay}" Margin="4,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Track" Binding="{Binding SourcePath, Mode=OneWay}" Width="2*" MinWidth="240" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Action" Binding="{Binding Description, Mode=OneWay}" Width="2*" MinWidth="220" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Destination" Binding="{Binding DestinationPath, Mode=OneWay}" Width="2*" MinWidth="240" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Result" Binding="{Binding ResultText, Mode=OneWay}" Width="*" MinWidth="160" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Conflicts">
                        <DataGrid ItemsSource="{Binding ConflictGroups}" AutoGenerateColumns="False" Margin="4,12,4,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Album" Binding="{Binding Album, Mode=OneWay}" Width="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Field" Binding="{Binding Field, Mode=OneWay}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Files" Binding="{Binding FileCount, Mode=OneWay}" Width="65" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Canonical value" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><ComboBox ItemsSource="{Binding Options, Mode=OneWay}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}" DisplayMemberPath="Value"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Directory" Binding="{Binding Directory, Mode=OneWay}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Album matrix">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="4,12,4,4">
                            <ItemsControl ItemsSource="{Binding Matrices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="True" Margin="0,0,0,8">
                                            <Expander.Header>
                                                <TextBlock>
                                                    <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding TrackCount, Mode=OneWay, StringFormat={}  ·  {0:N0} tracks}"/>
                                                    <Run Text="{Binding InconsistentCellCount, Mode=OneWay, StringFormat={}  ·  {0:N0} differences}"/>
                                                </TextBlock>
                                            </Expander.Header>
                                            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                                                      MaxHeight="360" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Disc" Binding="{Binding DiscNumber.Display, Mode=OneWay}" Width="60"/>
                                                    <DataGridTextColumn Header="Track" Binding="{Binding TrackNumber.Display, Mode=OneWay}" Width="65"/>
                                                    <DataGridTextColumn Header="Title" Binding="{Binding Title.Display, Mode=OneWay}" Width="180"/>
                                                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist.Display, Mode=OneWay}" Width="150"/>
                                                    <DataGridTextColumn Header="Album artist" Binding="{Binding AlbumArtist.Display, Mode=OneWay}" Width="150"/>
                                                    <DataGridTextColumn Header="Album" Binding="{Binding Album.Display, Mode=OneWay}" Width="170"/>
                                                    <DataGridTextColumn Header="Date" Binding="{Binding ReleaseDate.Display, Mode=OneWay}" Width="90"/>
                                                    <DataGridTextColumn Header="Track total" Binding="{Binding TrackTotal.Display, Mode=OneWay}" Width="85"/>
                                                    <DataGridTextColumn Header="Disc total" Binding="{Binding DiscTotal.Display, Mode=OneWay}" Width="80"/>
                                                    <DataGridTextColumn Header="Path" Binding="{Binding Path, Mode=OneWay}" Width="300"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
