<UserControl
    x:Class="MusicLibraryManager.Pages.IngestPage" x:Name="IngestRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    Background="Transparent" AllowDrop="True" DragOver="IngestPage_DragOver" Drop="IngestPage_Drop">
    <Grid Margin="28,24,28,28" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Ingest" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Preflight, preview, and safely import music into the active library." Opacity="0.66" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Preflight" Command="{Binding PreflightCommand}"/>
                <Button Content="Preview" Command="{Binding PreviewCommand}"/>
                <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyCommand}"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <Grid RowSpacing="10" ColumnSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding SourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Source folder or file"/>
                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseSourceCommand}"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding RecentSources}" SelectedItem="{Binding SelectedRecentSource, Mode=TwoWay}" PlaceholderText="Recent sources"/>
                <TextBlock Grid.ColumnSpan="4" Grid.Row="1" Text="{Binding ConfigurationReadinessText}" TextWrapping="Wrap" Opacity="0.72"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8">
                    <ComboBox Width="190" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Preset"/>
                    <TextBox Width="170" Text="{Binding PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Preset name"/>
                    <Button Content="Save preset" Command="{Binding SavePresetCommand}"/>
                    <Button Content="Delete preset" Command="{Binding DeletePresetCommand}"/>
                    <ComboBox Width="170" ItemsSource="{Binding PreviewFilters}" SelectedItem="{Binding SelectedPreviewFilter, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabView Grid.Row="2" IsAddTabButtonVisible="False">
            <TabViewItem Header="Preview" IsClosable="False">
                <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding PreflightChecks}"><ItemsControl.ItemTemplate><DataTemplate><InfoBar IsOpen="True" IsClosable="False" Title="{Binding Severity}" Message="{Binding Message}" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding AlbumCount}"/><TextBlock Grid.Column="1" Text="{Binding OutputCount}"/><TextBlock Grid.Column="2" Text="{Binding CleanupCount}"/><TextBlock Grid.Column="3" Text="{Binding ConflictCount}"/>
                    </Grid>
                    <tv:TableView Grid.Row="2" ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True" CanResizeColumns="True" CanReorderColumns="True">
                        <tv:TableView.Columns>
                            <tv:TableViewTextColumn Header="Type" Binding="{Binding SourceType}" Width="145"/><tv:TableViewTextColumn Header="Source" Binding="{Binding Source}" Width="360"/><tv:TableViewTextColumn Header="Plan" Binding="{Binding Summary}" Width="480"/><tv:TableViewTextColumn Header="Progress" Binding="{Binding ProgressText}" Width="150"/>
                        </tv:TableView.Columns>
                    </tv:TableView>
                    <StackPanel Grid.Row="3" Spacing="6"><ProgressBar Value="{Binding ApplyProgress}" Maximum="{Binding ApplyProgressMaximum}"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.72"/></StackPanel>
                </Grid>
            </TabViewItem>
            <TabViewItem Header="History" IsClosable="False">
                <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh" Command="{Binding RefreshHistoryCommand}"/><TextBlock Text="{Binding HistoryStatus}" VerticalAlignment="Center" Opacity="0.7"/></StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding History}" SelectionMode="Single">
                        <ListView.ItemTemplate><DataTemplate><Grid Margin="4,6" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Created}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Source}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Opacity="0.65"/></StackPanel><Button Grid.Column="2" Content="Open" Command="{Binding DataContext.OpenHistoryCommand, ElementName=IngestRoot}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</UserControl>
