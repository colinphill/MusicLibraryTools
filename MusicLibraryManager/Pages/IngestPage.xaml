<UserControl x:Class="MusicLibraryManager.Pages.IngestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      AllowDrop="True" DragOver="IngestPage_DragOver" Drop="IngestPage_Drop"
      Background="Transparent">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Ingest" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Preflight incoming music, preview every output, then install it safely." Opacity="0.66" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Preflight" Command="{Binding PreflightCommand}" Margin="0,0,8,0"/>
                <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/>
                <Button Content="Apply ingest" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyCommand}" Margin="0,0,8,0"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1  Source" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <TextBlock Text="Drop a folder anywhere on this page, paste a path, or browse." Opacity="0.62" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseSourceCommand}" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding RecentSources}" SelectedItem="{Binding SelectedRecentSource}" Margin="0,8,0,0" ToolTip="Recent sources"/>
                            <TextBlock Text="{Binding ConfigurationReadinessText}" Opacity="0.68" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Presets" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"/>
                            <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,8" ToolTip="Preset name"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save preset" Command="{Binding SavePresetCommand}" Margin="0,0,8,0"/>
                                <Button Content="Delete" Command="{Binding DeletePresetCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Preflight checks" Style="{StaticResource SectionTitleStyle}"/>
                                <Button Grid.Column="1" Content="Run" Command="{Binding PreflightCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PreflightChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock><Run Text="{Binding Severity}" FontWeight="SemiBold"/><Run Text="{Binding Name, StringFormat={}  ·  {0}}"/></TextBlock>
                                            <TextBlock Text="{Binding Message}" Opacity="0.64" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Recovery history" Style="{StaticResource SectionTitleStyle}"/>
                                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshHistoryCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding HistoryStatus}" Opacity="0.64" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" MaxHeight="210" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3,5">
                                            <TextBlock Text="{Binding State}" FontWeight="SemiBold"/>
                                            <TextBlock><Run Text="{Binding Created}"/><Run Text="{Binding AffectedItems, StringFormat={}  ·  {0}}"/></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Open selected run" Command="{Binding OpenHistoryCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=HistoryList}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="2  Preview" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="{Binding StatusText}" Opacity="0.68" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="130" ItemsSource="{Binding PreviewFilters}" SelectedItem="{Binding SelectedPreviewFilter}"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,14,0,12">
                        <WrapPanel>
                            <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,8,8"><TextBlock Text="{Binding AlbumCount, StringFormat={}Albums  {0:N0}}"/></Border>
                            <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,8,8"><TextBlock Text="{Binding OutputCount, StringFormat={}Outputs  {0:N0}}"/></Border>
                            <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,8,8"><TextBlock Text="{Binding ConflictCount, StringFormat={}Conflicts  {0:N0}}"/></Border>
                            <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,8,8"><TextBlock Text="{Binding CleanupCount, StringFormat={}Cleanup  {0:N0}}"/></Border>
                        </WrapPanel>
                        <ProgressBar Minimum="0" Maximum="{Binding ApplyProgressMaximum}" Value="{Binding ApplyProgress}" Height="5" Margin="0,4,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding SourceType}" Width="145"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*"/>
                            <DataGridTextColumn Header="Plan" Binding="{Binding Summary}" Width="3*"/>
                            <DataGridTextColumn Header="Progress" Binding="{Binding ProgressText}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
