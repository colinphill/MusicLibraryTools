<UserControl x:Class="MusicLibraryManager.Pages.OperationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:MusicLibrary.App.ViewModels;assembly=MusicLibraryManager.Presentation"
      Background="Transparent">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Operations" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Run library jobs and recover interrupted or quarantined file operations." Opacity="0.66" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel active operation" Command="{Binding CancelCommand}" VerticalAlignment="Center"/>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,18,0,0" Background="Transparent" BorderThickness="0">
            <TabItem Header="Library jobs">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Choose a job" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                    <ComboBox ItemsSource="{Binding JobCatalog}" SelectedItem="{Binding SelectedJob}" DisplayMemberPath="Name"/>
                                    <TextBlock Text="{Binding SelectedJob.Description}" Opacity="0.66" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Inputs" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                    <StackPanel Visibility="{Binding ShowPlaylistName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Playlist" Opacity="0.66"/>
                                        <TextBox Text="{Binding JobPlaylistName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowDestinationPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Destination folder" Opacity="0.66"/>
                                        <DockPanel Margin="0,4,0,10">
                                            <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseJobDestinationCommand}" Margin="8,0,0,0"/>
                                            <TextBox Text="{Binding JobDestinationPath, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowValidationPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="iTunes library to validate" Opacity="0.66"/>
                                        <DockPanel Margin="0,4,0,10">
                                            <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseJobValidationCommand}" Margin="8,0,0,0"/>
                                            <TextBox Text="{Binding JobValidationPath, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowRemovalLimit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Maximum removals (0 blocks removals)" Opacity="0.66"/>
                                        <TextBox Text="{Binding JobMaxRemovals, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                                    </StackPanel>
                                    <CheckBox Content="Initialize target" IsChecked="{Binding JobInitialize}" Margin="0,3"
                                              Visibility="{Binding ShowInitialize, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <CheckBox Content="Clean obsolete playlists" IsChecked="{Binding JobClean}" Margin="0,3"
                                              Visibility="{Binding ShowClean, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <CheckBox Content="Rebalance paths" IsChecked="{Binding JobRebalance}" Margin="0,3"
                                              Visibility="{Binding ShowRebalance, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <CheckBox Content="Repair missing target files" IsChecked="{Binding JobFixErrors}" Margin="0,3"
                                              Visibility="{Binding ShowFixErrors, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Preview job" Command="{Binding PreviewJobCommand}" Margin="0,0,8,0"/>
                                <Button Content="Apply job" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyJobCommand}"
                                        Visibility="{Binding ShowJobApply, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="220"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Preview and results" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding JobStatus}" TextWrapping="Wrap" Opacity="0.7" Margin="0,5,0,0"/>
                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                        <TextBox Grid.Row="1" Text="{Binding JobOutput}" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Cascadia Mono, Consolas" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12"/>
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Job history" Style="{StaticResource SectionTitleStyle}" Margin="4,2,4,8"/>
                                <DataGrid ItemsSource="{Binding JobHistory}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When" Binding="{Binding Created}" Width="145"/>
                                        <DataGridTextColumn Header="Job" Binding="{Binding JobName}" Width="180"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="130"/>
                                        <DataGridTextColumn Header="Elapsed" Binding="{Binding Elapsed}" Width="80"/>
                                        <DataGridTextColumn Header="Output" Binding="{Binding Output}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Recovery and retention">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Additional root" Opacity="0.66" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchRoot, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseRootCommand}" Margin="8,0,18,0"/>
                            <TextBox Grid.Column="3" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" ToolTip="Retention days"/>
                            <Button Grid.Column="4" Content="Scan operations" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.72"/>
                                <TextBlock Text="{Binding RestorePreviewText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding PurgePreviewText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                <Button Content="Preview purge" Command="{Binding PreviewPurgeCommand}" Margin="0,0,8,0"/>
                                <Button Content="Apply purge" Command="{Binding ApplyPurgeCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,12,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Discovered runs" Style="{StaticResource SectionTitleStyle}" Margin="4,2,4,8"/>
                                <Button DockPanel.Dock="Bottom" Content="Open selected run" Command="{Binding OpenRunCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=RunsList}" HorizontalAlignment="Left" Margin="4,8,4,2"/>
                                <ListBox x:Name="RunsList" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="5,6">
                                                <TextBlock><Run Text="{Binding ToolName}" FontWeight="SemiBold"/><Run Text="{Binding Kind, StringFormat={}  ·  {0}}"/></TextBlock>
                                                <TextBlock Text="{Binding State}" Opacity="0.68" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Created}" FontSize="11" Opacity="0.55"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,2,10">
                                    <Button Content="Select restorable" Command="{Binding SelectAllRestorableCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Clear selection" Command="{Binding ClearRestoreSelectionCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Preview restore" Command="{Binding PreviewRestoreCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Apply restore" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyRestoreCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Close run" Command="{Binding CloseBrowserCommand}"/>
                                </StackPanel>
                                <TreeView ItemsSource="{Binding RootNodes}" BorderThickness="0" Background="Transparent">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:OperationEntryNodeViewModel}" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanRestore}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="{Binding StateText, StringFormat={}  ·  {0}}" Opacity="0.58"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
