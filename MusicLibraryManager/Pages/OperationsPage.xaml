<UserControl
    x:Class="MusicLibraryManager.Pages.OperationsPage" x:Name="OperationsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicLibraryManager.Controls"
    xmlns:tv="using:WinUI.TableView"
    Background="Transparent">
    <Grid Margin="28,24,28,28" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Operations" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Run unified jobs, inspect history, and recover journaled changes." Opacity="0.66" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Refresh" Command="{Binding RefreshCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/></StackPanel>
        </Grid>
        <TabView Grid.Row="1" IsAddTabButtonVisible="False">
            <TabViewItem Header="Jobs" IsClosable="False">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="220" MaxWidth="520"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="10"><ListView ItemsSource="{Binding JobCatalog}" SelectedItem="{Binding SelectedJob, Mode=TwoWay}"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Opacity="0.65" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Border>
                    <controls:ColumnSplitter Grid.Column="1" AutomationProperties.Name="Resize job catalog" Style="{StaticResource ColumnSplitterStyle}"/>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <ScrollViewer><StackPanel Spacing="10">
                            <TextBlock Text="{Binding SelectedJob.Description}" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap"/>
                            <TextBox Header="Playlist name" Text="{Binding JobPlaylistName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowPlaylistName, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Grid ColumnSpacing="8" Visibility="{Binding ShowDestinationPath, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Header="Destination" Text="{Binding JobDestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse" Command="{Binding BrowseJobDestinationCommand}" VerticalAlignment="Bottom"/></Grid>
                            <Grid ColumnSpacing="8" Visibility="{Binding ShowValidationPath, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Header="Validation path" Text="{Binding JobValidationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse" Command="{Binding BrowseJobValidationCommand}" VerticalAlignment="Bottom"/></Grid>
                            <NumberBox Header="Maximum removals" Value="{Binding JobMaxRemovals, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Visibility="{Binding ShowRemovalLimit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12"><CheckBox Content="Initialize" IsChecked="{Binding JobInitialize, Mode=TwoWay}" Visibility="{Binding ShowInitialize, Converter={StaticResource BooleanToVisibilityConverter}}"/><CheckBox Content="Clean" IsChecked="{Binding JobClean, Mode=TwoWay}" Visibility="{Binding ShowClean, Converter={StaticResource BooleanToVisibilityConverter}}"/><CheckBox Content="Rebalance" IsChecked="{Binding JobRebalance, Mode=TwoWay}" Visibility="{Binding ShowRebalance, Converter={StaticResource BooleanToVisibilityConverter}}"/><CheckBox Content="Fix errors" IsChecked="{Binding JobFixErrors, Mode=TwoWay}" Visibility="{Binding ShowFixErrors, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Preview" Command="{Binding PreviewJobCommand}"/><Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyJobCommand}" Visibility="{Binding ShowJobApply, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
                            <TextBlock Text="{Binding JobStatus}" TextWrapping="Wrap" Opacity="0.72"/>
                            <TextBox Text="{Binding JobOutput}" AcceptsReturn="True" IsReadOnly="True" Height="220" TextWrapping="NoWrap"/>
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Job history" IsClosable="False">
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <tv:TableView ItemsSource="{Binding JobHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanResizeColumns="True" CanReorderColumns="True"
                                  controls:TableViewColumnReorderBehavior.IsEnabled="True">
                        <tv:TableView.Columns><tv:TableViewTextColumn Header="When" Binding="{Binding Created}" Width="145"/><tv:TableViewTextColumn Header="Job" Binding="{Binding JobName}" Width="180"/><tv:TableViewTextColumn Header="State" Binding="{Binding State}" Width="130"/><tv:TableViewTextColumn Header="Elapsed" Binding="{Binding Elapsed}" Width="80"/><tv:TableViewTextColumn Header="Output" Binding="{Binding Output}" Width="520"/></tv:TableView.Columns>
                    </tv:TableView>
                </Border>
            </TabViewItem>

            <TabViewItem Header="Recovery" IsClosable="False">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320" MinWidth="260" MaxWidth="620"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="10"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="190" PlaceholderText="Search root" Text="{Binding SearchRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Browse" Command="{Binding BrowseRootCommand}"/></StackPanel><ListView Grid.Row="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding StateText}" Opacity="0.65"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
                    <controls:ColumnSplitter Grid.Column="1" AutomationProperties.Name="Resize recovery runs" Style="{StaticResource ColumnSplitterStyle}"/>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open run" Command="{Binding OpenRunCommand}"/><Button Content="Select restorable" Command="{Binding SelectAllRestorableCommand}"/><Button Content="Clear selection" Command="{Binding ClearRestoreSelectionCommand}"/></StackPanel>
                        <ListView Grid.Row="1" ItemsSource="{Binding RootNodes}"><ListView.ItemTemplate><DataTemplate><Grid Margin="4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanRestore}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding OriginalPath}" Opacity="0.6" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Kind}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                        <StackPanel Grid.Row="2" Spacing="8"><TextBlock Text="{Binding RestorePreviewText}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Preview restore" Command="{Binding PreviewRestoreCommand}"/><Button Content="Apply restore" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyRestoreCommand}"/><Button Content="Preview purge" Command="{Binding PreviewPurgeCommand}"/><Button Content="Apply purge" Command="{Binding ApplyPurgeCommand}"/></StackPanel><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.72"/></StackPanel>
                    </Grid></Border>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</UserControl>
