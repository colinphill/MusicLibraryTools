<UserControl x:Class="MusicLibraryManager.Pages.MilestonePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="36">
        <Border Style="{StaticResource CardStyle}" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource BrandTealBrush}" Margin="0,0,0,16">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="{Binding Message}" FontSize="16" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
