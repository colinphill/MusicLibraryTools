<UserControl
    x:Class="MusicLibraryManager.Controls.ColumnSplitter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid Background="Transparent">
        <Border Width="2" Background="{StaticResource BrandTealBrush}"
                CornerRadius="1" Opacity="0.48"/>
        <Thumb HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               Background="Transparent" DragDelta="SplitterThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</UserControl>
