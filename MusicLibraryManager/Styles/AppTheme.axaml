<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="AppTextFont">Segoe UI Variable Text, Inter</FontFamily>
      <FontFamily x:Key="AppDisplayFont">Segoe UI Variable Display, Inter</FontFamily>

      <x:Double x:Key="AppRadiusSmall">6</x:Double>
      <x:Double x:Key="AppRadius">8</x:Double>
      <x:Double x:Key="AppRadiusLarge">11</x:Double>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#2CC7BC</Color>
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2CC7BC" />
          <SolidColorBrush x:Key="AppCanvasBrush" Color="#0D1417" />
          <SolidColorBrush x:Key="AppPanelBrush" Color="#121D21" />
          <SolidColorBrush x:Key="AppRaisedBrush" Color="#18262B" />
          <SolidColorBrush x:Key="AppInsetBrush" Color="#0F181B" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#2A3B40" />
          <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#3D555B" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#EAF3F2" />
          <SolidColorBrush x:Key="AppMutedBrush" Color="#91A6A5" />
          <SolidColorBrush x:Key="AppFaintBrush" Color="#617579" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#2CC7BC" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#48D8CE" />
          <SolidColorBrush x:Key="AppAccentInkBrush" Color="#062B2A" />
          <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#222CC7BC" />
          <SolidColorBrush x:Key="AppSelectionBrush" Color="#1B3D3F" />
          <SolidColorBrush x:Key="AppHoverBrush" Color="#1A3033" />
          <SolidColorBrush x:Key="AppInfoBrush" Color="#3B8FC4" />
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#3BAA7A" />
          <SolidColorBrush x:Key="AppWarningBrush" Color="#D99A36" />
          <SolidColorBrush x:Key="AppDangerBrush" Color="#D85D65" />
          <SolidColorBrush x:Key="AppScrimBrush" Color="#99000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#087F8C</Color>
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#087F8C" />
          <SolidColorBrush x:Key="AppCanvasBrush" Color="#EEF4F3" />
          <SolidColorBrush x:Key="AppPanelBrush" Color="#F8FBFA" />
          <SolidColorBrush x:Key="AppRaisedBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppInsetBrush" Color="#E7EFED" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#CFDDDA" />
          <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#AEBFBB" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#142321" />
          <SolidColorBrush x:Key="AppMutedBrush" Color="#5F7471" />
          <SolidColorBrush x:Key="AppFaintBrush" Color="#849793" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#087F8C" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#0A6D77" />
          <SolidColorBrush x:Key="AppAccentInkBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#22087F8C" />
          <SolidColorBrush x:Key="AppSelectionBrush" Color="#DCF1F1" />
          <SolidColorBrush x:Key="AppHoverBrush" Color="#E7EFED" />
          <SolidColorBrush x:Key="AppInfoBrush" Color="#2879AA" />
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#25855D" />
          <SolidColorBrush x:Key="AppWarningBrush" Color="#B87518" />
          <SolidColorBrush x:Key="AppDangerBrush" Color="#BD414B" />
          <SolidColorBrush x:Key="AppScrimBrush" Color="#66000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource AppTextFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource AppCanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="UserControl">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" /></Style>
  <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" /></Style>
  <Style Selector="TextBlock.summary-label">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Run.text-difference">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFont}" />
    <Setter Property="FontSize" Value="27" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFont}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontFamily" Value="{DynamicResource AppTextFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="ListBox.primary-list ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
  </Style>
  <Style Selector="ListBox.primary-list ListBoxItem:selected Border.card">
    <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.inset"><Setter Property="Background" Value="{DynamicResource AppInsetBrush}" /></Style>
  <Style Selector="Border.status-banner">
    <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppInfoBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Button.app">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.app:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.app.primary">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.app.danger"><Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" /></Style>
  <Style Selector="Button.nav">
    <Setter Property="Height" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Grid.nav-content">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Viewbox.nav-icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.nav-icon-path">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="TextBlock.nav-label">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.nav-marker">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="Button.nav:pointerover Path.nav-icon-path">
    <Setter Property="Stroke" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="Button.nav.active Path.nav-icon-path">
    <Setter Property="Stroke" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="Button.nav.active Border.nav-marker">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="Button.caption /template/ ContentPresenter">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Viewbox.caption-icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.caption-icon-path">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AppHoverBrush}" /></Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppDangerBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.caption.close:pointerover Path.caption-icon-path">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <Style Selector="TextBox.primary, ComboBox.primary, NumericUpDown.primary">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBox.primary:focus, ComboBox.primary:focus, NumericUpDown.primary:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="Border.result-card">
    <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.history-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.history-item">
    <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
  </Style>
  <Style Selector="TreeView.health-tree">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="TreeView.health-tree TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TreeView.health-tree ComboBox">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.tree-count">
    <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    <Setter Property="Margin" Value="12,0,3,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ProgressBar.primary">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
  </Style>

  <Style Selector="DataGrid.primary-grid">
    <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="RowBackground" Value="{DynamicResource AppRaisedBrush}" />
  </Style>
  <Style Selector="DataGrid.primary-grid DataGridColumnHeader">
    <Setter Property="Height" Value="39" />
    <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="DataGrid.primary-grid DataGridRow">
    <Setter Property="Height" Value="38" />
    <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="DataGrid.primary-grid DataGridRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="DataGrid.primary-grid DataGridRow:selected">
    <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
  </Style>
  <Style Selector="DataGrid.primary-grid DataGridCell">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
  </Style>
</Styles>
