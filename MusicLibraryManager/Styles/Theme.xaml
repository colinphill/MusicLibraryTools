<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicLibraryManager.Controls">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppSurfaceColor">#F3F8F9</Color>
            <Color x:Key="NavPaneColor">#E7F2F4</Color>
            <Color x:Key="CardFillColor">#FAFFFFFF</Color>
            <Color x:Key="CardStrokeColor">#3A087F8C</Color>
            <Color x:Key="TitleBarColor">#076D78</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppSurfaceColor">#10191B</Color>
            <Color x:Key="NavPaneColor">#142326</Color>
            <Color x:Key="CardFillColor">#C8172528</Color>
            <Color x:Key="CardStrokeColor">#542787C8</Color>
            <Color x:Key="TitleBarColor">#064A52</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="AppSurfaceColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="NavPaneColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="CardFillColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="CardStrokeColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="TitleBarColor">{ThemeResource SystemColorHighlightColor}</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Color x:Key="BrandTealColor">#087F8C</Color>
    <Color x:Key="BrandTealBrightColor">#39C6C8</Color>
    <Color x:Key="BrandSkyColor">#2787C8</Color>
    <Color x:Key="BrandAmberColor">#D68A14</Color>
    <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTealColor}"/>
    <SolidColorBrush x:Key="BrandTealBrightBrush" Color="{StaticResource BrandTealBrightColor}"/>
    <SolidColorBrush x:Key="BrandSkyBrush" Color="{StaticResource BrandSkyColor}"/>
    <SolidColorBrush x:Key="BrandAmberBrush" Color="{StaticResource BrandAmberColor}"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{ThemeResource AppSurfaceColor}"/>
    <SolidColorBrush x:Key="NavPaneBrush" Color="{ThemeResource NavPaneColor}"/>
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource CardStrokeColor}"/>
    <SolidColorBrush x:Key="CardFillBrush" Color="{ThemeResource CardFillColor}"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="{ThemeResource TitleBarColor}"/>

    <!-- Keep Fluent controls aligned with the blue/teal identity from the WPF shell. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#087F8C"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6087F8C"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B8087F8C"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#087F8C"/>
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2787C8"/>
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource NavPaneColor}"/>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="MetricStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandTealBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style x:Key="ColumnSplitterStyle" TargetType="controls:ColumnSplitter">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="ToolTipService.ToolTip" Value="Drag to resize"/>
    </Style>
</ResourceDictionary>
