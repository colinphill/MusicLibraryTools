<Window x:Class="MusicLibraryManager.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MusicLibraryManager.Controls"
        xmlns:views="using:MusicLibraryManager.Views"
        Title="{DynamicResource Loc.App.Title}"
        Icon="/Assets/AppIcon.ico"
        Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowDecorations="Full" CanResize="True"
        WindowStartupLocation="Manual">
  <Window.Styles>
    <Style Selector="ContentControl#ContentHost /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>
  <Grid>
    <Grid x:Name="BodyGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="NavigationRail"
              Grid.Column="0"
              HorizontalAlignment="Left"
              Background="{DynamicResource AppPanelBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,0,1,0">
        <Grid Margin="12,12,12,12" RowDefinitions="60,8,*,Auto">
          <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="BrandBlock"
                  Margin="4,0,0,12"
                  ColumnDefinitions="36,*"
                  ColumnSpacing="8"
                  AutomationProperties.Name="{DynamicResource Loc.App.Title}">
              <Button x:Name="NavigationRailToggle"
                      Classes="app quiet icon"
                      Click="OnNavigationRailToggle"
                      ToolTip.Tip="{DynamicResource Loc.Shell.Navigation.Toggle}"
                      AutomationProperties.Name="{DynamicResource Loc.Shell.Navigation.Toggle}"
                      AutomationProperties.HelpText="{DynamicResource Loc.App.Title}">
                <controls:BrandMark Width="30"
                                    Height="30"
                                    IsHitTestVisible="False"
                                    AutomationProperties.Name="{DynamicResource Loc.About.BrandAutomation}" />
              </Button>
              <StackPanel x:Name="BrandCopy" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Loc.App.Title}"
                           FontFamily="{DynamicResource AppDisplayFont}"
                           FontSize="13"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           MaxLines="2" />
              </StackPanel>
            </Grid>
          </Border>

          <ListBox x:Name="PrimaryNavigation"
                   Grid.Row="2"
                   Classes="nav-list"
                   SelectionMode="Single"
                   SelectionChanged="OnNavigationSelectionChanged"
                   KeyDown="OnNavigationKeyDown">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <Button x:Name="HomeNav" Classes="nav active" Tag="Home" Click="OnNavigationClick" ToolTip.Tip="{DynamicResource Loc.Navigation.Home}" AutomationProperties.Name="{DynamicResource Loc.Navigation.Home}">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="99" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M3,11 L12,3 L21,11 M5,10 L5,21 L10,21 L10,15 L14,15 L14,21 L19,21 L19,10" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="{DynamicResource Loc.Navigation.Home}" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="LibraryNav" Classes="nav" Tag="Library" Click="OnNavigationClick" ToolTip.Tip="{DynamicResource Loc.Navigation.Library}" AutomationProperties.Name="{DynamicResource Loc.Navigation.Library}">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="99" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M9,5 L20,3 L20,16 M9,9 L20,7 M9,5 L9,18 M9,18 C9,20 7.5,21.5 5.5,21.5 C3.7,21.5 2.5,20.5 2.5,19 C2.5,17.5 4,16.5 6,16.5 C7.2,16.5 8.2,16.8 9,17.3 M20,16 C20,18 18.5,19.5 16.5,19.5 C14.7,19.5 13.5,18.5 13.5,17 C13.5,15.5 15,14.5 17,14.5 C18.2,14.5 19.2,14.8 20,15.3" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="{DynamicResource Loc.Navigation.Library}" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="WorkbenchNav" Classes="nav" Tag="Workbench" Click="OnNavigationClick" ToolTip.Tip="{DynamicResource Loc.Navigation.WorkbenchAutomation}" AutomationProperties.Name="{DynamicResource Loc.Navigation.WorkbenchAutomation}">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="99" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M4,5 L20,5 L20,19 L4,19 Z M8,9 L16,9 M8,13 L16,13 M8,17 L13,17" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="{DynamicResource Loc.Navigation.Workbench}" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="HealthNav" Classes="nav" Tag="Health" Click="OnNavigationClick" ToolTip.Tip="{DynamicResource Loc.Navigation.Health}" AutomationProperties.Name="{DynamicResource Loc.Navigation.Health}">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="99" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M12,2 L22,12 L12,22 L2,12 Z M6.5,12 L9.5,12 L11,8 L13.5,16 L15,12 L18,12" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="{DynamicResource Loc.Navigation.Health}" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="IngestNav" Classes="nav" Tag="Ingest" Click="OnNavigationClick" ToolTip.Tip="{DynamicResource Loc.Navigation.Ingest}" AutomationProperties.Name="{DynamicResource Loc.Navigation.Ingest}">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="99" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M12,3 L12,16 M7,11 L12,16 L17,11 M4,20 L20,20" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="{DynamicResource Loc.Navigation.Ingest}" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="OrganizeNav" Classes="nav" Tag="Organize" Click="OnNavigationClick" ToolTip.Tip="{DynamicResource Loc.Navigation.Organize}" AutomationProperties.Name="{DynamicResource Loc.Navigation.Organize}">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="99" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M4,7 L19,7 M15,3 L19,7 L15,11 M20,17 L5,17 M9,13 L5,17 L9,21" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="{DynamicResource Loc.Navigation.Organize}" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="DevicesNav" Classes="nav" Tag="Devices" Click="OnNavigationClick" ToolTip.Tip="{DynamicResource Loc.Navigation.Devices}" AutomationProperties.Name="{DynamicResource Loc.Navigation.Devices}">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="99" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M7,2 L17,2 C18.1,2 19,2.9 19,4 L19,20 C19,21.1 18.1,22 17,22 L7,22 C5.9,22 5,21.1 5,20 L5,4 C5,2.9 5.9,2 7,2 Z M9,5 L15,5 M10,19 L14,19" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="{DynamicResource Loc.Navigation.Devices}" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="OperationsNav" Classes="nav" Tag="Operations" Click="OnNavigationClick" ToolTip.Tip="{DynamicResource Loc.Navigation.Operations}" AutomationProperties.Name="{DynamicResource Loc.Navigation.Operations}">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="99" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M4,6 L20,6 M8,12 L20,12 M4,18 L16,18 M14,3 L14,9 M6,9 L6,15 M18,15 L18,21" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="{DynamicResource Loc.Navigation.Operations}" FontWeight="SemiBold" /></Grid>
            </Button>
          </ListBox>

          <ListBox x:Name="SecondaryNavigation"
                   Grid.Row="3"
                   Classes="nav-list"
                   SelectionMode="Single"
                   SelectionChanged="OnNavigationSelectionChanged"
                   KeyDown="OnNavigationKeyDown">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <Button x:Name="SettingsNav" Classes="nav" Tag="Settings" Click="OnNavigationClick" ToolTip.Tip="{DynamicResource Loc.Navigation.Settings}" AutomationProperties.Name="{DynamicResource Loc.Navigation.Settings}">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="99" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M12,8 C9.8,8 8,9.8 8,12 C8,14.2 9.8,16 12,16 C14.2,16 16,14.2 16,12 C16,9.8 14.2,8 12,8 Z M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="{DynamicResource Loc.Navigation.Settings}" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="AboutNav" Classes="nav" Tag="About" Click="OnNavigationClick" ToolTip.Tip="{DynamicResource Loc.Navigation.About}" AutomationProperties.Name="{DynamicResource Loc.Navigation.About}">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="99" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 M12,10 L12,18 M12,6 L12.1,6" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="{DynamicResource Loc.Navigation.About}" FontWeight="SemiBold" /></Grid>
            </Button>
          </ListBox>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="56,Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
          <Grid x:Name="TopBarContent"
                Margin="16,8"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12">
            <Border x:Name="SearchChrome" Classes="top-search" MaxWidth="650" HorizontalAlignment="Stretch" Height="38" Padding="12,0"
                    Background="{DynamicResource AppInsetBrush}" CornerRadius="8">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc.Shell.Search}">
                  <Path Data="M10,4 A6,6 0 1 0 10,16 A6,6 0 1 0 10,4 M14.5,14.5 L20,20"
                        Fill="Transparent" Stroke="{DynamicResource AppFaintBrush}" StrokeThickness="2" />
                </Viewbox>
                <TextBox x:Name="SearchBox" Classes="top-search-input" Grid.Column="1" Padding="0" BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center"
                         Text="{Binding GlobalSearchText, Mode=TwoWay}" PlaceholderText="{DynamicResource Loc.Shell.SearchLibrary}"
                         AutomationProperties.Name="{DynamicResource Loc.Shell.SearchLibrary}"
                         KeyDown="OnSearchKeyDown" />
                <Border x:Name="SearchShortcut" Grid.Column="2" Padding="8,4" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6"
                        Background="{DynamicResource AppRaisedBrush}">
                  <TextBlock x:Name="SearchShortcutText" Text="Ctrl+K" Classes="caption" />
                </Border>
              </Grid>
            </Border>
            <Button Grid.Column="1" Classes="app" Height="38" Click="OnConfigurationClick"
                    ToolTip.Tip="{DynamicResource Loc.Shell.OpenLibraryConfiguration}" AutomationProperties.Name="{DynamicResource Loc.Shell.OpenLibraryConfiguration}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:AppVectorIcon Kind="Settings"
                                        VerticalAlignment="Center" />
                <TextBlock x:Name="ConfigurationChipText" Text="{Binding ConfigurationName}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <Border x:Name="ActivityBanner" Grid.Row="1" Margin="16,8,16,0" Classes="status-banner activity"
                IsVisible="{Binding HasVisibleActivity}"
                Classes.info="{Binding ActivityIsInfo}"
                Classes.success="{Binding ActivityIsSuccess}"
                Classes.warning="{Binding ActivityIsWarning}"
                Classes.error="{Binding ActivityIsError}"
                AutomationProperties.LiveSetting="Polite">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <Ellipse Width="8" Height="8" Classes="activity-dot"
                     Classes.info="{Binding ActivityIsInfo}"
                     Classes.success="{Binding ActivityIsSuccess}"
                     Classes.warning="{Binding ActivityIsWarning}"
                     Classes.error="{Binding ActivityIsError}"
                     VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Binding ActivityTitle}" FontWeight="SemiBold" />
              <TextBlock x:Name="ActivityMessageText" Classes="muted" Text="{Binding ActivityText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Grid x:Name="ActivityProgressHost" Width="160" ClipToBounds="True"
                    IsVisible="{Binding HasVisibleActivityProgress}">
                <ProgressBar Classes="app" Minimum="0" Maximum="1" Value="{Binding ActivityProgress}"
                             IsVisible="{Binding HasDeterminateActivityProgress}" />
                <ProgressBar Classes="app" IsIndeterminate="True"
                             IsVisible="{Binding HasIndeterminateActivityProgress}" />
              </Grid>
              <TextBlock x:Name="ActivityStateLabel" Classes="activity-state"
                          Classes.info="{Binding ActivityIsInfo}"
                          Classes.success="{Binding ActivityIsSuccess}"
                          Classes.warning="{Binding ActivityIsWarning}"
                          Classes.error="{Binding ActivityIsError}"
                          Text="{Binding ActivityStateText}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
            <Button Classes="app" Content="{DynamicResource Loc.Common.Open}" Command="{Binding OpenActivityCommand}" />
            <Button x:Name="ActivityCancelButton" Classes="app" Content="{DynamicResource Loc.Common.Cancel}"
                      IsVisible="{Binding IsActivityCancelVisible}"
                      Command="{Binding CancelActivityCommand}" />
            <Button x:Name="ActivityDismissButton" Classes="app" Content="{DynamicResource Loc.Common.Dismiss}"
                      IsVisible="{Binding IsActivityDismissVisible}"
                      Command="{Binding DismissActivityCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Grid>
      <Border x:Name="NavigationScrim"
              Grid.Column="1"
              Classes="overlay-scrim"
              IsVisible="False"
              PointerPressed="OnNavigationScrimPressed" />
      <views:DialogHost x:Name="RootDialogHost" Grid.ColumnSpan="2" />
    </Grid>
  </Grid>
</Window>
