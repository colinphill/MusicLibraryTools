<Window x:Class="MusicLibraryManager.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MusicLibraryManager.Views"
        Title="Music Library Manager"
        Icon="/Assets/AppIcon.ico"
        Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowDecorations="None" CanResize="True"
        WindowStartupLocation="Manual">
  <Window.Styles>
    <Style Selector="ContentControl#ContentHost /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="44,*">
    <Border x:Name="TitleBar" Grid.Row="0"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="*,Auto">
        <Grid Margin="12,0,0,0" ColumnDefinitions="24,Auto,*">
          <Border Width="22" Height="22" CornerRadius="5"
                  Background="{DynamicResource AppRaisedBrush}"
                  BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1">
            <Image Source="/Assets/AppIcon.ico" Width="16" Height="16" Stretch="Uniform" />
          </Border>
          <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                     Text="Music Library Manager" FontFamily="{DynamicResource AppDisplayFont}"
                     FontSize="13" FontWeight="SemiBold" />
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="MinimizeButton" Classes="caption" ToolTip.Tip="Minimize" Click="OnMinimizeClick">
            <Viewbox Classes="caption-icon"><Path Classes="caption-icon-path" Data="M3,12 L21,12" /></Viewbox>
          </Button>
          <Button x:Name="MaximizeButton" Classes="caption" ToolTip.Tip="Maximize" Click="OnMaximizeRestoreClick">
            <Viewbox Classes="caption-icon">
              <Grid Width="24" Height="24">
                <Path x:Name="MaximizeGlyph" Classes="caption-icon-path" Data="M2,2 L22,2 L22,22 L2,22 Z" />
                <Path x:Name="RestoreGlyph" Classes="caption-icon-path" IsVisible="False"
                      Data="M8,2 L22,2 L22,16 L18,16 M8,8 L8,2 M2,8 L18,8 L18,22 L2,22 Z" />
              </Grid>
            </Viewbox>
          </Button>
          <Button x:Name="CloseButton" Classes="caption close" ToolTip.Tip="Close" Click="OnCloseClick">
            <Viewbox Classes="caption-icon"><Path Classes="caption-icon-path" Data="M5,5 L19,19 M19,5 L5,19" /></Viewbox>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="BodyGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource AppPanelBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="10,16,10,12" RowDefinitions="52,10,*,Auto">
          <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="BrandBlock" Margin="8,0,0,14" ColumnDefinitions="34,*" ColumnSpacing="11">
              <Viewbox Width="34" Height="34">
                <Canvas Width="256" Height="256">
                  <Rectangle Canvas.Left="32" Canvas.Top="50" Width="142" Height="154" RadiusX="28" RadiusY="28" Fill="#9E0D4F59" />
                  <Rectangle Canvas.Left="55" Canvas.Top="32" Width="150" Height="164" RadiusX="30" RadiusY="30">
                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7DD3FC" Offset="0" /><GradientStop Color="#2787C8" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                  </Rectangle>
                  <Rectangle Canvas.Left="78" Canvas.Top="54" Width="150" Height="164" RadiusX="30" RadiusY="30">
                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#39C6C8" Offset="0" /><GradientStop Color="#087F8C" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                  </Rectangle>
                  <Ellipse Canvas.Left="101" Canvas.Top="84" Width="104" Height="104" Fill="#F7FBFC" />
                  <Ellipse Canvas.Left="118" Canvas.Top="101" Width="70" Height="70" Stroke="#9BDCDF" StrokeThickness="7" />
                  <Ellipse Canvas.Left="142" Canvas.Top="125" Width="22" Height="22" Fill="#087F8C" />
                  <Line StartPoint="94,82" EndPoint="148,82" Stroke="#F7FBFC" StrokeThickness="10" StrokeLineCap="Round" />
                </Canvas>
              </Viewbox>
              <StackPanel x:Name="BrandCopy" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Music Library" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" FontWeight="Bold" />
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Grid.Row="2" Spacing="3">
            <Button x:Name="HomeNav" Classes="nav active" Tag="Home" Click="OnNavigationClick">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M3,11 L12,3 L21,11 M5,10 L5,21 L10,21 L10,15 L14,15 L14,21 L19,21 L19,10" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="Home" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="LibraryNav" Classes="nav" Tag="Library" Click="OnNavigationClick">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M9,5 L20,3 L20,16 M9,9 L20,7 M9,5 L9,18 M9,18 C9,20 7.5,21.5 5.5,21.5 C3.7,21.5 2.5,20.5 2.5,19 C2.5,17.5 4,16.5 6,16.5 C7.2,16.5 8.2,16.8 9,17.3 M20,16 C20,18 18.5,19.5 16.5,19.5 C14.7,19.5 13.5,18.5 13.5,17 C13.5,15.5 15,14.5 17,14.5 C18.2,14.5 19.2,14.8 20,15.3" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="Library" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="HealthNav" Classes="nav" Tag="Health" Click="OnNavigationClick">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M12,2 L22,12 L12,22 L2,12 Z M6.5,12 L9.5,12 L11,8 L13.5,16 L15,12 L18,12" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="Health" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="IngestNav" Classes="nav" Tag="Ingest" Click="OnNavigationClick">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M12,3 L12,16 M7,11 L12,16 L17,11 M4,20 L20,20" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="Ingest" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="OrganizeNav" Classes="nav" Tag="Organize" Click="OnNavigationClick">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M4,7 L19,7 M15,3 L19,7 L15,11 M20,17 L5,17 M9,13 L5,17 L9,21" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="Organize" FontWeight="SemiBold" /></Grid>
            </Button>
            <Button x:Name="OperationsNav" Classes="nav" Tag="Operations" Click="OnNavigationClick">
              <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M4,6 L20,6 M8,12 L20,12 M4,18 L16,18 M14,3 L14,9 M6,9 L6,15 M18,15 L18,21" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="Operations" FontWeight="SemiBold" /></Grid>
            </Button>
          </StackPanel>

          <Button x:Name="SettingsNav" Grid.Row="3" Classes="nav" Tag="Settings" Click="OnNavigationClick">
            <Grid Classes="nav-content" ColumnDefinitions="24,*" ColumnSpacing="12"><Border Classes="nav-marker" Width="3" Height="22" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False" /><Viewbox Classes="nav-icon"><Path Classes="nav-icon-path" Data="M12,8 C9.8,8 8,9.8 8,12 C8,14.2 9.8,16 12,16 C14.2,16 16,14.2 16,12 C16,9.8 14.2,8 12,8 Z M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1" /></Viewbox><TextBlock Grid.Column="1" Classes="nav-label" Text="Settings" FontWeight="SemiBold" /></Grid>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="56,*">
        <Border Grid.Row="0" Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
          <Grid Margin="18,8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Border MaxWidth="650" HorizontalAlignment="Stretch" Height="38" Padding="11,0"
                    Background="{DynamicResource AppInsetBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="9">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center" Classes="muted" Text="&#x2315;" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Padding="0" BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center"
                         Text="{Binding GlobalSearchText, Mode=TwoWay}" PlaceholderText="Search the library"
                         KeyDown="OnSearchKeyDown" />
                <Border x:Name="SearchShortcut" Grid.Column="2" Padding="6,2" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5"
                        Background="{DynamicResource AppRaisedBrush}">
                  <TextBlock Text="Ctrl K" Classes="faint" FontSize="10" />
                </Border>
              </Grid>
            </Border>
            <Button Grid.Column="1" Classes="app" Height="38" Click="OnConfigurationClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AppAccentBrush}" />
                <TextBlock x:Name="ConfigurationChipText" Text="{Binding ConfigurationName}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <ContentControl x:Name="ContentHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Grid>
      <views:DialogHost Grid.ColumnSpan="2" />
    </Grid>

    <Border x:Name="ResizeGrip" Grid.RowSpan="2"
            Width="22" Height="22"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Background="Transparent" Cursor="BottomRightCorner"
            PointerPressed="OnResizeGripPointerPressed"
            ToolTip.Tip="Resize window">
      <Viewbox Width="14" Height="14" Margin="0,0,3,3"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               IsHitTestVisible="False">
        <Path Data="M4,14 L14,4 M8,14 L14,8 M12,14 L14,12"
              Fill="Transparent"
              Stroke="{DynamicResource AppMutedBrush}"
              StrokeThickness="1.5"
              StrokeLineCap="Round" />
      </Viewbox>
    </Border>
  </Grid>
</Window>
