<Window x:Class="MusicLibraryManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Library Manager"
        Icon="Assets/AppIcon-32.png"
        Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,7" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="32" Height="32" Source="Assets/AppIcon-32.png" />
                <StackPanel x:Name="AppIdentity" Grid.Column="1" Margin="10,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="Music Library Manager" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ConfigurationName}" FontSize="11" Opacity="0.66" />
                </StackPanel>
                <Grid Grid.Column="2" MaxWidth="520" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                    <TextBox x:Name="GlobalSearchBox" Padding="12,7,34,7"
                             Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search your library (Ctrl+K)" KeyDown="GlobalSearchBox_KeyDown" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="14"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                               IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="3" Margin="0,0,8,0" Padding="12,7" Click="Configuration_Click"
                        ToolTip="Library configuration">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0" />
                        <TextBlock x:Name="ConfigurationButtonText" Text="{Binding ConfigurationName}"
                                   MaxWidth="150" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="ActivityToggle" Grid.Column="4" Padding="12,7" ToolTip="Activity center">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Width="18" Height="4" IsIndeterminate="True"
                                     Visibility="{Binding HasRunningActivity, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Margin="7,0" />
                        <TextBlock x:Name="ActivityButtonText" Text="{Binding ActivityText}"
                                   MaxWidth="150" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ToggleButton>
                <Popup Grid.Column="4" IsOpen="{Binding IsChecked, ElementName=ActivityToggle}"
                       PlacementTarget="{Binding ElementName=ActivityToggle}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Style="{StaticResource CardStyle}" Width="430" MaxHeight="480" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Activity" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Activities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Background="{StaticResource BrandTealBrush}" CornerRadius="2" />
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.72" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="0,6">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <RadioButton x:Name="HomeNav" Style="{StaticResource NavButtonStyle}" Tag="Home" IsChecked="True" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" Width="28"/><TextBlock x:Name="HomeLabel" Text="Home"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Tag="Library" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA69;" FontFamily="Segoe Fluent Icons" Width="28"/><TextBlock x:Name="LibraryLabel" Text="Library"/></StackPanel>
                        </RadioButton>
                        <Separator Margin="10,8" />
                        <RadioButton Style="{StaticResource NavButtonStyle}" Tag="Health" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Width="28"/><TextBlock x:Name="HealthLabel" Text="Health"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Tag="Ingest" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" Width="28"/><TextBlock x:Name="IngestLabel" Text="Ingest"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Tag="Organize" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Width="28"/><TextBlock x:Name="OrganizeLabel" Text="Organize"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Tag="Operations" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F5;" FontFamily="Segoe Fluent Icons" Width="28"/><TextBlock x:Name="OperationsLabel" Text="Operations"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <RadioButton Grid.Row="1" Style="{StaticResource NavButtonStyle}" Tag="Settings" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Width="28"/><TextBlock x:Name="SettingsLabel" Text="Settings"/></StackPanel>
                    </RadioButton>
                </Grid>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
