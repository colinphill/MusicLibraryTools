<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicLibrary.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="620"
        x:Class="MusicLibrary.App.Views.ConfigDialog"
        x:DataType="vm:ConfigDialogViewModel"
        Width="720" Height="620" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">

    <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="h1" Margin="0,0,0,14"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>

        <Grid Grid.Row="1" ColumnDefinitions="150,*,90,110" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cache DB file:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DatabaseFile}"
                     PlaceholderText="cache.db (relative to this config)" ToolTip.Tip="{Binding DatabaseFile}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Length limits:" VerticalAlignment="Center" Margin="0,6,0,0"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <TextBlock Text="Path" VerticalAlignment="Center"/>
                <NumericUpDown Value="{Binding LengthLimit}" Minimum="1" Maximum="4096" Width="120" FormatString="0"/>
                <TextBlock Text="Disc" VerticalAlignment="Center"/>
                <NumericUpDown Value="{Binding DiscNumLengthLimit}" Minimum="1" Maximum="4096" Width="120" FormatString="0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Classes="card" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                    <TextBlock Text="Scan roots (IndexTargets)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Add root" Command="{Binding AddTargetCommand}"/>
                </StackPanel>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding IndexTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IndexTargetRow">
                                <Grid ColumnDefinitions="*,Auto,Auto,120,Auto" Margin="0,3" ColumnSpacing="6">
                                    <TextBox Grid.Column="0" Text="{Binding Target}" PlaceholderText="Folder path"
                                             ToolTip.Tip="{Binding Target}"/>
                                    <Button Grid.Column="1" Content="…"
                                            Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).BrowseTargetCommand}"
                                            CommandParameter="{Binding}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Set" VerticalAlignment="Center" Classes="muted"/>
                                        <NumericUpDown Value="{Binding Set}" Minimum="0" Maximum="99"
                                                       Width="130" FormatString="0" ToolTip.Tip="Scan-set number"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="3" Text="{Binding Filter}" PlaceholderText="Filter"/>
                                    <Button Grid.Column="4" Content="Remove"
                                            Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).RemoveTargetCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sync target:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SyncTarget}" PlaceholderText="(optional)"
                     ToolTip.Tip="{Binding SyncTarget}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Playlist target:" VerticalAlignment="Center" Margin="0,6,0,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PlaylistTarget}" PlaceholderText="(optional)"
                     ToolTip.Tip="{Binding PlaylistTarget}" Margin="0,6,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Playlist type:" VerticalAlignment="Center" Margin="0,6,0,0"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PlaylistType}" PlaceholderText="(optional)" Margin="0,6,0,0"/>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="IndianRed"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0"
                    HorizontalAlignment="Right">
            <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}"/>
            <Button Content="Save As…" Command="{Binding SaveAsCommand}"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
