<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicLibrary.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="700"
        x:Class="MusicLibrary.App.Views.ConfigDialog"
        x:DataType="vm:ConfigDialogViewModel"
        Width="820" Height="700" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">

    <Grid Margin="18" RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,4,0">

        <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="h1" Margin="0,0,0,14"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>

        <Grid Grid.Row="1" ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="6" ColumnSpacing="6" Margin="0,0,0,10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cache DB file:" Classes="formlabel"/>
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DatabaseFile}"
                     PlaceholderText="cache.db (relative to this config)" ToolTip.Tip="{Binding DatabaseFile}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="iTunes library:" Classes="formlabel"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ItunesLibraryPath}"
                     PlaceholderText="Optional .itl path" ToolTip.Tip="{Binding ItunesLibraryPath}"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Command="{Binding BrowseItunesLibraryCommand}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="ffmpeg:" Classes="formlabel"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FfmpegPath}"
                     PlaceholderText="ffmpeg or executable path" ToolTip.Tip="{Binding FfmpegPath}"/>
            <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Command="{Binding BrowseFfmpegCommand}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Length limits:" Classes="formlabel"/>
            <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Classes="toolbarwrap"
                       Margin="0,0,-8,-8">
                <TextBlock Text="Path" Classes="formlabel"/>
                <NumericUpDown Value="{Binding LengthLimit}" Minimum="1" Maximum="4096"
                               FormatString="0"/>
                <TextBlock Text="Disc title" Classes="formlabel"/>
                <NumericUpDown Value="{Binding DiscNumLengthLimit}" Minimum="1" Maximum="4096"
                               FormatString="0"/>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="2" Classes="card" Padding="10" MinHeight="220">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Classes="toolbarwrap" Margin="0,0,-8,0">
                    <TextBlock Text="Scan roots (IndexTargets)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Add root" Command="{Binding AddTargetCommand}"/>
                    <Button Content="Import legacy ingest config…"
                            Command="{Binding ImportIngestConfigurationCommand}"
                            ToolTip.Tip="Copy destinations and ingest behavior from an existing IngestMusicConfiguration XML"/>
                    <Button Content="Clear sync target"
                            Command="{Binding ClearSyncTargetCommand}"
                            ToolTip.Tip="Leave CrossSyncMusic without a configured destination"/>
                </WrapPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding IndexTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IndexTargetRow">
                                <Border BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,0,0,1"
                                        Padding="0,4,0,8" Margin="0,0,0,4">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <TextBox Grid.Column="0" Text="{Binding Target}" PlaceholderText="Folder path"
                                                     ToolTip.Tip="{Binding Target}"/>
                                            <Button Grid.Column="1" Content="Browse"
                                                    Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).BrowseTargetCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Grid.Column="2" Content="Remove root"
                                                    Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).RemoveTargetCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <WrapPanel Classes="toolbarwrap" Margin="0,0,-8,-8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Filter" Classes="formlabel"/>
                                                <TextBox Text="{Binding Filter}" MinWidth="150"
                                                         PlaceholderText="Optional extensions"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Default offset" Classes="formlabel"/>
                                                <TextBox Text="{Binding DefaultOffset}" MinWidth="170"
                                                         PlaceholderText="Applied to all sets"
                                                         ToolTip.Tip="Used by every set below unless that set supplies an override"/>
                                            </StackPanel>
                                            <CheckBox Content="Include in organization"
                                                      IsChecked="{Binding Organize}"
                                                      ToolTip.Tip="Clear to keep this root indexed while excluding it from organization operations"/>
                                            <RadioButton Content="Cross-library sync target"
                                                         GroupName="CrossLibrarySyncTarget"
                                                         IsChecked="{Binding IsSyncTarget}"
                                                         ToolTip.Tip="Use this indexed root as the CrossSyncMusic destination"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Ingest use" Classes="formlabel"/>
                                                <ComboBox ItemsSource="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).IngestRoles}"
                                                          SelectedItem="{Binding IngestRole}"
                                                          MinWidth="150"
                                                          ToolTip.Tip="Optional destination role used by the Ingest tab"/>
                                            </StackPanel>
                                            <Button Content="Add set"
                                                    Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).AddSetCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </WrapPanel>
                                        <TextBlock Text="Set memberships · the default offset applies unless a set overrides it."
                                                   Classes="caption" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding Memberships}" Margin="18,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:IndexTargetSetRow">
                                                    <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="6" Margin="0,2">
                                                        <TextBox Grid.Column="0" Text="{Binding Name}"
                                                                 PlaceholderText="Alphanumeric set name"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Offset}"
                                                                 PlaceholderText="Optional offset override"/>
                                                        <Button Grid.Column="2" Content="Remove"
                                                                Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).RemoveSetCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Classes="card" Padding="10" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Ingest behavior" FontWeight="SemiBold"/>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Destination folders are assigned with each IndexTarget's Ingest use. Partial setup is allowed; the Ingest tab reports anything still required."/>
                <WrapPanel Classes="toolbarwrap" Margin="0,0,-8,-8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="AAC encoder" Classes="formlabel"/>
                        <TextBox Text="{Binding AacEncoder}" MinWidth="180"
                                 PlaceholderText="libfdk_aac"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="AAC bitrate (kbit/s)" Classes="formlabel"/>
                        <NumericUpDown Value="{Binding AacBitrateKbps}" Minimum="1" Maximum="1000"
                                       FormatString="0"/>
                    </StackPanel>
                    <CheckBox Content="Delete successfully ingested sources"
                              IsChecked="{Binding DeleteSourcesAfterIngest}"/>
                    <CheckBox Content="Also remove non-music files and empty folders"
                              IsChecked="{Binding RemoveNonMusicAfterIngest}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
            <Border Grid.Row="0" Classes="card" Padding="10">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Classes="toolbarwrap" Margin="0,0,-8,0">
                        <TextBlock Text="Cross-library sync playlists"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Add playlist" Command="{Binding AddSyncPlaylistCommand}"/>
                        <TextBlock Text="The destination is the IndexTarget marked as the cross-library sync target."
                                   Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding SyncPlaylists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SyncPlaylistRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,3">
                                    <TextBox Grid.Column="0" Text="{Binding Name}"
                                             PlaceholderText="iTunes playlist name"/>
                                    <Button Grid.Column="1" Content="Remove"
                                            Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).RemoveSyncPlaylistCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Classes="card" Padding="10" Margin="0,8,0,0">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Classes="toolbarwrap" Margin="0,0,-8,0">
                        <TextBlock Text="Playlist exports" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Add target" Command="{Binding AddPlaylistTargetCommand}"/>
                        <TextBlock Text="Every target requires one or more scan sets."
                                   Classes="muted" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PlaylistTargets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaylistTargetRow">
                                    <Border BorderBrush="{DynamicResource AppDivider}"
                                            BorderThickness="0,0,0,1" Padding="0,3,0,8" Margin="0,0,0,4">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <TextBox Grid.Column="0" Text="{Binding Target}" PlaceholderText="Export folder"
                                                         ToolTip.Tip="{Binding Target}"/>
                                                <Button Grid.Column="1" Content="Browse"
                                                        Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).BrowsePlaylistTargetCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="2" Content="Remove"
                                                        Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).RemovePlaylistTargetCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <WrapPanel Classes="toolbarwrap" Margin="0,0,-8,-8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Type" Classes="formlabel"/>
                                                    <TextBox Text="{Binding Type}" MinWidth="100"
                                                             PlaceholderText="m3u"
                                                             ToolTip.Tip="Playlist type: m3u or wpl"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Sets" Classes="formlabel"/>
                                                    <TextBox Text="{Binding Sets}" MinWidth="220"
                                                             PlaceholderText="required: set1,set2"
                                                             ToolTip.Tip="Required comma-separated alphanumeric scan-set names"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Foreground="IndianRed"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        </Grid>
        </ScrollViewer>

        <WrapPanel Grid.Row="1" Classes="toolbarwrap" Margin="0,14,-8,-8"
                   HorizontalAlignment="Right">
            <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}"/>
            <Button Content="Save As…" Command="{Binding SaveAsCommand}"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}"/>
        </WrapPanel>
    </Grid>
</Window>
