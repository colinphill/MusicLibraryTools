<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicLibrary.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="700"
        x:Class="MusicLibrary.App.Views.ConfigDialog"
        x:DataType="vm:ConfigDialogViewModel"
        Width="820" Height="700" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">

    <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="h1" Margin="0,0,0,14"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>

        <Grid Grid.Row="1" ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="6" ColumnSpacing="6" Margin="0,0,0,10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cache DB file:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DatabaseFile}"
                     PlaceholderText="cache.db (relative to this config)" ToolTip.Tip="{Binding DatabaseFile}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="iTunes library:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ItunesLibraryPath}"
                     PlaceholderText="Optional .itl path" ToolTip.Tip="{Binding ItunesLibraryPath}"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Command="{Binding BrowseItunesLibraryCommand}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="ffmpeg:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FfmpegPath}"
                     PlaceholderText="ffmpeg or executable path" ToolTip.Tip="{Binding FfmpegPath}"/>
            <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Command="{Binding BrowseFfmpegCommand}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Length limits:" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Path" VerticalAlignment="Center"/>
                <NumericUpDown Value="{Binding LengthLimit}" Minimum="1" Maximum="4096" Width="120" FormatString="0"/>
                <TextBlock Text="Disc" VerticalAlignment="Center"/>
                <NumericUpDown Value="{Binding DiscNumLengthLimit}" Minimum="1" Maximum="4096" Width="120" FormatString="0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Classes="card" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                    <TextBlock Text="Scan roots (IndexTargets)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Add root" Command="{Binding AddTargetCommand}"/>
                </StackPanel>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding IndexTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IndexTargetRow">
                                <Border BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,0,0,1"
                                        Padding="0,4,0,8" Margin="0,0,0,4">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto,130,170,Auto" ColumnSpacing="6">
                                            <TextBox Grid.Column="0" Text="{Binding Target}" PlaceholderText="Folder path"
                                                     ToolTip.Tip="{Binding Target}"/>
                                            <Button Grid.Column="1" Content="Browse"
                                                    Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).BrowseTargetCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBox Grid.Column="2" Text="{Binding Filter}" PlaceholderText="Filter"/>
                                            <TextBox Grid.Column="3" Text="{Binding DefaultOffset}"
                                                     PlaceholderText="Default offset"
                                                     ToolTip.Tip="Used by every set below unless that set supplies an override"/>
                                            <Button Grid.Column="4" Content="Remove root"
                                                    Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).RemoveTargetCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Set memberships" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="The default offset above applies to every set without an override."
                                                       Classes="muted" VerticalAlignment="Center"/>
                                            <CheckBox Content="Include in organization"
                                                      IsChecked="{Binding Organize}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Clear to keep this root indexed while excluding it from organization operations"/>
                                            <Button Content="Add set"
                                                    Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).AddSetCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Memberships}" Margin="18,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:IndexTargetSetRow">
                                                    <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="6" Margin="0,2">
                                                        <TextBox Grid.Column="0" Text="{Binding Name}"
                                                                 PlaceholderText="Alphanumeric set name"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Offset}"
                                                                 PlaceholderText="Optional offset override"/>
                                                        <Button Grid.Column="2" Content="Remove"
                                                                Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).RemoveSetCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
            <Grid Grid.Row="0" ColumnDefinitions="150,*">
                <TextBlock Grid.Column="0" Text="Sync target:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding SyncTarget}" PlaceholderText="(optional)"
                         ToolTip.Tip="{Binding SyncTarget}"/>
            </Grid>

            <Border Grid.Row="1" Classes="card" Padding="10" Margin="0,8,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <TextBlock Text="Playlist exports" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Add target" Command="{Binding AddPlaylistTargetCommand}"/>
                        <TextBlock Text="Every target requires one or more scan sets."
                                   Classes="muted" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="150">
                        <ItemsControl ItemsSource="{Binding PlaylistTargets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaylistTargetRow">
                                    <Grid ColumnDefinitions="*,Auto,90,175,Auto" Margin="0,3" ColumnSpacing="6">
                                        <TextBox Grid.Column="0" Text="{Binding Target}" PlaceholderText="Export folder"
                                                 ToolTip.Tip="{Binding Target}"/>
                                        <Button Grid.Column="1" Content="Browse"
                                                Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).BrowsePlaylistTargetCommand}"
                                                CommandParameter="{Binding}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Type}" PlaceholderText="m3u"
                                                 ToolTip.Tip="Playlist type: m3u or wpl"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Sets" Classes="muted" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Sets}" Width="130" PlaceholderText="required"
                                                     ToolTip.Tip="Required comma-separated alphanumeric scan-set names"/>
                                        </StackPanel>
                                        <Button Grid.Column="4" Content="Remove"
                                                Command="{Binding $parent[Window].((vm:ConfigDialogViewModel)DataContext).RemovePlaylistTargetCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="IndianRed"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0"
                    HorizontalAlignment="Right">
            <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}"/>
            <Button Content="Save As…" Command="{Binding SaveAsCommand}"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
