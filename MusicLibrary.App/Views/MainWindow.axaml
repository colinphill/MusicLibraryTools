<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicLibrary.App.ViewModels"
        xmlns:models="using:MusicLibrary.Core.Models"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="MusicLibrary.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Width="1280" Height="820" MinWidth="760" MinHeight="500"
        Background="{DynamicResource AppWindowBg}"
        Title="Music Library">

    <Grid RowDefinitions="Auto,*">

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Classes="toolbar">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <StackPanel Grid.Column="0" Classes="toolbarrow" Spacing="12">
                        <Border Classes="chip" Width="56" Height="56" CornerRadius="15">
                        <!-- Brand mark: the full "lossless" waveform + verified metadata tag rows, from the app icon. -->
                        <Viewbox Width="43" Height="43" Stretch="Uniform"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="256" Height="256">
                                <!-- Lossless: full, symmetric waveform -->
                                <Rectangle Canvas.Left="29"  Canvas.Top="86" Width="18" Height="52"  RadiusX="9" RadiusY="9" Fill="White" Opacity="0.80"/>
                                <Rectangle Canvas.Left="59"  Canvas.Top="54" Width="18" Height="116" RadiusX="9" RadiusY="9" Fill="White" Opacity="0.90"/>
                                <Rectangle Canvas.Left="89"  Canvas.Top="68" Width="18" Height="88"  RadiusX="9" RadiusY="9" Fill="White" Opacity="0.95"/>
                                <Rectangle Canvas.Left="119" Canvas.Top="28" Width="18" Height="168" RadiusX="9" RadiusY="9" Fill="White"/>
                                <Rectangle Canvas.Left="149" Canvas.Top="48" Width="18" Height="128" RadiusX="9" RadiusY="9" Fill="White" Opacity="0.95"/>
                                <Rectangle Canvas.Left="179" Canvas.Top="74" Width="18" Height="76"  RadiusX="9" RadiusY="9" Fill="White" Opacity="0.90"/>
                                <Rectangle Canvas.Left="209" Canvas.Top="88" Width="18" Height="48"  RadiusX="9" RadiusY="9" Fill="White" Opacity="0.80"/>
                                <!-- Consistent metadata: two identical, aligned, verified tag rows -->
                                <Rectangle Canvas.Left="76" Canvas.Top="206" Width="104" Height="13" RadiusX="6.5" RadiusY="6.5" Fill="White" Opacity="0.92"/>
                                <Ellipse Canvas.Left="84.8" Canvas.Top="209.3" Width="6.4" Height="6.4" Fill="#5A4BD6"/>
                                <Path Data="M156,213 l3,3 l6,-8" Stroke="#5A4BD6" StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round"/>
                                <Rectangle Canvas.Left="76" Canvas.Top="224" Width="104" Height="13" RadiusX="6.5" RadiusY="6.5" Fill="White" Opacity="0.92"/>
                                <Ellipse Canvas.Left="84.8" Canvas.Top="227.3" Width="6.4" Height="6.4" Fill="#5A4BD6"/>
                                <Path Data="M156,231 l3,3 l6,-8" Stroke="#5A4BD6" StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="260">
                            <TextBlock Text="Music Library" Classes="h1"/>
                            <TextBlock Text="{Binding Settings.StatusMessage}" Classes="caption"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Settings.StatusMessage}"/>
                        </StackPanel>
                    </StackPanel>

                <!-- Configuration actions wrap instead of disappearing past the right edge. -->
                <WrapPanel Grid.Column="1" Classes="toolbarwrap" HorizontalAlignment="Right"
                           Margin="24,0,-8,-8">
                    <TextBlock Text="Config" Classes="h2" VerticalAlignment="Center"/>
                    <ComboBox Width="170" PlaceholderText="No configuration loaded"
                              ItemsSource="{Binding Settings.RecentConfigs}"
                              SelectedItem="{Binding Settings.SelectedRecent}"
                              ToolTip.Tip="{Binding Settings.ConfigPath}">
                        <!-- Collapsed box: just the file name. -->
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{Binding Converter={x:Static vm:PathToFileNameConverter.Instance}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                        <!-- Dropdown: full path (grows the popup to fit). -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Browse…" Command="{Binding Settings.BrowseCommand}"/>
                    <Button Content="New…" Command="{Binding Settings.NewConfigCommand}"/>
                    <Button Content="Edit…" Command="{Binding Settings.EditConfigCommand}"/>
                    <Button Content="Clear recent" Command="{Binding Settings.ClearRecentCommand}"
                            ToolTip.Tip="Forget the recent-configuration history"/>
                    <Button Content="Shortcuts">
                        <Button.Flyout>
                            <Flyout>
                                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="18" RowSpacing="7" Margin="6">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+1 … Ctrl+8" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Switch workspace"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+PgUp / PgDn" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Previous / next workspace"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+F" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Focus Library filter"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+R" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Reload cached Library rows"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+I" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Index library"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl+S" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Save Tag Editor / Artwork"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Esc" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Cancel active operation"/>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </WrapPanel>
                </Grid>

                <!-- Library indexing (browsing/selection happens in the Library table below). -->
                <WrapPanel Grid.Row="1" Classes="toolbarwrap" Margin="0,10,-8,-8">
                    <Button Content="Index library" Classes="accent" Command="{Binding Library.IndexCommand}"
                            ToolTip.Tip="Index library (Ctrl+I)"/>
                    <TextBlock Text="Readers" VerticalAlignment="Center" Classes="muted"/>
                    <NumericUpDown Value="{Binding Library.ReaderParallelism}" Minimum="1" Maximum="64"
                                   Increment="1" Width="112" FormatString="0"
                                   IsEnabled="{Binding !Library.IsBusy}"
                                   ToolTip.Tip="Global cap on concurrent metadata readers"/>
                    <TextBlock Text="Auto min" VerticalAlignment="Center" Classes="muted"/>
                    <NumericUpDown Value="{Binding Library.ScheduledScanMinutes}" Minimum="0" Maximum="1440"
                                   Increment="5" Width="112" FormatString="0"
                                   IsEnabled="{Binding !Library.IsBusy}"
                                   ToolTip.Tip="{Binding Library.ScheduledScanText}"/>
                    <Button Content="Benchmark readers" Command="{Binding Library.BenchmarkReadersCommand}"
                            ToolTip.Tip="Read a bounded metadata sample from each configured root; makes no changes"/>
                    <Button Content="Use recommendation" Command="{Binding Library.UseBenchmarkRecommendationCommand}"
                            IsVisible="{Binding Library.HasBenchmarkRecommendation}"/>
                    <Button Content="Benchmark results…" IsVisible="{Binding Library.HasBenchmarkDetails}">
                        <Button.Flyout>
                            <Flyout>
                                <ScrollViewer MaxHeight="420" MaxWidth="760">
                                    <TextBlock Text="{Binding Library.BenchmarkDetails}" TextWrapping="Wrap"
                                               Width="720" Margin="8"/>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Root health…" IsVisible="{Binding Library.HasRootHealthDetails}">
                        <Button.Flyout>
                            <Flyout>
                                <ScrollViewer MaxHeight="420" MaxWidth="760">
                                    <TextBlock Text="{Binding Library.RootHealthDetails}" TextWrapping="Wrap"
                                               Width="720" Margin="8"/>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Cancel" Command="{Binding Library.CancelIndexCommand}"
                            IsVisible="{Binding Library.IsBusy}"/>
                    <ProgressBar IsIndeterminate="True" Width="60"
                                 IsVisible="{Binding Library.IsBusy}"/>
                    <TextBlock Text="{Binding Library.StatusText}" Classes="muted"
                               MaxWidth="900" TextWrapping="Wrap"
                               ToolTip.Tip="{Binding Library.StatusText}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Border Grid.Row="1" Classes="card" Padding="0" Margin="14">
            <TabControl Margin="14,4,14,14" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                    <!-- Library: the primary browse + selection surface (auto-populates) -->
                    <TabItem Header="Library" DataContext="{Binding Table}" x:DataType="vm:DetailsGridViewModel">
                        <Grid RowDefinitions="Auto,*" Margin="2,12,2,2">
                            <WrapPanel Grid.Row="0" Classes="toolbarwrap" Margin="0,0,-8,2">
                                <Button Content="Reload" Classes="accent" Command="{Binding LoadCommand}"
                                        ToolTip.Tip="Reload cached rows (Ctrl+R)"/>
                                <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/>
                                <ProgressBar IsIndeterminate="True" Width="60" VerticalAlignment="Center"
                                             IsVisible="{Binding IsBusy}"/>
                                <Button Content="Columns ▾">
                                    <Button.Flyout>
                                        <Flyout>
                                            <ScrollViewer MaxHeight="400">
                                                <ItemsControl ItemsSource="{Binding Columns}" Margin="4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ColumnToggle">
                                                            <CheckBox Content="{Binding Header}" IsChecked="{Binding IsSelected}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <ComboBox ItemsSource="{Binding SavedViews}"
                                          SelectedItem="{Binding SelectedSavedView}"
                                          Width="160" PlaceholderText="Saved views">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SavedLibraryView">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Text="{Binding SavedViewName}" Width="150"
                                         PlaceholderText="View name"/>
                                <Button Content="Save view" Click="OnSaveLibraryView"
                                        IsEnabled="{Binding CanSaveView}"/>
                                <Button Content="Delete view" Command="{Binding DeleteSavedViewCommand}"/>
                                <ComboBox ItemsSource="{Binding FilterModes}"
                                          SelectedItem="{Binding SelectedFilterMode}" Width="120"/>
                                <ComboBox ItemsSource="{Binding FilterScopes}"
                                          SelectedItem="{Binding SelectedScope}" Width="170"
                                          ToolTip.Tip="Filter in which column"/>
                                <TextBox Name="LibraryFilterTextBox" Text="{Binding FilterText}" Width="360"
                                         PlaceholderText="Filter or Artist:Name AND NOT Codec:MP3"
                                         ToolTip.Tip="{Binding FilterError}"/>
                                <Button Content="Syntax">
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Width="440" Spacing="7" Margin="6">
                                                <TextBlock Text="Advanced library filtering" FontWeight="SemiBold"/>
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="Qualify terms with any column name and combine them with uppercase AND, OR, NOT, and parentheses."/>
                                                <TextBlock FontFamily="Consolas" TextWrapping="Wrap"
                                                           Text="Artist:&quot;Miles Davis&quot; AND (Codec:FLAC OR Codec:ALAC) AND NOT Album:Live"/>
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="Adjacent terms imply AND. Column names ignore spaces and punctuation, so AlbumArtist and album-artist are equivalent. Quote values containing spaces or parentheses."/>
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="The selected Substring, Glob, or Regex mode applies to every term. Unqualified text uses the selected scope; qualified terms can use hidden columns."/>
                                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                                           Text="Plain text without column qualifiers or uppercase boolean operators keeps the original filtering behavior."/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock Text="{Binding StatusText}" Classes="muted" MaxWidth="320"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}"/>
                            </WrapPanel>

                            <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True"
                                    BorderThickness="1" BorderBrush="{DynamicResource AppDivider}">
                                <DataGrid Name="DetailsGrid"
                                          ItemsSource="{Binding View}"
                                          SelectionMode="Extended"
                                          CanUserSortColumns="True"
                                          CanUserResizeColumns="True"
                                          CanUserReorderColumns="True"
                                          RowHeight="48"
                                          IsReadOnly="True">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open Details" Click="OnOpenDetails"/>
                                            <MenuItem Header="Edit tags" Click="OnEditTags"/>
                                            <MenuItem Header="Edit artwork" Click="OnEditArtwork"/>
                                            <Separator/>
                                            <MenuItem Header="Reindex selection" Click="OnReindexSelection"/>
                                            <MenuItem Header="Reveal first file" Click="OnRevealSelection"/>
                                            <MenuItem Header="Copy path(s)" Click="OnCopyPaths"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tag Editor (single + batch) -->
                    <TabItem Header="Tag Editor">
                        <Grid RowDefinitions="Auto,*,Auto" Margin="2,10,2,2" DataContext="{Binding Editor}"
                              x:DataType="vm:TagEditorViewModel">
                            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                                <TextBlock Text="{Binding TargetSummary}" FontWeight="SemiBold" FontSize="15"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Blank a field and Save to clear it. Only edited fields are written."
                                           Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" IsEnabled="{Binding HasTargets}">
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EditableField">
                                            <Grid ColumnDefinitions="150,*" Margin="0,4">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           VerticalAlignment="Center" Classes="muted"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}"
                                                         PlaceholderText="{Binding IsMixed, Converter={x:Static vm:MixedConverter.Instance}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <WrapPanel Grid.Row="2" Classes="toolbarwrap" Margin="0,12,-8,-8">
                                <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}"
                                        ToolTip.Tip="Save tag edits (Ctrl+S)"/>
                                <Button Content="Revert" Command="{Binding RevertCommand}"/>
                                <Button Content="Edit all fields…" Command="{Binding EditAllFieldsCommand}"/>
                                <TextBlock Text="{Binding ResultMessage}" Classes="muted" TextWrapping="Wrap"
                                           MaxWidth="420"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <!-- Read-only details of the focused file (representative when multi-selected) -->
                    <TabItem Header="Details" DataContext="{Binding Inspector}" x:DataType="vm:FileInspectorViewModel">
                        <Grid Margin="2,12,2,2" RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="{Binding MultiSelectionNote}" Classes="muted" Margin="0,0,0,8"
                                       IsVisible="{Binding MultiSelectionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <Grid Grid.Row="1" ColumnDefinitions="280,*"
                                  IsVisible="{Binding HasContent}">
                                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled"
                                              Margin="0,0,16,0">
                                <StackPanel Spacing="10">
                                    <Border Width="260" Height="260" HorizontalAlignment="Left" CornerRadius="10"
                                            ClipToBounds="True"
                                            Background="{DynamicResource AppInsetBg}">
                                        <Panel>
                                            <Image Source="{Binding Artwork}" Stretch="Uniform"
                                                   IsVisible="{Binding !ArtworkIsMixed}"/>
                                            <StackPanel IsVisible="{Binding ArtworkIsMixed}" Spacing="8"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🖼" FontSize="46" Opacity="0.55" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Artwork differs" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="{Binding ArtworkCaption}" Classes="caption" TextWrapping="Wrap"/>
                                    <StackPanel Spacing="3" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding HeaderTitle}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding HeaderArtist}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding HeaderAlbum}" FontStyle="Italic" TextWrapping="Wrap" Classes="muted"/>
                                        <TextBlock Text="{Binding HeaderInfo}" Classes="caption" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>

                                <TabControl Grid.Column="1">
                                    <TabItem Header="Known fields">
                                        <ScrollViewer Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding KnownFields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AggregatedField">
                                                        <Grid ColumnDefinitions="180,*" Margin="0,3">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="muted"
                                                                       TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                                       FontStyle="{Binding IsMixed, Converter={x:Static vm:MixedFontStyleConverter.Instance}}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Raw text">
                                        <ScrollViewer Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding TextFields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AggregatedField">
                                                        <Grid ColumnDefinitions="180,*" Margin="0,3">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="muted"
                                                                       TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                                       FontStyle="{Binding IsMixed, Converter={x:Static vm:MixedFontStyleConverter.Instance}}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Artwork gallery for the focused file -->
                    <TabItem Header="Artwork" DataContext="{Binding Artwork}" x:DataType="vm:ArtworkViewModel">
                        <Grid RowDefinitions="Auto,Auto,*" Margin="2,12,2,2">
                            <WrapPanel Grid.Row="0" Classes="toolbarwrap" Margin="0,0,-8,0">
                                <Button Content="Add image…" Classes="accent" Command="{Binding AddCommand}"/>
                                <Button Content="Scrub all" Command="{Binding ScrubAllCommand}"/>
                                <Button Content="Save" Command="{Binding SaveCommand}"
                                        ToolTip.Tip="Save artwork changes (Ctrl+S)"/>
                                <Button Content="Preview normalization" Command="{Binding PreviewNormalizationCommand}"
                                        ToolTip.Tip="Re-encode the chosen canonical image and calculate projected batch size"/>
                                <Button Content="Apply normalization" Classes="accent"
                                        Command="{Binding ApplyNormalizationCommand}"/>
                                <TextBlock Text="Max px" VerticalAlignment="Center" Classes="muted"/>
                                <NumericUpDown Value="{Binding MaxDimension}" Minimum="0" Maximum="4000"
                                               Increment="100" Width="120" FormatString="0"/>
                                <ProgressBar IsIndeterminate="True" Width="70" VerticalAlignment="Center"
                                             IsVisible="{Binding IsBusy}"/>
                            </WrapPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,8" Spacing="2">
                                <TextBlock Text="{Binding TargetSummary}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"
                                           IsVisible="{Binding TargetSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="This file's format doesn't support artwork writing."
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           IsVisible="{Binding !SupportsWrite}"/>
                                <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding NormalizationPreviewText}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                           IsVisible="{Binding HasNormalizationPreview}"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="2">
                                <ItemsControl ItemsSource="{Binding Images}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ArtworkSlot">
                                            <Border Classes="card" Margin="0,0,12,12" Padding="10" Width="236">
                                                <StackPanel Spacing="8">
                                                    <Border Width="214" Height="214" CornerRadius="8" ClipToBounds="True"
                                                            Background="{DynamicResource AppInsetBg}">
                                                        <Image Source="{Binding Preview}" Stretch="Uniform"/>
                                                    </Border>
                                                    <ComboBox HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding $parent[ItemsControl].((vm:ArtworkViewModel)DataContext).PictureTypes}"
                                                              SelectedItem="{Binding Type}"/>
                                                    <TextBlock Text="{Binding Usage}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               IsVisible="{Binding Usage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Classes="caption"/>
                                                    <TextBlock Text="Canonical album image" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               IsVisible="{Binding IsCanonical}"/>
                                                    <Button Content="Use as canonical" HorizontalAlignment="Stretch"
                                                            Command="{Binding $parent[ItemsControl].((vm:ArtworkViewModel)DataContext).SelectCanonicalCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Remove" HorizontalAlignment="Stretch"
                                                            Command="{Binding $parent[ItemsControl].((vm:ArtworkViewModel)DataContext).RemoveCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Library-wide analysis: each type runs on its own button -->
                    <TabItem Header="Analyze" DataContext="{Binding Analyzer}" x:DataType="vm:AnalyzerViewModel">
                        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="2,12,2,2">
                            <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                                <Button Content="Inconsistencies" Classes="accent" Margin="0,0,8,8"
                                        Command="{Binding RunInconsistenciesCommand}"/>
                                <Button Content="Lossy files" Margin="0,0,8,8" Command="{Binding RunLossyCommand}"/>
                                <Button Content="Duplicates" Margin="0,0,8,8" Command="{Binding RunDuplicatesCommand}"/>
                                <Button Content="Cross-set check" Margin="0,0,8,8" Command="{Binding RunCheckSetsCommand}"/>
                                <Button Content="Representations" Margin="0,0,8,8" Command="{Binding RunRepresentationsCommand}"
                                        ToolTip.Tip="Compare cached CD/high-resolution FLAC, purchased, and generated AAC counterparts"/>
                                <Button Content="Representation repairs" Margin="0,0,8,8"
                                        Command="{Binding PreviewRepresentationRepairsCommand}"
                                        ToolTip.Tip="Preview counterpart metadata copies, missing derived files, and canonical organization"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,8,8">
                                    <Button Content="Verify decoded audio" Command="{Binding VerifyDecodedAudioCommand}"
                                            ToolTip.Tip="Hash decoded PCM for compatible lossless representation pairs"/>
                                    <TextBox Text="{Binding FfmpegPath}" Width="210" PlaceholderText="ffmpeg path"
                                             ToolTip.Tip="ffmpeg executable used only for explicit decoded-audio verification"/>
                                </StackPanel>
                                <Button Content="Album matrix" Margin="0,0,8,8" Command="{Binding RunAlbumMatrixCommand}"/>
                                <Button Content="Artwork health" Margin="0,0,8,8" Command="{Binding RunArtworkHealthCommand}"
                                        ToolTip.Tip="Audit cached artwork metadata without loading image blobs or scanning deferred files"/>
                                <Button Content="Metadata repairs" Margin="0,0,8,8"
                                        Command="{Binding PreviewMetadataRepairsCommand}"/>
                                <Button Content="Album artist conflicts" Margin="0,0,8,8"
                                        Command="{Binding FindAlbumArtistConflictsCommand}"
                                        ToolTip.Tip="Choose canonical values for ambiguous album artists"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,8,8" VerticalAlignment="Center">
                                    <Button Content="Similar artists" Command="{Binding RunSimilarArtistsCommand}"/>
                                    <TextBlock Text="threshold" Classes="muted" VerticalAlignment="Center"/>
                                    <NumericUpDown Value="{Binding ArtistThreshold}" Minimum="0" Maximum="100"
                                                   Increment="0.05" FormatString="0.00" Width="120"
                                                   ToolTip.Tip="Fuzzy-distance threshold for the artist check (0 = identical only)"/>
                                </StackPanel>
                                <Button Content="Cancel" Margin="0,0,8,8" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/>
                                <ProgressBar IsIndeterminate="True" Width="70" VerticalAlignment="Center" Margin="0,0,8,8"
                                             IsVisible="{Binding IsBusy}"/>
                            </WrapPanel>

                            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Classes="muted" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>

                            <WrapPanel Grid.Row="2" Classes="toolbarwrap" Margin="0,0,-8,8"
                                       IsVisible="{Binding HasRuns}">
                                <TextBlock Text="Results" Classes="muted" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"
                                          MinWidth="300" MaxWidth="520">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnalysisRunViewModel">
                                            <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Remove result" Command="{Binding RemoveRunCommand}"/>
                                <Button Content="Clear results" Command="{Binding ClearRunsCommand}"/>
                            </WrapPanel>

                            <Grid Grid.Row="3">
                                <!-- Findings (inconsistencies / lossy / cross-set) -->
                                <ListBox IsVisible="{Binding ShowFindings}" ItemsSource="{Binding FindingGroups}"
                                         Classes="analysisresults">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AnalysisProblemGroupViewModel">
                                                <Expander Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                                    <Expander.Header>
                                                        <TextBlock>
                                                            <Run Text="{Binding Problem}" FontWeight="SemiBold"/>
                                                            <Run Text="{Binding Count, StringFormat=' ({0})'}"/>
                                                            <Run Text="{Binding ActiveCount, StringFormat=' · {0} active'}"
                                                                 Foreground="{DynamicResource AppTextMuted}"/>
                                                        </TextBlock>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding Albums}" Margin="10,0,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AnalysisAlbumGroupViewModel">
                                                                <Expander Margin="0,2" HorizontalAlignment="Stretch">
                                                                    <Expander.Header>
                                                                        <TextBlock>
                                                                            <Run Text="{Binding Album}" FontWeight="SemiBold"/>
                                                                            <Run Text="{Binding Count, StringFormat=' ({0})'}"/>
                                                                            <Run Text="{Binding ActiveCount, StringFormat=' · {0} active'}"
                                                                                 Foreground="{DynamicResource AppTextMuted}"/>
                                                                        </TextBlock>
                                                                    </Expander.Header>
                                                                    <ItemsControl ItemsSource="{Binding Findings}" Margin="10,0,0,0">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:AnalysisFindingViewModel">
                                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                    <Button Grid.Column="0" HorizontalAlignment="Stretch"
                                                                                            HorizontalContentAlignment="Left"
                                                                                            Background="Transparent" Padding="8,4" CornerRadius="6"
                                                                                            Command="{Binding $parent[TabItem].((vm:AnalyzerViewModel)DataContext).OpenCommand}"
                                                                                            CommandParameter="{Binding Path}">
                                                                                        <StackPanel>
                                                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                                                            <TextBlock Text="{Binding Path}" Classes="caption" TextWrapping="Wrap"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                    <ComboBox Grid.Column="1" Width="120" VerticalAlignment="Center"
                                                                                              ItemsSource="{Binding Dispositions}"
                                                                                              SelectedItem="{Binding Disposition}"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Duplicates -->
                                <ListBox IsVisible="{Binding ShowDuplicates}" ItemsSource="{Binding Duplicates}"
                                         Classes="analysisresults">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:DuplicateGroup">
                                                <Border Classes="card" Margin="0,0,0,10" Padding="12">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                        <ItemsControl ItemsSource="{Binding Tracks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:TrackRecord">
                                                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                            Background="Transparent" Padding="8,4" CornerRadius="6"
                                                                            Command="{Binding $parent[TabItem].((vm:AnalyzerViewModel)DataContext).OpenCommand}"
                                                                            CommandParameter="{Binding Path}">
                                                                        <TextBlock TextWrapping="Wrap">
                                                                            <Run Text="{Binding CodecName}" FontWeight="SemiBold"/>
                                                                            <Run Text="{Binding SampleRate, StringFormat=' {0}Hz · '}"/>
                                                                            <Run Text="{Binding Path}"/>
                                                                        </TextBlock>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Similar artists (merge in place) -->
                                <ListBox IsVisible="{Binding ShowArtists}" ItemsSource="{Binding ArtistGroups}"
                                         Classes="analysisresults">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ArtistGroupViewModel">
                                                <Border Classes="card" Margin="0,0,0,10" Padding="12">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="{Binding TrackCount, StringFormat='Similar spellings · {0} tracks'}"
                                                                   Classes="h2"/>
                                                        <ItemsControl ItemsSource="{Binding Variants}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ArtistVariant">
                                                                    <Expander Margin="0,1" HorizontalAlignment="Stretch" Padding="8,4">
                                                                        <Expander.Header>
                                                                            <TextBlock>
                                                                                <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                                <Run Text="{Binding TrackCount, StringFormat='  ({0} files)'}"
                                                                                     Foreground="{DynamicResource AppTextMuted}"/>
                                                                            </TextBlock>
                                                                        </Expander.Header>
                                                                        <ItemsControl ItemsSource="{Binding Paths}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="sys:String">
                                                                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                            Background="Transparent" Padding="8,2" CornerRadius="6"
                                                                                            Command="{Binding $parent[TabItem].((vm:AnalyzerViewModel)DataContext).OpenCommand}"
                                                                                            CommandParameter="{Binding}">
                                                                                        <TextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap"/>
                                                                                    </Button>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Expander>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <WrapPanel Classes="toolbarwrap" Margin="0,4,-8,-8">
                                                            <TextBlock Text="Merge to:" VerticalAlignment="Center" Classes="muted"/>
                                                            <TextBox Text="{Binding CanonicalName}" Width="280"
                                                                     IsEnabled="{Binding !IsMerged}"/>
                                                            <Button Content="Merge" Classes="accent"
                                                                    Command="{Binding MergeCommand}"/>
                                                            <ProgressBar IsIndeterminate="True" Width="60" VerticalAlignment="Center"
                                                                         IsVisible="{Binding IsBusy}"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"
                                                                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Explicit choices for ambiguous album-artist values -->
                                <Grid IsVisible="{Binding ShowConflicts}" RowDefinitions="Auto,*">
                                    <WrapPanel Grid.Row="0" Classes="toolbarwrap" Margin="0,0,-8,4">
                                        <Button Content="Create repair preview" Classes="accent"
                                                Command="{Binding PreviewConflictRepairsCommand}"/>
                                        <TextBlock Text="Choose an existing canonical value for any album you want to repair. Nothing is selected automatically."
                                                   Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </WrapPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding ConflictGroups}"
                                             Classes="analysisresults">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AnalysisConflictGroupViewModel">
                                                    <Border Classes="card" Margin="0,0,0,8" Padding="12">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                            <StackPanel Grid.Column="0" Spacing="3">
                                                                <TextBlock Text="{Binding Album}" Classes="h2" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Directory}" Classes="caption" TextWrapping="Wrap"/>
                                                                <TextBlock Classes="muted">
                                                                    <Run Text="{Binding FileCount, StringFormat='{}{0} files · '}"/>
                                                                    <Run Text="{Binding Options.Count, StringFormat='{}{0} existing values · '}"/>
                                                                    <Run Text="{Binding MissingCount, StringFormat='{}{0} missing'}"/>
                                                                </TextBlock>
                                                                <ItemsControl ItemsSource="{Binding Options}" Margin="0,3,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:AnalysisConflictOptionViewModel">
                                                                            <Expander HorizontalAlignment="Stretch" Padding="6,2">
                                                                                <Expander.Header>
                                                                                    <TextBlock>
                                                                                        <Run Text="{Binding Value}" FontWeight="SemiBold"/>
                                                                                        <Run Text="{Binding FileCount, StringFormat='  ({0} files)'}"
                                                                                             Foreground="{DynamicResource AppTextMuted}"/>
                                                                                    </TextBlock>
                                                                                </Expander.Header>
                                                                                <ItemsControl ItemsSource="{Binding Paths}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="sys:String">
                                                                                            <Button HorizontalAlignment="Stretch"
                                                                                                    HorizontalContentAlignment="Left"
                                                                                                    Background="Transparent" Padding="4,2"
                                                                                                    Command="{Binding $parent[TabItem].((vm:AnalyzerViewModel)DataContext).OpenCommand}"
                                                                                                    CommandParameter="{Binding}">
                                                                                                <TextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap"/>
                                                                                            </Button>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Expander>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" MinWidth="240" Spacing="4">
                                                                <TextBlock Text="Canonical album artist" Classes="muted"/>
                                                                <ComboBox ItemsSource="{Binding Options}"
                                                                          SelectedItem="{Binding SelectedOption}"
                                                                          PlaceholderText="Choose a value…">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:AnalysisConflictOptionViewModel">
                                                                            <TextBlock>
                                                                                <Run Text="{Binding Value}"/>
                                                                                <Run Text="{Binding FileCount, StringFormat='  ({0} files)'}"
                                                                                     Foreground="{DynamicResource AppTextMuted}"/>
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <!-- Previewable, stale-checked metadata repairs -->
                                <Grid IsVisible="{Binding ShowRepairs}" RowDefinitions="Auto,*">
                                    <WrapPanel Grid.Row="0" Classes="toolbarwrap" Margin="0,0,-8,4">
                                        <Button Content="Apply selected" Classes="accent"
                                                Command="{Binding ApplyRepairsCommand}"/>
                                        <TextBlock Text="Automatic repairs are unambiguous; explicit conflict choices use the same stale-checked preview."
                                                   Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </WrapPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding RepairItems}"
                                             Classes="analysisresults">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AnalysisRepairItemViewModel">
                                                    <Border Classes="card" Margin="0,0,0,8" Padding="12">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                                      IsEnabled="{Binding !IsApplied}"
                                                                      VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1" Spacing="3">
                                                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                                    <Run Text="{Binding Field}"/>
                                                                    <Run Text="{Binding Before, StringFormat='  {0} → '}"/>
                                                                    <Run Text="{Binding After}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                                                                <Button HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                                        Background="Transparent" Padding="0,2"
                                                                        Command="{Binding $parent[TabItem].((vm:AnalyzerViewModel)DataContext).OpenCommand}"
                                                                        CommandParameter="{Binding Path}">
                                                                    <TextBlock Text="{Binding Path}" Classes="caption" TextWrapping="Wrap"/>
                                                                </Button>
                                                                <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <!-- Cache-only album metadata matrices; highlighted cells violate an invariant. -->
                                <ListBox IsVisible="{Binding ShowMatrix}" ItemsSource="{Binding Matrices}"
                                         Classes="analysisresults"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AlbumMetadataMatrix">
                                                <Expander Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                                    <Expander.Header>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold">
                                                                <Run Text="{Binding DisplayName}"/>
                                                                <Run Text="{Binding TrackCount, StringFormat=' · {0} tracks'}"/>
                                                                <Run Text="{Binding InconsistentCellCount, StringFormat=' · {0} highlighted'}"
                                                                     Foreground="{DynamicResource AppWarningStroke}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Root}" Classes="caption"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Disabled">
                                                        <StackPanel Width="1520">
                                                            <Grid ColumnDefinitions="60,60,75,75,170,190,200,110,220,360">
                                                                <Border Grid.Column="0" Classes="matrixcell"><TextBlock Text="Disc" Classes="h2"/></Border>
                                                                <Border Grid.Column="1" Classes="matrixcell"><TextBlock Text="Track" Classes="h2"/></Border>
                                                                <Border Grid.Column="2" Classes="matrixcell"><TextBlock Text="Tracks" Classes="h2"/></Border>
                                                                <Border Grid.Column="3" Classes="matrixcell"><TextBlock Text="Discs" Classes="h2"/></Border>
                                                                <Border Grid.Column="4" Classes="matrixcell"><TextBlock Text="Artist" Classes="h2"/></Border>
                                                                <Border Grid.Column="5" Classes="matrixcell"><TextBlock Text="Album artist" Classes="h2"/></Border>
                                                                <Border Grid.Column="6" Classes="matrixcell"><TextBlock Text="Album" Classes="h2"/></Border>
                                                                <Border Grid.Column="7" Classes="matrixcell"><TextBlock Text="Release date" Classes="h2"/></Border>
                                                                <Border Grid.Column="8" Classes="matrixcell"><TextBlock Text="Title" Classes="h2"/></Border>
                                                                <Border Grid.Column="9" Classes="matrixcell"><TextBlock Text="File" Classes="h2"/></Border>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:AlbumMetadataRow">
                                                                        <Grid ColumnDefinitions="60,60,75,75,170,190,200,110,220,360">
                                                                            <Border Grid.Column="0" Classes="matrixcell"
                                                                                    Classes.inconsistent="{Binding DiscNumber.IsInconsistent}"
                                                                                    ToolTip.Tip="{Binding DiscNumber.Reason}">
                                                                                <TextBlock Text="{Binding DiscNumber.Display}" TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                            <Border Grid.Column="1" Classes="matrixcell"
                                                                                    Classes.inconsistent="{Binding TrackNumber.IsInconsistent}"
                                                                                    ToolTip.Tip="{Binding TrackNumber.Reason}">
                                                                                <TextBlock Text="{Binding TrackNumber.Display}" TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                            <Border Grid.Column="2" Classes="matrixcell"
                                                                                    Classes.inconsistent="{Binding TrackTotal.IsInconsistent}"
                                                                                    ToolTip.Tip="{Binding TrackTotal.Reason}">
                                                                                <TextBlock Text="{Binding TrackTotal.Display}" TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                            <Border Grid.Column="3" Classes="matrixcell"
                                                                                    Classes.inconsistent="{Binding DiscTotal.IsInconsistent}"
                                                                                    ToolTip.Tip="{Binding DiscTotal.Reason}">
                                                                                <TextBlock Text="{Binding DiscTotal.Display}" TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                            <Border Grid.Column="4" Classes="matrixcell"
                                                                                    Classes.inconsistent="{Binding Artist.IsInconsistent}"
                                                                                    ToolTip.Tip="{Binding Artist.Reason}">
                                                                                <TextBlock Text="{Binding Artist.Display}" TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                            <Border Grid.Column="5" Classes="matrixcell"
                                                                                    Classes.inconsistent="{Binding AlbumArtist.IsInconsistent}"
                                                                                    ToolTip.Tip="{Binding AlbumArtist.Reason}">
                                                                                <TextBlock Text="{Binding AlbumArtist.Display}" TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                            <Border Grid.Column="6" Classes="matrixcell"
                                                                                    Classes.inconsistent="{Binding Album.IsInconsistent}"
                                                                                    ToolTip.Tip="{Binding Album.Reason}">
                                                                                <TextBlock Text="{Binding Album.Display}" TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                            <Border Grid.Column="7" Classes="matrixcell"
                                                                                    Classes.inconsistent="{Binding ReleaseDate.IsInconsistent}"
                                                                                    ToolTip.Tip="{Binding ReleaseDate.Reason}">
                                                                                <TextBlock Text="{Binding ReleaseDate.Display}" TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                            <Border Grid.Column="8" Classes="matrixcell"
                                                                                    Classes.inconsistent="{Binding Title.IsInconsistent}"
                                                                                    ToolTip.Tip="{Binding Title.Reason}">
                                                                                <TextBlock Text="{Binding Title.Display}" TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                            <Border Grid.Column="9" Classes="matrixcell">
                                                                                <Button Background="Transparent" Padding="0"
                                                                                        HorizontalAlignment="Stretch"
                                                                                        HorizontalContentAlignment="Left"
                                                                                        Command="{Binding $parent[TabItem].((vm:AnalyzerViewModel)DataContext).OpenCommand}"
                                                                                        CommandParameter="{Binding Path}">
                                                                                    <TextBlock Text="{Binding Path}" Classes="caption"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                </Button>
                                                                            </Border>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Expander>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Ingest incoming FLAC / ALAC albums -->
                    <TabItem Header="Ingest" DataContext="{Binding Ingest}" x:DataType="vm:IngestViewModel">
                        <Grid RowDefinitions="Auto,*" Margin="2,12,2,2">
                            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto,220" ColumnSpacing="8"
                                      DragDrop.AllowDrop="True"
                                      DragDrop.DragOver="OnIngestSourceDragOver"
                                      DragDrop.Drop="OnIngestSourceDrop">
                                    <TextBlock Grid.Column="0" Text="Source" VerticalAlignment="Center" Classes="muted"/>
                                    <TextBox Grid.Column="1" Text="{Binding SourceDirectory}"
                                             ToolTip.Tip="Drop a source folder here, or enter its path"/>
                                    <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseSourceCommand}"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding RecentSources}"
                                              SelectedItem="{Binding SelectedRecentSource}"
                                              PlaceholderText="Recent sources">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Config" VerticalAlignment="Center" Classes="muted"/>
                                    <TextBox Grid.Column="1" Text="{Binding ConfigurationPath}"
                                             ToolTip.Tip="{Binding ConfigurationPath}"/>
                                    <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseConfigurationCommand}"/>
                                    <Button Grid.Column="3" Content="New…" Command="{Binding NewConfigurationCommand}"/>
                                    <Button Grid.Column="4" Content="Edit…" Command="{Binding EditConfigurationCommand}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,220,*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Preset" VerticalAlignment="Center" Classes="muted"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding SelectedPreset}" PlaceholderText="Choose preset">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:IngestPreset">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="2" Text="{Binding PresetName}" PlaceholderText="Preset name"/>
                                    <Button Grid.Column="3" Content="Save preset" Command="{Binding SavePresetCommand}"/>
                                    <Button Grid.Column="4" Content="Delete" Command="{Binding DeletePresetCommand}"/>
                                </Grid>
                                <WrapPanel Classes="toolbarwrap" Margin="0,0,-8,-8">
                                    <Button Content="Preflight" Command="{Binding PreflightCommand}"/>
                                    <Button Content="Preview" Command="{Binding PreviewCommand}"/>
                                    <Button Content="Apply" Classes="accent" Command="{Binding ApplyCommand}"/>
                                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/>
                                    <ProgressBar IsIndeterminate="True" Width="70" VerticalAlignment="Center" IsVisible="{Binding IsPreviewing}"/>
                                    <ProgressBar Minimum="0" Maximum="{Binding ApplyProgressMaximum}" Value="{Binding ApplyProgress}"
                                                 Width="180" VerticalAlignment="Center" IsVisible="{Binding IsApplying}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Classes="muted"/>
                                <ItemsControl ItemsSource="{Binding PreflightChecks}" IsVisible="{Binding HasPreflightChecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:IngestPreflightCheck">
                                            <Grid ColumnDefinitions="90,*" ColumnSpacing="8" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Severity}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                                    <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Message, StringFormat=' — {0}'}"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="8"
                                      IsVisible="{Binding HasPreviewSummary}">
                                    <Border Grid.Column="0" Classes="card" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Albums" Classes="caption"/>
                                            <TextBlock Text="{Binding AlbumCount}" Classes="h2"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="card" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Outputs" Classes="caption"/>
                                            <TextBlock Text="{Binding OutputCount}" Classes="h2"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="card" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Conflicts" Classes="caption"/>
                                            <TextBlock Text="{Binding ConflictCount}" Classes="h2"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Classes="card" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Cleanup" Classes="caption"/>
                                            <TextBlock Text="{Binding CleanupCount}" Classes="h2"/>
                                        </StackPanel>
                                    </Border>
                                    <ComboBox Grid.Column="4" ItemsSource="{Binding PreviewFilters}"
                                              SelectedItem="{Binding SelectedPreviewFilter}"
                                              MinWidth="130" VerticalAlignment="Center"/>
                                </Grid>
                                <Expander Header="Ingest history and recovery" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="6" Margin="8,4,0,4">
                                        <WrapPanel Classes="toolbarwrap" Margin="0,0,-8,0">
                                            <Button Content="Refresh history" Command="{Binding RefreshHistoryCommand}"/>
                                            <ProgressBar IsIndeterminate="True" Width="60" VerticalAlignment="Center"
                                                         IsVisible="{Binding IsHistoryBusy}"/>
                                            <TextBlock Classes="muted" VerticalAlignment="Center">
                                                <Run Text="{Binding History.Count, StringFormat='{}{0} runs · '}"/>
                                                <Run Text="{Binding InterruptedHistoryCount, StringFormat='{}{0} interrupted'}"/>
                                            </TextBlock>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding HistoryStatus}" Classes="muted" TextWrapping="Wrap"/>
                                        <ScrollViewer MaxHeight="220" IsVisible="{Binding HasHistory}">
                                            <ItemsControl ItemsSource="{Binding History}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:IngestHistoryItemViewModel">
                                                        <Grid ColumnDefinitions="Auto,150,*,Auto" ColumnSpacing="10" Margin="0,3">
                                                            <TextBlock Grid.Column="0" Text="{Binding Created}" Classes="caption"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding State}" TextWrapping="Wrap"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="{Binding AffectedItems}"/>
                                                                <TextBlock Text="{Binding RunPath}" Classes="caption"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Content="Browse / recover"
                                                                    Command="{Binding $parent[TabItem].((vm:IngestViewModel)DataContext).OpenHistoryCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:IngestFileItemViewModel">
                                            <StackPanel Margin="0,6">
                                                <TextBlock Text="{Binding SourceType}" FontWeight="SemiBold"
                                                           TextDecorations="{Binding IsComplete, Converter={x:Static vm:StrikeConverter.Instance}}"/>
                                                <TextBlock Text="{Binding Source}" Classes="caption" TextWrapping="Wrap"
                                                           TextDecorations="{Binding IsComplete, Converter={x:Static vm:StrikeConverter.Instance}}"/>
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="12,3,0,0"
                                                           TextDecorations="{Binding IsComplete, Converter={x:Static vm:StrikeConverter.Instance}}"/>
                                                <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" Margin="12,4,0,0"
                                                           IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Organize / Rename (preview → confirm → apply) -->
                    <TabItem Header="Organize" DataContext="{Binding Organize}" x:DataType="vm:OrganizeViewModel">
                        <Grid RowDefinitions="Auto,*" Margin="2,12,2,2">
                            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
                                <WrapPanel Classes="toolbarwrap" Margin="0,0,-8,-8">
                                    <Button Content="Preview" Command="{Binding PreviewCommand}"/>
                                    <Button Content="Apply moves" Classes="accent" Command="{Binding ApplyCommand}"/>
                                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/>
                                    <ProgressBar IsIndeterminate="True" Width="70" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsBusy}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Classes="muted"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding Moves}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:PlannedMove">
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="{Binding Source}" Classes="caption" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Destination, StringFormat='→ {0}'}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Inventory, restore, and retention management for quarantine/recovery operations -->
                    <TabItem Header="Operations" DataContext="{Binding Operations}" x:DataType="vm:OperationsViewModel">
                        <Grid RowDefinitions="Auto,*" Margin="2,12,2,2">
                            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
                                <Expander Header="Run library jobs" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="7" Margin="8,6,0,6">
                                        <Grid ColumnDefinitions="145,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Job" Classes="muted"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding JobCatalog}"
                                                      SelectedItem="{Binding SelectedJob}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:UnifiedJobDescriptor">
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedJob.Description}"
                                                       Classes="muted" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="145,*,Auto" ColumnSpacing="8"
                                              IsVisible="{Binding ShowConfigurationPath}">
                                            <TextBlock Grid.Column="0" Text="Configuration" Classes="muted"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding JobConfigurationPath}"
                                                     PlaceholderText="LibraryConfiguration.xml"/>
                                            <Button Grid.Column="2" Content="Browse..."
                                                    Command="{Binding BrowseJobConfigurationCommand}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="145,*,Auto" ColumnSpacing="8"
                                              IsVisible="{Binding ShowLibraryPath}">
                                            <TextBlock Grid.Column="0" Text="iTunes library" Classes="muted"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding JobLibraryPath}"
                                                     PlaceholderText="Optional; uses the default library when empty"/>
                                            <Button Grid.Column="2" Content="Browse..."
                                                    Command="{Binding BrowseJobLibraryCommand}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="145,*" ColumnSpacing="8"
                                              IsVisible="{Binding ShowPlaylistName}">
                                            <TextBlock Grid.Column="0" Text="Playlist" Classes="muted"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding JobPlaylistName}"
                                                     PlaceholderText="iTunes playlist name"/>
                                        </Grid>
                                        <StackPanel Spacing="7" IsVisible="{Binding ShowDevicePaths}">
                                            <Grid ColumnDefinitions="145,*,Auto" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="Source" Classes="muted"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding JobSourcePath}"
                                                         PlaceholderText="Local folder or adb: path"/>
                                                <Button Grid.Column="2" Content="Browse..."
                                                        Command="{Binding BrowseJobSourceCommand}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="145,*,Auto" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="Destination" Classes="muted"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding JobDestinationPath}"
                                                         PlaceholderText="Local folder or adb: path"/>
                                                <Button Grid.Column="2" Content="Browse..."
                                                        Command="{Binding BrowseJobDestinationCommand}"/>
                                            </Grid>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="145,*,Auto" ColumnSpacing="8"
                                              IsVisible="{Binding ShowDestinationPath}">
                                            <TextBlock Grid.Column="0" Text="Destination" Classes="muted"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding JobDestinationPath}"
                                                     PlaceholderText="Smart-storage folder"/>
                                            <Button Grid.Column="2" Content="Browse..."
                                                    Command="{Binding BrowseJobDestinationCommand}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="145,*,Auto" ColumnSpacing="8"
                                              IsVisible="{Binding ShowValidationPath}">
                                            <TextBlock Grid.Column="0" Text="Library to validate" Classes="muted"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding JobValidationPath}"
                                                     PlaceholderText="iTunes Library.itl"/>
                                            <Button Grid.Column="2" Content="Browse..."
                                                    Command="{Binding BrowseJobValidationCommand}"/>
                                        </Grid>
                                        <WrapPanel Classes="toolbarwrap" Margin="145,0,-8,0">
                                            <CheckBox Content="Initialize target" IsChecked="{Binding JobInitialize}"
                                                      IsVisible="{Binding ShowInitialize}"/>
                                            <CheckBox Content="Clean obsolete playlists" IsChecked="{Binding JobClean}"
                                                      IsVisible="{Binding ShowClean}"/>
                                            <CheckBox Content="Rebalance paths" IsChecked="{Binding JobRebalance}"
                                                      IsVisible="{Binding ShowRebalance}"/>
                                            <CheckBox Content="Repair missing target files" IsChecked="{Binding JobFixErrors}"
                                                      IsVisible="{Binding ShowFixErrors}"/>
                                            <CheckBox Content="Remap paths" IsChecked="{Binding JobRemap}"
                                                      IsVisible="{Binding ShowRemap}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="7"
                                                        IsVisible="{Binding ShowRemovalLimit}">
                                                <TextBlock Text="Maximum removals" Classes="muted"
                                                           VerticalAlignment="Center"/>
                                                <NumericUpDown Value="{Binding JobMaxRemovals}" Minimum="0"
                                                               Maximum="10000000" Increment="1" Width="150"
                                                               FormatString="0"
                                                               ToolTip.Tip="0 blocks any removal"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <WrapPanel Classes="toolbarwrap" Margin="0,0,-8,0">
                                            <Button Content="Preview job" Command="{Binding PreviewJobCommand}"/>
                                            <Button Content="Apply job" Classes="accent" Command="{Binding ApplyJobCommand}"
                                                    IsVisible="{Binding ShowJobApply}"/>
                                            <TextBlock Text="{Binding JobStatus}" Classes="muted" VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </WrapPanel>
                                        <TextBox Text="{Binding JobOutput}" IsReadOnly="True" AcceptsReturn="True"
                                                 TextWrapping="NoWrap" MinHeight="80" MaxHeight="180"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 IsVisible="{Binding HasJobPreview}"/>
                                        <Expander Header="Job history" HorizontalAlignment="Stretch">
                                            <ItemsControl ItemsSource="{Binding JobHistory}" Margin="8,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:UnifiedJobHistoryItem">
                                                        <Grid ColumnDefinitions="140,180,120,*" ColumnSpacing="8" Margin="0,2">
                                                            <TextBlock Grid.Column="0" Text="{Binding Created}" Classes="caption"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding JobName}" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding State}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Output}" Classes="caption"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Expander>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Additional root" VerticalAlignment="Center"
                                               Classes="muted"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchRoot}"
                                             PlaceholderText="Optional source, sync, or device root"
                                             ToolTip.Tip="Configured library, sync, playlist, and ingest roots are included automatically"/>
                                    <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseRootCommand}"/>
                                </Grid>
                                <WrapPanel Classes="toolbarwrap" Margin="0,0,-8,-8">
                                    <Button Content="Scan operations" Classes="accent" Command="{Binding RefreshCommand}"/>
                                    <TextBlock Text="Keep runs (days)" VerticalAlignment="Center" Classes="muted"/>
                                    <NumericUpDown Value="{Binding RetentionDays}" Minimum="1" Maximum="3650"
                                                   Increment="1" Width="120" FormatString="0"
                                                   ToolTip.Tip="Interrupted operations are always protected"/>
                                    <Button Content="Preview purge" Command="{Binding PreviewPurgeCommand}"
                                            ToolTip.Tip="Inventory old completed/quarantine runs without deleting anything"/>
                                    <Button Content="Apply purge" Classes="accent" Command="{Binding ApplyPurgeCommand}"
                                            IsVisible="{Binding ShowPurgePreview}"
                                            ToolTip.Tip="Permanently delete the runs in the current preview"/>
                                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/>
                                    <ProgressBar IsIndeterminate="True" Width="70" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsBusy}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding PurgePreviewText}" TextWrapping="Wrap" Classes="muted"
                                           IsVisible="{Binding ShowPurgePreview}"/>
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Classes="muted"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" IsVisible="{Binding !ShowBrowser}">
                                <ItemsControl ItemsSource="{Binding Runs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OperationRunViewModel">
                                            <Border Classes="card" Margin="0,0,0,8" Padding="12">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                    <StackPanel Grid.Column="0" MinWidth="140" Spacing="3">
                                                        <TextBlock Text="{Binding ToolName}" Classes="h2"/>
                                                        <TextBlock Text="{Binding Kind}" Classes="muted"/>
                                                        <TextBlock Text="{Binding Created}" Classes="caption"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="{Binding State}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   IsVisible="{Binding !IsInterrupted}"/>
                                                        <TextBlock Text="{Binding State}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   Foreground="#D94A4A" IsVisible="{Binding IsInterrupted}"/>
                                                        <TextBlock Text="{Binding AffectedItems}" Classes="muted"/>
                                                        <TextBlock Text="{Binding RunPath}" Classes="caption" TextWrapping="Wrap"
                                                                   ToolTip.Tip="{Binding RunPath}"/>
                                                        <TextBlock Text="{Binding Journal}" Classes="caption" TextWrapping="Wrap"
                                                                   ToolTip.Tip="{Binding Journal}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Browse" VerticalAlignment="Center"
                                                            Command="{Binding $parent[TabItem].((vm:OperationsViewModel)DataContext).OpenRunCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Grid.Row="1" IsVisible="{Binding ShowBrowser}" RowDefinitions="Auto,*">
                                <WrapPanel Grid.Row="0" Classes="toolbarwrap" Margin="0,0,-8,8">
                                    <Button Content="Back to operations" Command="{Binding CloseBrowserCommand}"/>
                                    <Button Content="Select restorable" Command="{Binding SelectAllRestorableCommand}"/>
                                    <Button Content="Clear selection" Command="{Binding ClearRestoreSelectionCommand}"/>
                                    <Button Content="Preview restore" Command="{Binding PreviewRestoreCommand}"/>
                                    <Button Content="Apply restore" Classes="accent" Command="{Binding ApplyRestoreCommand}"
                                            IsVisible="{Binding ShowRestorePreview}"/>
                                    <TextBlock VerticalAlignment="Center" Classes="muted">
                                        <Run Text="{Binding SelectedRun.ToolName}" FontWeight="SemiBold"/>
                                        <Run Text=" — original hierarchy"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RestorePreviewText}" VerticalAlignment="Center"
                                               Classes="muted" TextWrapping="Wrap"
                                               IsVisible="{Binding ShowRestorePreview}"/>
                                </WrapPanel>
                                <TreeView Grid.Row="1" ItemsSource="{Binding RootNodes}"
                                          Background="Transparent">
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate x:DataType="vm:OperationEntryNodeViewModel"
                                                          ItemsSource="{Binding Children}">
                                            <StackPanel Margin="2" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              IsVisible="{Binding CanRestore}"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding StateText}" Classes="muted"
                                                               IsVisible="{Binding HasEntry}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CurrentPath}" Classes="caption"
                                                           TextWrapping="Wrap" ToolTip.Tip="{Binding CurrentPath}"
                                                           IsVisible="{Binding HasEntry}"/>
                                            </StackPanel>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
    </Grid>
</Window>
