<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\BuildTools\SyncerResourceVerifier\SyncerResourceVerifier.cs"
             Link="BuildTools\SyncerResourceVerifier.cs" />
    <Compile Include="..\BuildTools\LocalizationCatalogGenerator\CatalogGeneratorCommandLine.cs"
             Link="BuildTools\CatalogGeneratorCommandLine.cs" />
    <Compile Include="..\BuildTools\LocalizationCatalogGenerator\LocalizationProtectedTerms.cs"
             Link="BuildTools\LocalizationProtectedTerms.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="..\MusicLibraryManager.Presentation\MusicLibraryManager.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures\SyncerServers\arm64-v8a\syncerd"
                      LogicalName="Syncer.Servers.arm64-v8a.syncerd" />
    <EmbeddedResource Include="Fixtures\SyncerServers\armeabi-v7a\syncerd"
                      LogicalName="Syncer.Servers.armeabi-v7a.syncerd" />
    <EmbeddedResource Include="Fixtures\SyncerServers\x86_64\syncerd"
                      LogicalName="Syncer.Servers.x86_64.syncerd" />
    <EmbeddedResource Include="Fixtures\SyncerServers\x86-fixture\syncerd"
                      LogicalName="Syncer.Servers.x86.syncerd" />
    <None Update="Fixtures\SyncerServers\arm64-v8a\syncerd"
          CopyToOutputDirectory="PreserveNewest" TargetPath="syncer-server-inputs\arm64-v8a\syncerd" />
    <None Update="Fixtures\SyncerServers\armeabi-v7a\syncerd"
          CopyToOutputDirectory="PreserveNewest" TargetPath="syncer-server-inputs\armeabi-v7a\syncerd" />
    <None Update="Fixtures\SyncerServers\x86_64\syncerd"
          CopyToOutputDirectory="PreserveNewest" TargetPath="syncer-server-inputs\x86_64\syncerd" />
    <None Update="Fixtures\SyncerServers\x86-fixture\syncerd"
          CopyToOutputDirectory="PreserveNewest" TargetPath="syncer-server-inputs\x86\syncerd" />
  </ItemGroup>
</Project>
