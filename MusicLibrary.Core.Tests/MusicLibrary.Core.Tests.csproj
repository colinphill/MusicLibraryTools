<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PowerShellExecutable Condition="'$(OS)' == 'Windows_NT'">powershell -ExecutionPolicy Bypass</PowerShellExecutable>
    <PowerShellExecutable Condition="'$(OS)' != 'Windows_NT'">pwsh</PowerShellExecutable>
    <!-- Many tests intentionally supply their own CancellationTokenSource to exercise cancellation. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicLibrary.Core\MusicLibrary.Core.csproj" />
    <ProjectReference Include="..\MusicLibraryManager.Presentation\MusicLibraryManager.Presentation.csproj" />
    <ProjectReference
      Include="..\MusicLibrary.Core.Tests.FpcalcFixture\MusicLibrary.Core.Tests.FpcalcFixture.csproj"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Reuse the shared fixture generator from MusicFileUtilities.Tests: tiny ffmpeg tone clips
       carrying baseline tags, written into this test binary's TestFiles folder. -->
  <Target Name="GenerateTestFixtures" AfterTargets="Build">
    <Exec Command="$(PowerShellExecutable) -NoProfile -File &quot;$(MSBuildProjectDirectory)/../MusicFileUtilities.Tests/generate-fixtures.ps1&quot; -OutDir &quot;$(TargetDir)TestFiles&quot;" />
  </Target>

  <Target Name="CopyFpcalcFixture" AfterTargets="Build">
    <PropertyGroup>
      <FpcalcFixtureConfiguration
        Condition="Exists('$(MSBuildProjectDirectory)/../MusicLibrary.Core.Tests.FpcalcFixture/bin/$(Configuration)/$(TargetFramework)/FpcalcFixture.dll')">$(Configuration)</FpcalcFixtureConfiguration>
      <FpcalcFixtureConfiguration
        Condition="'$(FpcalcFixtureConfiguration)' == ''">Debug</FpcalcFixtureConfiguration>
    </PropertyGroup>
    <ItemGroup>
      <FpcalcFixtureOutput
        Include="$(MSBuildProjectDirectory)/../MusicLibrary.Core.Tests.FpcalcFixture/bin/$(FpcalcFixtureConfiguration)/$(TargetFramework)/FpcalcFixture*" />
    </ItemGroup>
    <Copy SourceFiles="@(FpcalcFixtureOutput)"
          DestinationFolder="$(TargetDir)FpcalcFixtureRuntime" />
  </Target>

</Project>
